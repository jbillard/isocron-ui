const LANGUAGES_COLORS: u32[] = [0x519ABAu32, 0x519ABAu32, 0x519ABAu32, 0xA074C4u32, 0x519ABAu32, 0x519ABAu32, 0x8DC149u32, 0xCBCB41u32, 0x519ABAu32, 0x519ABAu32, 0x519ABAu32, 0x8DC149u32, 0x519ABAu32, 0xE37933u32, 0xF55385u32, 0x519ABAu32, 0x6D8086u32, 0xA074C4u32, 0x519ABAu32, 0xCC3E44u32, 0x519ABAu32, 0x41535Bu32, 0xD4D7D6u32, 0x519ABAu32, 0x519ABAu32, 0x519ABAu32, 0x8DC149u32, 0xCC3E44u32, 0xE37933u32, 0xA074C4u32, 0xE37933u32, 0xE37933u32, 0x41535Bu32, 0x519ABAu32, 0xCC3E44u32, 0xCC3E44u32, 0xCBCB41u32, 0x519ABAu32, 0xCC3E44u32, 0xCBCB41u32, 0xCBCB41u32, 0xCBCB41u32, 0xA074C4u32, 0xE37933u32, 0x519ABAu32, 0x519ABAu32, 0x519ABAu32, 0xE37933u32, 0x519ABAu32, 0xE37933u32, 0x8DC149u32, 0xCBCB41u32, 0xCBCB41u32, 0xE37933u32, 0x519ABAu32, 0xA074C4u32, 0x519ABAu32, 0x519ABAu32, 0x519ABAu32, 0x6D8086u32, 0x519ABAu32, 0x519ABAu32, 0x519ABAu32, 0xCC3E44u32, 0xCC3E44u32, 0x6D8086u32, 0xF55385u32, 0xF55385u32, 0xA074C4u32, 0x8DC149u32, 0x519ABAu32, 0xF55385u32, 0x8DC149u32, 0xE37933u32, 0xA074C4u32, 0xCBCB41u32, 0xCCCCCCu32, 0x519ABAu32, 0x519ABAu32, 0x6D8086u32, 0x8DC149u32, 0xE37933u32, 0xA074C4u32];
const FILE_CHAR: string = "\u{E023}";
const FILE_COLOR: u32 = 0xD4D7D6u32;

// the language of an extension (those of Visual Studio Code)
const LANGUAGE_EXTS: string[] = ["py", "pyw", "sh", "bash", "zsh", "yaml", "yml", "md", "markdown", "lua", "json", "jsonc", "jsonl", "js", "mjs", "cjs", "jsx", "ts", "mts", "tsx", "rs", "go", "c", "h", "cpp", "cc", "hpp", "cs", "java", "kt", "swift", "rb", "php", "pl", "css", "scss", "sass", "less", "html", "htm", "xml", "svg", "sql", "bat", "cmd", "ps1", "r", "dart", "vue", "tex", "ini", "properties", "gradle", "groovy", "ml", "hs", "ex", "jl"];
const LANGUAGE_IDS: string[] = ["python", "python", "shellscript", "shellscript", "shellscript", "yaml", "yaml", "markdown", "markdown", "lua", "json", "jsonc", "jsonl", "javascript", "javascript", "javascript", "javascriptreact", "typescript", "typescript", "typescriptreact", "rust", "go", "c", "c", "cpp", "cpp", "cpp", "csharp", "java", "kotlin", "swift", "ruby", "php", "perl", "css", "scss", "sass", "less", "html", "html", "xml", "xml", "sql", "bat", "bat", "powershell", "r", "dart", "vue", "latex", "properties", "properties", "gradle", "groovy", "ocaml", "haskell", "elixir", "julia"];
const NAME_FILES: string[] = ["dockerfile", "makefile", ".gitignore", ".dockerignore", ".env"];
const NAME_IDS: string[] = ["dockerfile", "makefile", "ignore", "ignore", "dotenv"];

// the icon of the file `name`: by its name, then by its extensions (the
// longest first), then by its language; else the icon of a file
function iconOf(name: string): [string, u32] {
    const low = baseOf(name).toLowerCase();
    const n = findIndex(NAMES_KEYS, (k) => k == low);
    if (n >= 0) {
        return [NAMES_CHARS[n], NAMES_COLORS[n]] as const;
    }
    const b = bytes(low);
    const dots = filter(iota(b.length), (i) => i > 0 && b[i] == 46u8);
    const hits = filter(map(dots, (d) => findIndex(EXTENSIONS_KEYS, (k) => k == low.slice(d + 1, low.length))), (x) => x >= 0);
    if (hits.length > 0) {
        return [EXTENSIONS_CHARS[hits[0]], EXTENSIONS_COLORS[hits[0]]] as const;
    }
    const ext = dots.length > 0 ? low.slice(dots[dots.length - 1] + 1, low.length) : "";
    const byName = findIndex(NAME_FILES, (k) => k == low);
    const byExt = findIndex(LANGUAGE_EXTS, (k) => k == ext);
    const language = byName >= 0 ? NAME_IDS[byName] : (byExt >= 0 ? LANGUAGE_IDS[byExt] : "");
    const l = findIndex(LANGUAGES_KEYS, (k) => k == language);
    return l >= 0 ? [LANGUAGES_CHARS[l], LANGUAGES_COLORS[l]] as const : [FILE_CHAR, FILE_COLOR] as const;
}

function baseOf(p: string): string {
    const k = max(p.lastIndexOf("/"), p.lastIndexOf("\\"));
    return k < 0 ? p : p.slice(k + 1, p.length);
}

export function fileIcon(name: string): string {
    const [c, col] = iconOf(name);
    return c;
}

export function fileIconColor(name: string): Color {
    const [c, col] = iconOf(name);
    return rgb(col);
}
