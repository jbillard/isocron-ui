// The counter (examples/counter.isc) in a window of Windows: its view laid
// out at the size of the window, drawn and shown; a click of the left
// button on a button gives its message, and the model it makes is drawn
// again; the up and down arrows give + and −. Without arguments, the
// window stays until it is closed. With `play`, the program posts to its
// window the messages a hand would make (the pointer moved to a button, the
// button pressed, then released: +, +, +, −, the step, +), read back
// through the procedure of the window, and prints the model they make;
// with a PNG file, what the window shows is captured into it at the end;
// with a number, the window closes after that many seconds. The font is
// `DejaVuSans.ttf` beside the program, or the file of `--font=`.
// usage: counter_window [play] [capture.png] [seconds] [--font=file]
import * as win from "win32";
import * as sys from "sys";
import { rgb, render } from "../src/paint";
import { encode } from "../src/png";
import { parse, Font } from "../src/font";
import { place, hitTest, Hit } from "../src/ui";
import { Model, initial, update, view, INCREMENT, DECREMENT, STEP } from "./counter";

// the view of `m` laid out in the window, drawn and shown; its places
action draw(w: win.Window, f: Font, m: Model, width: i64, height: i64): Hit[] {
    const [ps, hits] = place(f, view(m), 0.0f32, 0.0f32, f32(width), f32(height));
    const shown = win.show(w, render(width, height, rgb(0xF3F4F6u32), ps), width, height);
    return hits;
}

// the events of the window until `until` (nanoseconds of `clock`) or its
// closing: the pointer followed, a press of the left button on a place
// gives its message; the model drawn again when it changes or Windows asks
action run(w: win.Window, f: Font, m: Model, hits: Hit[], x: i64, y: i64, width: i64, height: i64, until: u64): Model {
    if (clock() >= until) {
        return m;
    }
    return match (win.events(w, 50)) {
        Ok(evs) => {
            const [next, nx, ny, again, closed] = fold(evs, [m, x, y, false, false] as const, (acc, e) => {
                const [mm, px, py, redraw, cl] = acc;
                return match (e) {
                    win.Pointer(a, b) => [mm, a, b, redraw, cl] as const,
                    // the arrows up and down (virtual keys 0x26, 0x28)
                    win.Key(k, down, s) => {
                        const msg = !down ? -1 : (k == 38 ? INCREMENT : (k == 40 ? DECREMENT : -1));
                        return [msg >= 0 ? update(mm, msg) : mm, px, py, redraw || msg >= 0, cl] as const;
                    },
                    win.Button(b, down) => {
                        const msg = b == 0 && down ? hitTest(hits, f32(px) + 0.5f32, f32(py) + 0.5f32) : -1;
                        return [msg >= 0 ? update(mm, msg) : mm, px, py, redraw || msg >= 0, cl] as const;
                    },
                    win.Paint => [mm, px, py, true, cl] as const,
                    win.Close => [mm, px, py, redraw, true] as const,
                    _ => acc,
                };
            });
            if (closed) {
                return next;
            }
            if (again) {
                return run(w, f, next, draw(w, f, next, width, height), nx, ny, width, height, until);
            }
            return run(w, f, next, hits, nx, ny, width, height, until);
        },
        Err(e) => m,
    };
}

// a click posted at the centre of the place of `id`: the pointer moved
// there, the left button pressed and released
action post(w: win.Window, hits: Hit[n], id: i64): void {
    const k = findIndex(hits, (h) => h.id == id);
    const at = i64(hits[k].x + hits[k].w * 0.5f32) + i64(hits[k].y + hits[k].h * 0.5f32) * 65536;
    const moved = win.post(w, 512, 0, at);
    const down = win.post(w, 513, 1, at);
    const up = win.post(w, 514, 0, at);
}

// the value of the argument `--name=value`, or `d`
function option(args: string[k], name: string, d: string): string {
    const at = findIndex(args, (a) => a.startsWith(`--${name}=`));
    return at < 0 ? d : args[at].slice(name.length + 3, args[at].length);
}

action main(args: string[k]): i32 {
    if (sys.platform() != "windows") {
        print("Windows only");
        return 1;
    }
    const play = findIndex(args, (a) => a == "play") >= 0;
    const capture = findIndex(args, (a) => a.endsWith(".png"));
    const timed = findIndex(args, (a) => a.length > 0 && findIndex(bytes(a), (b) => b < 48u8 || b > 57u8) < 0);
    return match (parse(readBytes(option(args, "font", "DejaVuSans.ttf")))) {
        Ok(f) => match (win.open("Isocron : un compteur", 480, 320)) {
            Ok(w) => {
                const [width, height] = win.clientSize(w);
                const m0 = initial();
                const hits = draw(w, f, m0, width, height);
                if (play) {
                    post(w, hits, INCREMENT);
                    post(w, hits, INCREMENT);
                    post(w, hits, INCREMENT);
                    post(w, hits, DECREMENT);
                    post(w, hits, STEP);
                    post(w, hits, INCREMENT);
                }
                // until closed, or for the seconds given
                const until = timed >= 0 ? clock() + u64(parseI64(args[timed])) * 1000000000u64 : 18446744073709551615u64;
                const m = run(w, f, m0, hits, 0, 0, width, height, until);
                print([m.count, m.step] as const);
                if (capture >= 0) {
                    match (win.capture(w)) {
                        Ok(shot) => writeBytes(args[capture], encode(width, height, shot)),
                        Err(e) => print(sys.message(e)),
                    };
                }
                win.close(w);
                return 0;
            },
            Err(e) => {
                print(sys.message(e));
                return 1;
            },
        },
        Err(e) => {
            print(e);
            return 1;
        },
    };
}
