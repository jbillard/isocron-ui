// Everything the library draws, with variants of each effect, in one
// image (1280 by 1040), written to the PNG file of the first argument (the
// plate: `gallery_plate.isc`).
import { rgb, render } from "../src/paint";
import { encode } from "../src/png";
import { plate } from "./gallery_plate";
import { parse } from "../src/font";

action main(args: string[k]): i32 {
    const w = 1280;
    const h = 1040;
    const ps = match (parse(readBytes("tests/fonts/DejaVuSans.ttf"))) {
        Ok(f) => plate(f),
        Err(e) => [],
    };
    const t0 = clock();
    const px = render(w, h, rgb(0xF3F4F6u32), ps);
    const t1 = clock();
    print(`${ps.length} primitives, ${w}x${h}, drawn in ${f64(t1 - t0) / 1e6} ms`);
    writeBytes(args[0], encode(w, h, px));
    return 0;
}
