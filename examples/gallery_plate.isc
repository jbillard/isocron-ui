// The plate of the gallery: everything the library draws, with variants of
// each effect, for an image of 1280 by 1040. The rows, from the top: the
// radii of the corners; the borders; colours with alpha over each other;
// the shadows; the components of the library; a card of an interface; places and
// sizes that are not whole pixels; their texts last, over them.
import { Primitive, Box, Blur, Raster, Color, Quad, quad, rounded, bordered, rgb, rgba, transparent, render } from "../src/paint";
import { Font } from "../src/font";
import { line, lineWidth, paragraph, Start, Center, End } from "../src/text";
import { Element, Fill, placeFrame } from "../src/ui";
import { editing } from "../src/edit";
import * as wd from "../src/widgets";

// a quad with a radius for each corner
function corners(q: Quad, tl: f32, tr: f32, br: f32, bl: f32): Quad {
    return { ...q, topLeft: tl, topRight: tr, bottomRight: br, bottomLeft: bl };
}

// a quad with a width of border for each side
function sides(q: Quad, top: f32, right: f32, bottom: f32, left: f32, c: Color): Quad {
    return { ...q, borderColor: c, top: top, right: right, bottom: bottom, left: left };
}

// the shadow of a rectangle with the radius `r`, moved by (dx, dy)
function shadow(x: f32, y: f32, w: f32, h: f32, r: f32, dx: f32, dy: f32, blur: f32, c: Color): Primitive {
    return Blur({ x: x + dx, y: y + dy, w: w, h: h, blur: blur, color: c, topLeft: r, topRight: r, bottomRight: r, bottomLeft: r });
}

function box(q: Quad): Primitive {
    return Box(q);
}

// a white card with a soft shadow under it
function card(x: f32, y: f32, w: f32, h: f32, r: f32): Primitive[2] {
    return [shadow(x, y, w, h, r, 0.0f32, 4.0f32, 8.0f32, rgba(0.0f32, 0.0f32, 0.0f32, 0.18f32)), box(rounded(quad(x, y, w, h, rgb(0xFFFFFFu32)), r))];
}

function blue(): Color {
    return rgb(0x3B82F6u32);
}

// row 1: the radii of the corners
function radii(): Primitive[] {
    const y = 30.0f32;
    const c = blue();
    return [
        box(quad(40.0f32, y, 110.0f32, 80.0f32, c)),
        box(rounded(quad(190.0f32, y, 110.0f32, 80.0f32, c), 4.0f32)),
        box(rounded(quad(340.0f32, y, 110.0f32, 80.0f32, c), 12.0f32)),
        box(rounded(quad(490.0f32, y, 110.0f32, 80.0f32, c), 24.0f32)),
        box(rounded(quad(640.0f32, y, 110.0f32, 80.0f32, c), 40.0f32)),
        box(corners(quad(790.0f32, y, 110.0f32, 80.0f32, c), 36.0f32, 0.0f32, 0.0f32, 0.0f32)),
        box(corners(quad(940.0f32, y, 110.0f32, 80.0f32, c), 36.0f32, 0.0f32, 36.0f32, 0.0f32)),
        box(rounded(quad(1110.0f32, y, 80.0f32, 80.0f32, c), 40.0f32)),
    ];
}

// row 2: the borders
function borders(): Primitive[] {
    const y = 150.0f32;
    const ink = rgb(0x111827u32);
    const white = rgb(0xFFFFFFu32);
    return [
        box(bordered(rounded(quad(40.0f32, y, 110.0f32, 80.0f32, white), 10.0f32), 1.0f32, ink)),
        box(bordered(rounded(quad(190.0f32, y, 110.0f32, 80.0f32, white), 10.0f32), 2.0f32, ink)),
        box(bordered(rounded(quad(340.0f32, y, 110.0f32, 80.0f32, white), 10.0f32), 4.0f32, blue())),
        box(bordered(rounded(quad(490.0f32, y, 110.0f32, 80.0f32, white), 20.0f32), 10.0f32, rgb(0x10B981u32))),
        box(sides(quad(640.0f32, y, 110.0f32, 80.0f32, rgb(0xFEF3C7u32)), 8.0f32, 0.0f32, 0.0f32, 0.0f32, rgb(0xD97706u32))),
        box(sides(rounded(quad(790.0f32, y, 110.0f32, 80.0f32, rgb(0xFCE7F3u32)), 14.0f32), 2.0f32, 10.0f32, 2.0f32, 10.0f32, rgb(0xDB2777u32))),
        box(bordered(rounded(quad(940.0f32, y, 110.0f32, 80.0f32, transparent()), 16.0f32), 3.0f32, rgb(0x7C3AEDu32))),
        box(bordered(rounded(quad(1110.0f32, y, 80.0f32, 80.0f32, rgb(0xE0F2FEu32)), 40.0f32), 8.0f32, rgba(0.0f32, 0.3f32, 0.8f32, 0.35f32))),
    ];
}

// row 3: colours with alpha over each other
function alphas(): Primitive[] {
    const y = 270.0f32;
    // a checkerboard, to see through
    const checks = map(iota(48), (i) => box(quad(40.0f32 + f32(i % 12) * 20.0f32, y + f32(i / 12) * 20.0f32, 20.0f32, 20.0f32, (i % 12 + i / 12) % 2 == 0 ? rgb(0xFFFFFFu32) : rgb(0xD1D5DBu32))));
    const veils = [
        box(quad(50.0f32, y + 10.0f32, 50.0f32, 60.0f32, rgba(0.23f32, 0.51f32, 0.96f32, 0.25f32))),
        box(quad(110.0f32, y + 10.0f32, 50.0f32, 60.0f32, rgba(0.23f32, 0.51f32, 0.96f32, 0.5f32))),
        box(quad(170.0f32, y + 10.0f32, 50.0f32, 60.0f32, rgba(0.23f32, 0.51f32, 0.96f32, 0.75f32))),
        box(quad(230.0f32, y + 10.0f32, 40.0f32, 60.0f32, rgba(0.23f32, 0.51f32, 0.96f32, 1.0f32))),
    ];
    // three discs of red, green and blue at half alpha
    const discs = [
        box(rounded(quad(330.0f32, y, 60.0f32, 60.0f32, rgba(1.0f32, 0.0f32, 0.0f32, 0.5f32)), 30.0f32)),
        box(rounded(quad(365.0f32, y, 60.0f32, 60.0f32, rgba(0.0f32, 0.8f32, 0.0f32, 0.5f32)), 30.0f32)),
        box(rounded(quad(347.0f32, y + 28.0f32, 60.0f32, 60.0f32, rgba(0.0f32, 0.0f32, 1.0f32, 0.5f32)), 30.0f32)),
    ];
    // cards of colours fanned out, each over the one before
    const fan = map(iota(6), (i) => box(bordered(rounded(quad(480.0f32 + f32(i) * 34.0f32, y + f32(i) * 6.0f32, 90.0f32, 60.0f32, rgba(f32(i) / 6.0f32, 0.4f32, 1.0f32 - f32(i) / 6.0f32, 0.8f32)), 10.0f32), 2.0f32, rgb(0xFFFFFFu32))));
    // a glass panel over stripes
    const stripes = map(iota(8), (i) => box(quad(800.0f32 + f32(i) * 50.0f32, y, 25.0f32, 80.0f32, i % 2 == 0 ? rgb(0xF59E0Bu32) : rgb(0xEF4444u32))));
    const glass = [box(bordered(rounded(quad(830.0f32, y + 15.0f32, 330.0f32, 50.0f32, rgba(1.0f32, 1.0f32, 1.0f32, 0.55f32)), 14.0f32), 1.0f32, rgba(1.0f32, 1.0f32, 1.0f32, 0.9f32)))];
    return concat(concat(concat(concat(concat(checks, veils), discs), fan), stripes), glass);
}

// row 4: the shadows
function shadows(): Primitive[] {
    const y = 410.0f32;
    const black = (a: f32) => rgba(0.0f32, 0.0f32, 0.0f32, a);
    const white = rgb(0xFFFFFFu32);
    const at = (i: i64) => 40.0f32 + f32(i) * 150.0f32;
    const blurs = map(iota(6), (i) => [0.0f32, 2.0f32, 4.0f32, 8.0f32, 12.0f32, 18.0f32][i]);
    const under = map(iota(6), (i) => shadow(at(i), y, 110.0f32, 80.0f32, 12.0f32, 0.0f32, 6.0f32, blurs[i], black(0.3f32)));
    const cards = map(iota(6), (i) => box(rounded(quad(at(i), y, 110.0f32, 80.0f32, white), 12.0f32)));
    // a glow of colour, not moved; layers of shadows (a small sharp one,
    // a large soft one)
    const glow = [shadow(940.0f32, y, 110.0f32, 80.0f32, 12.0f32, 0.0f32, 0.0f32, 12.0f32, rgba(0.23f32, 0.51f32, 0.96f32, 0.9f32)), box(rounded(quad(940.0f32, y, 110.0f32, 80.0f32, white), 12.0f32))];
    const layered = [
        shadow(1100.0f32, y, 110.0f32, 80.0f32, 12.0f32, 0.0f32, 1.0f32, 1.0f32, black(0.3f32)),
        shadow(1100.0f32, y, 110.0f32, 80.0f32, 12.0f32, 0.0f32, 14.0f32, 20.0f32, black(0.25f32)),
        box(rounded(quad(1100.0f32, y, 110.0f32, 80.0f32, white), 12.0f32)),
    ];
    // a sharp shadow moved down and right, as a printed label
    const hard = [shadow(40.0f32, y + 110.0f32, 160.0f32, 34.0f32, 6.0f32, 6.0f32, 6.0f32, 0.0f32, rgb(0x111827u32)), box(bordered(rounded(quad(40.0f32, y + 110.0f32, 160.0f32, 34.0f32, rgb(0xFDE047u32)), 6.0f32), 2.0f32, rgb(0x111827u32)))];
    // a shadow of every corner its radius
    const odd = [shadow(260.0f32, y + 110.0f32, 160.0f32, 34.0f32, 0.0f32, 0.0f32, 6.0f32, 6.0f32, black(0.4f32)), box(corners(quad(260.0f32, y + 110.0f32, 160.0f32, 34.0f32, rgb(0xFFFFFFu32)), 17.0f32, 0.0f32, 17.0f32, 0.0f32))];
    return concat(concat(concat(concat(concat(under, cards), glow), layered), hard), odd);
}

// row 5: the components of the library (src/widgets.isc), each laid out
// in its box: what every application shows of them
function widgets(f: Font): Primitive[] {
    const y = 600.0f32;
    const fr = { offsets: [], caretOn: true, hotBar: -1, scale: 1.0f32, deferred: false };
    const at = (e: Element, x: f32, yy: f32, w: f32, h: f32) => {
        const [ps, hits] = placeFrame([f], e, x, yy, w, h, fr);
        return ps;
    };
    const still = { hovered: false, pressed: false };
    const buttons = concat(concat(
        at(wd.button("Valider", 1, true, Fill(1.0f32), still), 40.0f32, y + 6.0f32, 120.0f32, 28.0f32),
        at(wd.button("Appuyé", 2, true, Fill(1.0f32), { hovered: true, pressed: true }), 180.0f32, y + 6.0f32, 120.0f32, 28.0f32)),
        at(wd.button("Annuler", 3, false, Fill(1.0f32), still), 320.0f32, y + 6.0f32, 120.0f32, 28.0f32));
    const switches = concat(at(wd.toggle(true, 4), 470.0f32, y + 10.0f32, 36.0f32, 20.0f32), at(wd.toggle(false, 5), 560.0f32, y + 10.0f32, 36.0f32, 20.0f32));
    const boxes = concat(concat(at(wd.checkbox(true, 6, still), 650.0f32, y + 11.0f32, 18.0f32, 18.0f32), at(wd.checkbox(false, 7, still), 700.0f32, y + 11.0f32, 18.0f32, 18.0f32)), at(wd.radio(true, 8, still), 750.0f32, y + 11.0f32, 18.0f32, 18.0f32));
    const bars = concat(at(wd.slider(0.672f32, 9, 200.0f32), 810.0f32, y + 10.0f32, 200.0f32, 20.0f32), at(wd.progress(0.36f32, 200.0f32), 1040.0f32, y + 16.0f32, 200.0f32, 8.0f32));
    const av = (i: i64) => at(wd.avatar([0xF87171u32, 0xFBBF24u32, 0x34D399u32, 0x60A5FAu32, 0xA78BFAu32][i]), 40.0f32 + f32(i) * 24.0f32, y + 68.0f32, 32.0f32, 32.0f32);
    const avatars = concat(concat(concat(concat(av(0), av(1)), av(2)), av(3)), av(4));
    // a square of an application under its badge
    const badge = concat([box(rounded(quad(230.0f32, y + 68.0f32, 32.0f32, 32.0f32, rgb(0x6B7280u32)), 8.0f32))], at(wd.badge("3"), 254.0f32, y + 62.0f32, 16.0f32, 16.0f32));
    const fields = concat(at(wd.textField(editing(""), false, "Votre nom", 10, Fill(1.0f32)), 320.0f32, y + 70.0f32, 200.0f32, 28.0f32), at(wd.textField(editing("Isocron"), true, "Votre nom", 11, Fill(1.0f32)), 550.0f32, y + 70.0f32, 200.0f32, 28.0f32));
    const segments = at(wd.segments(["Jour", "Semaine", "Mois"], 1, 12, 210.0f32 / 3.0f32), 790.0f32, y + 69.0f32, 216.0f32, 30.0f32);
    // a tooltip and its arrow (a small square with a rounded corner under it)
    const tip = concat(at(wd.tooltip("Une infobulle", 120.0f32), 1060.0f32, y + 68.0f32, 120.0f32, 24.0f32), [box(corners(quad(1114.0f32, y + 86.0f32, 12.0f32, 12.0f32, rgb(0x111827u32)), 0.0f32, 0.0f32, 6.0f32, 0.0f32))]);
    return concat(concat(concat(concat(concat(concat(concat(concat(buttons, switches), boxes), bars), avatars), badge), fields), segments), tip);
}

// row 6: a card of an interface: a header with its upper corners rounded,
// rows separated by lines of one pixel, a selected row, a footer
// an image of 12 by 12 pixels made here: red across, green down, a corner
// transparent and a band at half its opacity; at four times its size (each
// pixel the mix of the four nearest, bilinear), then stretched
function images(): Primitive[] {
    const pixels = map(iota(144), (i) => {
        const x = i % 12;
        const y = i / 12;
        const a = x + y < 5 ? 0u32 : (x >= 9 ? 128u32 : 255u32);
        return (a << 24u32) | (u32(40 + x * 18) << 16u32) | (u32(60 + y * 15) << 8u32) | 210u32;
    });
    return [
        Raster({ x: 480.0f32, y: 509.0f32, w: 48.0f32, h: 48.0f32, iw: 12, ih: 12, pixels: pixels }),
        Raster({ x: 548.0f32, y: 509.0f32, w: 132.0f32, h: 48.0f32, iw: 12, ih: 12, pixels: pixels }),
    ];
}

function panel(): Primitive[] {
    const x = 40.0f32;
    const y = 750.0f32;
    const w = 560.0f32;
    const shell = card(x, y, w, 250.0f32, 14.0f32);
    const header = [box(corners(quad(x, y, w, 44.0f32, rgb(0x1E3A8Au32)), 14.0f32, 14.0f32, 0.0f32, 0.0f32))];
    const rows = map(iota(4), (i) => box(quad(x, y + 44.0f32 + f32(i + 1) * 40.0f32, w, 1.0f32, rgb(0xE5E7EBu32))));
    const selected = [box(quad(x, y + 85.0f32, w, 39.0f32, rgb(0xEFF6FFu32))), box(quad(x, y + 85.0f32, 4.0f32, 39.0f32, blue()))];
    const dots = map(iota(4), (i) => box(rounded(quad(x + 20.0f32, y + 58.0f32 + f32(i) * 40.0f32, 14.0f32, 14.0f32, rgb([0x10B981u32, 0x3B82F6u32, 0xF59E0Bu32, 0xEF4444u32][i])), 7.0f32)));
    const footer = [box(corners(quad(x, y + 210.0f32, w, 40.0f32, rgb(0xF9FAFBu32)), 0.0f32, 0.0f32, 14.0f32, 14.0f32)), box(rounded(quad(x + w - 110.0f32, y + 218.0f32, 96.0f32, 26.0f32, blue()), 13.0f32))];
    return concat(concat(concat(concat(concat(shell, header), selected), rows), dots), footer);
}

// row 6, right: places and sizes that are not whole pixels: lines of 0.25,
// 0.5, 1 and 1.5 pixels; squares moved by quarters of a pixel; circles of
// 2 to 12 pixels
function fractions(): Primitive[] {
    const x = 660.0f32;
    const y = 760.0f32;
    const ink = rgb(0x111827u32);
    const widths = [0.25f32, 0.5f32, 1.0f32, 1.5f32, 2.0f32, 3.0f32];
    const lines = map(iota(6), (i) => box(quad(x + f32(i) * 20.0f32 + 0.5f32 * f32(i % 2), y, widths[i], 90.0f32, ink)));
    const squares = map(iota(8), (i) => box(quad(x + 140.0f32 + f32(i) * 14.25f32, y + f32(i) * 0.25f32, 8.0f32, 8.0f32, ink)));
    const circles = map(iota(6), (i) => box(rounded(quad(x + 140.0f32 + f32(i) * 24.0f32, y + 40.0f32, 2.0f32 + f32(i) * 2.0f32, 2.0f32 + f32(i) * 2.0f32, ink), 1.0f32 + f32(i))));
    const thin = map(iota(5), (i) => box(bordered(rounded(quad(x + 300.0f32 + f32(i) * 56.0f32, y, 46.0f32, 46.0f32, transparent()), 10.0f32), 0.5f32 + f32(i) * 0.5f32, ink)));
    // a slanted edge made of thin steps
    const stairs = map(iota(40), (i) => box(quad(x + 300.0f32 + f32(i) * 7.0f32, y + 60.0f32 + f32(i) * 0.4f32, 7.0f32, 0.75f32, blue())));
    return concat(concat(concat(concat(lines, squares), circles), thin), stairs);
}

// `s` in `em` pixels, centred in the rectangle (x, y, w, h)
function centred(f: Font, s: string, x: f32, y: f32, w: f32, h: f32, em: f32, c: Color): Primitive[] {
    return line(f, em, s, x + (w - lineWidth(f, em, s)) * 0.5f32, y + h * 0.5f32 + em * 0.36f32, c);
}

// `s` ending at `x` on the baseline `y`
function rightAligned(f: Font, s: string, x: f32, y: f32, em: f32, c: Color): Primitive[] {
    return line(f, em, s, x - lineWidth(f, em, s), y, c);
}

// `names[k]` centred in the rectangles from `xs[k]` (a row of them), from
// the `k`-th, after `acc` (an array of arrays of a sum type is not yet in
// Isocron: noted)
function centredRow(f: Font, names: string[n], xs: f32[n], y: f32, w: f32, h: f32, em: f32, c: Color, k: i64, acc: Primitive[]): Primitive[] {
    return k >= names.length ? acc : centredRow(f, names, xs, y, w, h, em, c, k + 1, concat(acc, centred(f, names[k], xs[k], y, w, h, em, c)));
}

// `names[k]` at `xs[k]` on the baselines `ys[k]`, from the `k`-th
function linesFrom(f: Font, names: string[n], xs: f32[n], ys: f32[n], em: f32, c: Color, k: i64, acc: Primitive[]): Primitive[] {
    return k >= names.length ? acc : linesFrom(f, names, xs, ys, em, c, k + 1, concat(acc, line(f, em, names[k], xs[k], ys[k], c)));
}

// `names[k]` ending at `x` on the baselines `ys[k]`, from the `k`-th
function rightFrom(f: Font, names: string[n], x: f32, ys: f32[n], em: f32, c: Color, k: i64, acc: Primitive[]): Primitive[] {
    return k >= names.length ? acc : rightFrom(f, names, x, ys, em, c, k + 1, concat(acc, rightAligned(f, names[k], x, ys[k], em, c)));
}

// the texts of the plate, over its shapes
function labels(f: Font): Primitive[] {
    const white = rgb(0xFFFFFFu32);
    const ink = rgb(0x111827u32);
    const gray = rgb(0x6B7280u32);
    const xs = [40.0f32, 190.0f32, 340.0f32, 490.0f32, 640.0f32, 790.0f32, 940.0f32];
    const radiiNames = ["droits", "4 px", "12 px", "24 px", "pilule", "un coin", "deux coins"];
    const borderNames = ["1 px", "2 px", "4 px", "10 px", "haut", "côtés", "contour"];
    const shadowNames = ["net", "flou 2", "flou 4", "flou 8", "flou 12", "flou 18"];
    const rows = ["Compiler le module unix", "Tester win32 sous Windows", "Dessiner le texte", "Publier la planche"];
    const states = ["fait", "en cours", "fait", "à faire"];
    const all: Primitive[] = [];
    const t0 = concat(all, centredRow(f, radiiNames, xs, 30.0f32, 110.0f32, 80.0f32, 14.0f32, white, 0, []));
    const t1 = concat(t0, centred(f, "disque", 1110.0f32, 30.0f32, 80.0f32, 80.0f32, 14.0f32, white));
    const t2 = concat(t1, centredRow(f, borderNames, xs, 150.0f32, 110.0f32, 80.0f32, 14.0f32, ink, 0, []));
    const t3 = concat(t2, centred(f, "35 %", 1110.0f32, 150.0f32, 80.0f32, 80.0f32, 13.0f32, ink));
    const t4 = concat(t3, line(f, 12.0f32, "voiles de 25 à 100 %", 40.0f32, 382.0f32, gray));
    const t5 = concat(t4, line(f, 12.0f32, "rouge, vert, bleu à 50 %", 318.0f32, 382.0f32, gray));
    const t6 = concat(t5, line(f, 12.0f32, "éventail à 80 %", 520.0f32, 382.0f32, gray));
    const t7 = concat(t6, line(f, 12.0f32, "verre à 55 % sur des rayures", 800.0f32, 382.0f32, gray));
    const t8 = concat(t7, centredRow(f, shadowNames, map(iota(6), (i) => 40.0f32 + f32(i) * 150.0f32), 410.0f32, 110.0f32, 80.0f32, 14.0f32, ink, 0, []));
    const t9 = concat(t8, centred(f, "halo", 940.0f32, 410.0f32, 110.0f32, 80.0f32, 14.0f32, ink));
    const t10 = concat(t9, centred(f, "deux ombres", 1100.0f32, 410.0f32, 110.0f32, 80.0f32, 14.0f32, ink));
    const t11 = concat(t10, centred(f, "étiquette", 40.0f32, 520.0f32, 160.0f32, 34.0f32, 14.0f32, ink));
    const t12 = concat(t11, centred(f, "coins alternés", 260.0f32, 520.0f32, 160.0f32, 34.0f32, 14.0f32, ink));
    // (the texts of the components drawn by them, row 5)
    const t16 = concat(t12, line(f, 12.0f32, "36 %", 1210.0f32, 597.0f32, gray));
    const t25 = concat(t16, line(f, 16.0f32, "Tâches de la semaine", 60.0f32, 778.0f32, white));
    const t26 = concat(t25, linesFrom(f, rows, fill(4, 90.0f32), map(iota(4), (i) => 820.0f32 + f32(i) * 40.0f32), 14.0f32, ink, 0, []));
    const t27 = concat(t26, rightFrom(f, states, 580.0f32, map(iota(4), (i) => 820.0f32 + f32(i) * 40.0f32), 12.0f32, gray, 0, []));
    const t28 = concat(t27, line(f, 12.0f32, "4 tâches", 60.0f32, 985.0f32, gray));
    const t29 = concat(t28, centred(f, "Ajouter", 490.0f32, 968.0f32, 96.0f32, 26.0f32, 13.0f32, white));
    const t30 = concat(t29, line(f, 12.0f32, "traits de 0,25 à 3 px", 660.0f32, 872.0f32, gray));
    const t31 = concat(t30, line(f, 12.0f32, "quarts de pixel, disques", 800.0f32, 835.0f32, gray));
    const t32 = concat(t31, line(f, 12.0f32, "contours de 0,5 à 2,5 px, pente", 960.0f32, 862.0f32, gray));
    const t33 = concat(t32, line(f, 22.0f32, "isocron-ui", 660.0f32, 915.0f32, ink));
    const t34 = concat(t33, paragraph(f, 13.0f32, "Tout est dessiné par la bibliothèque, texte compris : chaque glyphe est tracé depuis le fichier de la police, placé au quart de pixel, et ce paragraphe est coupé en lignes de 300 pixels.", 660.0f32, 942.0f32, 300.0f32, 17.0f32, Start, gray));
    const t35 = concat(t34, paragraph(f, 12.0f32, "Centré dans 220 pixels : chaque ligne est placée au milieu de sa largeur, et la dernière, plus courte, aussi.", 1000.0f32, 942.0f32, 220.0f32, 16.0f32, Center, gray));
    const t36 = concat(t35, paragraph(f, 12.0f32, "une image de 12 × 12 pixels au coin transparent, quatre fois plus grande (bilinéaire), puis étirée", 700.0f32, 527.0f32, 300.0f32, 16.0f32, Start, gray));
    return t36;
}

// every primitive of the plate, in their order, the texts last
export function plate(f: Font): Primitive[] {
    return concat(concat(concat(concat(concat(concat(concat(concat(radii(), borders()), alphas()), shadows()), widgets(f)), panel()), fractions()), images()), labels(f));
}
