// A list of tasks in the manner of Elm: a field that takes the focus on a
// click and edits its text (src/edit.isc: its caret, its selection by the
// keys and the pointer, the clipboard; Enter adds the task, Escape leaves
// the field), tasks ticked or removed by a click, the button under the
// pointer lit; its model, the messages of its places, how the input of the
// hand changes the model, and its view.
import { rgb, rgba, Color } from "../src/paint";
import { Element, Div, Label, Input, Length, Px, Fill, Auto, Row, Column, Packed, Between, style, textStyle, TEXT, ARROW } from "../src/ui";
import { Start, Center, End } from "../src/text";
import { Input as HandInput, Effect, Click, Release, Hover, Key, ENTER, ESCAPE } from "../src/input";
import { Editing, editing, edited } from "../src/edit";
import { button, iconButton, textField, checkbox, handOf, Hand, INK, HINT, MUTED } from "../src/widgets";

export type Item = { text: string, done: boolean };

export type Model = { items: Item[], field: Editing, focused: boolean, hover: i64, pressed: i64 };

// the messages of the clicks: the field, the button that adds, the button
// that clears the tasks done, a click on nothing; a task ticked or
// removed (its index added)
export const FIELD: i64 = 1;
export const ADD: i64 = 2;
export const CLEAR: i64 = 3;
export const NOTHING: i64 = 4;
export const TICK: i64 = 1000;
export const REMOVE: i64 = 2000;

export function initial(): Model {
    return { items: [{ text: "Écrire la bibliothèque", done: true }, { text: "Taper du texte dans un champ", done: false }], field: editing(""), focused: false, hover: -1, pressed: -1 };
}

// the model with the text of the field added as a task (an empty field
// adds nothing)
function added(m: Model): Model {
    return m.field.text == "" ? m : { ...m, items: concat(m.items, [{ text: m.field.text, done: false }]), field: editing("") };
}

// the model after a click on the place of the message `msg` (not the field)
function clicked(m: Model, msg: i64): Model {
    if (msg == ADD) {
        return added(m);
    }
    if (msg == CLEAR) {
        return { ...m, items: filter(m.items, (it) => !it.done) };
    }
    if (msg == NOTHING) {
        return { ...m, focused: false };
    }
    if (msg >= REMOVE && msg - REMOVE < m.items.length) {
        const k = msg - REMOVE;
        return { ...m, items: map(filter(iota(m.items.length), (i) => i != k), (i) => m.items[i]) };
    }
    if (msg >= TICK && msg - TICK < m.items.length) {
        const k = msg - TICK;
        return { ...m, items: map(iota(m.items.length), (i) => i == k ? { ...m.items[i], done: !m.items[i].done } : m.items[i]) };
    }
    return m;
}

// the model after the input `i` of the hand, and what it asks: a click on
// the field gives it the focus (and places its caret), on another place
// its message; with the focus, Enter adds the task, Escape leaves the
// field, the other keys, the characters and the pointer edit it
export function update(m: Model, i: HandInput): [Model, Effect[]] {
    return match (i) {
        Hover(p) => [{ ...m, hover: p }, []] as const,
        Click(p, x, y, at, clicks, mods) => {
            if (p == FIELD) {
                const [f, fx, own] = edited(m.field, i, FIELD);
                return [{ ...m, focused: true, field: f, pressed: p }, fx] as const;
            }
            return [{ ...clicked(m, p), pressed: p }, []] as const;
        },
        Release(p) => [{ ...m, pressed: -1 }, []] as const,
        Key(k, mods) => {
            if (!m.focused) {
                return [m, []] as const;
            }
            if (k == ENTER) {
                return [added(m), []] as const;
            }
            if (k == ESCAPE) {
                return [{ ...m, focused: false }, []] as const;
            }
            const [f, fx, own] = edited(m.field, i, FIELD);
            return [{ ...m, field: f }, fx] as const;
        },
        _ => {
            if (!m.focused) {
                return [m, []] as const;
            }
            const [f, fx, own] = edited(m.field, i, FIELD);
            return [{ ...m, field: f }, fx] as const;
        },
    };
}

// the hand of the place `id`: under the pointer, pressed
function hand(m: Model, id: i64): Hand {
    return { hovered: m.hover == id, pressed: m.pressed == id };
}

// a task: its box to tick, its text, its button to remove it
function row(it: Item, k: i64, m: Model): Element {
    const text = Label(textStyle(15.0f32, it.done ? rgb(HINT) : rgb(INK)), it.text);
    return Div({ ...style(), direction: Row, gap: 12.0f32, align: Center, stretch: false, padding: 6.0f32, radius: 8.0f32, background: m.hover == TICK + k ? rgb(0xF9FAFBu32) : rgba(0.0f32, 0.0f32, 0.0f32, 0.0f32) }, [
        checkbox(it.done, TICK + k, hand(m, TICK + k)),
        Div({ ...style(), width: Fill(1.0f32) }, [text]),
        iconButton("×", REMOVE + k, true, hand(m, REMOVE + k)),
    ]);
}

export function view(m: Model): Element {
    const left = count(m.items, (it) => !it.done);
    const header: Element[] = [
        Label(textStyle(22.0f32, rgb(0x111827u32)), "Tâches"),
        Div({ ...style(), direction: Row, gap: 10.0f32, align: Center, stretch: false }, [textField(m.field, m.focused, "Nouvelle tâche", FIELD, Fill(1.0f32)), button("Ajouter", ADD, true, Auto, hand(m, ADD))]),
    ];
    const rows = map(iota(m.items.length), (k) => row(m.items[k], k, m));
    const footer: Element[] = [
        Div({ ...style(), direction: Row, justify: Between, align: Center, stretch: false }, [
            Label(textStyle(13.0f32, rgb(MUTED)), left <= 1 ? `${left} tâche à faire` : `${left} tâches à faire`),
            button("Effacer les terminées", CLEAR, false, Auto, hand(m, CLEAR)),
        ]),
    ];
    // the tasks in a column that scrolls (its offset the first the
    // application keeps), between the header and the footer
    const list = Div({ ...style(), height: Fill(1.0f32), scroll: 0 }, rows);
    const card = Div({
        ...style(),
        width: Px(440.0f32),
        height: Fill(1.0f32),
        padding: 24.0f32,
        gap: 12.0f32,
        background: rgb(0xFFFFFFu32),
        radius: 16.0f32,
        shadowBlur: 12.0f32,
        shadowY: 6.0f32,
        shadowColor: rgba(0.0f32, 0.0f32, 0.0f32, 0.18f32),
    }, concat(concat(header, [list]), footer));
    // the card at the top, in the middle across (it grows downwards: the
    // places above do not move); a click on the ground gives NOTHING (the
    // field loses the focus), the pointer an arrow over it
    return Div({ ...style(), width: Fill(1.0f32), height: Fill(1.0f32), padding: 40.0f32, justify: Packed(Start), align: Center, stretch: false, background: rgb(0xF3F4F6u32), onClick: NOTHING, cursor: ARROW }, [card]);
}
