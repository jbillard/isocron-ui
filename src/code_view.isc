8, 121u8, 0u8, 0u8, 111u8, 91u8, 98u8, 0u8, 24u8, 0u8, 0u8, 0u8, 125u8, 56u8, 54u8, 123u8, 59u8, 37u8, 54u8, 0u8, 145u8, 58u8, 97u8, 11u8, 11u8, 50u8, 0u8, 0u8, 90u8, 91u8, 103u8, 115u8, 50u8, 43u8, 0u8, 0u8, 93u8, 93u8, 98u8, 95u8, 22u8, 15u8, 0u8, 0u8, 107u8, 99u8, 154u8, 151u8, 28u8, 28u8, 0u8, 0u8, 99u8, 95u8, 101u8, 91u8, 28u8, 28u8, 0u8, 0u8, 95u8, 94u8, 96u8, 93u8, 107u8, 23u8, 0u8, 0u8, 65u8, 130u8, 101u8, 23u8, 57u8, 53u8, 31u8, 76u8, 80u8, 33u8, 93u8, 28u8, 37u8, 81u8, 47u8, 26u8, 58u8, 33u8, 58u8, 33u8, 58u8, 33u8, 92u8, 14u8, 57u8, 55u8, 49u8, 71u8, 100u8, 18u8, 0u8, 0u8, 62u8, 26u8, 33u8, 61u8, 0u8, 0u8];

// the margin of the map at its left, in pixels
const MAP_MARGIN: i64 = 8;

// a line on the map: the character of each column (0 for none: a space)
// and its colour
type MapRow = { codes: i64[], colors: Color[] };

// the image of the map, `w` by `h` units, in pixels: each character its
// boxes of its colour on the background by their brightness
function mapPicture(d: Doc, look: CodeLook, w: i64, h: i64): Picture {
    const s = mapScale(d);
    const lh = 2 * s;
    const pw = i64(f32(w) * d.ratio + 0.5f32);
    const ph = i64(f32(h) * d.ratio + 0.5f32);
    const scrollPx = i64(mapScroll(d) * d.ratio);
    const first = scrollPx / lh;
    const off = scrollPx - first * lh;
    const cols = max(0, (pw - MAP_MARGIN) / s);
    const count = max(0, min(d.lines.length - first, ph / lh + 2));
    const rows = map(iota(count), (i) => mapRow(d, first + i, cols));
    const bg = look.background;
    const back = 0xFF000000u32 | (u32(bg.r * 255.0f32) << 16u32) | (u32(bg.g * 255.0f32) << 8u32) | u32(bg.b * 255.0f32);
    const table = s == 1 ? MAP_CHARS_1 : MAP_CHARS_2;
    const per = 2 * s * s;
    const pixels = map(iota(pw * ph), (i) => {
        const y = i / pw + off;
        const r = y / lh;
        const cx = i % pw - MAP_MARGIN;
        if (cx < 0 || r >= count) {
            return back;
        }
        const col = cx / s;
        if (col >= cols) {
            return back;
        }
        const ch = rows[r].codes[col];
        if (ch == 0) {
            return back;
        }
        const v = f32(table[(ch - 32) * per + (y % lh) * s + cx % s]) / 255.0f32;
        const c = rows[r].colors[col];
        const mix = (a: f32, z: f32) => u32(min(255.0f32, (z + (a - z) * v) * 255.0f32 + 0.5f32));
        return 0xFF000000u32 | (mix(c.r, bg.r) << 16u32) | (mix(c.g, bg.g) << 8u32) | mix(c.b, bg.b);
    });
    return { width: pw, height: ph, pixels: pixels };
}

// the line `k` on the map: the characters of its first `w` columns (tabs to
// their stops; a byte past ASCII drawn as an `x`) and the colours of their
// tokens
function mapRow(d: Doc, k: i64, w: i64): MapRow {
    const text = d.lines[k];
    const b = bytes(text);
    const [pieces, depth] = piecesOf(text, d.scans[k].raws, d.depths[k]);
    const offs = map(iota(w), (x) => offsetAtColumnOf(text, x));
    return {
        codes: map(offs, (o) => o >= b.length || b[o] == 32u8 || b[o] == 9u8 ? 0 : (b[o] >= 33u8 && b[o] <= 126u8 ? i64(b[o]) : 120)),
        colors: map(offs, (o) => {
            const p = findIndex(pieces, (x) => x.start <= o && o < x.end);
            return p >= 0 ? pieces[p].color : kindColor(-1);
        }),
    };
}

// the offset of the line at the column `c` (a tab spans its columns), its
// length past its end
function offsetAtColumnOf(text: string, c: i64): i64 {
    const b = bytes(text);
    if (findIndex(b, (x) => x == 9u8) < 0) {
        return c;
    }
    const k = findIndex(iota(b.length), (j) => columnOf(text, j + 1) > c);
    return k < 0 ? b.length : k;
}

function mapOf(d: Doc, look: CodeLook): Element[] {
    const w = i64(d.mapWidth);
    const h = i64(d.height);
    if (w <= 8 || h <= 0) {
        return [];
    }
    const pic = mapPicture(d, look, w, h);
    // (its thumb under the pointer alone, as Visual Studio Code)
    const hot = look.hover == look.parts + MAP;
    const [ty, th] = mapThumb(d);
    const thumb: Element[] = hot ? [Div({ ...style(), width: Fill(1.0f32), height: Px(max(0.0f32, ty)) }, []), Div({ ...style(), width: Fill(1.0f32), height: Px(th), background: rgba(0.475f32, 0.475f32, 0.475f32, 0.2f32) }, [])] : [];
    const area = Div({ ...style(), width: Px(f32(w)), height: Fill(1.0f32), clip: true, onClick: look.parts + MAP, cursor: ARROW }, concat([
        Div({ ...style(), width: Fill(1.0f32), height: Fill(1.0f32), floating: true, under: true }, [Image(pic, f32(w), f32(h))]),
    ], thumb));
    return [Div({ ...style(), width: Fill(1.0f32), height: Fill(1.0f32), floating: true, direction: Row, justify: Packed(End), stretch: true }, [
        area, Div({ ...style(), width: Px(VBAR), height: Px(1.0f32) }, []),
    ])];
}

// the bar across, under the code, when its lines in sight pass its width:
// its thumb as long as the share of them shown
const HBAR_HEIGHT: f32 = 12.0f32;

function barThumb(d: Doc): [f32, f32] {
    const total = widestShown(d) + 30.0f32;
    const w = d.width;
    const tw = max(20.0f32, w * w / total);
    return [(w - tw) * leftShown(d) / max(1.0f32, total - w), tw] as const;
}

function barAcross(d: Doc, look: CodeLook): Element[] {
    if (widestShown(d) + 30.0f32 <= d.width) {
        return [];
    }
    const [tx, tw] = barThumb(d);
    const hot = look.hover == look.parts + HBAR;
    const track = Div({ ...style(), width: Px(d.width), height: Px(HBAR_HEIGHT), direction: Row, align: Center, stretch: false, onClick: look.parts + HBAR, cursor: ARROW }, [
        Div({ ...style(), width: Px(tx), height: Px(1.0f32) }, []),
        Div({ ...style(), width: Px(tw), height: Px(HBAR_HEIGHT), background: hot ? rgba(0.659f32, 0.663f32, 0.667f32, 0.565f32) : rgba(0.659f32, 0.663f32, 0.667f32, 0.52f32) }, []),
    ]);
    return [Div({ ...style(), width: Fill(1.0f32), height: Fill(1.0f32), floating: true, direction: Column, justify: Packed(End), stretch: false }, [
        Div({ ...style(), width: Fill(1.0f32), height: Px(HBAR_HEIGHT), direction: Row, stretch: false }, [
            Div({ ...style(), width: Px(GUTTER), height: Px(1.0f32) }, []), track,
        ]),
    ])];
}

// ----- the widget of the search ------------------------------------------------

// its colours: those of the widgets of the editor and of their fields
const WIDGET: u32 = 0x202122u32;
const WIDGET_BORDER: u32 = 0x2A2B2Cu32;
const FIELD_BACK: u32 = 0x191A1Bu32;
const FIELD_BORDER: u32 = 0x333536u32;
const TEXT_COLOR: u32 = 0xBFBFBFu32;
const NO_RESULTS: u32 = 0xF48771u32;

// the icons of the widget (codicons)
const I_CHEVRON_RIGHT: string = "\u{EAB6}";
const I_CHEVRON_DOWN: string = "\u{EAB4}";
const I_CASE: string = "\u{EAB1}";
const I_WORD: string = "\u{EB7E}";
const I_REGEX: string = "\u{EB38}";
const I_UP: string = "\u{EAA1}";
const I_DOWN: string = "\u{EA9A}";
const I_SELECTION: string = "\u{EB85}";
const I_CLOSE: string = "\u{EA76}";
const I_REPLACE: string = "\u{EB3D}";
const I_REPLACE_ALL: string = "\u{EB3C}";
const I_PRESERVE: string = "\u{EB2E}";

// a button of the widget: its icon, 16 units in a box of 22 (its tip),
// lit under the pointer, faded when it does nothing (`off`), marked when
// it is an option turned on
function button(look: CodeLook, part: i64, icon: string, tip: string, on: boolean, off: boolean, side: f32): Element {
    const hot = look.hover == look.parts + part && !off;
    return Div({ ...style(), width: Px(side), height: Px(side), direction: Row, justify: Packed(Center), align: Center, stretch: false, radius: 4.0f32,
        onClick: off ? -1 : look.parts + part, tip: tip, cursor: off ? ARROW : POINTER, opacity: off ? 0.4f32 : 1.0f32,
        background: on ? rgba(0.224f32, 0.580f32, 0.737f32, 0.4f32) : (hot ? rgba(1.0f32, 1.0f32, 1.0f32, 0.1f32) : transparent()),
        border: on ? 1.0f32 : 0.0f32, borderColor: rgb(0x3994BCu32) }, [
        Label({ ...textStyle(16.0f32, rgb(0xCCCCCCu32)), face: look.icons, lineHeight: 16.0f32 }, icon),
    ]);
}

// a field of the widget: its text, its hint, its options inside it
function field(look: CodeLook, part: i64, e: Editing, focused: boolean, hint: string, error: boolean, inside: Element[]): Element {
    return Div({ ...style(), width: Fill(1.0f32), height: Px(25.0f32), direction: Row, align: Center, stretch: false, background: rgb(FIELD_BACK),
        border: 1.0f32, borderColor: error ? rgb(0xBE1100u32) : (focused ? rgba(0.224f32, 0.580f32, 0.737f32, 0.7f32) : rgb(FIELD_BORDER)), radius: 2.0f32, padX: 4.0f32 }, concat([
        Div({ ...style(), width: Fill(1.0f32), height: Px(23.0f32), direction: Row, align: Center, stretch: false, onClick: look.parts + part, cursor: TEXT }, [
            ui.Input({ ...textStyle(13.0f32, rgb(TEXT_COLOR)), caret: rgb(0xBBBEBFu32) }, e, focused, hint),
        ]),
    ], inside));
}

// the count of the texts found: `No results`, `? of N` (the selection is
// none of them), `K of N`
export function foundText(d: Doc): string {
    if (d.find.query.text == "") {
        return "No results";
    }
    const n = d.found.length;
    if (n == 0) {
        return "No results";
    }
    const k = currentFound(d);
    return k < 0 ? `? of ${n}` : `${k + 1} of ${n}`;
}

function findWidget(d: Doc, look: CodeLook): Element[] {
    const f = d.find;
    if (!f.shown) {
        return [];
    }
    const none = f.query.text != "" && d.found.length == 0;
    const focusedQuery = f.field == 1 && look.focused;
    const focusedWith = f.field == 2 && look.focused;
    const queryField = field(look, FIND_QUERY, f.query, focusedQuery, "Find", false, [
        button(look, FIND_CASE, I_CASE, "Match Case (Alt+C)", f.matchCase, false, 20.0f32),
        button(look, FIND_WORD, I_WORD, "Match Whole Word (Alt+W)", f.wholeWord, false, 20.0f32),
        button(look, FIND_REGEX, I_REGEX, "Use Regular Expression (Alt+R)", f.regex, false, 20.0f32),
    ]);
    const countText = Div({ ...style(), width: Px(69.0f32), height: Px(25.0f32), direction: Row, align: Center, stretch: false, padX: 4.0f32 }, [
        Label(textStyle(12.0f32, none ? rgb(NO_RESULTS) : rgb(TEXT_COLOR)), foundText(d)),
    ]);
    const empty = d.found.length == 0;
    const findRow = Div({ ...style(), width: Fill(1.0f32), height: Px(33.0f32), direction: Row, align: Center, stretch: false, gap: 3.0f32 }, [
        queryField, countText,
        button(look, FIND_PREV, I_UP, "Previous Match (Shift+Enter)", false, empty, 22.0f32),
        button(look, FIND_NEXT, I_DOWN, "Next Match (Enter)", false, empty, 22.0f32),
        button(look, FIND_SELECTION, I_SELECTION, "Find in Selection (Alt+L)", f.inSelection, false, 22.0f32),
        Div({ ...style(), width: Px(2.0f32), height: Px(1.0f32) }, []),
        button(look, FIND_CLOSE, I_CLOSE, "Close (Escape)", false, false, 22.0f32),
    ]);
    const withField = field(look, FIND_WITH, f.replaceText, focusedWith, "Replace", false, [
        button(look, FIND_PRESERVE, I_PRESERVE, "Preserve Case (Alt+P)", f.preserveCase, false, 20.0f32),
    ]);
    const replaceRow: Element[] = f.replacing ? [Div({ ...style(), width: Fill(1.0f32), height: Px(28.0f32), direction: Row, align: Start, stretch: false, gap: 3.0f32 }, [
        withField,
        button(look, FIND_ONE, I_REPLACE, "Replace (Enter)", false, empty, 22.0f32),
        button(look, FIND_ALL, I_REPLACE_ALL, "Replace All (Ctrl+Alt+Enter)", false, empty, 22.0f32),
        Div({ ...style(), width: Px(101.0f32), height: Px(1.0f32) }, []),
    ])] : [];
    // (the button that shows the replacement: along the left edge)
    const toggle = Div({ ...style(), width: Px(18.0f32), height: Fill(1.0f32), direction: Row, justify: Packed(Center), align: Center, stretch: false,
        onClick: look.parts + FIND_TOGGLE, tip: "Toggle Replace", cursor: POINTER,
        background: look.hover == look.parts + FIND_TOGGLE ? rgba(1.0f32, 1.0f32, 1.0f32, 0.1f32) : transparent() }, [
        Label({ ...textStyle(16.0f32, rgb(0xCCCCCCu32)), face: look.icons, lineHeight: 16.0f32 }, f.replacing ? I_CHEVRON_DOWN : I_CHEVRON_RIGHT),
    ]);
    const height = f.replacing ? 61.0f32 : 33.0f32;
    const box = Div({ ...style(), width: Px(min(419.0f32, max(260.0f32, d.width + d.mapWidth - 20.0f32))), height: Px(height), direction: Row, stretch: true,
        background: rgb(WIDGET), radiusBottomLeft: 4.0f32, radiusBottomRight: 4.0f32, radiusTopLeft: 0.0f32, radiusTopRight: 0.0f32,
        border: 1.0f32, borderColor: rgb(WIDGET_BORDER), borderTop: 0.0f32,
        shadowBlur: 8.0f32, shadowY: 2.0f32, shadowColor: rgba(0.0f32, 0.0f32, 0.0f32, 0.36f32), cursor: ARROW }, [
        toggle,
        Div({ ...style(), width: Fill(1.0f32), height: Fill(1.0f32), padX: 4.0f32, direction: Column, stretch: true }, concat([findRow], replaceRow)),
    ]);
    return [Div({ ...style(), width: Fill(1.0f32), floating: true, direction: Row, justify: Packed(End), stretch: false }, [
        box, Div({ ...style(), width: Px(d.mapWidth + VBAR), height: Px(1.0f32) }, []),
    ])];
}

// ----- the parts clicked and dragged --------------------------------------------

// a click on the part `part` (its message less `look.parts`), the input it
// is: the widget of the search; the map (the thumb taken, else the box
// scrolled to the line under the pointer, in the middle); the bar across
// (the thumb taken, else a page across)
export function codePartClicked(d: Doc, look: CodeLook, part: i64, i: inp.Input): [Doc, Effect[]] {
    if (part < MAP) {
        return findClicked(d, part, i);
    }
    return match (i) {
        inp.Click(p, x, y, at, clicks, mods) => {
            if (part == MAP) {
                const [ty, th] = mapThumb(d);
                if (y >= ty && y < ty + th) {
                    return [{ ...d, grab: y - ty }, []] as const;
                }
                const line = (y + mapScroll(d)) / mapLine(d);
                const top = max(0.0f32, line * LINE_HEIGHT - d.height * 0.5f32);
                return [{ ...d, grab: th * 0.5f32 }, [ScrollTo(look.scroll, top)]] as const;
            }
            const [tx, tw] = barThumb(d);
            if (x >= tx && x < tx + tw) {
                return [{ ...d, grab: x - tx }, []] as const;
            }
            return [{ ...scrolledAcross(d, leftShown(d) + (x < tx ? -d.width : d.width)), grab: -1.0f32 }, []] as const;
        },
        _ => [d, []] as const,
    };
}

// a drag from the part `part` to (x, y) of it: the thumb of the map or of
// the bar across moved with the pointer (the place it was taken at kept)
export function codePartDragged(d: Doc, look: CodeLook, part: i64, i: inp.Input): [Doc, Effect[]] {
    if (part < MAP) {
        return findClicked(d, part, i);
    }
    return match (i) {
        inp.Drag(p, x, y, at) => {
            if (d.grab < 0.0f32) {
                return [d, []] as const;
            }
            if (part == MAP) {
                // (the top of the thumb under the pointer: the box at the
                // offset whose thumb is there)
                const content = f32(d.lines.length) * LINE_HEIGHT;
                const mapped = f32(d.lines.length) * mapLine(d);
                const [ty, th] = mapThumb(d);
                const room = min(d.height, mapped) - th;
                const ratio = room > 0.0f32 ? max(0.0f32, min(1.0f32, (y - d.grab) / room)) : 0.0f32;
                return [d, [ScrollTo(look.scroll, ratio * max(0.0f32, content - d.height))]] as const;
            }
            const total = widestShown(d) + 30.0f32;
            const [tx, tw] = barThumb(d);
            const room = d.width - tw;
            return [scrolledAcross(d, room > 0.0f32 ? (x - d.grab) / room * (total - d.width) : 0.0f32), []] as const;
        },
        _ => [d, []] as const,
    };
}

// ----- the menu of the right button --------------------------------------------

// the entries of the menu of the editor, as Visual Studio Code shows them
// over a file without the features of a language (no definitions, no
// formatter: those entries are not shown there): Change All Occurrences;
// Cut, Copy, Paste (with no selection, the line); Command Palette... (the
// application's: its index `CODE_MENU_PALETTE`)
export const CODE_MENU_PALETTE: i64 = 6;

export function codeMenu(d: Doc): MenuItem[] {
    return [
        menuItem("Change All Occurrences", "Ctrl+F2"),
        menuSeparator(),
        menuItem("Cut", "Ctrl+X"),
        menuItem("Copy", "Ctrl+C"),
        menuItem("Paste", "Ctrl+V"),
        menuSeparator(),
        menuItem("Command Palette...", "Ctrl+Shift+P"),
    ];
}

// how the menus look in the theme 2026 Dark of Visual Studio Code (`menu.*`
// of its colours; its menus of 13 units, entries of 2 em, their texts 2 em
// in, corners of 5 units, entries lit with corners of 4)
export function codeMenuLook(): MenuLook {
    return {
        background: rgb(0x202122u32), foreground: rgb(0xBFBFBFu32), disabled: rgba(0.749f32, 0.749f32, 0.749f32, 0.4f32),
        selection: rgba(0.224f32, 0.580f32, 0.737f32, 0.149f32), selectionBorder: rgb(0x3994BCu32),
        separator: rgb(0x2A2B2Cu32), border: rgb(0x2A2B2Cu32), shadow: rgba(0.0f32, 0.0f32, 0.0f32, 0.36f32),
        radius: 5.0f32, itemRadius: 4.0f32, em: 13.0f32, item: 26.0f32, pad: 26.0f32, least: 160.0f32,
    };
}

// the entry `k` of `codeMenu` chosen: what its shortcut does (Paste: the
// clipboard asked, it comes as a paste); the palette is the application's
export function codeMenuChosen(d: Doc, k: i64): [Doc, Effect[]] {
    if (k == 0) {
        return keyed(d, F2, WITH_CTRL);
    }
    if (k == 2) {
        return keyed(d, 120, WITH_CTRL);
    }
    if (k == 3) {
        return keyed(d, 99, WITH_CTRL);
    }
    if (k == 4) {
        return [d, [AskPaste]] as const;
    }
    return [d, []] as const;
}

// the right button pressed on the row `row` at `x` units from its left: the
// cursor moved there as by a click, unless the place is within a
// selection (kept for the menu, as Visual Studio Code)
export function rowContext(d: Doc, look: CodeLook, row: i64, x: f32): Doc {
    const d1 = rowClicked(d, look, row, x, 1, 0);
    const p = d1.cursor;
    const inside = count(allSelections(d), (s) => {
        const [a, b] = rangeOf(s);
        const afterA = p.line > a.line || (p.line == a.line && p.col >= a.col);
        const beforeB = p.line < b.line || (p.line == b.line && p.col < b.col);
        return (a.line != b.line || a.col != b.col) && afterA && beforeB;
    }) > 0;
    return inside ? d : d1;
}
