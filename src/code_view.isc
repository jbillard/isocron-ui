// The lines of a document of the editor of code (src/doc.isc) as elements,
// as Visual Studio Code draws them: those in sight alone (the others a
// space of their height), each its number, the guides of its indentation,
// its tokens coloured, its selections, its carets, the texts found by the
// search, the line of each cursor lit, the code scrolled across under its
// numbers; the lines of the blocks around the first line in sight kept at
// the top (sticky scroll); over them, the widget of the search, the map of
// the document (the minimap) and the scrollbar across. Its spaces and tabs
// are drawn as spaces of no break: a column of a font of fixed width each.
import { rgb, rgba, Color, transparent } from "./paint";
import { Element, Div, Label, Caret, Image, Spans, Span, span, style, textStyle, Px, Fill, Auto, Row, Column, Packed, Between, POINTER, TEXT, ARROW } from "./ui";
import * as ui from "./ui";
import { Center, End, Start } from "./text";
import { Picture } from "./png";
import { Editing } from "./edit";
import * as inp from "./input";
import { Effect, ScrollTo, AskPaste, MenuItem, MenuLook, menuItem, menuSeparator, WITH_CTRL, F2 } from "./input";
import { Doc, Pos, Sel, Match, mapScale, keyed, selection, hasSelection, columnOf, allSelections, rangeOf, currentFound, findClicked, leftShown, widestShown, scrolledAcross, clickedWith, draggedTo, wrapped, wrapColumns, wrapIndent, rowsOfLine, lineOfRow, totalRows, positionAtRow, LINE_HEIGHT, TAB_SIZE, GUTTER, VBAR, FIND_QUERY, FIND_WITH, FIND_CASE, FIND_WORD, FIND_REGEX, FIND_PREV, FIND_NEXT, FIND_CLOSE, FIND_TOGGLE, FIND_ONE, FIND_ALL, FIND_SELECTION, FIND_PRESERVE } from "./doc";
import { Piece, piecesOf, kindColor } from "./code";

// how the code looks (the theme 2026 Dark of Visual Studio Code by
// default): the width of a column of its font of fixed width at its size
// (`advance`), the font (`face`), the message of the first line (`ids`: a
// click on the line `k` gives `ids + k`), whether the editor has the focus
// (the carets shown, the selection of its colour); the message of the
// first of its other parts (`parts`: the widget of the search, the map,
// the bar across, from `FIND_QUERY` to `HBAR`), the face of the icons, the
// number of the box that scrolls it, the place under the pointer
export type CodeLook = {
    advance: f32, em: f32, lineHeight: f32, face: i64, ids: i64, focused: boolean,
    gutter: f32, gap: f32,
    number: Color, numberActive: Color, current: Color, selection: Color, inactiveSelection: Color,
    caret: Color, guide: Color, background: Color, stickyLine: Color,
    findMatch: Color, findHighlight: Color,
    parts: i64, icons: i64, scroll: i64, hover: i64,
};

// the parts past those of the widget: the map, the bar across
export const MAP: i64 = 20;
export const HBAR: i64 = 21;

export function codeLook(advance: f32, face: i64, ids: i64, focused: boolean): CodeLook {
    return {
        advance: advance, em: 14.0f32, lineHeight: LINE_HEIGHT, face: face, ids: ids, focused: focused,
        gutter: 42.4f32, gap: 25.6f32,
        number: rgb(0x858889u32), numberActive: rgb(0xBBBEBFu32), current: rgb(0x242526u32),
        selection: rgba(0.153f32, 0.404f32, 0.510f32, 0.867f32), inactiveSelection: rgba(0.153f32, 0.404f32, 0.510f32, 0.376f32),
        caret: rgb(0xBBBEBFu32), guide: rgba(0.514f32, 0.518f32, 0.522f32, 0.3f32), background: rgb(0x121314u32),
        stickyLine: rgb(0x2A2B2Cu32),
        findMatch: rgb(0x9E6A03u32), findHighlight: rgba(0.918f32, 0.361f32, 0.0f32, 0.333f32),
        parts: ids - 100, icons: 2, scroll: 1, hover: -1,
    };
}

// the look with the messages of its parts, the face of its icons, its box,
// the place under the pointer
export function lookWith(look: CodeLook, parts: i64, icons: i64, scroll: i64, hover: i64): CodeLook {
    return { ...look, parts: parts, icons: icons, scroll: scroll, hover: hover };
}

// the rows in sight (a few more above and below), rows of `lineHeight`:
// the first, the last (excluded); a row a line unless they are wrapped
export function sightOf(d: Doc, lineHeight: f32): [i64, i64] {
    const n = totalRows(d);
    const first = max(0, i64(d.top / lineHeight) - 5);
    const last = min(n, i64((d.top + d.height) / lineHeight) + 6);
    return [min(first, last), last] as const;
}

// every element of the box that scrolls the document: the lines kept at
// its top, the lines, the map, the bar across, the widget of the search
export function codeElements(d: Doc, look: CodeLook): Element[] {
    return concat(concat(stickyOf(d, look), codeRows(d, look)), overlays(d, look));
}

// the elements of the box that scrolls the document: a space for the lines
// above those in sight, their rows, a space for those below
export function codeRows(d: Doc, look: CodeLook): Element[] {
    const [first, last] = sightOf(d, look.lineHeight);
    const above = Div({ ...style(), height: Px(f32(first) * look.lineHeight) }, []);
    const below = Div({ ...style(), height: Px(f32(totalRows(d) - last) * look.lineHeight) }, []);
    const sels = allSelections(d);
    const cur = currentFound(d);
    const shift = leftShown(d);
    if (wrapped(d)) {
        const [k0, g0] = lineOfRow(d, first);
        return concat(concat([above], wrappedRows(d, look, k0, g0, first, last, sels, cur, [])), [below]);
    }
    return concat(concat([above], map(iota(last - first), (i) => lineRow(d, look, first + i, true, sels, cur, shift, 0, -1, first + i, 0))), [below]);
}

// the rows of the lines wrapped from the row `g` of the line `k` (the row
// `r` of the document) to the row `last`
function wrappedRows(d: Doc, look: CodeLook, k: i64, g: i64, r: i64, last: i64, sels: Sel[ns], cur: i64, out: Element[]): Element[] {
    if (r >= last || k >= d.lines.length) {
        return out;
    }
    const st = rowsOfLine(d, k);
    const n = bytes(d.lines[k]).length;
    const end = g + 1 < st.length ? st[g + 1] : n;
    const indent = g > 0 ? wrapIndent(d.lines[k], wrapColumns(d)) : 0;
    const row = lineRow(d, look, k, true, sels, cur, 0.0f32, st[g], g + 1 < st.length ? end : -1, r, indent);
    return g + 1 < st.length ? wrappedRows(d, look, k, g + 1, r + 1, last, sels, cur, concat(out, [row]))
        : wrappedRows(d, look, k + 1, 0, r + 1, last, sels, cur, concat(out, [row]));
}

// a click on the row `row` at `x` units from its left: the cursor at the
// line and the column under the pointer (lines wrapped: of the row)
export function rowClicked(d: Doc, look: CodeLook, row: i64, x: f32, clicks: i64, mods: i64): Doc {
    if (!wrapped(d)) {
        return clickedWith(d, row, columnAtX(d, look, x), clicks, mods);
    }
    const p = positionAtRow(d, row, max(0, i64(floor((x - look.gutter - look.gap) / look.advance + 0.5f32))));
    return clickedWith(d, p.line, columnOf(d.lines[p.line], p.col), clicks, mods);
}

// a drag from the row `row` to (x, y) of it: the selection to the line and
// the column under the pointer
export function rowDragged(d: Doc, look: CodeLook, row: i64, x: f32, y: f32): Doc {
    const r = row + i64(floor(y / look.lineHeight));
    if (!wrapped(d)) {
        return draggedTo(d, r, columnAtX(d, look, x));
    }
    if (r < 0) {
        return draggedTo(d, -1, 0);
    }
    const p = positionAtRow(d, r, max(0, i64(floor((x - look.gutter - look.gap) / look.advance + 0.5f32))));
    return draggedTo(d, r >= totalRows(d) ? d.lines.length : p.line, columnOf(d.lines[p.line], p.col));
}

// the column of the code under the pointer at `x` units from the left of a
// line (its number and the gap after it, the code scrolled across)
export function columnAtX(d: Doc, look: CodeLook, x: f32): i64 {
    return i64(floor((x - look.gutter - look.gap + leftShown(d)) / look.advance + 0.5f32));
}

// a run of the line to draw: its bytes, its colour, its background (none:
// transparent)
type Run = { start: i64, end: i64, color: Color, back: Color };

// the bytes of the selections on a line: their starts and ends, whether
// each goes on below it
type Marks = { starts: i64[], ends: i64[], past: boolean[] };

function marksOf(sels: Sel[n], k: i64, len: i64): Marks {
    const on = filter(sels, (s) => {
        const [a, b] = rangeOf(s);
        return (a.line != b.line || a.col != b.col) && k >= a.line && k <= b.line;
    });
    return {
        starts: map(on, (s) => {
            const [a, b] = rangeOf(s);
            return k == a.line ? a.col : 0;
        }),
        ends: map(on, (s) => {
            const [a, b] = rangeOf(s);
            return k == b.line ? b.col : len;
        }),
        past: map(on, (s) => {
            const [a, b] = rangeOf(s);
            return k < b.line;
        }),
    };
}

// the row of the line `k`: its number, its code (`live`: its selections,
// its carets and the light of the lines of the cursors; the sticky lines
// have none), the texts found on it (`cur` the index of the current one),
// the code moved left by `shift`; of its bytes from `rs` to `re` (-1: its
// end; a row of a line wrapped, `indent` columns in when not its first),
// its message that of the row `row`
function lineRow(d: Doc, look: CodeLook, k: i64, live: boolean, sels: Sel[ns], cur: i64, shift: f32, rs: i64, re0: i64, row: i64, indent: i64): Element {
    const text = d.lines[k];
    const n = bytes(text).length;
    const re = re0 < 0 ? n : re0;
    const lastRow = re0 < 0;
    // (the cursors on the line: their carets, the light of the line when
    // one has no selection)
    const cursors = live ? filter(sels, (s) => s.cursor.line == k) : [];
    const active = cursors.length > 0;
    const lit = count(cursors, (s) => s.cursor.line == s.anchor.line && s.cursor.col == s.anchor.col) > 0
        && count(sels, (s) => {
            const [a, b] = rangeOf(s);
            return (a.line != b.line || a.col != b.col) && k >= a.line && k <= b.line;
        }) == 0;
    const number = Div({ ...style(), width: Px(look.gutter), height: Px(look.lineHeight), direction: Row, justify: Packed(End), align: Center, stretch: false },
        rs == 0 ? [Label({ ...textStyle(look.em, active ? look.numberActive : look.number), face: look.face }, `${k + 1}`)] : []);
    const gap = Div({ ...style(), width: Px(look.gap), height: Px(1.0f32) }, []);
    const ms = live ? marksOf(sels, k, n) : { starts: [], ends: [], past: [] };
    const found = filter(iota(d.found.length), (i) => d.found[i].line == k);
    const [pieces, depth] = piecesOf(text, d.scans[k].raws, d.depths[k]);
    // (the indentation: its guides each `indent` columns, the runs within)
    const lead = leadColumns(text);
    const levels = lead.bytes == n || rs > 0 ? 0 : lead.columns / d.indent;
    // (no caret while the widget of the search has the keyboard; those of
    // this row of the line)
    const carets = look.focused && d.find.field == 0 ? filter(map(cursors, (s) => s.cursor.col), (c) => c >= rs && (c < re || (lastRow && c == re))) : [];
    const cuts = sortedCuts(concat(concat(concat(concat(concat(ms.starts, ms.ends), carets), guideCuts(text, levels, d.indent)), [rs, re]),
        concat(concat(map(pieces, (p) => p.start), map(pieces, (p) => p.end)), concat(map(found, (i) => d.found[i].start), map(found, (i) => d.found[i].end)))), n);
    const selColor = look.focused ? look.selection : look.inactiveSelection;
    const runs = filter(runsOf(pieces, cuts, ms, d.found, found, cur, selColor, look), (r) => r.start >= rs && r.end <= re);
    // (the guides of the indentation: a line along the left of the run at
    // each of its levels)
    const guides = map(iota(levels), (g) => offsetAtColumn(text, g * d.indent));
    const past = lastRow && count(ms.past, (p) => p) > 0;
    // (a row after the first of a line wrapped: its indentation; a caret at
    // its start; its runs, a caret before each that begins at one; a caret
    // at its end; the selection going on below it: a column of its colour)
    const pad: Span[] = indent > 0 ? [span(join(map(iota(indent), (x) => "\u{A0}"), ""), look.caret)] : [];
    const caretFirst: Span[] = count(carets, (c) => c == rs) > 0 ? [caretSpan(look)] : [];
    const caretEnd: Span[] = count(carets, (c) => c == re) > 0 && re > rs ? [caretSpan(look)] : [];
    const eol: Span[] = past ? [{ ...span("\u{A0}", look.caret), back: selColor }] : [];
    const spans = concat(concat(concat(concat(pad, caretFirst), spansOf(text, runs, look, carets, rs, guides)), caretEnd), eol);
    // (the code cut to its box, before the map: moved left when scrolled
    // across)
    const code = Div({ ...style(), width: Fill(1.0f32), height: Px(look.lineHeight), direction: Row, align: Center, stretch: false,
        background: lit ? look.current : transparent(), clip: true, shiftX: shift }, [Spans({ ...textStyle(look.em, look.caret), face: look.face }, spans)]);
    // (the room of the map after the code: the code ends at its left edge,
    // as in Visual Studio Code, not drawn under it)
    const room: Element[] = d.mapWidth > 8.0f32 && d.width > 0.0f32 ? [Div({ ...style(), width: Px(d.mapWidth), height: Px(1.0f32) }, [])] : [];
    return Div({ ...style(), width: Fill(1.0f32), height: Px(look.lineHeight), direction: Row, align: Center, stretch: false, onClick: live ? look.ids + row : -1, cursor: TEXT }, concat([number, gap, code], room));
}

// a caret of the code: a run without text
function caretSpan(look: CodeLook): Span {
    return { ...span("", look.caret), caret: true };
}

// the runs drawn: their text with spaces of no break, a tab up to its stop,
// their colours and backgrounds; a guide along the left of a run that
// begins at one of `guides`; a caret before a run that begins at one of
// `carets` (but at the start of the row `rs`, drawn before them)
function spansOf(text: string, runs: Run[n], look: CodeLook, carets: i64[c], rs: i64, guides: i64[g]): Span[] {
    return spansFrom(text, runs, look, carets, rs, guides, 0, []);
}

function spansFrom(text: string, runs: Run[n], look: CodeLook, carets: i64[c], rs: i64, guides: i64[g], i: i64, out: Span[]): Span[] {
    if (i >= n) {
        return out;
    }
    const r = runs[i];
    const mark: Span[] = r.start > rs && count(carets, (x) => x == r.start) > 0 ? [caretSpan(look)] : [];
    const edge = count(guides, (x) => x == r.start) > 0 ? look.guide : transparent();
    return spansFrom(text, runs, look, carets, rs, guides, i + 1, concat(concat(out, mark), [{ text: spacedText(text, r.start, r.end), color: r.color, back: r.back, edge: edge, caret: false }]));
}

// the leading spaces and tabs of a line: their bytes and their columns
type Lead = { bytes: i64, columns: i64 };

function leadColumns(text: string): Lead {
    const b = bytes(text);
    const k = findIndex(iota(b.length), (j) => b[j] != 32u8 && b[j] != 9u8);
    const end = k < 0 ? b.length : k;
    return { bytes: end, columns: columnOf(text, end) };
}

// the offsets where the guides of the indentation begin (each `indent`
// columns of the leading spaces)
function guideCuts(text: string, levels: i64, indent: i64): i64[] {
    return map(iota(levels + 1), (g) => offsetAtColumn(text, g * indent));
}

// the offset of the line at the column `c` of its indentation
function offsetAtColumn(text: string, c: i64): i64 {
    const b = bytes(text);
    const k = findIndex(iota(b.length + 1), (j) => columnOf(text, j) >= c);
    return k < 0 ? b.length : k;
}

// the offsets where the runs are cut, sorted, each once, within the line
function sortedCuts(xs: i64[n], len: i64): i64[] {
    return uniq(sort(filter(concat(xs, [0, len]), (x) => x >= 0 && x <= len)), 0, []);
}

function uniq(s: i64[n], i: i64, out: i64[]): i64[] {
    if (i >= n) {
        return out;
    }
    return uniq(s, i + 1, i > 0 && s[i] == s[i - 1] ? out : concat(out, [s[i]]));
}

// the runs between the cuts: the colour of the piece holding each; its
// background the current text found, a selection, another text found
function runsOf(pieces: Piece[p], cuts: i64[n], ms: Marks, found: Match[f], on: i64[q], cur: i64, sel: Color, look: CodeLook): Run[] {
    return filter(map(iota(max(0, n - 1)), (i) => {
        const s = cuts[i];
        const e = cuts[i + 1];
        const k = findIndex(pieces, (x) => x.start <= s && s < x.end);
        const selected = findIndex(iota(ms.starts.length), (j) => s >= ms.starts[j] && e <= ms.ends[j]) >= 0;
        const hit = findIndex(on, (j) => s >= found[j].start && e <= found[j].end);
        const back = hit >= 0 && on[hit] == cur ? look.findMatch : (selected ? sel : (hit >= 0 ? look.findHighlight : transparent()));
        return { start: s, end: e, color: k >= 0 ? pieces[k].color : kindColor(-1), back: back };
    }), (r) => r.end > r.start);
}

// the bytes [s, e) of the line as drawn: a space a space of no break, a tab
// as many as its columns
function spacedText(text: string, s: i64, e: i64): string {
    const part = text.slice(s, e);
    return part.indexOf(" ") < 0 && part.indexOf("\t") < 0 ? part : spaced(text, s, e);
}

// (each character of the part, a space or a tab replaced)
function spaced(text: string, s: i64, e: i64): string {
    const b = bytes(text);
    return spacedFrom(text, b, s, e, s, "");
}

function spacedFrom(text: string, b: u8[n], i: i64, e: i64, from: i64, out: string): string {
    if (i >= e) {
        return out + text.slice(from, e);
    }
    if (b[i] == 32u8) {
        return spacedFrom(text, b, i + 1, e, i + 1, out + text.slice(from, i) + "\u{A0}");
    }
    if (b[i] == 9u8) {
        const w = columnOf(text, i + 1) - columnOf(text, i);
        return spacedFrom(text, b, i + 1, e, i + 1, out + text.slice(from, i) + join(map(iota(w), (x) => "\u{A0}"), ""));
    }
    return spacedFrom(text, b, i + 1, e, from, out);
}

// the lines of the blocks around the first line in sight, kept at the top
// of the box (sticky scroll): each line before it less indented than those
// after it, the outermost first, 5 at most (a line of a bracket alone left
// out); in a box over the code, a line and a shadow under it
export function stickyOf(d: Doc, look: CodeLook): Element[] {
    const [first, g] = lineOfRow(d, i64(d.top / look.lineHeight));
    if (first <= 0 || first >= d.lines.length) {
        return [];
    }
    const chain = stickyFrom(d, first - 1, leadColumns(d.lines[first]).columns, []);
    const n = min(5, chain.length);
    if (n == 0) {
        return [];
    }
    const none: Sel[] = [];
    const shift = leftShown(d);
    const rows = map(iota(n), (i) => lineRow(d, look, chain[chain.length - 1 - i], false, none, -1, shift, 0, -1, -1, 0));
    return [Div({ ...style(), width: Fill(1.0f32), floating: true, background: look.background, borderBottom: 1.0f32, borderColor: look.stickyLine,
        shadowBlur: 3.0f32, shadowY: 2.0f32, shadowColor: rgba(0.098f32, 0.106f32, 0.114f32, 0.3f32) }, rows)];
}

function stickyFrom(d: Doc, k: i64, level: i64, out: i64[]): i64[] {
    if (k < 0 || level == 0) {
        return out;
    }
    const lead = leadColumns(d.lines[k]);
    const blank = lead.bytes == bytes(d.lines[k]).length;
    const body = d.lines[k].trim();
    const bare = body == "{" || body == "[" || body == "(";
    return lead.columns < level && !blank && !bare ? stickyFrom(d, k - 1, lead.columns, concat(out, [k])) : stickyFrom(d, k - 1, level, out);
}

// ----- over the code: the map, the bar across, the widget of the search ------

function overlays(d: Doc, look: CodeLook): Element[] {
    if (d.width <= 0.0f32) {
        return [];
    }
    return concat(concat(mapOf(d, look), barAcross(d, look)), findWidget(d, look));
}

// the map, as Visual Studio Code draws its minimap: in the pixels of the
// screen (`d.ratio` a unit), a character `mapScale` pixels wide and twice
// as high, a line as high as its characters, from 8 pixels in (its
// margin); as much of the document as its height holds, moved with the box
// past it in proportion

// a line of the map, in units
function mapLine(d: Doc): f32 {
    return f32(2 * mapScale(d)) / d.ratio;
}

// the offset of the map in units: the map scrolled in proportion with the
// box
function mapScroll(d: Doc): f32 {
    const content = f32(d.lines.length) * LINE_HEIGHT;
    const mapped = f32(d.lines.length) * mapLine(d);
    return mapped > d.height && content > d.height ? min(1.0f32, d.top / (content - d.height)) * (mapped - d.height) : 0.0f32;
}

// the thumb of the map (the lines in sight): its top and height in the map
function mapThumb(d: Doc): [f32, f32] {
    return [d.top / LINE_HEIGHT * mapLine(d) - mapScroll(d), d.height / LINE_HEIGHT * mapLine(d)] as const;
}

// the brightness of each character of ASCII from 32 to 126 in its boxes of
// pixels, row by row (1 by 2 at the scale 1, 2 by 4 at the scale 2): made
// by tools/mapchars.isc from the font of fixed width, as Visual Studio Code
// makes those of its minimap
