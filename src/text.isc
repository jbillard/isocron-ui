// Text drawn: the outlines of the glyphs of a font of TrueType turned into
// images of coverage (`Sprite`), a line of text laid out (its characters
// read from UTF-8, their glyphs, their advances and the kerning of their
// pairs, each glyph drawn at its place to a fraction of a pixel).
import { Font, glyphOf, advance, kerning, outline, hasOutline, Segment } from "./font";
import { Primitive, Glyph, Sprite, Color } from "./paint";

// the characters of `s` (its code points), read from its UTF-8
export function codePoints(s: string): i64[] {
    const b = bytes(s);
    // the first byte of each character
    const starts = filter(iota(b.length), (i) => (b[i] & 0xC0u8) != 0x80u8);
    return map(starts, (i) => {
        const c = i64(b[i]);
        const at = (k: i64) => i + k < b.length ? i64(b[i + k]) & 63 : 0;
        return c < 0x80 ? c
            : (c < 0xE0 ? (c & 31) * 64 + at(1)
            : (c < 0xF0 ? (c & 15) * 4096 + at(1) * 64 + at(2)
            : (c & 7) * 262144 + at(1) * 4096 + at(2) * 64 + at(3)));
    });
}

// the parts of the outline of `g` at `em` pixels a unit of the font
// (`em` / units per em), its origin at (fx, 0) (fx: the fraction of a
// pixel of the pen), y down; four straight parts to a curve, eight above
// 32 pixels
export function scaledOutline(f: Font, g: i64, em: f32, fx: f32): Segment[] {
    const k = em / f32(f.unitsPerEm);
    const steps = em > 32.0f32 ? 8 : 4;
    return map(outline(f, g, steps), (s) => ({ x0: fx + s.x0 * k, y0: -s.y0 * k, x1: fx + s.x1 * k, y1: -s.y1 * k }));
}

// the smaller and the larger of two floats that are not NaN (`min` and
// `max` treat NaN and -0 as IEEE 754-2019 asks: more instructions)
function less(a: f32, b: f32): f32 {
    return a < b ? a : b;
}

function more(a: f32, b: f32): f32 {
    return a > b ? a : b;
}

// the image of coverage of the glyph `g` at `em`, its pen at (fx, 0): the
// place of its top left pixel from the pen, its size, its coverage (an
// empty glyph: one pixel of none). The coverage is exact for the parts of
// the outline (the method of font-rs, fontdue and ab_glyph): each part
// drawn row by row into a buffer of areas, updated in place, each row then
// added up from its left; a pixel inside two contours turning the same way
// is covered once.
export function rasterize(f: Font, g: i64, em: f32, fx: f32): [i64, i64, i64, i64, f32[]] {
    // the parts in units of the font, placed and scaled as they are read
    // (`scaledOutline`'s)
    const ss = outline(f, g, em > 32.0f32 ? 8 : 4);
    const k = em / f32(f.unitsPerEm);
    if (ss.length == 0) {
        return [0, 0, 1, 1, [0.0f32]] as const;
    }
    // the box of the parts in units of the font, then placed and scaled
    // (both monotonic, their roundings too: the box of the parts placed;
    // y down, so the top is the largest y)
    const [lo, bo, ro, to] = fold(ss, [1e30f32, 1e30f32, -1e30f32, -1e30f32] as const, (box, s) => {
        const [l0, b0, r0, t0] = box;
        return [less(l0, less(s.x0, s.x1)), less(b0, less(s.y0, s.y1)), more(r0, more(s.x0, s.x1)), more(t0, more(s.y0, s.y1))] as const;
    });
    const l = fx + lo * k;
    const r = fx + ro * k;
    const t = -to * k;
    const b = -bo * k;
    const left = floor(l);
    const top = floor(t);
    const w = max(1, i64(ceil(r)) - i64(left));
    const h = max(1, i64(ceil(b)) - i64(top));
    // two columns more on the right: the cells a piece at the right edge
    // writes past it
    const width = w + 2;
    // each part drawn row by row into the areas (rows of `width` cells),
    // updated in place: each cell it crosses given the area of the row it
    // leaves on its right, the cell after given the rest, so that a row
    // added up from its left is the coverage of the outline (the rows in
    // lambdas of the `fold`, always inlined: a function the compiler calls
    // would cost a call a row, 100 to 200 a glyph)
    const areas = fold(ss, fill(width * h, 0.0f32), (a, s) => {
        const x0 = fx + s.x0 * k - left;
        const y0 = -s.y0 * k - top;
        const x1 = fx + s.x1 * k - left;
        const y1 = -s.y1 * k - top;
        if (y0 == y1) {
            return a;
        }
        const down = y1 > y0;
        const ax = down ? x0 : x1;
        const ay = down ? y0 : y1;
        const bx = down ? x1 : x0;
        const by = down ? y1 : y0;
        const dir = down ? 1.0f32 : -1.0f32;
        const dxdy = (bx - ax) / (by - ay);
        const r0 = i64(floor(ay));
        return fold(iota(i64(ceil(by)) - r0), a, (c, kr) => {
            const row = r0 + kr;
            const ya = more(f32(row), ay);
            const yb = less(f32(row + 1), by);
            const xa = ax + (ya - ay) * dxdy;
            const xb = ax + (yb - ay) * dxdy;
            const d = (yb - ya) * dir;
            const lo = less(xa, xb);
            const hi = more(xa, xb);
            const lof = floor(lo);
            const hic = ceil(hi);
            const i0 = i64(lof);
            const i1 = i64(hic);
            const p = row * width + i0;
            // within a cell or two: the area left of the middle of the piece
            if (i1 <= i0 + 1) {
                const xmf = 0.5f32 * (xa + xb) - lof;
                const one = requireUnique(c.with(p, c[p] + (d - d * xmf)));
                return requireUnique(one.with(p + 1, one[p + 1] + d * xmf));
            }
            // across more: a triangle in the first and the last cell, the
            // slope in each cell between
            const sl = 1.0f32 / (hi - lo);
            const x0f = lo - lof;
            const a0 = 0.5f32 * sl * (1.0f32 - x0f) * (1.0f32 - x0f);
            const x1f = hi - hic + 1.0f32;
            const am = 0.5f32 * sl * x1f * x1f;
            const q = row * width + i1;
            const first = requireUnique(c.with(p, c[p] + d * a0));
            if (i1 == i0 + 2) {
                const mid = requireUnique(first.with(p + 1, first[p + 1] + d * (1.0f32 - a0 - am)));
                return requireUnique(mid.with(q, mid[q] + d * am));
            }
            const a1 = sl * (1.5f32 - x0f);
            const second = requireUnique(first.with(p + 1, first[p + 1] + d * (a1 - a0)));
            const run = fold(iota(i1 - i0 - 3), second, (e, t) => requireUnique(e.with(p + 2 + t, e[p + 2 + t] + d * sl)));
            const a2 = a1 + f32(i1 - i0 - 3) * sl;
            const last = requireUnique(run.with(q - 1, run[q - 1] + d * (1.0f32 - a2 - am)));
            return requireUnique(last.with(q, last[q] + d * am));
        });
    });
    // each row added up from its left into the coverage of its pixels,
    // written in place (one pass, as C writes it: no division by the width
    // for each pixel)
    const mask = fold(iota(h), fill(w * h, 0.0f32), (m, r) => {
        const [row, sum] = fold(iota(w), [m, 0.0f32] as const, (acc, x) => {
            const [o, c] = acc;
            const total = c + areas[r * width + x];
            return [requireUnique(o.with(r * w + x, less(1.0f32, abs(total)))), total] as const;
        });
        return row;
    });
    return [i64(left), i64(top), w, h, mask] as const;
}

// the advance of the line `s` at `em`, in pixels (kerning included)
export function lineWidth(f: Font, em: f32, s: string): f32 {
    const gs = map(codePoints(s), (c) => glyphOf(f, c));
    const k = em / f32(f.unitsPerEm);
    return fold(iota(gs.length), 0.0f32, (w, i) => w + f32(advance(f, gs[i]) + (i + 1 < gs.length ? kerning(f, gs[i], gs[i + 1]) : 0)) * k);
}

// the line `s` at `em` pixels a em, its pen starting at `x` on the
// baseline `y` (its pixels above it), in the colour `c`: a glyph for each
// character that draws something, each at its pen to a quarter of a pixel
export function line(f: Font, em: f32, s: string, x: f32, y: f32, c: Color): Primitive[] {
    const gs = map(codePoints(s), (cp) => glyphOf(f, cp));
    const k = em / f32(f.unitsPerEm);
    const steps = map(iota(gs.length), (i) => f32(advance(f, gs[i]) + (i + 1 < gs.length ? kerning(f, gs[i], gs[i + 1]) : 0)) * k);
    const ends = scan(steps, (a, b) => a + b, 0.0f32);
    const base = i64(floor(y + 0.5f32));
    // the glyphs that draw something (a space has no outline), chosen
    // before they are drawn: a glyph is not copied to be kept
    const drawn = filter(iota(gs.length), (i) => hasOutline(f, gs[i]));
    return map(drawn, (i) => {
        // the pen at a quarter of a pixel, as GPUI places its glyphs (four
        // images of a glyph at most for a size)
        const pen = floor((x + ends[i] - steps[i]) * 4.0f32 + 0.5f32) * 0.25f32;
        const whole = floor(pen);
        const [left, top, w, h, mask] = rasterize(f, gs[i], em, pen - whole);
        return Glyph({ x: i64(whole) + left, y: base + top, w: w, h: h, color: c, mask: mask });
    });
}

// how the lines of a paragraph are placed in its width
export type Align = Start | Center | End;

// the first character of each line of the characters `cps` (their
// advances, kerning included, in `steps`) in `width` pixels, then the
// number of lines: a line ends after the spaces that follow its last word
// that fits, after a line feed, or, in a word wider than the width,
// before its first character that does not fit (a line holds one
// character at least)
export function breaks(cps: i64[n], steps: f32[n], width: f32): [i64[], i64] {
    const [starts, count, first, x, after, xa] = fold(iota(n), [fill(n + 1, 0), 1, 0, 0.0f32, -1, 0.0f32] as const, (acc, i) => {
        const [ls, cnt, st, xx, bk, xbk] = acc;
        const c = cps[i];
        if (c == 10) {
            return [requireUnique(ls.with(cnt, i + 1)), cnt + 1, i + 1, 0.0f32, -1, 0.0f32] as const;
        }
        // a space: a line may end after it; it never overflows
        if (c == 32) {
            return [ls, cnt, st, xx + steps[i], i + 1, xx + steps[i]] as const;
        }
        if (xx + steps[i] <= width || i == st) {
            return [ls, cnt, st, xx + steps[i], bk, xbk] as const;
        }
        // after the last spaces of the line, or before this character
        const ns = bk > st ? bk : i;
        const nx = bk > st ? xx - xbk : 0.0f32;
        return [requireUnique(ls.with(cnt, ns)), cnt + 1, ns, nx + steps[i], -1, 0.0f32] as const;
    });
    return [starts, count] as const;
}

// the characters of `s` at `em` pixels a em, their glyphs, their advances
// (kerning included) and the end of each from the start of the text, and
// its lines in `width` pixels: the first character of each (`breaks`) and
// its width (up to its last character that is neither a space nor a line
// feed)
function laidOut(f: Font, em: f32, s: string, width: f32): [i64[], i64[], f32[], f32[], i64[], f32[]] {
    const cps = codePoints(s);
    const gs = map(cps, (cp) => glyphOf(f, cp));
    const n = gs.length;
    const k = em / f32(f.unitsPerEm);
    const steps = map(iota(n), (i) => f32(advance(f, gs[i]) + (i + 1 < n ? kerning(f, gs[i], gs[i + 1]) : 0)) * k);
    const ends = scan(steps, (a, b) => a + b, 0.0f32);
    const [all, count] = breaks(cps, steps, width);
    const starts = all.slice(0, count);
    const lastInk = scan(map(iota(n), (i) => cps[i] != 32 && cps[i] != 10 ? i : -1), max, -1);
    const widths = map(iota(count), (j) => {
        const a = starts[j];
        const z = j + 1 < count ? starts[j + 1] : n;
        const last = z > a ? lastInk[z - 1] : -1;
        return last >= a ? ends[last] - (ends[a] - steps[a]) : 0.0f32;
    });
    return [cps, gs, steps, ends, starts, widths] as const;
}

// the size of the paragraph of `s` (`paragraph`) in `width`: its widest
// line, and its lines times `lineHeight`
export function measureParagraph(f: Font, em: f32, s: string, width: f32, lineHeight: f32): [f32, f32] {
    const [cps, gs, steps, ends, starts, widths] = laidOut(f, em, s, width);
    return [fold(widths, 0.0f32, (m, w) => more(m, w)), f32(widths.length) * lineHeight] as const;
}

// the text `s` at `em` pixels a em in lines of at most `width` pixels
// (`breaks`), the baseline of the first at `y`, each line `lineHeight`
// below the one before, placed in [x, x + width] by `align` (a line's
// width ends at its last character that is neither a space nor a line
// feed), in the colour `c`: its glyphs, made by one `map` (none copied)
export function paragraph(f: Font, em: f32, s: string, x: f32, y: f32, width: f32, lineHeight: f32, align: Align, c: Color): Primitive[] {
    const [cps, gs, steps, ends, starts, widths] = laidOut(f, em, s, width);
    const n = gs.length;
    const count = starts.length;
    // the line of each character (a line after a final line feed holds
    // none)
    const firsts = filter(iota(count), (j) => starts[j] < n);
    const lineOf = scan(scatter(fill(n, 0), map(firsts, (j) => starts[j]), firsts, (a, z) => z), max, 0);
    // the pen of the start of each line, placed by `align`
    const shift = map(iota(count), (j) => {
        const a = starts[j];
        const origin = a < n ? ends[a] - steps[a] : 0.0f32;
        const free = width - widths[j];
        const offset = match (align) {
            Start => 0.0f32,
            Center => free * 0.5f32,
            End => free,
        };
        return offset - origin;
    });
    const drawn = filter(iota(n), (i) => cps[i] != 10 && hasOutline(f, gs[i]));
    return map(drawn, (i) => {
        const j = lineOf[i];
        const pen = floor((x + shift[j] + ends[i] - steps[i]) * 4.0f32 + 0.5f32) * 0.25f32;
        const whole = floor(pen);
        const base = i64(floor(y + f32(j) * lineHeight + 0.5f32));
        const [left, top, w, h, mask] = rasterize(f, gs[i], em, pen - whole);
        return Glyph({ x: i64(whole) + left, y: base + top, w: w, h: h, color: c, mask: mask });
    });
}
