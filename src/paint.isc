// The primitives of a scene drawn on the processor: rectangles with rounded
// corners and borders (the quads of GPUI), their shadows and glyphs, each
// pixel the composition of the primitives that cover it, in their order. The formulas are those of the
// fragment shader of the quads of GPUI (the signed distance to a rounded
// rectangle, the antialiasing of half a pixel), in `f32`: the same bits on
// every target and for any number of threads.

// a colour in the space of sRGB, not premultiplied, each channel in [0, 1]
export type Color = { r: f32, g: f32, b: f32, a: f32 };

// a rectangle of the scene, in pixels: its place and size, its colour, its
// border (a width for each side, its colour) and the radius of each corner
export type Quad = {
    x: f32, y: f32, w: f32, h: f32,
    background: Color,
    borderColor: Color,
    top: f32, right: f32, bottom: f32, left: f32,
    topLeft: f32, topRight: f32, bottomRight: f32, bottomLeft: f32,
};

// a shadow: the rectangle it is the shadow of (placed where the shadow
// falls), the radius of its corners, its blur (the deviation of the
// gaussian, in pixels; 0: sharp) and its colour
export type Shadow = {
    x: f32, y: f32, w: f32, h: f32,
    blur: f32,
    color: Color,
    topLeft: f32, topRight: f32, bottomRight: f32, bottomLeft: f32,
};

// a glyph, or any small image of coverage: the place of its top left
// pixel (whole pixels), its size, its colour, the coverage of each of its
// pixels in [0, 1] (rows from the top; at least one pixel)
// (`at`: the place of its coverage in the pixels of the atlas given to
// `renderWith`, its `mask` then empty; -1: its own `mask`. `key`: the key of
// its image in the atlas, -1 for its own: two sprites of the same key at
// the same place have the same pixels, compared without them)
export type Sprite = { x: i64, y: i64, w: i64, h: i64, color: Color, mask: f32[], at: i64, key: i64 };

// an image drawn in the rectangle (x, y, w, h): its `iw` by `ih` pixels
// (`0xAARRGGBB`, not premultiplied, rows from the top), each pixel of the
// rectangle the mix of the four of the image nearest its centre (bilinear)
export type Bitmap = { x: f32, y: f32, w: f32, h: f32, iw: i64, ih: i64, pixels: u32[] };

// what a scene holds, drawn in its order; `Clip(x0, y0, x1, y1)` and
// `Unclip`: the primitives between them drawn only on the pixels whose
// centre is inside the rectangle (and inside those of the `Clip`s around
// them)
// a glyph whose image is not made yet: the glyph `glyph` of the font at
// `em` pixels a em, its pen at `x` and `quarter` quarters of a pixel (0 to
// 3), on the baseline `base`, in the colour `color`, of the font `face`
// among those of the application (`resolved` of atlas.isc makes it a
// `Glyph`, from the images kept: it draws nothing itself)
export type GlyphKey = { glyph: i64, em: f32, quarter: i64, x: i64, base: i64, color: Color, face: i64 };

export type Primitive = Box(Quad) | Blur(Shadow) | Glyph(Sprite) | Raster(Bitmap) | Pending(GlyphKey) | Clip(f32, f32, f32, f32) | Unclip;

export function rgba(r: f32, g: f32, b: f32, a: f32): Color {
    return { r: r, g: g, b: b, a: a };
}

// a colour of the form 0xRRGGBB, opaque
export function rgb(hex: u32): Color {
    return {
        r: f32((hex >> 16u32) & 255u32) / 255.0f32,
        g: f32((hex >> 8u32) & 255u32) / 255.0f32,
        b: f32(hex & 255u32) / 255.0f32,
        a: 1.0f32,
    };
}

export function transparent(): Color {
    return { r: 0.0f32, g: 0.0f32, b: 0.0f32, a: 0.0f32 };
}

// a rectangle filled with `c`, without border nor radius
export function quad(x: f32, y: f32, w: f32, h: f32, c: Color): Quad {
    return {
        x: x, y: y, w: w, h: h, background: c, borderColor: transparent(),
        top: 0.0f32, right: 0.0f32, bottom: 0.0f32, left: 0.0f32,
        topLeft: 0.0f32, topRight: 0.0f32, bottomRight: 0.0f32, bottomLeft: 0.0f32,
    };
}

// `q` with the radius `r` at each corner
export function rounded(q: Quad, r: f32): Quad {
    return { ...q, topLeft: r, topRight: r, bottomRight: r, bottomLeft: r };
}

// `q` with a border of `width` on each side, of colour `c`
export function bordered(q: Quad, width: f32, c: Color): Quad {
    return { ...q, borderColor: c, top: width, right: width, bottom: width, left: width };
}

function clamp01(v: f32): f32 {
    return min(1.0f32, max(0.0f32, v));
}

// the signed distance from (px, py) to the rectangle of centre (cx, cy), of
// half sizes (hw, hh), whose corners have the radius `r` (negative inside)
function roundedDistance(px: f32, py: f32, cx: f32, cy: f32, hw: f32, hh: f32, r: f32): f32 {
    const qx = abs(px - cx) - hw + r;
    const qy = abs(py - cy) - hh + r;
    const ox = max(qx, 0.0f32);
    const oy = max(qy, 0.0f32);
    return sqrt(ox * ox + oy * oy) + min(max(qx, qy), 0.0f32) - r;
}

// the colour of `q` at the centre (px, py) of a pixel, premultiplied by its
// coverage: [r, g, b, a]
function shade(q: Quad, px: f32, py: f32): [f32, f32, f32, f32] {
    const cx = q.x + q.w * 0.5f32;
    const cy = q.y + q.h * 0.5f32;
    const left = px < cx;
    const above = py < cy;
    // the corner of the quarter of the pixel, its radius at most half the
    // smaller side
    const r0 = above ? (left ? q.topLeft : q.topRight) : (left ? q.bottomLeft : q.bottomRight);
    const r = min(r0, min(q.w, q.h) * 0.5f32);
    const outside = roundedDistance(px, py, cx, cy, q.w * 0.5f32, q.h * 0.5f32, r);
    const cover = clamp01(0.5f32 - outside);
    // the inner edge of the border: the rectangle less its widths, its
    // corners less the wider of the two borders that meet there
    const bx = left ? q.left : q.right;
    const by = above ? q.top : q.bottom;
    const ix = q.x + q.left;
    const iy = q.y + q.top;
    const iw = max(0.0f32, q.w - q.left - q.right);
    const ih = max(0.0f32, q.h - q.top - q.bottom);
    const ir = max(0.0f32, r - max(bx, by));
    const noBorder = q.top == 0.0f32 && q.right == 0.0f32 && q.bottom == 0.0f32 && q.left == 0.0f32;
    const inside = noBorder ? cover : min(cover, clamp01(0.5f32 - roundedDistance(px, py, ix + iw * 0.5f32, iy + ih * 0.5f32, iw * 0.5f32, ih * 0.5f32, min(ir, min(iw, ih) * 0.5f32))));
    const fa = q.background.a * inside;
    const ba = q.borderColor.a * (cover - inside);
    return [
        q.background.r * fa + q.borderColor.r * ba,
        q.background.g * fa + q.borderColor.g * ba,
        q.background.b * fa + q.borderColor.b * ba,
        fa + ba,
    ] as const;
}

// the error function, approximated as the shader of GPUI does (Abramowitz
// and Stegun 7.1.27)
function erf(v: f32): f32 {
    const s = v < 0.0f32 ? -1.0f32 : (v > 0.0f32 ? 1.0f32 : 0.0f32);
    const a = abs(v);
    const r1 = 1.0f32 + (0.278393f32 + (0.230389f32 + (0.000972f32 + 0.078108f32 * a) * a) * a) * a;
    const r2 = r1 * r1;
    return s - s / (r2 * r2);
}

// e^x for x in [-4.5, 0], the exponents of the gaussian of a shadow (its
// samples within three deviations): (1 + x/1024)^1024, ten squarings, less
// than 1 % from e^x there, as precise as the `exp` of a GPU for a blur, and
// computed for many pixels at once (the `exp` of the prelude is a call for
// each)
function expNear(x: f32): f32 {
    return fold(iota(10), 1.0f32 + x / 1024.0f32, (v, i) => v * v);
}

function gaussian(x: f32, sigma: f32): f32 {
    return expNear(-(x * x) / (2.0f32 * sigma * sigma)) / (sqrt(2.0f32 * f32(Math.PI)) * sigma);
}

// the blur of the rectangle along x at the height y of its centre (GPUI's
// `blur_along_x`): the integral of the gaussian across its width there
function blurAlongX(x: f32, y: f32, sigma: f32, corner: f32, hw: f32, hh: f32): f32 {
    const delta = min(hh - corner - abs(y), 0.0f32);
    const curved = hw - corner + sqrt(max(0.0f32, corner * corner - delta * delta));
    const k = sqrt(0.5f32) / sigma;
    return 0.5f32 * (erf((x + curved) * k) - erf((x - curved) * k));
}

// the coverage of a blurred rectangle at (dx, dy) from its centre: the
// gaussian along y sampled four times where it is not zero
function blurred(dx: f32, dy: f32, sigma: f32, r: f32, hw: f32, hh: f32): f32 {
    const low = dy - hh;
    const high = dy + hh;
    const start = min(high, max(low, -3.0f32 * sigma));
    const end = min(high, max(low, 3.0f32 * sigma));
    const step = (end - start) / 4.0f32;
    return fold(iota(4), 0.0f32, (acc, i) => {
        const y = start + step * (f32(i) + 0.5f32);
        return acc + blurAlongX(dx, dy - y, sigma, r, hw, hh) * gaussian(y, sigma) * step;
    });
}

// the colour of the shadow `s` at (px, py), premultiplied by its coverage:
// sharp, the coverage of its rounded rectangle; blurred, the gaussian
// integrated along x exactly (`erf`) and along y in four samples, as GPUI
function shadeShadow(s: Shadow, px: f32, py: f32): [f32, f32, f32, f32] {
    const hw = s.w * 0.5f32;
    const hh = s.h * 0.5f32;
    const dx = px - (s.x + hw);
    const dy = py - (s.y + hh);
    const r0 = dy < 0.0f32 ? (dx < 0.0f32 ? s.topLeft : s.topRight) : (dx < 0.0f32 ? s.bottomLeft : s.bottomRight);
    const r = min(r0, min(s.w, s.h) * 0.5f32);
    const alpha = s.blur == 0.0f32 ? clamp01(0.5f32 - roundedDistance(px, py, s.x + hw, s.y + hh, hw, hh, r)) : blurred(dx, dy, s.blur, r, hw, hh);
    const a = s.color.a * alpha;
    return [s.color.r * a, s.color.g * a, s.color.b * a, a] as const;
}

// no colour
const NONE: [f32, f32, f32, f32] = [0.0f32, 0.0f32, 0.0f32, 0.0f32] as const;

// a channel in [0, 1] as a byte
function byte(v: f32): u32 {
    return u32(clamp01(v) * 255.0f32 + 0.5f32);
}

// the primitive `p` moved by (dx, dy) pixels (a glyph by whole pixels: dx
// and dy rounded)
export function movedBy(p: Primitive, dx: f32, dy: f32): Primitive {
    const ix = i64(floor(dx + 0.5f32));
    const iy = i64(floor(dy + 0.5f32));
    return match (p) {
        Box(q) => Box({ ...q, x: q.x + dx, y: q.y + dy }),
        Blur(s) => Blur({ ...s, x: s.x + dx, y: s.y + dy }),
        Glyph(g) => Glyph({ ...g, x: g.x + ix, y: g.y + iy }),
        Raster(b) => Raster({ ...b, x: b.x + dx, y: b.y + dy }),
        Pending(g) => Pending({ ...g, x: g.x + ix, base: g.base + iy }),
        Clip(a, b, c, d) => Clip(a + dx, b + dy, c + dx, d + dy),
        Unclip => Unclip,
    };
}

// the box of a primitive outside of which it colours no pixel whose
// centre is there: [x0, y0, x1, y1], a centre (px, py) drawn only when
// x0 < px < x1 and y0 < py < y1 (one pixel more than a quad for its
// antialiasing; three deviations more than a shadow, as GPUI draws it)
function reach(p: Primitive): [f32, f32, f32, f32] {
    return match (p) {
        Box(q) => [q.x - 1.0f32, q.y - 1.0f32, q.x + q.w + 1.0f32, q.y + q.h + 1.0f32] as const,
        Blur(s) => {
            const m = 3.0f32 * s.blur + 1.0f32;
            return [s.x - m, s.y - m, s.x + s.w + m, s.y + s.h + m] as const;
        },
        Glyph(g) => [f32(g.x), f32(g.y), f32(g.x + g.w), f32(g.y + g.h)] as const,
        Raster(bm) => [bm.x, bm.y, bm.x + bm.w, bm.y + bm.h] as const,
        // (they draw nothing)
        _ => [0.0f32, 0.0f32, 0.0f32, 0.0f32] as const,
    };
}

// the rectangle of each primitive's clip: those of the `Clip`s open before
// it intersected (the whole plane when none is; 16 at most, those deeper
// clipped by the 16th)
function clips(ps: Primitive[n]): [f32, f32, f32, f32][n] {
    const all = [-1e30f32, -1e30f32, 1e30f32, 1e30f32] as const;
    const [out, stack, depth] = fold(iota(n), [fill(n, all), fill(64, 0.0f32), 0] as const, (acc, k) => {
        const [o, st, d] = acc;
        const top = d == 0 ? all : [st[d * 4 - 4], st[d * 4 - 3], st[d * 4 - 2], st[d * 4 - 1]] as const;
        return match (ps[k]) {
            Clip(a, b, c, e) => {
                const [t0, t1, t2, t3] = top;
                const nd = min(d + 1, 16);
                const at = (nd - 1) * 4;
                const s1 = requireUnique(st.with(at, max(a, t0)));
                const s2 = requireUnique(s1.with(at + 1, max(b, t1)));
                const s3 = requireUnique(s2.with(at + 2, min(c, t2)));
                return [o, requireUnique(s3.with(at + 3, min(e, t3))), nd] as const;
            },
            Unclip => [o, st, max(0, d - 1)] as const,
            _ => [requireUnique(o.with(k, top)), st, d] as const,
        };
    });
    return out;
}

// the side of a tile, in pixels
const TILE: i64 = 16;

// the primitives that may colour a pixel of a tile, in their order
type Bin = { ids: i64[] };

// a colour premultiplied: red, green, blue, alpha
type Px = [f32, f32, f32, f32];

// `s` over `d`, both premultiplied
function over(d: Px, s: Px): Px {
    const [sr, sg, sb, sa] = s;
    const [dr, dg, db, da] = d;
    const k = 1.0f32 - sa;
    return [sr + dr * k, sg + dg * k, sb + db * k, sa + da * k] as const;
}

// a colour premultiplied as a pixel `0xAARRGGBB`, not premultiplied
function pack(c: Px): u32 {
    const [r, g, b, a] = c;
    const inv = a > 0.0f32 ? 1.0f32 / a : 0.0f32;
    return (byte(a) << 24u32) | (byte(r * inv) << 16u32) | (byte(g * inv) << 8u32) | byte(b * inv);
}

// the coverage of `q` at the centre (px, py) of a pixel: the part of the
// pixel inside its outer edge (`shade`'s `cover`)
function coverOf(q: Quad, px: f32, py: f32): f32 {
    const cx = q.x + q.w * 0.5f32;
    const cy = q.y + q.h * 0.5f32;
    const left = px < cx;
    const above = py < cy;
    const r0 = above ? (left ? q.topLeft : q.topRight) : (left ? q.bottomLeft : q.bottomRight);
    const r = min(r0, min(q.w, q.h) * 0.5f32);
    return clamp01(0.5f32 - roundedDistance(px, py, cx, cy, q.w * 0.5f32, q.h * 0.5f32, r));
}

// the part of the pixel inside the inner edge of the border of `q`, at
// most `cover` (`shade`'s `inside`)
function insideOf(q: Quad, px: f32, py: f32, cover: f32): f32 {
    const cx = q.x + q.w * 0.5f32;
    const cy = q.y + q.h * 0.5f32;
    const left = px < cx;
    const above = py < cy;
    const r0 = above ? (left ? q.topLeft : q.topRight) : (left ? q.bottomLeft : q.bottomRight);
    const r = min(r0, min(q.w, q.h) * 0.5f32);
    const bx = left ? q.left : q.right;
    const by = above ? q.top : q.bottom;
    const ix = q.x + q.left;
    const iy = q.y + q.top;
    const iw = max(0.0f32, q.w - q.left - q.right);
    const ih = max(0.0f32, q.h - q.top - q.bottom);
    const ir = max(0.0f32, r - max(bx, by));
    const noBorder = q.top == 0.0f32 && q.right == 0.0f32 && q.bottom == 0.0f32 && q.left == 0.0f32;
    return noBorder ? cover : min(cover, clamp01(0.5f32 - roundedDistance(px, py, ix + iw * 0.5f32, iy + ih * 0.5f32, iw * 0.5f32, ih * 0.5f32, min(ir, min(iw, ih) * 0.5f32))));
}

// the alpha of the shadow `s` at (px, py) (`shadeShadow`'s)
function shadowAlpha(s: Shadow, px: f32, py: f32): f32 {
    const [r, g, b, a] = shadeShadow(s, px, py);
    return a;
}

// the channels of the pixels of a tile, premultiplied
type Channels = [f32[256], f32[256], f32[256], f32[256]];

// whether every centre of a pixel in [cx0, cx1] by [cy0, cy1] is inside the
// rectangle (x0, y0) to (x1, y1) by more than half a pixel (a quarter more
// for the roundings of the distance) and outside the quarters of its
// corners of radius `r`: its distance there is half a pixel or more
// inside, its coverage 1
function deepIn(x0: f32, y0: f32, x1: f32, y1: f32, r: f32, cx0: f32, cy0: f32, cx1: f32, cy1: f32): boolean {
    const m = 0.75f32;
    const sides = cx0 >= x0 + m && cx1 <= x1 - m && cy0 >= y0 + m && cy1 <= y1 - m;
    return sides && ((cx0 >= x0 + r && cx1 <= x1 - r) || (cy0 >= y0 + r && cy1 <= y1 - r));
}

// whether `q`, within its box `bx` (its clip), covers every centre of a
// pixel in [cx0, cx1] by [cy0, cy1] with its fill alone: `coverOf` and
// `insideOf` 1 at each (inside its outer edge and inside the inner edge of
// its border, outside the quarters of its corners, the largest radius
// taken for each)
function covers(q: Quad, bx: [f32, f32, f32, f32], cx0: f32, cy0: f32, cx1: f32, cy1: f32): boolean {
    const [x0, y0, x1, y1] = bx;
    const r = min(max(max(q.topLeft, q.topRight), max(q.bottomLeft, q.bottomRight)), min(q.w, q.h) * 0.5f32);
    const boxed = cx0 > x0 && cx1 < x1 && cy0 > y0 && cy1 < y1;
    return boxed && deepIn(q.x, q.y, q.x + q.w, q.y + q.h, r, cx0, cy0, cx1, cy1)
        && deepIn(q.x + q.left, q.y + q.top, q.x + q.w - q.right, q.y + q.h - q.bottom, r, cx0, cy0, cx1, cy1);
}

// the centres of the first and last pixels of the tile `t` (of `tx` tiles
// a row) within an image `width` by `height`: [cx0, cy0, cx1, cy1]
function centres(t: i64, tx: i64, width: i64, height: i64): [f32, f32, f32, f32] {
    const cx0 = f32((t % tx) * TILE) + 0.5f32;
    const cy0 = f32((t / tx) * TILE) + 0.5f32;
    return [cx0, cy0, min(cx0 + f32(TILE - 1), f32(width) - 0.5f32), min(cy0 + f32(TILE - 1), f32(height) - 0.5f32)] as const;
}

// a primitive that draws something: not a quad of no colour (its fill and
// its border transparent leave every pixel as it was, to the bit)
function seen(p: Primitive): boolean {
    return match (p) {
        Box(q) => q.background.a != 0.0f32 || q.borderColor.a != 0.0f32,
        _ => true,
    };
}

// a quad that covers the tile with an opaque fill: the pixels drawn before
// it are its colour after it, to the bit
function hides(p: Primitive, bx: [f32, f32, f32, f32], c: [f32, f32, f32, f32]): boolean {
    const [cx0, cy0, cx1, cy1] = c;
    return match (p) {
        Box(q) => q.background.a == 1.0f32 && covers(q, bx, cx0, cy0, cx1, cy1),
        _ => false,
    };
}

// the pixels `px` of an image `width` by `height` (of `tx` tiles a row)
// with the tiles `fresh` written in their places (the pixels of each in
// `tiles`, those beyond the image left out)
function patched(px: u32[n], tiles: { px: u32[256] }[m], fresh: i64[m], tx: i64, width: i64, height: i64): u32[n] {
    return fold(iota(m * 256), px, (im, j) => {
        const k = j / 256;
        const local = j % 256;
        const t = fresh[k];
        const x = (t % tx) * TILE + local % TILE;
        const y = (t / tx) * TILE + local / TILE;
        const inside = x < width && y < height;
        // (a pixel beyond the image writes the first again, as it is)
        const at = inside ? y * width + x : 0;
        const v = inside ? tiles[k].px[local] : im[0];
        return im.with(at, v);
    });
}

// the most primitives kept for a tile, to know whether the next frame
// draws it the same
const KEPT: i64 = 32;

// what drew a tile: the number of its primitives (-1: more than `KEPT`, the
// tile drawn again at each frame), their indexes among those of the frame,
// whether the first hides those before it (drawn from its colour, not from
// the colour under all)
type Kept = { n: i64, ids: i64[32], hidden: boolean };

// the primitives that may colour a pixel of the tile `t`, among those of
// its band `band`: from the last that hides those before it; whether one
// does
function listed(t: i64, tx: i64, width: i64, height: i64, ps: Primitive[n], boxes: [f32, f32, f32, f32][n], band: i64[m]): [i64[], boolean] {
    const c = centres(t, tx, width, height);
    const [cx0, cy0, cx1, cy1] = c;
    // (the centres of the whole tile: a primitive reaching none of them
    // colours none of its pixels)
    const ex = cx0 + f32(TILE - 1);
    const ey = cy0 + f32(TILE - 1);
    const all = filter(band, (k) => {
        const [x0, y0, x1, y1] = boxes[k];
        return ex > x0 && cx0 < x1 && ey > y0 && cy0 < y1;
    });
    const from = fold(iota(all.length), -1, (f, j) => hides(ps[all[j]], boxes[all[j]], c) ? j : f);
    return [from < 0 ? all : all.slice(from, all.length), from >= 0] as const;
}

// `listed` as kept for the next frame
function keptOf(ids: i64[n], hidden: boolean): Kept {
    return { n: n <= KEPT ? n : -1, ids: map(iota(32), (j) => j < n ? ids[j] : -1), hidden: hidden };
}

// whether the tile drawn by `a` (primitives `ps`, boxes `boxes`) is drawn
// as the tile drawn by `b` (primitives `qs`, boxes `qboxes`): the same
// primitives in the same boxes, in the same order
function sameTile(a: Kept, ps: Primitive[n], boxes: [f32, f32, f32, f32][n], b: Kept, qs: Primitive[m], qboxes: [f32, f32, f32, f32][m]): boolean {
    return a.n >= 0 && a.n == b.n && a.hidden == b.hidden
        && count(iota(a.n), (j) => !(ps[a.ids[j]] == qs[b.ids[j]] && boxes[a.ids[j]] == qboxes[b.ids[j]])) == 0;
}

// the 256 pixels of the tile `t` (of `tx` tiles a row), row after row: the
// primitives `ids` drawn over `base`, each over the 256 pixels at once, a
// channel after the other (loops the compiler makes of vector
// instructions), as a GPU draws. When the first hides those before it
// (`hidden`), its colour is the start, the others drawn over it; a quad
// that covers every pixel has a coverage of 1 without its distances
// computed (the same bits as computed).
// the coverage of the sprite `gl` over the tile `t`, its pixels from `at`
// in `m`: each pixel's, 0 outside it or its clip
function glyphCover(m: f32[], at: i64, gl: Sprite, t: i64, tx: i64, ox: f32, oy: f32, x0: f32, y0: f32, x1: f32, y1: f32): f32[256] {
    return map(iota(256), (j) => {
        const col = (t % tx) * TILE + j % TILE - gl.x;
        const row = (t / tx) * TILE + j / TILE - gl.y;
        const px = ox + f32(j % TILE);
        const py = oy + f32(j / TILE);
        // (its box: the sprite within its clip)
        const inside = col >= 0 && col < gl.w && row >= 0 && row < gl.h && px > x0 && px < x1 && py > y0 && py < y1;
        // (the place read whatever the pixel, then kept or not: a branch
        // that cannot fail, for every pixel at once)
        const v = m[inside ? at + row * gl.w + col : at];
        return inside ? gl.color.a * v : 0.0f32;
    });
}

function tile(t: i64, tx: i64, width: i64, height: i64, base: Color, ps: Primitive[n], boxes: [f32, f32, f32, f32][n], ids: i64[], hidden: boolean, masks: f32[]): u32[256] {
    const ox = f32((t % tx) * TILE) + 0.5f32;
    const oy = f32((t / tx) * TILE) + 0.5f32;
    const [cx0, cy0, cx1, cy1] = centres(t, tx, width, height);
    const ground = hidden ? match (ps[ids[0]]) {
        Box(q) => [q.background.r, q.background.g, q.background.b, 1.0f32] as const,
        _ => [0.0f32, 0.0f32, 0.0f32, 0.0f32] as const,
    } : [base.r * base.a, base.g * base.a, base.b * base.a, base.a] as const;
    const [gr, gg, gb, ga] = ground;
    const start: Channels = [fill(256, gr), fill(256, gg), fill(256, gb), fill(256, ga)] as const;
    const rest = hidden ? ids.slice(1, ids.length) : ids;
    const c = fold(rest, start, (acc, k) => {
        const [r, g, b, a] = acc;
        const [x0, y0, x1, y1] = boxes[k];
        return match (ps[k]) {
            Box(q) => {
                const whole = covers(q, boxes[k], cx0, cy0, cx1, cy1);
                const cover = whole ? fill(256, 1.0f32) : map(iota(256), (j) => {
                    const px = ox + f32(j % TILE);
                    const py = oy + f32(j / TILE);
                    return px > x0 && px < x1 && py > y0 && py < y1 ? coverOf(q, px, py) : 0.0f32;
                });
                const inside = whole ? fill(256, 1.0f32) : map(iota(256), (j) => {
                    const px = ox + f32(j % TILE);
                    const py = oy + f32(j / TILE);
                    // (read before the condition: a branch that cannot fail
                    // is computed for every pixel at once)
                    const cj = cover[j];
                    return px > x0 && px < x1 && py > y0 && py < y1 ? insideOf(q, px, py, cj) : 0.0f32;
                });
                // the fill and the border, then each channel over the tile
                const fa = map(iota(256), (j) => q.background.a * inside[j]);
                const ba = map(iota(256), (j) => q.borderColor.a * (cover[j] - inside[j]));
                const over = (d: f32[256], fc: f32, bc: f32) => map(iota(256), (j) => (fc * fa[j] + bc * ba[j]) + d[j] * (1.0f32 - (fa[j] + ba[j])));
                return [over(r, q.background.r, q.borderColor.r), over(g, q.background.g, q.borderColor.g), over(b, q.background.b, q.borderColor.b), map(iota(256), (j) => (fa[j] + ba[j]) + a[j] * (1.0f32 - (fa[j] + ba[j])))] as const;
            },
            Blur(sh) => {
                const sa = map(iota(256), (j) => {
                    const px = ox + f32(j % TILE);
                    const py = oy + f32(j / TILE);
                    return px > x0 && px < x1 && py > y0 && py < y1 ? shadowAlpha(sh, px, py) : 0.0f32;
                });
                const over = (d: f32[256], cc: f32) => map(iota(256), (j) => cc * sa[j] + d[j] * (1.0f32 - sa[j]));
                return [over(r, sh.color.r), over(g, sh.color.g), over(b, sh.color.b), map(iota(256), (j) => sa[j] + a[j] * (1.0f32 - sa[j]))] as const;
            },
            Glyph(gl) => {
                // (its coverage in the atlas, else its own)
                const sa = gl.at >= 0 ? glyphCover(masks, gl.at, gl, t, tx, ox, oy, x0, y0, x1, y1) : glyphCover(gl.mask, 0, gl, t, tx, ox, oy, x0, y0, x1, y1);
                const over = (d: f32[256], cc: f32) => map(iota(256), (j) => cc * sa[j] + d[j] * (1.0f32 - sa[j]));
                return [over(r, gl.color.r), over(g, gl.color.g), over(b, gl.color.b), map(iota(256), (j) => sa[j] + a[j] * (1.0f32 - sa[j]))] as const;
            },
            Raster(bm) => {
                // where the centre of each pixel falls in the image, in its
                // pixels (their centres at .5), clamped to its edges
                const iw = bm.iw;
                const ih = bm.ih;
                const u = map(iota(256), (j) => min(f32(iw) - 1.0f32, max(0.0f32, (ox + f32(j % TILE) - bm.x) / bm.w * f32(iw) - 0.5f32)));
                const v = map(iota(256), (j) => min(f32(ih) - 1.0f32, max(0.0f32, (oy + f32(j / TILE) - bm.y) / bm.h * f32(ih) - 0.5f32)));
                const seen = map(iota(256), (j) => {
                    const px = ox + f32(j % TILE);
                    const py = oy + f32(j / TILE);
                    return px > x0 && px < x1 && py > y0 && py < y1 ? 1.0f32 : 0.0f32;
                });
                // a channel (shift 16 red, 8 green, 0 blue; 24 alpha) of the
                // four pixels mixed, premultiplied by their alphas
                const mixed = (sh: u32) => map(iota(256), (j) => {
                    const fx = floor(u[j]);
                    const fy = floor(v[j]);
                    const ax = u[j] - fx;
                    const ay = v[j] - fy;
                    const c0 = i64(fx);
                    const r0 = i64(fy);
                    const c1 = min(iw - 1, c0 + 1);
                    const r1 = min(ih - 1, r0 + 1);
                    const at = (c: i64, r: i64) => {
                        const p = bm.pixels[r * iw + c];
                        const al = f32(p >> 24u32) / 255.0f32;
                        return sh == 24u32 ? al : f32((p >> sh) & 0xFFu32) / 255.0f32 * al;
                    };
                    const top = at(c0, r0) * (1.0f32 - ax) + at(c1, r0) * ax;
                    const bottom = at(c0, r1) * (1.0f32 - ax) + at(c1, r1) * ax;
                    return (top * (1.0f32 - ay) + bottom * ay) * seen[j];
                });
                const sa = mixed(24u32);
                const over = (d: f32[256], s: f32[256]) => map(iota(256), (j) => s[j] + d[j] * (1.0f32 - sa[j]));
                return [over(r, mixed(16u32)), over(g, mixed(8u32)), over(b, mixed(0u32)), over(a, sa)] as const;
            },
            // (never among the primitives of a tile: their boxes are empty)
            _ => acc,
        };
    });
    const [r, g, b, a] = c;
    return map(iota(256), (j) => pack([r[j], g[j], b[j], a[j]] as const));
}

// a frame drawn, kept to draw the next: the side of its tiles, its size,
// the colour under all, its primitives and their boxes (within their
// clips), what drew each tile; its pixels (`0xAARRGGBB`, rows from the
// top); the tiles drawn for it (the others those of the frame before), and
// the rectangle they cover ([x, y, width, height] in pixels; a width of 0:
// none)
// (the side of the tiles kept from frame to frame: the next frame made
// from the parts of the last, which a loop then gives rather than copies)
export type Canvas = { tile: i64, w: i64, h: i64, base: Color, ps: Primitive[], boxes: [f32, f32, f32, f32][], kept: Kept[], pixels: u32[], drawn: i64, damage: [i64, i64, i64, i64] };

// no frame drawn before
export function blank(): Canvas {
    return { tile: TILE, w: 0, h: 0, base: transparent(), ps: [], boxes: [], kept: [], pixels: [], drawn: 0, damage: [0, 0, 0, 0] as const };
}

// the `width` by `height` pixels (`0xAARRGGBB`) of the primitives `ps`
// drawn in their order over the colour `base` (`renderAgain` after no
// frame)
export function render(width: i64, height: i64, base: Color, ps: Primitive[n]): u32[] {
    return renderAgain(blank(), width, height, base, ps).pixels;
}

// the frame of the primitives `ps` drawn over `base`, `width` by `height`
// pixels, after the frame `prev`. The image is cut in tiles of 16 by 16
// pixels, each with the primitives whose box reaches one of its centres of
// pixels: a pixel is drawn with those alone, the others colouring nothing
// there (the same test, so the same bits as drawing every primitive at
// every pixel), from the last that hides those before it. A tile whose
// primitives are those that drew it in `prev` (of the same size and
// colour under all) keeps its pixels; the others are drawn, in parallel,
// the pixels of a tile together.
export function renderAgain(prev: Canvas, width: i64, height: i64, base: Color, ps: Primitive[n]): Canvas {
    return renderWith(prev, width, height, base, ps, []);
}

// `renderAgain`, the glyphs of the atlas (`Sprite.at`) drawn from its pixels
// `masks`
export function renderWith(prev: Canvas, width: i64, height: i64, base: Color, ps: Primitive[n], masks: f32[]): Canvas {
    const tx = (width + TILE - 1) / TILE;
    const ty = (height + TILE - 1) / TILE;
    const nt = tx * ty;
    // each box within its clip
    const cl = clips(ps);
    const boxes = map(iota(n), (k) => {
        const [x0, y0, x1, y1] = reach(ps[k]);
        const [c0, c1, c2, c3] = cl[k];
        return [max(x0, c0), max(y0, c1), min(x1, c2), min(y1, c3)] as const;
    });
    // the primitives that draw something in each band of tiles
    const bands = map(iota(ty), (b) => {
        const y0 = f32(b * TILE) + 0.5f32;
        const y1 = y0 + f32(TILE - 1);
        return { ids: filter(iota(n), (k) => {
            const [a0, b0, a1, b1] = boxes[k];
            return a1 > a0 && b1 > b0 && y1 > b0 && y0 < b1 && seen(ps[k]);
        }) };
    });
    const kept = map(iota(nt), (t) => {
        const [ids, hidden] = listed(t, tx, width, height, ps, boxes, bands[t / tx].ids);
        return keptOf(ids, hidden);
    });
    // the tiles of `prev` kept, those drawn again
    const again = prev.tile == TILE && prev.w == width && prev.h == height && prev.base == base && prev.kept.length == nt;
    const same = map(iota(nt), (t) => again && sameTile(kept[t], ps, boxes, prev.kept[t], prev.ps, prev.boxes));
    const fresh = filter(iota(nt), (t) => !same[t]);
    const tiles = map(fresh, (t) => {
        const k = kept[t];
        const [ids, hidden] = k.n >= 0 ? [k.ids.slice(0, k.n), k.hidden] as const : listed(t, tx, width, height, ps, boxes, bands[t / tx].ids);
        return { px: tile(t, tx, width, height, base, ps, boxes, ids, hidden, masks) };
    });
    // the place of each tile drawn among them
    const at = scan(map(iota(nt), (t) => same[t] ? 0 : 1), (a, b) => a + b, 0);
    // the tiles drawn written into the pixels of `prev` when they are few
    // (an eighth of the tiles at most), else the tiles back to rows of the
    // image (the row of a pixel by a product: exact for less than a million
    // columns, no division by pixel)
    const inv = 1.0 / f64(max(1, width));
    const pixels = again && fresh.length * 8 <= nt ? patched(prev.pixels, tiles, fresh, tx, width, height) : map(iota(width * height), (i) => {
        const y = i64(f64(i) * inv + 0.000001);
        const x = i - y * width;
        const t = (y / TILE) * tx + x / TILE;
        return same[t] ? prev.pixels[i] : tiles[at[t] - 1].px[(y % TILE) * TILE + x % TILE];
    });
    // the rectangle of the tiles drawn
    const [l, tp, r, bt] = fold(fresh, [nt, nt, -1, -1] as const, (acc, t) => {
        const [a0, b0, a1, b1] = acc;
        return [min(a0, t % tx), min(b0, t / tx), max(a1, t % tx), max(b1, t / tx)] as const;
    });
    const damage = fresh.length == 0 ? [0, 0, 0, 0] as const
        : [l * TILE, tp * TILE, min(width, (r + 1) * TILE) - l * TILE, min(height, (bt + 1) * TILE) - tp * TILE] as const;
    return { tile: prev.tile, w: width, h: height, base: base, ps: ps, boxes: boxes, kept: kept, pixels: pixels, drawn: fresh.length, damage: damage };
}
