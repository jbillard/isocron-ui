// A client of Wayland written in Isocron over the module `unix` (D632 of
// Isocron): the wire protocol (messages of 32-bit words, little-endian,
// descriptors passed beside the bytes), the objects a window needs
// (`wl_compositor`, `wl_shm`, `xdg_wm_base`, `wl_seat`), an image shown from
// memory shared with the compositor, the events of the pointer and of the
// keyboard. No C library: the socket of the compositor is spoken directly.
import * as unix from "unix";
import * as net from "net";
import { IoError, ioError } from "sys";

// ----- the wire --------------------------------------------------------

// the 4 bytes of `v`, the least significant first
export function le32(v: u32): u8[4] {
    return [u8(v & 255u32), u8((v >> 8u32) & 255u32), u8((v >> 16u32) & 255u32), u8(v >> 24u32)];
}

export function i32le(v: i32): u8[4] {
    return le32(u32(v));
}

// the word at `at` of `b`
export function word(b: u8[n], at: i64): u32 {
    return u32(b[at]) | (u32(b[at + 1]) << 8u32) | (u32(b[at + 2]) << 16u32) | (u32(b[at + 3]) << 24u32);
}

// a string argument: its length with its zero byte, its bytes, the zero
// byte, padded to 4 bytes
export function str(s: string): u8[] {
    const b = bytes(s);
    const padded = (b.length + 1 + 3) / 4 * 4;
    return concat(le32(u32(b.length + 1)), map(iota(padded), (i) => i < b.length ? b[i] : 0u8));
}

// the string argument at `at` of `b`, and the place after it
export function strAt(b: u8[n], at: i64): [string, i64] {
    const len = i64(word(b, at));
    const text = len == 0 ? "" : stringOf(b.slice(at + 4, at + 4 + len - 1));
    return [text, at + 4 + (len + 3) / 4 * 4] as const;
}

// a request of the object `id`: its header (the object, then its size in
// the high half of a word and its opcode in the low half) and its arguments
export function request(id: u32, opcode: u32, args: u8[n]): u8[] {
    return concat(concat(le32(id), le32((u32(8 + args.length) << 16u32) | opcode)), args);
}

// an event read from the compositor: its object, its opcode, its arguments
export type Event = { obj: u32, op: u32, args: u8[] };

// the whole events at the start of `b`, and the bytes left after them (the
// start of an event not received whole)
export function events(b: u8[n]): [Event[], u8[]] {
    // the place of each event, found one after the other
    const starts = eventStarts(b, 0, []);
    const evs = map(starts, (at) => ({ obj: word(b, at), op: word(b, at + 4) & 0xFFFFu32, args: b.slice(at + 8, at + i64(word(b, at + 4) >> 16u32)) }));
    const used = starts.length == 0 ? 0 : starts[starts.length - 1] + i64(word(b, starts[starts.length - 1] + 4) >> 16u32);
    return [evs, b.slice(used, b.length)] as const;
}

function eventStarts(b: u8[n], at: i64, found: i64[]): i64[] {
    if (at + 8 > b.length) {
        return found;
    }
    const len = i64(word(b, at + 4) >> 16u32);
    if (len < 8 || at + len > b.length) {
        return found;
    }
    return eventStarts(b, at + len, concat(found, [at]));
}

// ----- the objects -----------------------------------------------------

// the names of the globals of the compositor that a window needs (0: not
// offered)
export type Globals = { compositor: u32, shm: u32, wmBase: u32, seat: u32, cursorShape: u32, output: u32, data: u32, viewporter: u32, fractional: u32 };

// the ids the client gives its objects (the display is 1). A compositor
// takes a new id only when it is the next one or one it has freed
// (libwayland: `wl_map_insert_at`): the ids follow the order of creation.
// The seat, its pointer and its keyboard come with the window (10 to 12;
// three callbacks of `wl_display.sync` hold these ids when the compositor
// has no seat), the images after them; the callback of a frame is freed by
// the compositor once done (`delete_id`), its id taken again for the next
// frame.
export const DISPLAY: u32 = 1u32;
export const REGISTRY: u32 = 2u32;
export const SYNC: u32 = 3u32;
export const COMPOSITOR: u32 = 4u32;
export const SHM: u32 = 5u32;
export const WM_BASE: u32 = 6u32;
export const SURFACE: u32 = 7u32;
export const XDG_SURFACE: u32 = 8u32;
export const TOPLEVEL: u32 = 9u32;
export const SEAT: u32 = 10u32;
export const POINTER: u32 = 11u32;
export const KEYBOARD: u32 = 12u32;
export const POOL: u32 = 13u32;
export const BUFFER: u32 = 14u32;
export const FRAME: u32 = 15u32;

// `wl_registry.bind`: the global `name` of `iface` at `version`, as the
// object `id`
export function bind(name: u32, iface: string, version: u32, id: u32): u8[] {
    return request(REGISTRY, 0u32, concat(concat(concat(le32(name), str(iface)), le32(version)), le32(id)));
}

// the globals of `wl_registry.global` events (opcode 0) among `evs`
export function globalsOf(evs: Event[n], g: Globals): Globals {
    return fold(evs, g, (acc, e) => {
        if (e.obj != REGISTRY || e.op != 0u32) {
            return acc;
        }
        const name = word(e.args, 0);
        const [iface, after] = strAt(e.args, 4);
        return iface == "wl_compositor" ? { ...acc, compositor: name }
            : (iface == "wl_shm" ? { ...acc, shm: name }
            : (iface == "xdg_wm_base" ? { ...acc, wmBase: name }
            : (iface == "wl_seat" ? { ...acc, seat: name }
            : (iface == "wp_cursor_shape_manager_v1" ? { ...acc, cursorShape: name }
            : (iface == "wl_output" && acc.output == 0u32 ? { ...acc, output: name }
            : (iface == "wl_data_device_manager" ? { ...acc, data: name }
            : (iface == "wp_viewporter" ? { ...acc, viewporter: name }
            : (iface == "wp_fractional_scale_manager_v1" ? { ...acc, fractional: name } : acc))))))));
    });
}

// the requests that bind the globals and make a toplevel window titled
// `title`: its surface, its role, its title, the first commit (without an
// image: the compositor answers with `configure`); then the seat (version
// 4: no `frame` of the pointer), whose devices are asked when it tells it
// has them (`devicesRequests`: asking one it never had is an error of the
// protocol, the connection closed)
export function windowRequests(g: Globals, title: string): u8[] {
    const binds = concat(concat(bind(g.compositor, "wl_compositor", 4u32, COMPOSITOR), bind(g.shm, "wl_shm", 1u32, SHM)), bind(g.wmBase, "xdg_wm_base", 1u32, WM_BASE));
    const surface = request(COMPOSITOR, 0u32, le32(SURFACE));
    const role = request(WM_BASE, 2u32, concat(le32(XDG_SURFACE), le32(SURFACE)));
    const toplevel = request(XDG_SURFACE, 1u32, le32(TOPLEVEL));
    const named = request(TOPLEVEL, 2u32, str(title));
    const commit = request(SURFACE, 6u32, []);
    // (the ids of its pointer and its keyboard held by callbacks of
    // `wl_display.sync` meanwhile: the ids a client makes must follow each
    // other, and the server frees those of the callbacks once it answers
    // them, before it reads the requests of the devices)
    const reserved = concat(request(DISPLAY, 0u32, le32(POINTER)), request(DISPLAY, 0u32, le32(KEYBOARD)));
    const seat = g.seat != 0u32
        ? concat(bind(g.seat, "wl_seat", 4u32, SEAT), reserved)
        : concat(request(DISPLAY, 0u32, le32(SEAT)), reserved);
    return concat(concat(concat(concat(concat(concat(binds, surface), role), toplevel), named), commit), seat);
}

// the devices of the seat it now has (`caps` of `wl_seat.capabilities`: 1
// a pointer, 2 a keyboard) and had not (`had`): its pointer and its
// keyboard asked as POINTER and KEYBOARD
export function devicesRequests(caps: u32, had: u32): u8[] {
    const fresh = caps & ~had;
    const pointer = (fresh & 1u32) != 0u32 ? request(SEAT, 0u32, le32(POINTER)) : [];
    const keyboard = (fresh & 2u32) != 0u32 ? request(SEAT, 1u32, le32(KEYBOARD)) : [];
    return concat(pointer, keyboard);
}

// `wl_shm.create_pool` of `bytes` bytes (its descriptor sent beside it),
// then a buffer of `w` by `h` pixels `XRGB8888` (format 1) at its start
export function bufferRequests(bytes: i64, w: i64, h: i64): u8[] {
    const pool = request(SHM, 0u32, concat(le32(POOL), i32le(i32(bytes))));
    const buffer = request(POOL, 0u32, concat(concat(concat(concat(concat(le32(BUFFER), i32le(0i32)), i32le(i32(w))), i32le(i32(h))), i32le(i32(4 * w))), le32(1u32)));
    return concat(pool, buffer);
}

// the image of the buffer shown: attached, damaged whole, the callback of
// the next frame asked (`FRAME`), committed
export function showRequests(w: i64, h: i64): u8[] {
    const attach = request(SURFACE, 1u32, concat(concat(le32(BUFFER), i32le(0i32)), i32le(0i32)));
    const damage = request(SURFACE, 9u32, concat(concat(concat(i32le(0i32), i32le(0i32)), i32le(i32(w))), i32le(i32(h))));
    const callback = request(SURFACE, 3u32, le32(FRAME));
    const commit = request(SURFACE, 6u32, []);
    return concat(concat(concat(attach, damage), callback), commit);
}

// `wl_shm.create_pool` of `bytes` bytes as the object `pool` (its
// descriptor sent beside it), a buffer `buffer` of `w` by `h` pixels
// `XRGB8888` at its start, attached to the surface, damaged whole and
// committed (an image drawn again: new objects, the old ones destroyed
// after, `destroyRequests`)
export function imageRequests(pool: u32, buffer: u32, bytes: i64, w: i64, h: i64): u8[] {
    const made = request(SHM, 0u32, concat(le32(pool), i32le(i32(bytes))));
    const buf = request(pool, 0u32, concat(concat(concat(concat(concat(le32(buffer), i32le(0i32)), i32le(i32(w))), i32le(i32(h))), i32le(i32(4 * w))), le32(1u32)));
    const attach = request(SURFACE, 1u32, concat(concat(le32(buffer), i32le(0i32)), i32le(0i32)));
    const damage = request(SURFACE, 9u32, concat(concat(concat(i32le(0i32), i32le(0i32)), i32le(i32(w))), i32le(i32(h))));
    const commit = request(SURFACE, 6u32, []);
    return concat(concat(concat(concat(made, buf), attach), damage), commit);
}

// the shapes of the pointer asked of the compositor (`wp_cursor_shape_v1`):
// its manager bound as `manager`; the device of the pointer as `device`,
// once the pointer is asked (`shapeDeviceRequest`)
export function shapeRequests(g: Globals, manager: u32, device: u32): u8[] {
    // (the id of the device held by a callback meanwhile: the ids follow
    // each other)
    return concat(bind(g.cursorShape, "wp_cursor_shape_manager_v1", 1u32, manager), request(DISPLAY, 0u32, le32(device)));
}

export function shapeDeviceRequest(manager: u32, device: u32): u8[] {
    return request(manager, 1u32, concat(le32(device), le32(POINTER)));
}

// the shape of the pointer set by the device `device` at the entry `serial`
// (`set_shape`: 1 the default arrow, 4 a hand, 9 a bar of text)
export function shapeRequest(device: u32, serial: u32, shape: i64): u8[] {
    const code = shape == 1 ? 4u32 : (shape == 2 ? 9u32 : 1u32);
    return request(device, 1u32, concat(le32(serial), le32(code)));
}

// the images of the pointer drawn by the program: a surface `surface`, a
// pool `pool` of `count` images of `side` by `side` pixels (its descriptor
// sent beside it), a buffer of each (`ARGB8888`, format 0) from `first`
export function pointerImageRequests(surface: u32, pool: u32, first: u32, count: i64, side: i64): u8[] {
    const made = concat(request(COMPOSITOR, 0u32, le32(surface)), request(SHM, 0u32, concat(le32(pool), i32le(i32(count * side * side * 4)))));
    return buffersFrom(made, pool, first, 0, count, side);
}

// the buffers of the images from the `k`-th, after the requests `acc`
function buffersFrom(acc: u8[], pool: u32, first: u32, k: i64, count: i64, side: i64): u8[] {
    if (k >= count) {
        return acc;
    }
    const made = request(pool, 0u32, concat(concat(concat(concat(concat(le32(first + u32(k)), i32le(i32(k * side * side * 4))), i32le(i32(side))), i32le(i32(side))), i32le(i32(side * 4))), le32(0u32)));
    return buffersFrom(concat(acc, made), pool, first, k + 1, count, side);
}

// the pointer shown as the image of the buffer `buffer` (`side` by `side`
// pixels, `scale` pixels a unit) on the surface `surface`, its point at
// (hx, hy) in units, at the entry `serial` (`wl_pointer.set_cursor`, then
// the surface attached, its scale set, damaged, committed)
export function pointerImageRequest(surface: u32, buffer: u32, side: i64, scale: i64, serial: u32, hx: i64, hy: i64): u8[] {
    const set = request(POINTER, 0u32, concat(concat(concat(le32(serial), le32(surface)), i32le(i32(hx))), i32le(i32(hy))));
    const attach = request(surface, 1u32, concat(concat(le32(buffer), i32le(0i32)), i32le(0i32)));
    const scaled = request(surface, 8u32, i32le(i32(scale)));
    const damage = request(surface, 9u32, concat(concat(concat(i32le(0i32), i32le(0i32)), i32le(i32(side))), i32le(i32(side))));
    return concat(concat(concat(concat(set, attach), scaled), damage), request(surface, 6u32, []));
}

// the images of the pointer drawn by the program destroyed: the `count`
// buffers from `first`, their pool, their surface
export function pointerImagesDestroy(surface: u32, pool: u32, first: u32, count: i64): u8[] {
    return destroyedFrom(concat(request(pool, 1u32, []), request(surface, 0u32, [])), first, count);
}

// the buffers from `first` to `first + count - 1` destroyed before the
// requests `after`
function destroyedFrom(after: u8[], first: u32, count: i64): u8[] {
    return count <= 0 ? after : destroyedFrom(concat(request(first + u32(count - 1), 0u32, []), after), first, count - 1);
}

// the first screen bound as `id` (`wl_output`, version 2: its scale)
export function outputRequests(g: Globals, id: u32): u8[] {
    return bind(g.output, "wl_output", 2u32, id);
}

// the images of the window drawn at `scale` pixels a unit
// (`wl_surface.set_buffer_scale`)
export function scaleRequest(scale: i64): u8[] {
    return request(SURFACE, 8u32, i32le(i32(scale)));
}

// the scale of the window in 120ths (`wp_fractional_scale_v1`) and its
// images shown at its size in units whatever theirs (`wp_viewporter`):
// the viewporter bound as `viewporter`, the manager as `manager`, the
// viewport of the window `viewport`, its fractional scale `fraction`
export function fractionalRequests(g: Globals, viewporter: u32, manager: u32, viewport: u32, fraction: u32): u8[] {
    const binds = concat(bind(g.viewporter, "wp_viewporter", 1u32, viewporter), bind(g.fractional, "wp_fractional_scale_manager_v1", 1u32, manager));
    return concat(concat(binds, request(viewporter, 1u32, concat(le32(viewport), le32(SURFACE)))), request(manager, 1u32, concat(le32(fraction), le32(SURFACE))));
}

// the images of the window shown at `w` by `h` units
// (`wp_viewport.set_destination`)
export function destinationRequest(viewport: u32, w: i64, h: i64): u8[] {
    return request(viewport, 2u32, concat(i32le(i32(w)), i32le(i32(h))));
}

// the manager of the data of the seat bound as `manager` (version 3), the
// device of the seat as `device`: the selections of the other programs
export function dataRequests(g: Globals, manager: u32, device: u32): u8[] {
    return concat(bind(g.data, "wl_data_device_manager", 3u32, manager), request(manager, 1u32, concat(le32(device), le32(SEAT))));
}

// the text of the offer `offer` as the type `mime`, written by the program
// that holds it into the descriptor sent beside (`wl_data_offer.receive`)
export function receiveRequest(offer: u32, mime: string): u8[] {
    return request(offer, 1u32, str(mime));
}

// a source of data made (`source`, of the manager `manager`) that offers a
// text (UTF-8 under its three usual names), made the selection of the seat
// (its device `device`) at the input `serial`
export function selectionRequests(manager: u32, source: u32, device: u32, serial: u32): u8[] {
    const made = request(manager, 0u32, le32(source));
    const offers = concat(concat(request(source, 0u32, str("text/plain;charset=utf-8")), request(source, 0u32, str("text/plain"))), request(source, 0u32, str("UTF8_STRING")));
    return concat(concat(made, offers), request(device, 1u32, concat(le32(source), le32(serial))));
}

// a source no longer the selection destroyed (`wl_data_source.destroy`)
export function sourceDestroy(source: u32): u8[] {
    return request(source, 1u32, []);
}

// an offer no longer the selection destroyed (`wl_data_offer.destroy`)
export function offerDestroy(offer: u32): u8[] {
    return request(offer, 2u32, []);
}

// the buffer and the pool of an image no longer shown destroyed
// (`wl_buffer.destroy`, `wl_shm_pool.destroy`)
export function destroyRequests(pool: u32, buffer: u32): u8[] {
    return concat(request(buffer, 0u32, []), request(pool, 1u32, []));
}

// ----- what happened ---------------------------------------------------

// what the program learns from the events of a read
export type Input =
    Configure(u32)
    | Size(i64, i64)
    | Close
    | Ping(u32)
    | FrameDone(u32)
    | Released
    | Pointer(f64, f64)
    | Enter(u32, f64, f64)
    | Leave
    | Button(u32, boolean)
    | Key(u32, boolean)
    | Keymap(u32)
    | Modifiers(u32)
    | Axis(u32, f64)
    | Capabilities(u32)
    | OutputScale(u32, i64)
    | Failure(string)
    | Other(u32, u32);

// a fixed number of Wayland (24.8) as a float
function fixed(v: u32): f64 {
    return f64(i32(v)) / 256.0;
}

// the meaning of an event (its arguments of the length it has: the
// callbacks that hold the ids of the seat when the compositor has none
// send 4 bytes, read as nothing else)
export function input(e: Event): Input {
    if (e.obj == DISPLAY && e.op == 0u32) {
        const [m, after] = strAt(e.args, 8);
        return Failure(`object ${word(e.args, 0)}, code ${word(e.args, 4)}: ${m}`);
    }
    if (e.obj == WM_BASE && e.op == 0u32) {
        return Ping(word(e.args, 0));
    }
    if (e.obj == XDG_SURFACE && e.op == 0u32) {
        return Configure(word(e.args, 0));
    }
    if (e.obj == TOPLEVEL && e.op == 0u32) {
        return Size(i64(i32(word(e.args, 0))), i64(i32(word(e.args, 4))));
    }
    if (e.obj == TOPLEVEL && e.op == 1u32) {
        return Close;
    }
    // (the ids of a frame and of a buffer fixed by the programs that make
    // them so; others give these ids to objects of their own: a release of
    // a buffer, without arguments, is no frame)
    if (e.obj == FRAME && e.op == 0u32 && e.args.length >= 4) {
        return FrameDone(word(e.args, 0));
    }
    if (e.obj == BUFFER && e.op == 0u32) {
        return Released;
    }
    // a scale of a screen (`wl_output.scale`): its object and its factor
    if (e.op == 3u32 && e.obj > FRAME && e.args.length == 4) {
        return OutputScale(e.obj, i64(i32(word(e.args, 0))));
    }
    if (e.obj == SEAT && e.op == 0u32) {
        return Capabilities(word(e.args, 0));
    }
    // enter: serial, surface, x, y; leave; motion: time, x, y
    if (e.obj == POINTER && e.op == 0u32 && e.args.length >= 16) {
        return Enter(word(e.args, 0), fixed(word(e.args, 8)), fixed(word(e.args, 12)));
    }
    if (e.obj == POINTER && e.op == 1u32) {
        return Leave;
    }
    if (e.obj == POINTER && e.op == 2u32 && e.args.length >= 12) {
        return Pointer(fixed(word(e.args, 4)), fixed(word(e.args, 8)));
    }
    // the wheel: an axis (0 vertical) and a distance in pixels (down:
    // positive)
    if (e.obj == POINTER && e.op == 4u32 && e.args.length >= 12) {
        return Axis(word(e.args, 4), fixed(word(e.args, 8)));
    }
    if (e.obj == POINTER && e.op == 3u32 && e.args.length >= 16) {
        return Button(word(e.args, 8), word(e.args, 12) == 1u32);
    }
    if (e.obj == KEYBOARD && e.op == 0u32 && e.args.length >= 12) {
        return Keymap(word(e.args, 4));
    }
    // the modifiers in effect: held, latched or locked
    if (e.obj == KEYBOARD && e.op == 4u32 && e.args.length >= 20) {
        return Modifiers(word(e.args, 4) | word(e.args, 8) | word(e.args, 12));
    }
    if (e.obj == KEYBOARD && e.op == 3u32 && e.args.length >= 16) {
        return Key(word(e.args, 8), word(e.args, 12) == 1u32);
    }
    return Other(e.obj, e.op);
}

// the path of the socket of the compositor: `$WAYLAND_DISPLAY` (absolute,
// or in `$XDG_RUNTIME_DIR`; `wayland-0` when it is not set)
export function socketPath(display: string, runtime: string): string {
    const name = display == "" ? "wayland-0" : display;
    return name.startsWith("/") ? name : `${runtime}/${name}`;
}
