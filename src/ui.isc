// The elements of an interface and their layout: boxes laid out in a row
// or a column (a part of flexbox: a gap between children, a padding,
// sizes fixed, as their content or sharing the room left, children packed
// at the start, the centre or the end, or spread; aligned across or
// stretched), texts cut in lines, the line of a field (its selection, its
// caret, moved across to keep its caret in sight); the primitives that
// draw them, and the places the pointer reaches, the last drawn first: a
// click, the wheel, a scrollbar, the characters of a field, the shape of
// the pointer.
import { Primitive, Box, Blur, Glyph, Pending, Clip, Unclip, Raster, Color, quad, rounded, bordered, transparent, rgb, rgba, movedBy } from "./paint";
import { Font } from "./font";
import { Align, Start, Center, End, paragraph, paragraphAs, measureParagraph, line, lineAs, lineWidth, stops } from "./text";
import { Editing, selection } from "./edit";
import { Picture } from "./png";

// the shapes of the pointer over a place: an arrow, a hand (a place that a
// click reaches), a bar (a text)
export const ARROW: i64 = 0;
export const POINTER: i64 = 1;
export const TEXT: i64 = 2;

// the kinds of places: a click, the wheel, a scrollbar, the characters of a
// field, a shape of the pointer alone
export const CLICK: i64 = 0;
export const WHEEL: i64 = 1;
export const BAR: i64 = 2;
export const FIELD: i64 = 3;
export const SHAPE: i64 = 4;
export const MENU: i64 = 5;
// the tooltip of the box whose message is `id` in `e` ("": none)
export function tipOf(e: Element, id: i64): string {
    return match (e) {
        Div(st, cs) => st.onClick == id && st.tip != "" ? st.tip : tipAmong(cs, id, 0),
        _ => "",
    };
}

function tipAmong(cs: Element[n], id: i64, k: i64): string {
    if (k >= n) {
        return "";
    }
    const t = tipOf(cs[k], id);
    return t != "" ? t : tipAmong(cs, id, k + 1);
}

// a place the keyboard reaches (Tab): that of a box `focusable`, its
// message `id`, the radius of its corners as its `range` (its ring drawn
// around it)
export const FOCUS: i64 = 6;
// a place that moves the window when dragged: a title the application
// draws, a free part of its bar (`moves` of a box)
export const MOVE: i64 = 7;

// a size along an axis: as its content, a number of pixels, or a share of
// the room its siblings leave (`Fill(1.0)` and `Fill(2.0)`: a third and two)
export type Length = Auto | Px(f32) | Fill(f32);

export type Direction = Row | Column;

// where the children sit along the main axis: packed at the start, the
// centre or the end, or spread (the room left between them)
export type Justify = Packed(Align) | Between;

// how a box looks and lays out its children
export type Style = {
    width: Length,
    height: Length,
    direction: Direction,
    gap: f32,
    padding: f32,
    justify: Justify,
    // across the main axis: each child at the start, the centre or the end
    // of the room, or as large as it (`stretch`, a child of an automatic
    // size)
    align: Align,
    stretch: boolean,
    background: Color,
    border: f32,
    borderColor: Color,
    radius: f32,
    // a shadow under the box (a blur of 0: none)
    shadowBlur: f32,
    shadowY: f32,
    shadowColor: Color,
    // the message a click on the box gives (-1: none)
    onClick: i64,
    // its children drawn within its padding box alone
    clip: boolean,
    // a box whose column of children scrolls (clipped): the number of its
    // offset among those the application keeps (0 to 15; -1: none)
    scroll: i64,
    // the shape of the pointer over the box (-1: a hand over a box a click
    // reaches, else that of the box under it)
    cursor: i64,
    // a box with a message reached by the keyboard too: Tab gives it the
    // focus (a ring around it), Enter or Space then click it
    focusable: boolean,
    // the text of the tooltip of a box with a message, shown by the pointer
    // resting over it (half a second); "": none
    tip: string,
    // the padding across and down when not that of `padding` (-1)
    padX: f32,
    padY: f32,
    // a ring around the box, outside it (its place unchanged): its width (0:
    // none) and colour, its corners those of the box widened by it
    outline: f32,
    outlineColor: Color,
    // the width of the border of one side when not that of `border` (-1):
    // the line under a title, the edge of a tab
    borderTop: f32,
    borderRight: f32,
    borderBottom: f32,
    borderLeft: f32,
    // a box over its siblings, out of their flow: placed at the top of its
    // parent's inside (its width its own, `Fill` that of the parent), drawn
    // and reached after them (a palette, a menu)
    floating: boolean,
    // a box that moves the window when dragged where none of its children
    // takes the pointer: a title the application draws (`WindowSpec.drawn`)
    moves: boolean,
    // its width never under `minWidth` nor past `maxWidth` (-1: no limit),
    // whatever its parent gives it (a share of a row, the room of a column
    // that stretches it): the buttons of a title that the zone around them
    // keeps, a box at most 600 units wide
    minWidth: f32,
    maxWidth: f32,
    // a row whose children past its width are hidden, its last child (a
    // button « … ») shown after those that fit when some are and hidden
    // when all fit: the menus of a bar that folds (Visual Studio Code)
    folds: boolean,
    // the radius of one corner when not that of `radius` (-1): a tab
    // rounded at its top alone, the shoulder of a tab joined to its editor
    radiusTopLeft: f32,
    radiusTopRight: f32,
    radiusBottomRight: f32,
    radiusBottomLeft: f32,
    // a box over its siblings (`floating`) drawn under them rather than over
    // them, and wider than its parent's inside by `spreadX` units on each
    // side: the shape of a tab behind its text, its shoulders over its
    // neighbours (Visual Studio Code)
    under: boolean,
    spreadX: f32,
    // the scrollbar of a box that scrolls: the width of its thumb (-1: 6
    // units, 8 under the pointer), its colours (transparent: a black of
    // 28 %, 45 % under the pointer), its corners (-1: half its width), its
    // room from the right edge (-1: 2 units): the slider of Visual Studio
    // Code, 13 units of #A8A9AA85 at the edge, corners of 4
    barWidth: f32,
    barColor: Color,
    barHoverColor: Color,
    barRadius: f32,
    barInset: f32,
    // the box and all it draws faded to this opacity (1: as they are): the
    // bar of the title of Visual Studio Code while its window is inactive
    opacity: f32,
};

// how a text looks: its size (`em`, pixels a em), its colour, how its lines are
// placed in its width, the height of a line
// (`caret`: the colour of the caret of a field holding the text)
export type TextStyle = { em: f32, color: Color, align: Align, lineHeight: f32, face: i64, caret: Color };

// an element: a box and its children, a text, or the line of a field (its
// text, caret and selection; with the focus, its caret and its selection
// drawn; a text shown while it is empty, in a grey), or an image (a PNG
// file read, `png.decode`) drawn in its box, its size given (its own when
// 0)
// (`Canvas(w, h, ps)`: the primitives `ps` drawn in a box of `w` by `h`,
// their (0, 0) its corner, in pixels: not enlarged with the density, as
// GPUI's `canvas`)
// (`Caret(w, h, c)`: the caret of an editor, `w` by `h` of the colour `c`,
// drawn while the carets blink on; it takes no width among its siblings)
export type Element = Div(Style, Element[k]) | Label(TextStyle, string) | Input(TextStyle, Editing, boolean, string) | Image(Picture, f32, f32) | Canvas(f32, f32, Primitive[]) | Caret(f32, f32, Color);

// a place the pointer reaches, by its `kind`: CLICK (a box and its message
// `id`), WHEEL (a box that scrolls: the number of its offset as `id`, as
// far as `range` pixels), BAR (the scrollbar of such a box, along its
// right side), FIELD (the line of a field: the pen at each boundary of its
// characters, `stops`, and their offsets in its text, `marks`; its `id` 1
// with the focus, its `range` 1 with a selection), SHAPE (a shape of the
// pointer alone), MENU (an entry of a menu of the library, its number as
// `id`, `range` 1 when it can be chosen); the shape of the pointer over it
// (-1: none)
export type Hit = { x: f32, y: f32, w: f32, h: f32, id: i64, kind: i64, range: f32, cursor: i64, stops: f32[], marks: i64[] };

// what the frame drawn shows besides the view: the offsets of the boxes
// that scroll, the caret (shown or hidden by its blinking), the scrollbar
// under the pointer (its offset's number, -1: none), the pixels of a unit
// (the factor of the screen: 1.5 at 150 %), for the scrollbars
// (`deferred`: its glyphs `Pending`, their images made from those kept,
// atlas.isc)
export type Frame = { offsets: f32[], caretOn: boolean, hotBar: i64, scale: f32, deferred: boolean };

// a length `k` times larger
function scaledLength(l: Length, k: f32): Length {
    return match (l) {
        Px(v) => Px(v * k),
        _ => l,
    };
}

function scaledText(ts: TextStyle, k: f32): TextStyle {
    return { ...ts, em: ts.em * k, lineHeight: ts.lineHeight * k };
}

// the element `e` `k` times larger: its sizes, gaps, paddings, borders,
// corners, shadows, rings and texts (the view in units of 96 dots per inch
// laid out in the pixels of a screen of another density, its texts drawn
// at their size there, not enlarged after)
// a border of `b` units in pixels at `k` pixels a unit: whole pixels, one
// at least (as a browser draws it: a line of 1 unit sharp at 125 %)
function devicePixels(b: f32, k: f32): f32 {
    return b > 0.0f32 ? max(1.0f32, f32(i64(b * k + 0.001f32))) : 0.0f32;
}

export function scaledElement(e: Element, k: f32): Element {
    if (k == 1.0f32) {
        return e;
    }
    return match (e) {
        Label(ts, s) => Label(scaledText(ts, k), s),
        Input(ts, ed, focused, hint) => Input(scaledText(ts, k), ed, focused, hint),
        Image(p, w, h) => Image(p, (w > 0.0f32 ? w : f32(p.width)) * k, (h > 0.0f32 ? h : f32(p.height)) * k),
        Canvas(w, h, ps) => Canvas(w, h, ps),
        Caret(w, h, c) => Caret(devicePixels(w, k), h * k, c),
        Div(st, cs) => Div({
            ...st,
            width: scaledLength(st.width, k),
            height: scaledLength(st.height, k),
            gap: st.gap * k,
            padding: st.padding * k,
            padX: st.padX >= 0.0f32 ? st.padX * k : st.padX,
            padY: st.padY >= 0.0f32 ? st.padY * k : st.padY,
            border: devicePixels(st.border, k),
            borderTop: st.borderTop >= 0.0f32 ? devicePixels(st.borderTop, k) : st.borderTop,
            borderRight: st.borderRight >= 0.0f32 ? devicePixels(st.borderRight, k) : st.borderRight,
            borderBottom: st.borderBottom >= 0.0f32 ? devicePixels(st.borderBottom, k) : st.borderBottom,
            borderLeft: st.borderLeft >= 0.0f32 ? devicePixels(st.borderLeft, k) : st.borderLeft,
            radius: st.radius * k,
            radiusTopLeft: st.radiusTopLeft >= 0.0f32 ? st.radiusTopLeft * k : st.radiusTopLeft,
            radiusTopRight: st.radiusTopRight >= 0.0f32 ? st.radiusTopRight * k : st.radiusTopRight,
            radiusBottomRight: st.radiusBottomRight >= 0.0f32 ? st.radiusBottomRight * k : st.radiusBottomRight,
            radiusBottomLeft: st.radiusBottomLeft >= 0.0f32 ? st.radiusBottomLeft * k : st.radiusBottomLeft,
            minWidth: st.minWidth * k,
            spreadX: st.spreadX * k,
            barWidth: st.barWidth >= 0.0f32 ? st.barWidth * k : st.barWidth,
            barRadius: st.barRadius >= 0.0f32 ? st.barRadius * k : st.barRadius,
            barInset: st.barInset >= 0.0f32 ? st.barInset * k : st.barInset,
            maxWidth: st.maxWidth >= 0.0f32 ? st.maxWidth * k : st.maxWidth,
            shadowBlur: st.shadowBlur * k,
            shadowY: st.shadowY * k,
            outline: st.outline * k,
        }, map(cs, (c) => scaledElement(c, k))),
    };
}

// a place without the boundaries of a field
export function placeOf(x: f32, y: f32, w: f32, h: f32, id: i64, kind: i64, range: f32, cursor: i64): Hit {
    return { x: x, y: y, w: w, h: h, id: id, kind: kind, range: range, cursor: cursor, stops: [], marks: [] };
}

// the colours of the caret of a field and of its hint
function caretColor(): Color {
    return rgb(0x3B82F6u32);
}

function hintColor(): Color {
    return rgb(0x9CA3AFu32);
}

// the colour of a selection
function selectionColor(): Color {
    return rgba(0.231f32, 0.510f32, 0.965f32, 0.28f32);
}

// a box that draws nothing and lays out a column
export function style(): Style {
    return {
        width: Auto,
        height: Auto,
        direction: Column,
        gap: 0.0f32,
        padding: 0.0f32,
        justify: Packed(Start),
        align: Start,
        stretch: true,
        background: transparent(),
        border: 0.0f32,
        borderColor: transparent(),
        radius: 0.0f32,
        shadowBlur: 0.0f32,
        shadowY: 0.0f32,
        shadowColor: transparent(),
        onClick: -1,
        clip: false,
        scroll: -1,
        cursor: -1,
        focusable: false,
        tip: "",
        padX: -1.0f32,
        padY: -1.0f32,
        outline: 0.0f32,
        outlineColor: transparent(),
        borderTop: -1.0f32,
        borderRight: -1.0f32,
        borderBottom: -1.0f32,
        borderLeft: -1.0f32,
        floating: false,
        moves: false,
        minWidth: 0.0f32,
        maxWidth: -1.0f32,
        folds: false,
        radiusTopLeft: -1.0f32,
        radiusTopRight: -1.0f32,
        radiusBottomRight: -1.0f32,
        radiusBottomLeft: -1.0f32,
        under: false,
        spreadX: 0.0f32,
        barWidth: -1.0f32,
        barColor: transparent(),
        barHoverColor: transparent(),
        barRadius: -1.0f32,
        barInset: -1.0f32,
        opacity: 1.0f32,
    };
}

// whether `e` is a box over its siblings (`floating`)
function floats(e: Element): boolean {
    return match (e) {
        Div(st, cs) => st.floating,
        _ => false,
    };
}

// whether `e` is a box over its siblings drawn under them (`under`)
function beneath(e: Element): boolean {
    return match (e) {
        Div(st, cs) => st.floating && st.under,
        _ => false,
    };
}

// the units a box over its siblings spreads past its parent's inside on
// each side (`spreadX`)
function spreadOf(e: Element): f32 {
    return match (e) {
        Div(st, cs) => st.spreadX,
        _ => 0.0f32,
    };
}

// the padding across and down of the style `st`
function padsOf(st: Style): [f32, f32] {
    return [st.padX >= 0.0f32 ? st.padX : st.padding, st.padY >= 0.0f32 ? st.padY : st.padding] as const;
}

// a text of `em` pixels a em in the colour `c`, its lines at the start
// of its width, 1.4 em apart
export function textStyle(em: f32, c: Color): TextStyle {
    return { em: em, color: c, align: Start, lineHeight: em * 1.4f32, face: 0, caret: caretColor() };
}

function isRow(d: Direction): boolean {
    return match (d) {
        Row => true,
        Column => false,
    };
}

// the length of an element along the width or the height
function lengthOf(e: Element, wide: boolean): Length {
    return match (e) {
        Div(st, cs) => wide ? st.width : st.height,
        _ => Auto,
    };
}

function share(l: Length): f32 {
    return match (l) {
        Fill(k) => k,
        _ => 0.0f32,
    };
}

// the size `l` gives, `content` when it gives none
function sized(l: Length, content: f32): f32 {
    return match (l) {
        Px(v) => v,
        _ => content,
    };
}

// the width `w` within the limits of the style `st` (`minWidth`,
// `maxWidth`)
function bounded(st: Style, w: f32): f32 {
    const below = st.maxWidth >= 0.0f32 ? min(w, st.maxWidth) : w;
    return max(below, st.minWidth);
}

// the width `w` within the limits of the element `e` (a box's)
function boundedWidth(e: Element, w: f32): f32 {
    return match (e) {
        Div(st, cs) => bounded(st, w),
        _ => w,
    };
}

// the size of the element `e` (its width, its height) when it has `room`
// pixels of width: a text cut in lines of that width, a box around its
// children (their sizes along its main axis added with the gaps, the
// largest across) and its padding, or the sizes its style fixes
function measure(fs: Font[k], e: Element, room: f32): [f32, f32] {
    return match (e) {
        Label(ts, s) => measureParagraph(fs[faceOf(ts, k)], ts.em, s, room, ts.lineHeight),
        // a line and room for the caret after it
        Input(ts, ed, focused, hint) => [lineWidth(fs[faceOf(ts, k)], ts.em, ed.text == "" ? hint : ed.text) + 2.0f32, ts.lineHeight] as const,
        Image(p, w, h) => [w > 0.0f32 ? w : f32(p.width), h > 0.0f32 ? h : f32(p.height)] as const,
        Canvas(w, h, ps) => [w, h] as const,
        Caret(w, h, c) => [0.0f32, h] as const,
        Div(st, cs) => {
            const row = isRow(st.direction);
            const [px, py] = padsOf(st);
            const inner = bounded(st, sized(st.width, room)) - 2.0f32 * px;
            // (a box over its siblings takes no room among them; the last
            // child of a row that folds, its button « … », none when all
            // its children are shown)
            const n = cs.length;
            const out = (i: i64) => floats(cs[i]) || (st.folds && row && i == n - 1);
            const sizes = map(iota(n), (i) => out(i) ? [0.0f32, 0.0f32] as const : measure(fs, cs[i], inner));
            const inFlow = count(iota(n), (i) => !out(i));
            const gaps = inFlow > 1 ? f32(inFlow - 1) * st.gap : 0.0f32;
            const along = fold(sizes, gaps, (a, s) => {
                const [w, h] = s;
                return a + (row ? w : h);
            });
            const across = fold(sizes, 0.0f32, (a, s) => {
                const [w, h] = s;
                return max(a, row ? h : w);
            });
            const w = (row ? along : across) + 2.0f32 * px;
            const h = (row ? across : along) + 2.0f32 * py;
            return [bounded(st, sized(st.width, w)), sized(st.height, h)] as const;
        },
    };
}

// the font of the style `ts` among `k` (the first for one beyond them)
function faceOf(ts: TextStyle, k: i64): i64 {
    return ts.face >= 0 && ts.face < k ? ts.face : 0;
}

// the baseline of the first line of a text in a box at `y`: the line's
// leading shared above and below the font's height (as CSS places it)
function baseline(f: Font, ts: TextStyle, y: f32): f32 {
    const k = ts.em / f32(f.unitsPerEm);
    const height = f32(f.ascender - f.descender) * k;
    return y + (ts.lineHeight - height) * 0.5f32 + f32(f.ascender) * k;
}

// what draws the box of the style `st` at (x, y, w, h): its shadow, its
// background and border
function decoration(st: Style, x: f32, y: f32, w: f32, h: f32): Primitive[] {
    // (each corner its own radius, else that of `radius`)
    const tl = st.radiusTopLeft >= 0.0f32 ? st.radiusTopLeft : st.radius;
    const tr = st.radiusTopRight >= 0.0f32 ? st.radiusTopRight : st.radius;
    const brr = st.radiusBottomRight >= 0.0f32 ? st.radiusBottomRight : st.radius;
    const blr = st.radiusBottomLeft >= 0.0f32 ? st.radiusBottomLeft : st.radius;
    const shadow: Primitive[] = st.shadowBlur > 0.0f32 || st.shadowY != 0.0f32
        ? [Blur({ x: x, y: y + st.shadowY, w: w, h: h, blur: st.shadowBlur, color: st.shadowColor, topLeft: tl, topRight: tr, bottomRight: brr, bottomLeft: blr })]
        : [];
    // (each side its own width, else that of `border`)
    const bt = st.borderTop >= 0.0f32 ? st.borderTop : st.border;
    const br = st.borderRight >= 0.0f32 ? st.borderRight : st.border;
    const bb = st.borderBottom >= 0.0f32 ? st.borderBottom : st.border;
    const bl = st.borderLeft >= 0.0f32 ? st.borderLeft : st.border;
    const visible = st.background.a > 0.0f32 || ((bt > 0.0f32 || br > 0.0f32 || bb > 0.0f32 || bl > 0.0f32) && st.borderColor.a > 0.0f32);
    const q = bordered(rounded(quad(x, y, w, h, st.background), st.radius), st.border, st.borderColor);
    const body: Primitive[] = visible ? [Box({ ...q, top: bt, right: br, bottom: bb, left: bl, topLeft: tl, topRight: tr, bottomRight: brr, bottomLeft: blr })] : [];
    const o = st.outline;
    const ring: Primitive[] = o > 0.0f32 && st.outlineColor.a > 0.0f32 ? [Box(rounded(quad(x - o, y - o, w + 2.0f32 * o, h + 2.0f32 * o, st.outlineColor), st.radius + o))] : [];
    return concat(concat(shadow, ring), body);
}

// the element `e` laid out in the box (x, y, w, h): what draws it, in the
// order it is drawn, and the places a click on it reaches
export function place(f: Font, e: Element, x: f32, y: f32, w: f32, h: f32): [Primitive[], Hit[]] {
    return placeScrolled(f, e, x, y, w, h, []);
}

// `place` with the fonts `fs` (the face of a text its number among them)
export function placeFonts(fs: Font[k], e: Element, x: f32, y: f32, w: f32, h: f32): [Primitive[], Hit[]] {
    return placeFrame(fs, e, x, y, w, h, { offsets: [], caretOn: true, hotBar: -1, scale: 1.0f32, deferred: false });
}

// `place`, the boxes that scroll moved by the offsets `offsets` (by their
// numbers; none: 0), each offset within its range (the height of its
// content past its own)
export function placeScrolled(f: Font, e: Element, x: f32, y: f32, w: f32, h: f32, offsets: f32[]): [Primitive[], Hit[]] {
    return placeFrame([f], e, x, y, w, h, { offsets: offsets, caretOn: true, hotBar: -1, scale: 1.0f32, deferred: false });
}

// the line of a field (its text, caret and selection `ed`; with the focus,
// its selection and caret drawn) in the box (x, y, w, h), in the middle of
// its height: moved left as far as its caret needs to be seen, cut to the
// box; its place gives the pen at each boundary of its characters
function placeInput(f: Font, face: i64, ts: TextStyle, ed: Editing, focused: boolean, hint: string, x: f32, y: f32, w: f32, h: f32, caretOn: boolean, deferred: boolean): [Primitive[], Hit[]] {
    const [marks, xs] = stops(f, ts.em, ed.text);
    const at = (o: i64) => {
        const k = findIndex(marks, (m) => m >= o);
        return xs[k < 0 ? marks.length - 1 : k];
    };
    const cx = at(ed.caret);
    const shift = focused ? max(0.0f32, cx + 2.0f32 - w) : 0.0f32;
    const ox = x - shift;
    const top = y + (h - ts.lineHeight) * 0.5f32;
    const [a, b] = selection(ed);
    const sel: Primitive[] = focused && a != b ? [Box(quad(ox + at(a), top, at(b) - at(a), ts.lineHeight, selectionColor()))] : [];
    const ch = ts.em * 1.25f32;
    const caret: Primitive[] = focused && caretOn ? [Box(quad(floor(ox + cx), top + (ts.lineHeight - ch) * 0.5f32, 1.5f32, ch, ts.caret))] : [];
    // (an empty field shows its hint, its caret before it)
    const text = ed.text == "" ? lineAs(f, ts.em, hint, ox, baseline(f, ts, top), hintColor(), deferred, face) : lineAs(f, ts.em, ed.text, ox, baseline(f, ts, top), ts.color, deferred, face);
    const drawn = concat(concat(concat(concat([Clip(x, y, x + w, y + h)], sel), text), caret), [Unclip]);
    // (its `id` 1 with the focus: a caret to blink; its `range` 1 with a
    // selection)
    const place: Hit = { x: x, y: y, w: w, h: h, id: focused ? 1 : 0, kind: FIELD, range: a != b ? 1.0f32 : 0.0f32, cursor: TEXT, stops: map(xs, (v) => ox + v), marks: marks };
    return [drawn, [place]] as const;
}

// `placeScrolled`, what the frame `fr` shows besides the view: the caret
// shown or hidden, the scrollbar under the pointer
export function placeFrame(fs: Font[k], e: Element, x: f32, y: f32, w: f32, h: f32, fr: Frame): [Primitive[], Hit[]] {
    const offsets = fr.offsets;
    return match (e) {
        Label(ts, s) => [paragraphAs(fs[faceOf(ts, k)], ts.em, s, x, baseline(fs[faceOf(ts, k)], ts, y), w, ts.lineHeight, ts.align, ts.color, fr.deferred, faceOf(ts, k)), []] as const,
        Input(ts, ed, focused, hint) => placeInput(fs[faceOf(ts, k)], faceOf(ts, k), ts, ed, focused, hint, x, y, w, h, fr.caretOn, fr.deferred),
        // (its pixels in its box: its size the box's, given by its parent)
        Image(p, iw, ih) => [[Raster({ x: x, y: y, w: w, h: h, iw: p.width, ih: p.height, pixels: p.pixels })], []] as const,
        // (its primitives within its box)
        Canvas(cw, ch, ps) => [concat(concat([Clip(x, y, x + w, y + h)], map(ps, (p) => movedBy(p, x, y))), [Unclip]), []] as const,
        // (a place of no size, a field with the focus: the carets blink while
        // it is shown)
        Caret(cw, ch, c) => [fr.caretOn ? [Box(quad(floor(x), y, cw, ch, c))] : [], [placeOf(x, y, 0.0f32, 0.0f32, 1, FIELD, 0.0f32, -1)]] as const,
        Div(st, cs) => {
            const deco = decoration(st, x, y, w, h);
            const shape = st.cursor >= 0 ? st.cursor : (st.onClick >= 0 ? POINTER : -1);
            const clicked0: Hit[] = st.onClick >= 0 ? [placeOf(x, y, w, h, st.onClick, CLICK, 0.0f32, shape)] : (shape >= 0 ? [placeOf(x, y, w, h, -1, SHAPE, 0.0f32, shape)] : []);
            // (a box that moves the window: a place of its own before those
            // of its children, which keep the pointer)
            const clicked: Hit[] = st.moves ? concat([placeOf(x, y, w, h, -1, MOVE, 0.0f32, -1)], clicked0) : clicked0;
            const hits: Hit[] = st.focusable && st.onClick >= 0 ? concat(clicked, [placeOf(x, y, w, h, st.onClick, FOCUS, st.radius, shape)]) : clicked;
            const row = isRow(st.direction);
            const n = cs.length;
            const [px, py] = padsOf(st);
            const ix = x + px;
            const iy = y + py;
            const iw = max(0.0f32, w - 2.0f32 * px);
            const ih = max(0.0f32, h - 2.0f32 * py);
            // a column that scrolls and whose children pass its height: the
            // right 14 pixels kept for its scrollbar (its children laid out
            // left of it, never under it)
            const scrolls = st.scroll >= 0 && !row;
            // (the boxes over their siblings out of the flow: no room, no
            // gap; so the last child of a row that folds, placed after the
            // children shown)
            const over = map(cs, (c) => floats(c));
            const folding = st.folds && row && n > 0;
            const aside = map(iota(n), (i) => over[i] || (folding && i == n - 1));
            const inFlow = count(aside, (o) => !o);
            const gapsAll = inFlow > 1 ? f32(inFlow - 1) * st.gap : 0.0f32;
            const tall = scrolls && fold(cs, gapsAll, (a, c) => {
                const [mw, mh] = floats(c) ? [0.0f32, 0.0f32] as const : measure(fs, c, iw);
                return a + mh;
            }) > ih;
            const cw = tall ? max(0.0f32, iw - 14.0f32 * fr.scale) : iw;
            const mainRoom = row ? cw : ih;
            const crossRoom = row ? ih : cw;
            const sizes = map(cs, (c) => measure(fs, c, cw));
            // along the main axis: a share of the room left, or the size
            // the child has
            const grows = map(cs, (c) => share(lengthOf(c, row)));
            const base = map(iota(n), (i) => {
                const [cw, ch] = sizes[i];
                return aside[i] || grows[i] > 0.0f32 ? 0.0f32 : (row ? cw : ch);
            });
            const gaps = gapsAll;
            const used = fold(base, gaps, (a, b) => a + b);
            const shares = fold(iota(n), 0.0f32, (a, i) => aside[i] ? a : a + grows[i]);
            const room = max(0.0f32, mainRoom - used);
            // (in a row, a share past the limits of its child's width: the
            // child at its limit, the room left shared by the others)
            const tried = map(iota(n), (i) => !aside[i] && grows[i] > 0.0f32 ? room * grows[i] / shares : base[i]);
            const held = map(iota(n), (i) => row && !aside[i] && grows[i] > 0.0f32 && boundedWidth(cs[i], tried[i]) != tried[i]);
            const heldRoom = fold(iota(n), 0.0f32, (a, i) => held[i] ? a + boundedWidth(cs[i], tried[i]) : a);
            const freeShares = fold(iota(n), 0.0f32, (a, i) => aside[i] || held[i] ? a : a + grows[i]);
            const freeRoom = max(0.0f32, room - heldRoom);
            const mains = map(iota(n), (i) => held[i] ? boundedWidth(cs[i], tried[i])
                : (!aside[i] && grows[i] > 0.0f32 ? freeRoom * grows[i] / freeShares : base[i]));
            // (the room no child takes: none when one shares it, that its
            // limits leave when all are held)
            const left = shares > 0.0f32 ? (freeShares > 0.0f32 ? 0.0f32 : freeRoom) : room;
            const [first, extra] = match (st.justify) {
                Packed(a) => match (a) {
                    Start => [0.0f32, 0.0f32] as const,
                    Center => [left * 0.5f32, 0.0f32] as const,
                    End => [left, 0.0f32] as const,
                },
                Between => [0.0f32, inFlow > 1 ? left / f32(inFlow - 1) : 0.0f32] as const,
            };
            const ends = scan(map(iota(n), (i) => aside[i] ? 0.0f32 : mains[i] + st.gap + extra), (a, b) => a + b, 0.0f32);
            // a column that scrolls: its children moved up by its offset,
            // within the height they have past its own
            const range = scrolls ? max(0.0f32, used - mainRoom) : 0.0f32;
            const off = scrolls && st.scroll < offsets.length ? min(range, max(0.0f32, offsets[st.scroll])) : 0.0f32;
            // the frame of each child: across, the room, a size fixed or
            // the content's, placed by `align`
            const frames = map(iota(n), (i) => {
                const c = cs[i];
                const [cw, ch] = sizes[i];
                // (a box over its siblings at the top of the inside: its own
                // width, `Fill` that of the inside, its own height)
                const [ow, oh] = over[i] ? measure(fs, c, iw) : [0.0f32, 0.0f32] as const;
                const wide = match (lengthOf(c, true)) {
                    Fill(k) => true,
                    _ => false,
                };
                const fixed = match (lengthOf(c, !row)) {
                    Px(v) => true,
                    _ => false,
                };
                const content = row ? ch : cw;
                // (a width stretched within the limits of the child's)
                const cross = st.stretch && !fixed ? (row ? crossRoom : boundedWidth(c, crossRoom)) : content;
                const at = match (st.align) {
                    Start => 0.0f32,
                    Center => (crossRoom - cross) * 0.5f32,
                    End => crossRoom - cross,
                };
                const along = first + ends[i] - (mains[i] + st.gap + extra) - off;
                return over[i] ? [ix - spreadOf(c), iy, (wide ? iw : ow) + 2.0f32 * spreadOf(c), oh] as const
                    : (row
                    ? [ix + along, iy + at, mains[i], cross] as const
                    : [ix + at, iy + along, cross, mains[i]] as const);
            });
            // a row that folds: its children shown while they fit, its last
            // (its button « … ») after them when some do not
            const rightOf = (i: i64) => {
                const [fx, fy, fw, fh] = frames[i];
                return fx + fw - ix;
            };
            const all = folding && (n < 2 || rightOf(n - 2) <= iw + 0.5f32);
            const [mw, mh] = folding ? sizes[n - 1] : [0.0f32, 0.0f32] as const;
            const fits = map(iota(n), (i) => !folding || i == n - 1 || over[i]
                || (all ? true : rightOf(i) + st.gap + mw <= iw + 0.5f32));
            const shownKids = filter(iota(n), (i) => fits[i] && !(folding && i == n - 1 && all));
            const lastFit = fold(iota(n), -1, (a, i) => i < n - 1 && fits[i] && !over[i] ? i : a);
            const placed = map(iota(n), (i) => {
                if (!folding || i != n - 1 || all) {
                    return frames[i];
                }
                const [fx, fy, fw, fh] = frames[i];
                return [lastFit >= 0 ? ix + rightOf(lastFit) + st.gap : ix, fy, mw, fh] as const;
            });
            // a box that cuts its children: those wholly outside it not
            // placed (a long list scrolled: its rows out of sight neither
            // drawn nor reached)
            const cuts = st.clip || scrolls;
            const seenKids = filter(shownKids, (i) => {
                const [fx, fy, fw, fh] = placed[i];
                return !cuts || (fy < iy + ih && fy + fh > iy && fx < ix + iw && fx + fw > ix);
            });
            // (the boxes over their siblings drawn and reached after them,
            // those `under` them before them)
            const ordered = concat(concat(filter(seenKids, (i) => over[i] && beneath(cs[i])), filter(seenKids, (i) => !over[i])), filter(seenKids, (i) => over[i] && !beneath(cs[i])));
            const [cps, chs] = placeFrom(fs, map(ordered, (i) => cs[i]), map(ordered, (i) => placed[i]), 0, [], [], fr);
            if (!st.clip && !scrolls) {
                return [fadedAll(concat(deco, cps), st.opacity), concat(hits, chs)] as const;
            }
            // clipped: the children drawn within the padding box, their
            // places cut to it (none left where they are hidden)
            const x1 = ix + iw;
            const y1 = iy + ih;
            const seen = filter(chs, (c) => c.x < x1 && c.x + c.w > ix && c.y < y1 && c.y + c.h > iy);
            const cut = map(seen, (c) => {
                const cx = max(c.x, ix);
                const cy = max(c.y, iy);
                return { ...c, x: cx, y: cy, w: min(c.x + c.w, x1) - cx, h: min(c.y + c.h, y1) - cy };
            });
            const wheel: Hit[] = scrolls ? [placeOf(ix, iy, iw, ih, st.scroll, WHEEL, range, -1)] : [];
            // the scrollbar of a box whose content passes its height: a
            // thumb along its right side, as long as the share of the
            // content seen, wider under the pointer; its place the right
            // 12 pixels, over its children
            const hot = fr.hotBar == st.scroll;
            const [ty, th] = thumb(iy, ih, range, off, fr.scale);
            // (the thumb of the style, else the library's)
            const bw = st.barWidth >= 0.0f32 ? st.barWidth : (hot ? 8.0f32 : 6.0f32) * fr.scale;
            const inset = st.barInset >= 0.0f32 ? st.barInset : 2.0f32 * fr.scale;
            const own = hot ? st.barHoverColor : st.barColor;
            const shade = own.a > 0.0f32 ? own : rgba(0.0f32, 0.0f32, 0.0f32, hot ? 0.45f32 : 0.28f32);
            const corner = st.barRadius >= 0.0f32 ? st.barRadius : bw * 0.5f32;
            const bar: Primitive[] = range > 0.0f32 ? [Box(rounded(quad(x1 - inset - bw, ty, bw, th, shade), corner))] : [];
            const barPlace: Hit[] = range > 0.0f32 ? [placeOf(x1 - 12.0f32 * fr.scale, iy, 12.0f32 * fr.scale, ih, st.scroll, BAR, range, ARROW)] : [];
            const drawn = concat(concat(concat(concat(deco, [Clip(ix, iy, x1, y1)]), cps), bar), [Unclip]);
            return [fadedAll(drawn, st.opacity), concat(concat(concat(hits, wheel), cut), barPlace)] as const;
        },
    };
}

// the primitives `ps` faded to the opacity `a` (their colours' alpha
// multiplied; an image's pixels as they are)
function fadedAll(ps: Primitive[n], a: f32): Primitive[] {
    return a >= 1.0f32 ? ps : map(ps, (p) => faded(p, a));
}

function fadedColor(c: Color, a: f32): Color {
    return { ...c, a: c.a * a };
}

function faded(p: Primitive, a: f32): Primitive {
    return match (p) {
        Box(q) => Box({ ...q, background: fadedColor(q.background, a), borderColor: fadedColor(q.borderColor, a) }),
        Blur(s) => Blur({ ...s, color: fadedColor(s.color, a) }),
        Glyph(g) => Glyph({ ...g, color: fadedColor(g.color, a) }),
        Pending(k) => Pending({ ...k, color: fadedColor(k.color, a) }),
        other => other,
    };
}

// the thumb of the scrollbar of a box at `y`, `h` high, whose content
// passes it by `range`, scrolled by `off`, `k` pixels a unit: its top and
// its height (the share of the content seen, 24 units at least), 2 units
// from the ends
export function thumb(y: f32, h: f32, range: f32, off: f32, k: f32): [f32, f32] {
    const track = max(0.0f32, h - 4.0f32 * k);
    const th = min(track, max(24.0f32 * k, track * h / (h + range)));
    return [y + 2.0f32 * k + (range > 0.0f32 ? (track - th) * off / range : 0.0f32), th] as const;
}

// the children `cs` from the `i`-th, each laid out in its frame, after
// what draws those before (`ps`) and their places (`hs`)
function placeFrom(fs: Font[k], cs: Element[n], frames: [f32, f32, f32, f32][n], i: i64, ps: Primitive[], hs: Hit[], fr: Frame): [Primitive[], Hit[]] {
    if (i >= n) {
        return [ps, hs] as const;
    }
    const [x, y, w, h] = frames[i];
    const [cp, ch] = placeFrame(fs, cs[i], x, y, w, h, fr);
    return placeFrom(fs, cs, frames, i + 1, concat(ps, cp), concat(hs, ch), fr);
}

// the place `h` holds the point (px, py)
function holds(h: Hit, px: f32, py: f32): boolean {
    return px >= h.x && px < h.x + h.w && py >= h.y && py < h.y + h.h;
}

// the message of a click at (px, py): that of the last place drawn that
// holds it, -1 for none
export function hitTest(hits: Hit[n], px: f32, py: f32): i64 {
    return fold(hits, -1, (found, h) => h.kind == CLICK && holds(h, px, py) ? h.id : found);
}

// the place of a click at (px, py): the index of the last that holds it
// (-1: none)
export function clickAt(hits: Hit[n], px: f32, py: f32): i64 {
    return fold(iota(n), -1, (found, i) => hits[i].kind == CLICK && holds(hits[i], px, py) ? i : found);
}

// the shape of the pointer at (px, py): that of the last place that holds
// it and has one, an arrow over none
export function cursorAt(hits: Hit[n], px: f32, py: f32): i64 {
    return fold(hits, ARROW, (found, h) => h.cursor >= 0 && holds(h, px, py) ? h.cursor : found);
}

// the scrollbar at (px, py): its index among the places (-1: none)
export function barAt(hits: Hit[n], px: f32, py: f32): i64 {
    return fold(iota(n), -1, (found, i) => hits[i].kind == BAR && holds(hits[i], px, py) ? i : found);
}

// the line of a field a click at (px, py) on the place `c` (an index)
// reaches: the last that holds the point, else the last within the place
// (its padding); -1: none
export function fieldAt(hits: Hit[n], c: i64, px: f32, py: f32): i64 {
    const under = fold(iota(n), -1, (found, i) => hits[i].kind == FIELD && holds(hits[i], px, py) ? i : found);
    if (under >= 0 || c < 0) {
        return under;
    }
    const p = hits[c];
    return fold(iota(n), -1, (found, i) => hits[i].kind == FIELD && hits[i].x >= p.x - 0.5f32 && hits[i].y >= p.y - 0.5f32 && hits[i].x + hits[i].w <= p.x + p.w + 0.5f32 && hits[i].y + hits[i].h <= p.y + p.h + 0.5f32 ? i : found);
}

// the offset in the text of the line of a field `h` of the character under
// `px` (the last whose boundary is at or left of it; past the end: the end)
export function charAt(h: Hit, px: f32): i64 {
    const n = h.stops.length;
    if (n == 0) {
        return -1;
    }
    return h.marks[fold(iota(n - 1), 0, (k, i) => h.stops[i] <= px ? i : k)];
}

// the offset in the text of the line of a field `h` nearest to `px` (the
// boundary of its characters closest to it)
export function offsetAt(h: Hit, px: f32): i64 {
    const n = h.stops.length;
    if (n == 0) {
        return -1;
    }
    const k = fold(iota(n), 0, (best, i) => abs(h.stops[i] - px) < abs(h.stops[best] - px) ? i : best);
    return h.marks[k];
}

// the box the wheel scrolls at (px, py): the number of its offset and its
// range, the last drawn that holds it ([-1, 0]: none)
export function scrollTest(hits: Hit[n], px: f32, py: f32): [i64, f32] {
    return fold(hits, [-1, 0.0f32] as const, (found, h) => h.kind == 1 && px >= h.x && px < h.x + h.w && py >= h.y && py < h.y + h.h ? [h.id, h.range] as const : found);
}

// the offsets `offsets` (16) with that of the box the wheel scrolls at
// (px, py) moved by `dy` pixels (down: positive), within its range
export function scrolled(offsets: f32[n], hits: Hit[m], px: f32, py: f32, dy: f32): f32[n] {
    const [id, range] = scrollTest(hits, px, py);
    return id < 0 || id >= n ? offsets : map(iota(n), (i) => i == id ? min(range, max(0.0f32, offsets[i] + dy)) : offsets[i]);
}
