// The elements of an interface and their layout: boxes laid out in a row
// or a column (a part of flexbox: a gap between children, a padding,
// sizes fixed, as their content or sharing the room left, children packed
// at the start, the centre or the end, or spread; aligned across or
// stretched), texts cut in lines, the line of a field (its selection, its
// caret, moved across to keep its caret in sight); the primitives that
// draw them, and the places the pointer reaches, the last drawn first: a
// click, the wheel, a scrollbar, the characters of a field, the shape of
// the pointer.
import { Primitive, Box, Blur, Clip, Unclip, Color, quad, rounded, bordered, transparent, rgb, rgba } from "./paint";
import { Font } from "./font";
import { Align, Start, Center, End, paragraph, measureParagraph, line, lineWidth, stops } from "./text";
import { Editing, selection } from "./edit";

// the shapes of the pointer over a place: an arrow, a hand (a place that a
// click reaches), a bar (a text)
export const ARROW: i64 = 0;
export const POINTER: i64 = 1;
export const TEXT: i64 = 2;

// the kinds of places: a click, the wheel, a scrollbar, the characters of a
// field, a shape of the pointer alone
export const CLICK: i64 = 0;
export const WHEEL: i64 = 1;
export const BAR: i64 = 2;
export const FIELD: i64 = 3;
export const SHAPE: i64 = 4;
export const MENU: i64 = 5;

// a size along an axis: as its content, a number of pixels, or a share of
// the room its siblings leave (`Fill(1.0)` and `Fill(2.0)`: a third and two)
export type Length = Auto | Px(f32) | Fill(f32);

export type Direction = Row | Column;

// where the children sit along the main axis: packed at the start, the
// centre or the end, or spread (the room left between them)
export type Justify = Packed(Align) | Between;

// how a box looks and lays out its children
export type Style = {
    width: Length,
    height: Length,
    direction: Direction,
    gap: f32,
    padding: f32,
    justify: Justify,
    // across the main axis: each child at the start, the centre or the end
    // of the room, or as large as it (`stretch`, a child of an automatic
    // size)
    align: Align,
    stretch: boolean,
    background: Color,
    border: f32,
    borderColor: Color,
    radius: f32,
    // a shadow under the box (a blur of 0: none)
    shadowBlur: f32,
    shadowY: f32,
    shadowColor: Color,
    // the message a click on the box gives (-1: none)
    onClick: i64,
    // its children drawn within its padding box alone
    clip: boolean,
    // a box whose column of children scrolls (clipped): the number of its
    // offset among those the application keeps (0 to 15; -1: none)
    scroll: i64,
    // the shape of the pointer over the box (-1: a hand over a box a click
    // reaches, else that of the box under it)
    cursor: i64,
    // the padding across and down when not that of `padding` (-1)
    padX: f32,
    padY: f32,
    // a ring around the box, outside it (its place unchanged): its width (0:
    // none) and colour, its corners those of the box widened by it
    outline: f32,
    outlineColor: Color,
};

// how a text looks: its size (`em`, pixels a em), its colour, how its lines are
// placed in its width, the height of a line
export type TextStyle = { em: f32, color: Color, align: Align, lineHeight: f32 };

// an element: a box and its children, a text, or the line of a field (its
// text, caret and selection; with the focus, its caret and its selection
// drawn; a text shown while it is empty, in a grey)
export type Element = Div(Style, Element[k]) | Label(TextStyle, string) | Input(TextStyle, Editing, boolean, string);

// a place the pointer reaches, by its `kind`: CLICK (a box and its message
// `id`), WHEEL (a box that scrolls: the number of its offset as `id`, as
// far as `range` pixels), BAR (the scrollbar of such a box, along its
// right side), FIELD (the line of a field: the pen at each boundary of its
// characters, `stops`, and their offsets in its text, `marks`; its `id` 1
// with the focus, its `range` 1 with a selection), SHAPE (a shape of the
// pointer alone), MENU (an entry of a menu of the library, its number as
// `id`, `range` 1 when it can be chosen); the shape of the pointer over it
// (-1: none)
export type Hit = { x: f32, y: f32, w: f32, h: f32, id: i64, kind: i64, range: f32, cursor: i64, stops: f32[], marks: i64[] };

// what the frame drawn shows besides the view: the offsets of the boxes
// that scroll, the caret (shown or hidden by its blinking), the scrollbar
// under the pointer (its offset's number, -1: none), the pixels of a unit
// (the factor of the screen: 1.5 at 150 %), for the scrollbars
export type Frame = { offsets: f32[], caretOn: boolean, hotBar: i64, scale: f32 };

// a length `k` times larger
function scaledLength(l: Length, k: f32): Length {
    return match (l) {
        Px(v) => Px(v * k),
        _ => l,
    };
}

function scaledText(ts: TextStyle, k: f32): TextStyle {
    return { ...ts, em: ts.em * k, lineHeight: ts.lineHeight * k };
}

// the element `e` `k` times larger: its sizes, gaps, paddings, borders,
// corners, shadows, rings and texts (the view in units of 96 dots per inch
// laid out in the pixels of a screen of another density, its texts drawn
// at their size there, not enlarged after)
export function scaledElement(e: Element, k: f32): Element {
    if (k == 1.0f32) {
        return e;
    }
    return match (e) {
        Label(ts, s) => Label(scaledText(ts, k), s),
        Input(ts, ed, focused, hint) => Input(scaledText(ts, k), ed, focused, hint),
        Div(st, cs) => Div({
            ...st,
            width: scaledLength(st.width, k),
            height: scaledLength(st.height, k),
            gap: st.gap * k,
            padding: st.padding * k,
            padX: st.padX >= 0.0f32 ? st.padX * k : st.padX,
            padY: st.padY >= 0.0f32 ? st.padY * k : st.padY,
            border: st.border * k,
            radius: st.radius * k,
            shadowBlur: st.shadowBlur * k,
            shadowY: st.shadowY * k,
            outline: st.outline * k,
        }, map(cs, (c) => scaledElement(c, k))),
    };
}

// a place without the boundaries of a field
export function placeOf(x: f32, y: f32, w: f32, h: f32, id: i64, kind: i64, range: f32, cursor: i64): Hit {
    return { x: x, y: y, w: w, h: h, id: id, kind: kind, range: range, cursor: cursor, stops: [], marks: [] };
}

// the colours of the caret of a field and of its hint
function caretColor(): Color {
    return rgb(0x3B82F6u32);
}

function hintColor(): Color {
    return rgb(0x9CA3AFu32);
}

// the colour of a selection
function selectionColor(): Color {
    return rgba(0.231f32, 0.510f32, 0.965f32, 0.28f32);
}

// a box that draws nothing and lays out a column
export function style(): Style {
    return {
        width: Auto,
        height: Auto,
        direction: Column,
        gap: 0.0f32,
        padding: 0.0f32,
        justify: Packed(Start),
        align: Start,
        stretch: true,
        background: transparent(),
        border: 0.0f32,
        borderColor: transparent(),
        radius: 0.0f32,
        shadowBlur: 0.0f32,
        shadowY: 0.0f32,
        shadowColor: transparent(),
        onClick: -1,
        clip: false,
        scroll: -1,
        cursor: -1,
        padX: -1.0f32,
        padY: -1.0f32,
        outline: 0.0f32,
        outlineColor: transparent(),
    };
}

// the padding across and down of the style `st`
function padsOf(st: Style): [f32, f32] {
    return [st.padX >= 0.0f32 ? st.padX : st.padding, st.padY >= 0.0f32 ? st.padY : st.padding] as const;
}

// a text of `em` pixels a em in the colour `c`, its lines at the start
// of its width, 1.4 em apart
export function textStyle(em: f32, c: Color): TextStyle {
    return { em: em, color: c, align: Start, lineHeight: em * 1.4f32 };
}

function isRow(d: Direction): boolean {
    return match (d) {
        Row => true,
        Column => false,
    };
}

// the length of an element along the width or the height
function lengthOf(e: Element, wide: boolean): Length {
    return match (e) {
        Div(st, cs) => wide ? st.width : st.height,
        _ => Auto,
    };
}

function share(l: Length): f32 {
    return match (l) {
        Fill(k) => k,
        _ => 0.0f32,
    };
}

// the size `l` gives, `content` when it gives none
function sized(l: Length, content: f32): f32 {
    return match (l) {
        Px(v) => v,
        _ => content,
    };
}

// the size of the element `e` (its width, its height) when it has `room`
// pixels of width: a text cut in lines of that width, a box around its
// children (their sizes along its main axis added with the gaps, the
// largest across) and its padding, or the sizes its style fixes
function measure(f: Font, e: Element, room: f32): [f32, f32] {
    return match (e) {
        Label(ts, s) => measureParagraph(f, ts.em, s, room, ts.lineHeight),
        // a line and room for the caret after it
        Input(ts, ed, focused, hint) => [lineWidth(f, ts.em, ed.text == "" ? hint : ed.text) + 2.0f32, ts.lineHeight] as const,
        Div(st, cs) => {
            const row = isRow(st.direction);
            const [px, py] = padsOf(st);
            const inner = sized(st.width, room) - 2.0f32 * px;
            const sizes = map(cs, (c) => measure(f, c, inner));
            const gaps = cs.length > 1 ? f32(cs.length - 1) * st.gap : 0.0f32;
            const along = fold(sizes, gaps, (a, s) => {
                const [w, h] = s;
                return a + (row ? w : h);
            });
            const across = fold(sizes, 0.0f32, (a, s) => {
                const [w, h] = s;
                return max(a, row ? h : w);
            });
            const w = (row ? along : across) + 2.0f32 * px;
            const h = (row ? across : along) + 2.0f32 * py;
            return [sized(st.width, w), sized(st.height, h)] as const;
        },
    };
}

// the baseline of the first line of a text in a box at `y`: the line's
// leading shared above and below the font's height (as CSS places it)
function baseline(f: Font, ts: TextStyle, y: f32): f32 {
    const k = ts.em / f32(f.unitsPerEm);
    const height = f32(f.ascender - f.descender) * k;
    return y + (ts.lineHeight - height) * 0.5f32 + f32(f.ascender) * k;
}

// what draws the box of the style `st` at (x, y, w, h): its shadow, its
// background and border
function decoration(st: Style, x: f32, y: f32, w: f32, h: f32): Primitive[] {
    const shadow: Primitive[] = st.shadowBlur > 0.0f32 || st.shadowY != 0.0f32
        ? [Blur({ x: x, y: y + st.shadowY, w: w, h: h, blur: st.shadowBlur, color: st.shadowColor, topLeft: st.radius, topRight: st.radius, bottomRight: st.radius, bottomLeft: st.radius })]
        : [];
    const visible = st.background.a > 0.0f32 || (st.border > 0.0f32 && st.borderColor.a > 0.0f32);
    const body: Primitive[] = visible ? [Box(bordered(rounded(quad(x, y, w, h, st.background), st.radius), st.border, st.borderColor))] : [];
    const o = st.outline;
    const ring: Primitive[] = o > 0.0f32 && st.outlineColor.a > 0.0f32 ? [Box(rounded(quad(x - o, y - o, w + 2.0f32 * o, h + 2.0f32 * o, st.outlineColor), st.radius + o))] : [];
    return concat(concat(shadow, ring), body);
}

// the element `e` laid out in the box (x, y, w, h): what draws it, in the
// order it is drawn, and the places a click on it reaches
export function place(f: Font, e: Element, x: f32, y: f32, w: f32, h: f32): [Primitive[], Hit[]] {
    return placeScrolled(f, e, x, y, w, h, []);
}

// `place`, the boxes that scroll moved by the offsets `offsets` (by their
// numbers; none: 0), each offset within its range (the height of its
// content past its own)
export function placeScrolled(f: Font, e: Element, x: f32, y: f32, w: f32, h: f32, offsets: f32[]): [Primitive[], Hit[]] {
    return placeFrame(f, e, x, y, w, h, { offsets: offsets, caretOn: true, hotBar: -1, scale: 1.0f32 });
}

// the line of a field (its text, caret and selection `ed`; with the focus,
// its selection and caret drawn) in the box (x, y, w, h), in the middle of
// its height: moved left as far as its caret needs to be seen, cut to the
// box; its place gives the pen at each boundary of its characters
function placeInput(f: Font, ts: TextStyle, ed: Editing, focused: boolean, hint: string, x: f32, y: f32, w: f32, h: f32, caretOn: boolean): [Primitive[], Hit[]] {
    const [marks, xs] = stops(f, ts.em, ed.text);
    const at = (o: i64) => {
        const k = findIndex(marks, (m) => m >= o);
        return xs[k < 0 ? marks.length - 1 : k];
    };
    const cx = at(ed.caret);
    const shift = focused ? max(0.0f32, cx + 2.0f32 - w) : 0.0f32;
    const ox = x - shift;
    const top = y + (h - ts.lineHeight) * 0.5f32;
    const [a, b] = selection(ed);
    const sel: Primitive[] = focused && a != b ? [Box(quad(ox + at(a), top, at(b) - at(a), ts.lineHeight, selectionColor()))] : [];
    const ch = ts.em * 1.25f32;
    const caret: Primitive[] = focused && caretOn ? [Box(quad(floor(ox + cx), top + (ts.lineHeight - ch) * 0.5f32, 1.5f32, ch, caretColor()))] : [];
    // (an empty field shows its hint, its caret before it)
    const text = ed.text == "" ? line(f, ts.em, hint, ox, baseline(f, ts, top), hintColor()) : line(f, ts.em, ed.text, ox, baseline(f, ts, top), ts.color);
    const drawn = concat(concat(concat(concat([Clip(x, y, x + w, y + h)], sel), text), caret), [Unclip]);
    // (its `id` 1 with the focus: a caret to blink; its `range` 1 with a
    // selection)
    const place: Hit = { x: x, y: y, w: w, h: h, id: focused ? 1 : 0, kind: FIELD, range: a != b ? 1.0f32 : 0.0f32, cursor: TEXT, stops: map(xs, (v) => ox + v), marks: marks };
    return [drawn, [place]] as const;
}

// `placeScrolled`, what the frame `fr` shows besides the view: the caret
// shown or hidden, the scrollbar under the pointer
export function placeFrame(f: Font, e: Element, x: f32, y: f32, w: f32, h: f32, fr: Frame): [Primitive[], Hit[]] {
    const offsets = fr.offsets;
    return match (e) {
        Label(ts, s) => [paragraph(f, ts.em, s, x, baseline(f, ts, y), w, ts.lineHeight, ts.align, ts.color), []] as const,
        Input(ts, ed, focused, hint) => placeInput(f, ts, ed, focused, hint, x, y, w, h, fr.caretOn),
        Div(st, cs) => {
            const deco = decoration(st, x, y, w, h);
            const shape = st.cursor >= 0 ? st.cursor : (st.onClick >= 0 ? POINTER : -1);
            const hits: Hit[] = st.onClick >= 0 ? [placeOf(x, y, w, h, st.onClick, CLICK, 0.0f32, shape)] : (shape >= 0 ? [placeOf(x, y, w, h, -1, SHAPE, 0.0f32, shape)] : []);
            const row = isRow(st.direction);
            const n = cs.length;
            const [px, py] = padsOf(st);
            const ix = x + px;
            const iy = y + py;
            const iw = max(0.0f32, w - 2.0f32 * px);
            const ih = max(0.0f32, h - 2.0f32 * py);
            // a column that scrolls and whose children pass its height: the
            // right 14 pixels kept for its scrollbar (its children laid out
            // left of it, never under it)
            const scrolls = st.scroll >= 0 && !row;
            const gapsAll = n > 1 ? f32(n - 1) * st.gap : 0.0f32;
            const tall = scrolls && fold(cs, gapsAll, (a, c) => {
                const [mw, mh] = measure(f, c, iw);
                return a + mh;
            }) > ih;
            const cw = tall ? max(0.0f32, iw - 14.0f32 * fr.scale) : iw;
            const mainRoom = row ? cw : ih;
            const crossRoom = row ? ih : cw;
            const sizes = map(cs, (c) => measure(f, c, cw));
            // along the main axis: a share of the room left, or the size
            // the child has
            const grows = map(cs, (c) => share(lengthOf(c, row)));
            const base = map(iota(n), (i) => {
                const [cw, ch] = sizes[i];
                return grows[i] > 0.0f32 ? 0.0f32 : (row ? cw : ch);
            });
            const gaps = n > 1 ? f32(n - 1) * st.gap : 0.0f32;
            const used = fold(base, gaps, (a, b) => a + b);
            const shares = fold(grows, 0.0f32, (a, g) => a + g);
            const room = max(0.0f32, mainRoom - used);
            const mains = map(iota(n), (i) => grows[i] > 0.0f32 ? room * grows[i] / shares : base[i]);
            const left = shares > 0.0f32 ? 0.0f32 : room;
            const [first, extra] = match (st.justify) {
                Packed(a) => match (a) {
                    Start => [0.0f32, 0.0f32] as const,
                    Center => [left * 0.5f32, 0.0f32] as const,
                    End => [left, 0.0f32] as const,
                },
                Between => [0.0f32, n > 1 ? left / f32(n - 1) : 0.0f32] as const,
            };
            const ends = scan(map(iota(n), (i) => mains[i] + st.gap + extra), (a, b) => a + b, 0.0f32);
            // a column that scrolls: its children moved up by its offset,
            // within the height they have past its own
            const range = scrolls ? max(0.0f32, used - mainRoom) : 0.0f32;
            const off = scrolls && st.scroll < offsets.length ? min(range, max(0.0f32, offsets[st.scroll])) : 0.0f32;
            // the frame of each child: across, the room, a size fixed or
            // the content's, placed by `align`
            const frames = map(iota(n), (i) => {
                const c = cs[i];
                const [cw, ch] = sizes[i];
                const fixed = match (lengthOf(c, !row)) {
                    Px(v) => true,
                    _ => false,
                };
                const content = row ? ch : cw;
                const cross = st.stretch && !fixed ? crossRoom : content;
                const at = match (st.align) {
                    Start => 0.0f32,
                    Center => (crossRoom - cross) * 0.5f32,
                    End => crossRoom - cross,
                };
                const along = first + ends[i] - (mains[i] + st.gap + extra) - off;
                return row
                    ? [ix + along, iy + at, mains[i], cross] as const
                    : [ix + at, iy + along, cross, mains[i]] as const;
            });
            const [cps, chs] = placeFrom(f, cs, frames, 0, [], [], fr);
            if (!st.clip && !scrolls) {
                return [concat(deco, cps), concat(hits, chs)] as const;
            }
            // clipped: the children drawn within the padding box, their
            // places cut to it (none left where they are hidden)
            const x1 = ix + iw;
            const y1 = iy + ih;
            const seen = filter(chs, (c) => c.x < x1 && c.x + c.w > ix && c.y < y1 && c.y + c.h > iy);
            const cut = map(seen, (c) => {
                const cx = max(c.x, ix);
                const cy = max(c.y, iy);
                return { ...c, x: cx, y: cy, w: min(c.x + c.w, x1) - cx, h: min(c.y + c.h, y1) - cy };
            });
            const wheel: Hit[] = scrolls ? [placeOf(ix, iy, iw, ih, st.scroll, WHEEL, range, -1)] : [];
            // the scrollbar of a box whose content passes its height: a
            // thumb along its right side, as long as the share of the
            // content seen, wider under the pointer; its place the right
            // 12 pixels, over its children
            const hot = fr.hotBar == st.scroll;
            const [ty, th] = thumb(iy, ih, range, off, fr.scale);
            const bw = (hot ? 8.0f32 : 6.0f32) * fr.scale;
            const bar: Primitive[] = range > 0.0f32 ? [Box(rounded(quad(x1 - 2.0f32 * fr.scale - bw, ty, bw, th, rgba(0.0f32, 0.0f32, 0.0f32, hot ? 0.45f32 : 0.28f32)), bw * 0.5f32))] : [];
            const barPlace: Hit[] = range > 0.0f32 ? [placeOf(x1 - 12.0f32 * fr.scale, iy, 12.0f32 * fr.scale, ih, st.scroll, BAR, range, ARROW)] : [];
            const drawn = concat(concat(concat(concat(deco, [Clip(ix, iy, x1, y1)]), cps), bar), [Unclip]);
            return [drawn, concat(concat(concat(hits, wheel), cut), barPlace)] as const;
        },
    };
}

// the thumb of the scrollbar of a box at `y`, `h` high, whose content
// passes it by `range`, scrolled by `off`, `k` pixels a unit: its top and
// its height (the share of the content seen, 24 units at least), 2 units
// from the ends
export function thumb(y: f32, h: f32, range: f32, off: f32, k: f32): [f32, f32] {
    const track = max(0.0f32, h - 4.0f32 * k);
    const th = min(track, max(24.0f32 * k, track * h / (h + range)));
    return [y + 2.0f32 * k + (range > 0.0f32 ? (track - th) * off / range : 0.0f32), th] as const;
}

// the children `cs` from the `i`-th, each laid out in its frame, after
// what draws those before (`ps`) and their places (`hs`)
function placeFrom(f: Font, cs: Element[n], frames: [f32, f32, f32, f32][n], i: i64, ps: Primitive[], hs: Hit[], fr: Frame): [Primitive[], Hit[]] {
    if (i >= n) {
        return [ps, hs] as const;
    }
    const [x, y, w, h] = frames[i];
    const [cp, ch] = placeFrame(f, cs[i], x, y, w, h, fr);
    return placeFrom(f, cs, frames, i + 1, concat(ps, cp), concat(hs, ch), fr);
}

// the place `h` holds the point (px, py)
function holds(h: Hit, px: f32, py: f32): boolean {
    return px >= h.x && px < h.x + h.w && py >= h.y && py < h.y + h.h;
}

// the message of a click at (px, py): that of the last place drawn that
// holds it, -1 for none
export function hitTest(hits: Hit[n], px: f32, py: f32): i64 {
    return fold(hits, -1, (found, h) => h.kind == CLICK && holds(h, px, py) ? h.id : found);
}

// the place of a click at (px, py): the index of the last that holds it
// (-1: none)
export function clickAt(hits: Hit[n], px: f32, py: f32): i64 {
    return fold(iota(n), -1, (found, i) => hits[i].kind == CLICK && holds(hits[i], px, py) ? i : found);
}

// the shape of the pointer at (px, py): that of the last place that holds
// it and has one, an arrow over none
export function cursorAt(hits: Hit[n], px: f32, py: f32): i64 {
    return fold(hits, ARROW, (found, h) => h.cursor >= 0 && holds(h, px, py) ? h.cursor : found);
}

// the scrollbar at (px, py): its index among the places (-1: none)
export function barAt(hits: Hit[n], px: f32, py: f32): i64 {
    return fold(iota(n), -1, (found, i) => hits[i].kind == BAR && holds(hits[i], px, py) ? i : found);
}

// the line of a field a click at (px, py) on the place `c` (an index)
// reaches: the last that holds the point, else the last within the place
// (its padding); -1: none
export function fieldAt(hits: Hit[n], c: i64, px: f32, py: f32): i64 {
    const under = fold(iota(n), -1, (found, i) => hits[i].kind == FIELD && holds(hits[i], px, py) ? i : found);
    if (under >= 0 || c < 0) {
        return under;
    }
    const p = hits[c];
    return fold(iota(n), -1, (found, i) => hits[i].kind == FIELD && hits[i].x >= p.x - 0.5f32 && hits[i].y >= p.y - 0.5f32 && hits[i].x + hits[i].w <= p.x + p.w + 0.5f32 && hits[i].y + hits[i].h <= p.y + p.h + 0.5f32 ? i : found);
}

// the offset in the text of the line of a field `h` of the character under
// `px` (the last whose boundary is at or left of it; past the end: the end)
export function charAt(h: Hit, px: f32): i64 {
    const n = h.stops.length;
    if (n == 0) {
        return -1;
    }
    return h.marks[fold(iota(n - 1), 0, (k, i) => h.stops[i] <= px ? i : k)];
}

// the offset in the text of the line of a field `h` nearest to `px` (the
// boundary of its characters closest to it)
export function offsetAt(h: Hit, px: f32): i64 {
    const n = h.stops.length;
    if (n == 0) {
        return -1;
    }
    const k = fold(iota(n), 0, (best, i) => abs(h.stops[i] - px) < abs(h.stops[best] - px) ? i : best);
    return h.marks[k];
}

// the box the wheel scrolls at (px, py): the number of its offset and its
// range, the last drawn that holds it ([-1, 0]: none)
export function scrollTest(hits: Hit[n], px: f32, py: f32): [i64, f32] {
    return fold(hits, [-1, 0.0f32] as const, (found, h) => h.kind == 1 && px >= h.x && px < h.x + h.w && py >= h.y && py < h.y + h.h ? [h.id, h.range] as const : found);
}

// the offsets `offsets` (16) with that of the box the wheel scrolls at
// (px, py) moved by `dy` pixels (down: positive), within its range
export function scrolled(offsets: f32[n], hits: Hit[m], px: f32, py: f32, dy: f32): f32[n] {
    const [id, range] = scrollTest(hits, px, py);
    return id < 0 || id >= n ? offsets : map(iota(n), (i) => i == id ? min(range, max(0.0f32, offsets[i] + dy)) : offsets[i]);
}
