// An interface read from files when the program starts, not compiled: its
// elements in XML (the vocabulary of tools/uigen), the classes of its
// styles (src/css.isc), its behaviour in Lua (src/lua_vm.isc). The generic
// application (examples/scripted_app.isc) runs any such interface.
//
// The root `<view>`: `title`, `width`, `height` (its window), `resizable`,
// `minimizable`, `maximizable` (`false`: a window of a fixed size, without
// its button that minimizes or maximizes it; `true` by default), `styles` (its
// files of styles, beside it, separated by spaces), `script` (its files of
// Lua, run in their order: they make the globals the view reads), `menu`
// (the entries of the menu of a field, separated by commas), `onclose`
// (Lua run when the window is closed), `onbeforeclose` (Lua run when the
// window asks to close, before it: a true value keeps it open, an editor
// asks to save its files first, then calls `host.close()`). Its one child
// is the root of the
// interface. The elements, attributes and properties are those of uigen,
// with these changes:
//   - a value `{...}` is an expression of Lua, made a function of Lua once
//     when the files are read (at the line of the file of the view: an
//     error in it is told at that line); in a text, each `{...}` replaced
//     by its value (`tostring`);
//   - `onclick="..."` (a box or a component): Lua run by a click; in an
//     `<each items="{t}" as="x" index="k">`, `x` and `k` are its elements
//     of the sequence `t` and their indices (from 1);
//   - `<field bind="name" hint="..." onenter="..." onchange="...">`: its
//     text is the global `name` of Lua (set at each change, read at each
//     view: Lua that sets it changes the field);
//   - the hand of a component (pointer over it, pressed), the focus of a
//     field and the messages of the places are kept by the host: no `id`,
//     `hand`, `edit` nor `focused`.
// A click on a box with `onclick` takes the focus from a field; one on a
// component leaves it. The interface is made again after each input.
import * as lua from "./lua_vm";
import { V } from "./lua_vm";
import { T_TAB } from "./lua_code";
import { parse, Node, Tag, Text, Read, Fault, Attr, attr, has } from "./xml";
import { parseStyles, Sheet, Bad, Rule, Property } from "./css";
import { rgb, rgba, Color } from "./paint";
import { Element, Div, Label, Input, Image, Length, Px, Fill, Auto, Direction, Row, Column, Justify, Packed, Between, style, textStyle, Style, TextStyle, ARROW, POINTER, TEXT } from "./ui";
import { Align, Start, Center, End } from "./text";
import { Editing, editing, edited, utf8 } from "./edit";
import { button, iconButton, textField, checkbox, toggleAt, progress, restyled, Hand } from "./widgets";
import { renamed } from "./doc";
import { lineAt, lineCount } from "./lines";
import { Doc, docOf, keyed as docKeyed, typedCode, pasted, textOf, saved, dirty, clickedWith, draggedTo, viewed, topFor, cursorBand, columnOf, symbolsAt, boxSized, ratioSet, movedFrom, wheeledAcross, findFrom, statusOf, LINE_HEIGHT } from "./doc";
import { CodeLook, codeLook, lookWith, codeElements, sightOf, columnAtX, codePartClicked, codePartDragged, rowClicked, rowDragged, rowContext, codeMenu, codeMenuLook, codeMenuChosen, CODE_MENU_PALETTE } from "./code_view";
import { Symbol } from "./doc";
import * as inp from "./input";
import { Input as HandInput, Effect, Click, Drag, Release, Hover, Key, Paste, Focus, Viewport, TextRead, FolderListed, WindowState, WindowSize, WindowActive, TextWritten, BoxSized, WheelX, CloseAsked, KeepOpen, Density, ContextMenu, MenuChosen, shownMenu, ReadText, ListFolder, Minimize, ToggleMaximized, CloseWindow, WriteText, ScrollTo, Reveal, ENTER, ESCAPE, BACKSPACE, TAB, LEFT, UP, RIGHT, DOWN, DELETE, HOME, END, WITH_CTRL, WITH_SHIFT, WITH_ALT } from "./input";
import { decode, Picture } from "./png";
import * as sys from "sys";

// ----- values ----------------------------------------------------------

// a value of a property, read
export type PV = PNum(f32) | PLen(Length) | PCol(Color) | PBool(boolean) | PDir(Direction) | PJust(Justify) | PAl(Align) | PCur(i64) | PText(string) | PInt(i64) | PNone;

// the value of an attribute: as written (read), or the number of its
// function of Lua (`{...}`)
export type Val = Lit(PV) | Fn(i64);

// an attribute: the number of its property, its value
export type Prop = { k: i64, v: Val };

// a property of a class: the number of its property, its value
export type SetP = { k: i64, v: PV };

// a class of the styles: its properties of a box and of a text
export type Cls = { name: string, box: SetP[], text: SetP[] };

// the kinds of the values of the properties
const KIND_F32: i64 = 0;
const KIND_LENGTH: i64 = 1;
const KIND_COLOR: i64 = 2;
const KIND_BOOL: i64 = 3;
const KIND_DIRECTION: i64 = 4;
const KIND_JUSTIFY: i64 = 5;
const KIND_ALIGN: i64 = 6;
const KIND_CURSOR: i64 = 7;
const KIND_TEXT: i64 = 8;
const KIND_I64: i64 = 9;
// the font of a text: sans (0), mono (1), icons (2), seti (3), bold (4)
const KIND_FACE: i64 = 10;

const BOX_PROPS: string[] = ["width", "height", "direction", "gap", "padding", "padX", "padY", "justify", "align", "stretch", "background", "border", "borderColor", "radius", "shadowBlur", "shadowY", "shadowColor", "clip", "scroll", "cursor", "focusable", "tip", "outline", "outlineColor", "borderTop", "borderRight", "borderBottom", "borderLeft", "floating", "moves", "minWidth", "maxWidth", "folds", "radiusTopLeft", "radiusTopRight", "radiusBottomRight", "radiusBottomLeft", "under", "spreadX", "barWidth", "barColor", "barHoverColor", "barRadius", "barInset", "opacity"];
const BOX_KINDS: i64[] = [1, 1, 4, 0, 0, 0, 0, 5, 6, 3, 2, 0, 2, 0, 0, 0, 2, 3, 9, 7, 3, 8, 0, 2, 0, 0, 0, 0, 3, 3, 0, 0, 3, 0, 0, 0, 0, 3, 0, 0, 2, 2, 0, 0, 0];
const TEXT_PROPS: string[] = ["size", "color", "textAlign", "font", "caretColor"];
const TEXT_KINDS: i64[] = [0, 2, 6, 10, 2];

// the arguments of the components (`Prop.k` of a component), their kinds
const ARG_NAMES: string[] = ["primary", "width", "danger", "hint", "checked", "on", "value", "at", "autofocus"];
const ARG_KINDS: i64[] = [3, 1, 3, 8, 3, 3, 0, 0, 3];

// the components
const C_BUTTON: i64 = 0;
const C_ICON: i64 = 1;
const C_FIELD: i64 = 2;
const C_CHECK: i64 = 3;
const C_TOGGLE: i64 = 4;
const C_PROGRESS: i64 = 5;
const COMP_TAGS: string[] = ["button", "iconbutton", "field", "checkbox", "toggle", "progress"];

function isNumber(s: string): boolean {
    return match (tryParseF64(s)) {
        Ok(x) => true,
        Err(e) => false,
    };
}

function numberIn(s: string): f64 {
    return match (tryParseF64(s)) {
        Ok(x) => x,
        Err(e) => 0.0,
    };
}

// the value of the hexadecimal digits `s` (-1: not all digits)
function hex(s: string): i64 {
    const b = bytes(s);
    return b.length == 0 ? -1 : fold(b, 0, (v, c) => {
        const d = c >= 48u8 && c <= 57u8 ? i64(c) - 48 : (c >= 97u8 && c <= 102u8 ? i64(c) - 87 : (c >= 65u8 && c <= 70u8 ? i64(c) - 55 : -1));
        return v < 0 || d < 0 ? -1 : v * 16 + d;
    });
}

// the colour written `v` (#RRGGBB, #RRGGBBAA, rgba(r, g, b, a) the channels
// from 0 to 255 and the opacity from 0 to 1, transparent), PNone otherwise
function colorIn(v: string): PV {
    if (v == "transparent") {
        return PCol(rgba(0.0f32, 0.0f32, 0.0f32, 0.0f32));
    }
    const h = v.startsWith("#") ? hex(v.slice(1, v.length)) : -1;
    if (h >= 0 && v.length == 7) {
        return PCol(rgb(u32(h)));
    }
    if (h >= 0 && v.length == 9) {
        const c = (k: i64) => f32(f64(hex(v.slice(1 + 2 * k, 3 + 2 * k))) / 255.0);
        return PCol(rgba(c(0), c(1), c(2), c(3)));
    }
    if (v.startsWith("rgba(") && v.endsWith(")")) {
        const parts = map(split(v.slice(5, v.length - 1), ","), (x) => x.trim());
        if (parts.length == 4 && count(parts, (x) => isNumber(x)) == 4) {
            const ch = (x: string) => f32(numberIn(x) / 255.0);
            return PCol(rgba(ch(parts[0]), ch(parts[1]), ch(parts[2]), f32(numberIn(parts[3]))));
        }
    }
    return PNone;
}

// the value written `v` of the kind `kind`, PNone when it is not one
export function valueIn(kind: i64, v: string): PV {
    if (kind == KIND_F32) {
        return isNumber(v) ? PNum(f32(numberIn(v))) : PNone;
    }
    if (kind == KIND_I64) {
        return match (tryParseI64(v)) {
            Ok(x) => PInt(x),
            Err(e) => PNone,
        };
    }
    if (kind == KIND_LENGTH) {
        if (v == "auto") {
            return PLen(Auto);
        }
        if (v == "fill") {
            return PLen(Fill(1.0f32));
        }
        if (v.startsWith("fill(") && v.endsWith(")") && isNumber(v.slice(5, v.length - 1))) {
            return PLen(Fill(f32(numberIn(v.slice(5, v.length - 1)))));
        }
        return isNumber(v) ? PLen(Px(f32(numberIn(v)))) : PNone;
    }
    if (kind == KIND_COLOR) {
        return colorIn(v);
    }
    if (kind == KIND_BOOL) {
        return v == "true" ? PBool(true) : (v == "false" ? PBool(false) : PNone);
    }
    if (kind == KIND_DIRECTION) {
        return v == "row" ? PDir(Row) : (v == "column" ? PDir(Column) : PNone);
    }
    if (kind == KIND_JUSTIFY) {
        return v == "start" ? PJust(Packed(Start)) : (v == "center" ? PJust(Packed(Center)) : (v == "end" ? PJust(Packed(End)) : (v == "between" ? PJust(Between) : PNone)));
    }
    if (kind == KIND_ALIGN) {
        return v == "start" ? PAl(Start) : (v == "center" ? PAl(Center) : (v == "end" ? PAl(End) : PNone));
    }
    if (kind == KIND_CURSOR) {
        return v == "arrow" ? PCur(ARROW) : (v == "pointer" ? PCur(POINTER) : (v == "text" ? PCur(TEXT) : PNone));
    }
    if (kind == KIND_FACE) {
        return v == "sans" ? PInt(0) : (v == "mono" ? PInt(1) : (v == "icons" ? PInt(2) : (v == "seti" ? PInt(3) : (v == "bold" ? PInt(4) : (v == "caption" ? PInt(5) : (v == "semibold" ? PInt(6) : PNone))))));
    }
    return PText(v);
}

// what values a kind takes, for its faults
function kindName(kind: i64): string {
    return kind == KIND_F32 ? "a number" : (kind == KIND_I64 ? "an integer" : (kind == KIND_LENGTH ? "auto, fill, fill(n) or a number"
        : (kind == KIND_COLOR ? "#RRGGBB, #RRGGBBAA, rgba(r, g, b, a) or transparent" : (kind == KIND_BOOL ? "true or false"
        : (kind == KIND_DIRECTION ? "row or column" : (kind == KIND_JUSTIFY ? "start, center, end or between"
        : (kind == KIND_ALIGN ? "start, center or end" : (kind == KIND_CURSOR ? "arrow, pointer or text" : (kind == KIND_FACE ? "sans or mono" : "a text")))))))));
}

function numOf(v: PV, d: f32): f32 {
    return match (v) {
        PNum(x) => x,
        PLen(l) => match (l) {
            Px(x) => x,
            _ => d,
        },
        PInt(i) => f32(i),
        _ => d,
    };
}

function lenOf(v: PV, d: Length): Length {
    return match (v) {
        PLen(l) => l,
        PNum(x) => Px(x),
        _ => d,
    };
}

function colOf(v: PV, d: Color): Color {
    return match (v) {
        PCol(c) => c,
        _ => d,
    };
}

function boolOf(v: PV, d: boolean): boolean {
    return match (v) {
        PBool(b) => b,
        _ => d,
    };
}

function intOf(v: PV, d: i64): i64 {
    return match (v) {
        PInt(i) => i,
        PCur(c) => c,
        PNum(x) => i64(x),
        _ => d,
    };
}

function textOfPV(v: PV): string {
    return match (v) {
        PText(s) => s,
        _ => "",
    };
}

// the style `s` with its property `k` (of BOX_PROPS) set to `v`
function setBox(s: Style, k: i64, v: PV): Style {
    if (k == 0) {
        return { ...s, width: lenOf(v, s.width) };
    }
    if (k == 1) {
        return { ...s, height: lenOf(v, s.height) };
    }
    if (k == 2) {
        return match (v) {
            PDir(d) => ({ ...s, direction: d }),
            _ => s,
        };
    }
    if (k == 3) {
        return { ...s, gap: numOf(v, s.gap) };
    }
    if (k == 4) {
        return { ...s, padding: numOf(v, s.padding) };
    }
    if (k == 5) {
        return { ...s, padX: numOf(v, s.padX) };
    }
    if (k == 6) {
        return { ...s, padY: numOf(v, s.padY) };
    }
    if (k == 7) {
        return match (v) {
            PJust(j) => ({ ...s, justify: j }),
            _ => s,
        };
    }
    if (k == 8) {
        return match (v) {
            PAl(a) => ({ ...s, align: a }),
            _ => s,
        };
    }
    if (k == 9) {
        return { ...s, stretch: boolOf(v, s.stretch) };
    }
    if (k == 10) {
        return { ...s, background: colOf(v, s.background) };
    }
    if (k == 11) {
        return { ...s, border: numOf(v, s.border) };
    }
    if (k == 12) {
        return { ...s, borderColor: colOf(v, s.borderColor) };
    }
    if (k == 13) {
        return { ...s, radius: numOf(v, s.radius) };
    }
    if (k == 14) {
        return { ...s, shadowBlur: numOf(v, s.shadowBlur) };
    }
    if (k == 15) {
        return { ...s, shadowY: numOf(v, s.shadowY) };
    }
    if (k == 16) {
        return { ...s, shadowColor: colOf(v, s.shadowColor) };
    }
    if (k == 17) {
        return { ...s, clip: boolOf(v, s.clip) };
    }
    if (k == 18) {
        return { ...s, scroll: intOf(v, s.scroll) };
    }
    if (k == 19) {
        return { ...s, cursor: intOf(v, s.cursor) };
    }
    if (k == 20) {
        return { ...s, focusable: boolOf(v, s.focusable) };
    }
    if (k == 21) {
        return { ...s, tip: textOfPV(v) };
    }
    if (k == 22) {
        return { ...s, outline: numOf(v, s.outline) };
    }
    if (k == 23) {
        return { ...s, outlineColor: colOf(v, s.outlineColor) };
    }
    if (k == 24) {
        return { ...s, borderTop: numOf(v, s.borderTop) };
    }
    if (k == 25) {
        return { ...s, borderRight: numOf(v, s.borderRight) };
    }
    if (k == 26) {
        return { ...s, borderBottom: numOf(v, s.borderBottom) };
    }
    if (k == 27) {
        return { ...s, borderLeft: numOf(v, s.borderLeft) };
    }
    if (k == 28) {
        return { ...s, floating: boolOf(v, s.floating) };
    }
    if (k == 29) {
        return { ...s, moves: boolOf(v, s.moves) };
    }
    if (k == 30) {
        return { ...s, minWidth: numOf(v, s.minWidth) };
    }
    if (k == 31) {
        return { ...s, maxWidth: numOf(v, s.maxWidth) };
    }
    if (k == 32) {
        return { ...s, folds: boolOf(v, s.folds) };
    }
    if (k == 33) {
        return { ...s, radiusTopLeft: numOf(v, s.radiusTopLeft) };
    }
    if (k == 34) {
        return { ...s, radiusTopRight: numOf(v, s.radiusTopRight) };
    }
    if (k == 35) {
        return { ...s, radiusBottomRight: numOf(v, s.radiusBottomRight) };
    }
    if (k == 36) {
        return { ...s, radiusBottomLeft: numOf(v, s.radiusBottomLeft) };
    }
    if (k == 37) {
        return { ...s, under: boolOf(v, s.under) };
    }
    if (k == 38) {
        return { ...s, spreadX: numOf(v, s.spreadX) };
    }
    if (k == 39) {
        return { ...s, barWidth: numOf(v, s.barWidth) };
    }
    if (k == 40) {
        return { ...s, barColor: colOf(v, s.barColor) };
    }
    if (k == 41) {
        return { ...s, barHoverColor: colOf(v, s.barHoverColor) };
    }
    if (k == 42) {
        return { ...s, barRadius: numOf(v, s.barRadius) };
    }
    if (k == 43) {
        return { ...s, barInset: numOf(v, s.barInset) };
    }
    return { ...s, opacity: numOf(v, s.opacity) };
}

// the style of a text `t` with its property `k` (of TEXT_PROPS) set to `v`
function setText(t: TextStyle, k: i64, v: PV): TextStyle {
    if (k == 0) {
        return { ...t, em: numOf(v, t.em) };
    }
    if (k == 1) {
        return { ...t, color: colOf(v, t.color) };
    }
    if (k == 3) {
        return { ...t, face: intOf(v, t.face) };
    }
    if (k == 4) {
        return { ...t, caret: colOf(v, t.caret) };
    }
    return match (v) {
        PAl(a) => ({ ...t, align: a }),
        _ => t,
    };
}

// the style `s` with the classes of the numbers `cs` (of `classes`)
function classedBox(s: Style, classes: Cls[n], cs: i64[m]): Style {
    return fold(cs, s, (acc, c) => fold(classes[c].box, acc, (a, p) => setBox(a, p.k, p.v)));
}

// the style `s` with the classes of `cs` in the state `state` (`hover`,
// `active`) that the styles give
function inState(s: Style, classes: Cls[n], cs: i64[m], state: string): Style {
    return fold(cs, s, (acc, c) => {
        const k = findIndex(classes, (x) => x.name == `${classes[c].name}:${state}`);
        return k < 0 ? acc : fold(classes[k].box, acc, (a, p) => setBox(a, p.k, p.v));
    });
}

function classedText(t: TextStyle, classes: Cls[n], cs: i64[m]): TextStyle {
    return fold(cs, t, (acc, c) => fold(classes[c].text, acc, (a, p) => setText(a, p.k, p.v)));
}

// the element `e` with the texts of the classes `cs` given to each of its
// texts (its labels, its fields), at any depth: the text of a component
function textsClassed(e: Element, classes: Cls[n], cs: i64[m]): Element {
    return match (e) {
        Label(ts, s) => Label(classedText(ts, classes, cs), s),
        Input(ts, ed, focused, hint) => Input(classedText(ts, classes, cs), ed, focused, hint),
        Div(st, kids) => Div(st, map(kids, (k) => textsClassed(k, classes, cs))),
        other => other,
    };
}

// ----- the template of the view, read from its file ---------------------

// a component: its kind, its arguments, its classes, its text, the
// functions of its click, of Enter and of a change (-1: none), the global
// of a field (its number among the binds), its line
export type Comp = { kind: i64, args: Prop[], classes: i64[], label: Val, click: i64, enter: i64, change: i64, bind: i64, line: i64 };

// an element of the template: a box (its direction, -1 for that of
// `style()`; its attributes, classes, functions of its click and of a drag
// from it, children, line), a text (its attributes, classes, content, line), a component, the
// child of an `<each>` for each element of a sequence (the function of the
// sequence, its child), an image (its file, its width and height)
// (`TCode(doc, scroll, line)`: the document of the path `doc` (a text, an
// expression), in the box that scrolls `scroll`)
export type Tpl = TBox(i64, Prop[], i64[], i64, i64, Tpl[], i64) | TText(Prop[], i64[], Val, i64) | TComp(Comp) | TEach(i64, Tpl[], i64) | TImage(Val, Prop[], i64) | TCode(Val, i64, i64);

// what reading the view makes: the code of Lua of its expressions and
// handlers (the table of their functions), their number, the globals of
// its fields, its faults
type G = { file: string, classes: string[], code: string, line: i64, n: i64, binds: string[], faults: string[], images: string[] };

function fault(g: G, line: i64, m: string): G {
    return { ...g, faults: concat(g.faults, [`${g.file}:${line}: ${m}`]) };
}

// a string of Lua holding `s`
function luaQuoted(s: string): string {
    return "\"" + join(split(join(split(join(split(s, "\\"), "\\\\"), "\""), "\\\""), "\n"), "\\n") + "\"";
}

// a function of Lua added to the table of the view, at the line `line` of
// its file (the lines of the chunk those of the file): its number
function addFn(g: G, scope: string[n], body: string, line: i64): [G, i64] {
    // (`join` of k+1 empty parts: k newlines; one more for the k-th line)
    const nl = line > g.line ? join(fill(line - g.line + 1, ""), "\n") : "";
    const code = `${g.code}${nl}F[${g.n + 1}] = function(${join(scope, ", ")}) ${body} end `;
    return [{ ...g, code: code, line: max(g.line, line), n: g.n + 1 }, g.n] as const;
}

// `s` is an expression `{...}`
function isExpr(s: string): boolean {
    return s.startsWith("{") && s.endsWith("}");
}

// the expression of Lua of a text with `{...}` in it: the parts as they
// are, the expressions by their `tostring`, joined by `..`
function templateCode(s: string): string {
    const parts = split(s, "{");
    const first: string[] = parts[0] == "" ? [] : [luaQuoted(parts[0])];
    const rest: string[] = map(iota(parts.length - 1), (i) => {
        const p = parts[i + 1];
        const close = p.indexOf("}");
        const e = close < 0 ? p : p.slice(0, close);
        const after = close < 0 ? "" : p.slice(close + 1, p.length);
        return after == "" ? `tostring(${e})` : `tostring(${e}) .. ${luaQuoted(after)}`;
    });
    const all = concat(first, rest);
    return all.length == 0 ? "\"\"" : join(all, " .. ");
}

// the text of the children `kids` (texts trimmed, joined by a space)
function rawText(kids: Node[n]): string {
    return join(filter(map(kids, (k) => match (k) {
        Text(t, line) => t.trim(),
        Tag(name, attrs, cs, line) => "",
    }), (x) => x != ""), " ");
}

// the value of a text: as written, or the function of its template
function textVal(g: G, scope: string[n], s: string, line: i64): [G, Val] {
    if (s.indexOf("{") < 0) {
        return [g, Lit(PText(s))] as const;
    }
    const [g1, f] = addFn(g, scope, `return ${templateCode(s)}`, line);
    return [g1, Fn(f)] as const;
}

// the value of the attribute `name` = `v` of the kind `kind`, or a fault
function valOf(g: G, scope: string[n], name: string, kind: i64, v: string, line: i64): [G, Val] {
    if (isExpr(v)) {
        const [g1, f] = addFn(g, scope, `return (${v.slice(1, v.length - 1)})`, line);
        return [g1, Fn(f)] as const;
    }
    const pv = valueIn(kind, v);
    return match (pv) {
        PNone => [fault(g, line, `\`${v}\` is not a value of \`${name}\` (${kindName(kind)})`), Lit(PNone)] as const,
        _ => [g, Lit(pv)] as const,
    };
}

// a handler (Lua run, its statements `code`): its function, -1 when there
// is none
function handlerOf(g: G, scope: string[n], attrs: Attr[m], name: string, line: i64): [G, i64] {
    if (!has(attrs, name)) {
        return [g, -1] as const;
    }
    return addFn(g, scope, attr(attrs, name), line);
}

// the classes of the attribute `class`, their numbers, or a fault
function classesOf(g: G, attrs: Attr[n], line: i64): [G, i64[]] {
    const names = filter(map(split(attr(attrs, "class"), " "), (x) => x.trim()), (x) => x != "");
    const unknown = filter(names, (x) => findIndex(g.classes, (c) => c == x) < 0);
    if (unknown.length > 0) {
        return [fault(g, line, `the class \`${unknown[0]}\` is not in the styles`), []] as const;
    }
    return [g, map(names, (x) => findIndex(g.classes, (c) => c == x))] as const;
}

// the attributes `attrs` among `names` (of the kinds `kinds`) as props
function propsOf(g: G, scope: string[n], attrs: Attr[m], names: string[k], kinds: i64[k], line: i64): [G, Prop[]] {
    return propsFrom(g, scope, attrs, names, kinds, line, 0, []);
}

function propsFrom(g: G, scope: string[n], attrs: Attr[m], names: string[k], kinds: i64[k], line: i64, i: i64, acc: Prop[]): [G, Prop[]] {
    if (i >= m) {
        return [g, acc] as const;
    }
    const k = findIndex(names, (x) => x == attrs[i].name);
    if (k < 0) {
        return propsFrom(g, scope, attrs, names, kinds, line, i + 1, acc);
    }
    const [g1, v] = valOf(g, scope, attrs[i].name, kinds[k], attrs[i].value, line);
    return propsFrom(g1, scope, attrs, names, kinds, line, i + 1, concat(acc, [{ k: k, v: v }]));
}

// an attribute of `attrs` not among `known`: a fault
function onlyAttrs(g: G, attrs: Attr[n], what: string, known: string[m], line: i64): G {
    const strange = filter(attrs, (a) => findIndex(known, (x) => x == a.name) < 0);
    return strange.length > 0 ? fault(g, line, `the attribute \`${strange[0].name}\` is unknown for ${what} (${join(known, ", ")})`) : g;
}

// the template of the element `n` (its loops' names `scope`)
function tplOf(g: G, scope: string[n], node: Node): [G, Tpl[]] {
    return match (node) {
        Text(t, line) => [fault(g, line, "a text outside <text> or a component"), []] as const,
        Tag(name, attrs, kids, line) => tagTpl(g, scope, name, attrs, kids, line),
    };
}

function tagTpl(g: G, scope: string[n], name: string, attrs: Attr[m], kids: Node[k], line: i64): [G, Tpl[]] {
    if (name == "box" || name == "row" || name == "column") {
        const dir = name == "row" ? 1 : (name == "column" ? 2 : -1);
        const g0 = onlyAttrs(g, attrs, "a box", concat(BOX_PROPS, ["class", "onclick", "ondrag"]), line);
        const [g1, cs] = classesOf(g0, attrs, line);
        const [g2, ps] = propsOf(g1, scope, attrs, BOX_PROPS, BOX_KINDS, line);
        const [g3, click] = handlerOf(g2, scope, attrs, "onclick", line);
        // (a drag: `dx` and `dy` the pointer moved since the press)
        const [g3a, drag] = handlerOf(g3, concat(scope, ["dx", "dy"]), attrs, "ondrag", line);
        const [g4, ts] = kidsTpl(g3a, scope, kids, 0, []);
        return [g4, [TBox(dir, ps, cs, click, drag, ts, line)]] as const;
    }
    if (name == "text") {
        const g0 = onlyAttrs(g, attrs, "<text>", ["size", "color", "textAlign", "font", "class"], line);
        const [g1, cs] = classesOf(g0, attrs, line);
        const [g2, ps] = propsOf(g1, scope, attrs, TEXT_PROPS, TEXT_KINDS, line);
        const [g3, t] = textVal(g2, scope, rawText(kids), line);
        return [g3, [TText(ps, cs, t, line)]] as const;
    }
    if (name == "image") {
        // (its file read when the view is: one given by an expression is
        // among those of `images` of the view)
        const g0 = onlyAttrs(g, attrs, "<image>", ["src", "width", "height"], line);
        const src = attr(attrs, "src");
        if (src == "") {
            return [fault(g0, line, "<image> needs src=\"a file of PNG\""), []] as const;
        }
        const g1 = src.indexOf("{") >= 0 || findIndex(g0.images, (x) => x == src) >= 0 ? g0 : { ...g0, images: concat(g0.images, [src]) };
        const [g2, v] = textVal(g1, scope, isExpr(src) ? `{${src.slice(1, src.length - 1)}}` : src, line);
        const [g3, ps] = propsOf(g2, scope, attrs, ["src", "width", "height"], [KIND_TEXT, KIND_F32, KIND_F32], line);
        return [g3, [TImage(v, filter(ps, (p) => p.k > 0), line)]] as const;
    }
    if (name == "each") {
        return eachTpl(g, scope, attrs, kids, line);
    }
    if (name == "code") {
        // (the document the host keeps for the path `doc`: its lines in sight,
        // the box that scrolls it `scroll`)
        const g0 = onlyAttrs(g, attrs, "<code>", ["doc", "scroll"], line);
        const d = attr(attrs, "doc");
        if (d == "") {
            return [fault(g0, line, "<code> needs doc=\"{the path of a document}\""), []] as const;
        }
        const [g1, v] = textVal(g0, scope, d, line);
        const sc = match (tryParseI64(attr(attrs, "scroll"))) {
            Ok(x) => x,
            Err(e) => -1,
        };
        return [g1, [TCode(v, sc, line)]] as const;
    }
    const kind = findIndex(COMP_TAGS, (x) => x == name);
    if (kind < 0) {
        return [fault(g, line, `the element <${name}> is unknown (box, row, column, text, image, button, iconbutton, field, checkbox, toggle, progress, each)`), []] as const;
    }
    return compTpl(g, scope, kind, name, attrs, kids, line);
}

// the arguments each component takes
function argsKnown(kind: i64): string[] {
    return kind == C_BUTTON ? ["primary", "width", "onclick"] : (kind == C_ICON ? ["danger", "onclick"]
        : (kind == C_FIELD ? ["hint", "width", "bind", "onenter", "onchange", "autofocus"] : (kind == C_CHECK ? ["checked", "onclick"]
        : (kind == C_TOGGLE ? ["on", "at", "onclick"] : ["value", "width"]))));
}

function compTpl(g: G, scope: string[n], kind: i64, name: string, attrs: Attr[m], kids: Node[k], line: i64): [G, Tpl[]] {
    const known = concat(argsKnown(kind), ["class"]);
    const g0 = onlyAttrs(g, attrs, `<${name}>`, known, line);
    const [g1, cs] = classesOf(g0, attrs, line);
    // (the width of a progress bar a number of pixels)
    const kinds = map(ARG_NAMES, (x) => kind == C_PROGRESS && x == "width" ? KIND_F32 : ARG_KINDS[findIndex(ARG_NAMES, (y) => y == x)]);
    const [g2, ps] = propsOf(g1, scope, filter(attrs, (a) => findIndex(known, (x) => x == a.name) >= 0), ARG_NAMES, kinds, line);
    const [g3, label] = textVal(g2, scope, rawText(kids), line);
    const [g4, click] = handlerOf(g3, scope, attrs, "onclick", line);
    const [g5, enter] = handlerOf(g4, scope, attrs, "onenter", line);
    const [g6, change] = handlerOf(g5, scope, attrs, "onchange", line);
    const bindName = attr(attrs, "bind");
    const g7 = kind == C_FIELD && bindName == "" ? fault(g6, line, "<field> needs bind=\"a global of Lua\"") : g6;
    const at = findIndex(g7.binds, (x) => x == bindName);
    const g8 = kind != C_FIELD || at >= 0 ? g7 : { ...g7, binds: concat(g7.binds, [bindName]) };
    const bind = kind != C_FIELD ? -1 : (at >= 0 ? at : g8.binds.length - 1);
    return [g8, [TComp({ kind: kind, args: ps, classes: cs, label: label, click: click, enter: enter, change: change, bind: bind, line: line })]] as const;
}

// <each items="{t}" as="x" index="k">: its one child for each element of
// the sequence `t`
function eachTpl(g: G, scope: string[n], attrs: Attr[m], kids: Node[k], line: i64): [G, Tpl[]] {
    const g0 = onlyAttrs(g, attrs, "<each>", ["items", "as", "index"], line);
    const items = attr(attrs, "items");
    if (!isExpr(items)) {
        return [fault(g0, line, "<each> needs items=\"{a sequence}\""), []] as const;
    }
    const tags = filter(kids, (k) => match (k) {
        Tag(name, a, c, l) => true,
        Text(t, l) => false,
    });
    if (tags.length != 1) {
        return [fault(g0, line, `<each> holds one element (it has ${tags.length})`), []] as const;
    }
    const [g1, f] = addFn(g0, scope, `return (${items.slice(1, items.length - 1)})`, line);
    const inner = concat(scope, [has(attrs, "as") ? attr(attrs, "as") : "item", has(attrs, "index") ? attr(attrs, "index") : "index"]);
    const [g2, t] = tplOf(g1, inner, tags[0]);
    return [g2, [TEach(f, t, line)]] as const;
}

function kidsTpl(g: G, scope: string[n], kids: Node[m], i: i64, acc: Tpl[]): [G, Tpl[]] {
    if (i >= m) {
        return [g, acc] as const;
    }
    return match (kids[i]) {
        Text(t, line) => kidsTpl(fault(g, line, "a text in a box (in <text> it is shown)"), scope, kids, i + 1, acc),
        Tag(name, attrs, cs, line) => {
            const [g1, ts] = tplOf(g, scope, kids[i]);
            return kidsTpl(g1, scope, kids, i + 1, concat(acc, ts));
        },
    };
}

// the kind of the property `name` of a class (-1: unknown)
function propKind(name: string): i64 {
    const kb = findIndex(BOX_PROPS, (x) => x == name);
    const kt = findIndex(TEXT_PROPS, (x) => x == name);
    return kb >= 0 ? BOX_KINDS[kb] : (kt >= 0 ? TEXT_KINDS[kt] : -1);
}

function classOf(r: Rule): Cls {
    const box = map(filter(r.props, (p) => findIndex(BOX_PROPS, (x) => x == p.name) >= 0), (p) => {
        const k = findIndex(BOX_PROPS, (x) => x == p.name);
        return { k: k, v: valueIn(BOX_KINDS[k], p.value) };
    });
    const text = map(filter(r.props, (p) => findIndex(TEXT_PROPS, (x) => x == p.name) >= 0 && findIndex(BOX_PROPS, (x) => x == p.name) < 0), (p) => {
        const k = findIndex(TEXT_PROPS, (x) => x == p.name);
        return { k: k, v: valueIn(TEXT_KINDS[k], p.value) };
    });
    return { name: r.name, box: box, text: text };
}

// the faults of the properties of the rules from `i`: a property unknown,
// a value that is not one of its property
function faultsIn(file: string, rs: Rule[n], i: i64, acc: string[]): string[] {
    if (i >= n) {
        return acc;
    }
    const mine = map(filter(rs[i].props, (p) => propKind(p.name) < 0 || isNone(valueIn(propKind(p.name), p.value))), (p) => propKind(p.name) < 0
        ? `${file}:${p.line}: the property \`${p.name}\` is unknown (${join(concat(BOX_PROPS, TEXT_PROPS), ", ")})`
        : `${file}:${p.line}: \`${p.value}\` is not a value of \`${p.name}\` (${kindName(propKind(p.name))})`);
    return faultsIn(file, rs, i + 1, concat(acc, mine));
}

function isNone(v: PV): boolean {
    return match (v) {
        PNone => true,
        _ => false,
    };
}

// ----- the application ---------------------------------------------------

// a place of the view that answers: a box (the focus taken from a field), a
// component, or a field (its global); its functions; the values of its
// loops
export type H = { kind: i64, click: i64, drag: i64, enter: i64, change: i64, bind: i64, args: V[] };

// no place (a press outside every place)
function noPlace(): H {
    return { kind: -1, click: -1, drag: -1, enter: -1, change: -1, bind: -1, args: [] };
}

const H_BOX: i64 = 0;
const H_COMP: i64 = 1;
const H_FIELD: i64 = 2;
// (a line of a document: `bind` its line, `change` the document)
const H_CODE: i64 = 3;
// (a part of the editor of a document: the widget of its search, its map,
// its bar across; `bind` its number, `change` the document)
const H_PART: i64 = 4;
const PARTS: i64 = 22;

// the application: its machine of Lua, the file of its view, its template,
// its classes, the globals of its fields and their editing, the elements
// made, its places (their messages their numbers), the field with the
// focus (its number among the binds), the place under the pointer and the
// one pressed, the error of the last input, its window, the function run
// when it is closed, the one given the keys (`onkey`), the fields made the
// last time, the place pressed; the values Lua gave the last time the
// elements were made by calling it, its error then, and whether Lua ran
// since (if not, the elements are made again from those values: a
// pointer that moves over the view runs no Lua)
export type App = {
    vm: lua.Vm, cx: Cx, tpl: Tpl[], eds: Editing[], tree: Element, hs: H[],
    focus: i64, hover: i64, pressed: i64, err: string, title: string, width: i64, height: i64, resizable: boolean, minimizable: boolean, maximizable: boolean, drawn: boolean, menu: string[], close: i64,
    // the function run when the window asks to close (-1: none)
    beforeClose: i64,
    key: i64, seen: boolean[], pressX: f32, pressY: f32,
    // the place pressed as it was when it was pressed (none: kind -1): a
    // drag goes to it, though the places are numbered again as the view is
    // made again (the rows of code in sight, more or fewer as it scrolls)
    held: H,
    memo: V[], memoErr: string, luaRan: boolean,
    // the documents the host keeps (`host.openDoc`), whether the keyboard
    // goes to the one shown, whether the window is active, the width of a
    // column of the font of fixed width; the document shown and the box
    // that scrolls it
    docs: Doc[], codeFocus: boolean, active: boolean, advance: f32, shownPath: string, shownScroll: i64,
    // the size of the box of the documents (each made laid out at it)
    codeWidth: f32, codeHeight: f32,
    // the pixels of a unit of the screen (`Density`)
    ratio: f32,
    // the files asked by `host.openFile` not read yet: their documents made
    // by the host when they are
    fileReads: string[],
};

// what making the elements reads: the file of the view, its classes, the
// globals of its fields, its images and the names of their files
export type Cx = { file: string, classes: Cls[], binds: string[], pics: Picture[], names: string[] };

// what the scripts are given before they run: `host.readFile(path, done)`
// and `host.listFolder(path, done)` ask a file or a folder, read after the
// input that asked them (when the view is read, at once); `done` is then
// called with the text of the file or the sequence of the names in the
// folder (those of folders ending with `/`), or with nil and the reason;
// `host.folder` is the folder of the view; `host.offsets[k + 1]` and
// `host.heights[k + 1]` the offset of the box that scrolls `scroll="k"` and
// the height it may show (the window's), told when they change (a long
// list then makes the rows in sight alone); `host.width` and `host.height`
// the size of the inside of the window in units (a bar laid out after it);
// `host.active` whether the window is the one the keyboard goes to
const HOST_LUA: string = join([
    "host = { requests = {}, pending = {}, offsets = {}, heights = {}, maximized = false, width = 0, height = 0, active = true, docs = {} }",
    "function host.openDoc(path, text)",
    "  host.requests[#host.requests + 1] = { \"doc\", path, text }",
    "end",
    "function host.closeDoc(path)",
    "  host.requests[#host.requests + 1] = { \"closedoc\", path }",
    "end",
    "function host.save(path)",
    "  host.requests[#host.requests + 1] = { \"save\", path }",
    "end",
    "function host.saveAs(path, to)",
    "  host.requests[#host.requests + 1] = { \"saveas\", path, to }",
    "end",
    "function host.focusCode()",
    "  host.requests[#host.requests + 1] = { \"focus\", \"\" }",
    "end",
    "function host.blurCode()",
    "  host.requests[#host.requests + 1] = { \"blur\", \"\" }",
    "end",
    "function host.minimize()",
    "  host.requests[#host.requests + 1] = { \"min\", \"\" }",
    "end",
    "function host.toggleMaximized()",
    "  host.requests[#host.requests + 1] = { \"max\", \"\" }",
    "end",
    "function host.close()",
    "  host.requests[#host.requests + 1] = { \"close\", \"\" }",
    "end",
    "function host.readFile(path, done)",
    "  host.requests[#host.requests + 1] = { \"read\", path, done }",
    "end",
    "function host.openFile(path, done)",
    "  host.requests[#host.requests + 1] = { \"openfile\", path, done }",
    "end",
    "function host.listFolder(path, done)",
    "  host.requests[#host.requests + 1] = { \"list\", path, done }",
    "end",
    "function host.take()",
    "  local out = {}",
    "  for _, r in ipairs(host.requests) do",
    "    out[#out + 1] = r[1]",
    "    out[#out + 1] = r[2]",
    "    out[#out + 1] = (r[1] == \"doc\" or r[1] == \"saveas\") and r[3] or \"\"",
    "    if r[1] == \"read\" or r[1] == \"list\" or r[1] == \"openfile\" then",
    "      host.pending[#host.pending + 1] = r[3]",
    "    end",
    "  end",
    "  host.requests = {}",
    "  return out",
    "end",
    "function host.deliver(result, err)",
    "  local done = table.remove(host.pending, 1)",
    "  if done then",
    "    done(result, err)",
    "  end",
    "end",
    ""
], "\n");

// the global that keeps the table of the functions of the view
const REG: string = "__isocron_view";

// the folder of the file `path` (with its separator)
function folderOf(path: string): string {
    const k = max(path.lastIndexOf("/"), path.lastIndexOf("\\"));
    return k < 0 ? "" : path.slice(0, k + 1);
}

function namesIn(s: string, sep: string): string[] {
    return filter(map(split(s, sep), (x) => x.trim()), (x) => x != "");
}

// the styles of the files `paths`: their classes, or the faults
action stylesIn(paths: string[n], i: i64, acc: Rule[], faults: string[]): [Rule[], string[]] {
    if (i >= n) {
        return [acc, faults] as const;
    }
    return match (sys.readText(paths[i])) {
        Err(e) => stylesIn(paths, i + 1, acc, concat(faults, [`${paths[i]}: ${sys.message(e)}`])),
        Ok(t) => match (parseStyles(t)) {
            Bad(m, line) => stylesIn(paths, i + 1, acc, concat(faults, [`${paths[i]}:${line}: ${m}`])),
            Sheet(rs) => stylesIn(paths, i + 1, concat(acc, rs), concat(faults, faultsIn(paths[i], rs, 0, []))),
        },
    };
}

// the images of the files `names` (beside the view, in the folder `dir`)
// read, or the faults
action picturesIn(dir: string, names: string[n], i: i64, acc: Picture[], faults: string[]): [Picture[], string[]] {
    if (i >= n) {
        return [acc, faults] as const;
    }
    const empty = { width: 0, height: 0, pixels: [] };
    return match (sys.readFile(dir + names[i])) {
        Err(e) => picturesIn(dir, names, i + 1, concat(acc, [empty]), concat(faults, [`${dir}${names[i]}: ${sys.message(e)}`])),
        Ok(b) => match (decode(b)) {
            Ok(pic) => picturesIn(dir, names, i + 1, concat(acc, [pic]), faults),
            Err(m) => picturesIn(dir, names, i + 1, concat(acc, [empty]), concat(faults, [`${dir}${names[i]}: ${m}`])),
        },
    };
}

// the scripts of the files `paths` run in the machine `vm` in their order
action scriptsRun(vm: lua.Vm, paths: string[n], i: i64): Result<lua.Vm, string> {
    if (i >= n) {
        return Ok(vm);
    }
    return match (sys.readText(paths[i])) {
        Err(e) => Err(`${paths[i]}: ${sys.message(e)}`),
        Ok(src) => {
            const [v1, f] = lua.load(vm, src, paths[i]);
            if (lua.failed(v1)) {
                return Err(lua.errorText(v1));
            }
            const [v2, rs] = lua.call(v1, f, []);
            if (lua.failed(v2)) {
                return Err(lua.errorText(v2));
            }
            return scriptsRun(v2, paths, i + 1);
        },
    };
}

// the application of the view in the file `path`: its styles and scripts
// read, its expressions made functions of Lua, its first elements made;
// the faults of its files otherwise (each at its file and line)
export action load(path: string): Result<App, string> {
    return match (sys.readFile(path)) {
        Err(e) => Err(`${path}: ${sys.message(e)}`),
        Ok(text) => match (parse(text)) {
            Fault(m, line) => Err(`${path}:${line}: ${m}`),
            Read(root) => match (root) {
                Text(t, line) => Err(`${path}:${line}: <view> expected`),
                Tag(rname, rattrs, rkids, rline) => rname != "view" ? Err(`${path}:${rline}: the root is <view>, not <${rname}>`) : loaded(path, rattrs, rkids, rline),
            },
        },
    };
}

action loaded(path: string, rattrs: Attr[n], rkids: Node[m], rline: i64): Result<App, string> {
    const dir = folderOf(path);
    const [rules, sfaults] = stylesIn(map(namesIn(attr(rattrs, "styles"), " "), (x) => dir + x), 0, [], []);
    // (a class with states and no rule of its own: an empty one)
    const read = map(rules, (r) => classOf(r));
    const bases = map(filter(read, (c) => c.name.indexOf(":") >= 0), (c) => c.name.slice(0, c.name.indexOf(":")));
    const classes = concat(read, map(filter(bases, (x) => findIndex(read, (c) => c.name == x) < 0), (x) => ({ name: x, box: [], text: [] })));
    const known = ["title", "width", "height", "resizable", "minimizable", "maximizable", "titlebar", "styles", "script", "menu", "onclose", "onbeforeclose", "onkey", "images"];
    const g0 = onlyAttrs({ file: path, classes: map(classes, (c) => c.name), code: "local F = {} ", line: 1, n: 0, binds: [], faults: [], images: namesIn(attr(rattrs, "images"), " ") }, rattrs, "<view>", known, rline);
    const tags = filter(rkids, (k) => match (k) {
        Tag(name, a, c, l) => true,
        Text(t, l) => false,
    });
    const [g1, ts] = tags.length == 1 ? tplOf(g0, [], tags[0]) : [fault(g0, rline, `<view> holds one element (it has ${tags.length})`), []] as const;
    const [g2a, close] = handlerOf(g1, [], rattrs, "onclose", rline);
    const [g2b, key] = handlerOf(g2a, ["key", "ctrl", "shift", "alt"], rattrs, "onkey", rline);
    const [g2, beforeClose] = handlerOf(g2b, [], rattrs, "onbeforeclose", rline);
    const [pics, ifaults] = picturesIn(dir, g2.images, 0, [], []);
    // the buttons of the window (D669 of isocron): `true` (by default) or
    // `false`
    const flags = ["resizable", "minimizable", "maximizable"];
    const ffaults = map(filter(flags, (k) => has(rattrs, k) && attr(rattrs, k) != "true" && attr(rattrs, k) != "false"), (k) => `${path}:${rline}: <view ${k}="${attr(rattrs, k)}">: true or false`);
    // the title of the window: the system's (by default) or drawn by the view
    const tfaults = has(rattrs, "titlebar") && attr(rattrs, "titlebar") != "custom" && attr(rattrs, "titlebar") != "system" ? [`${path}:${rline}: <view titlebar="${attr(rattrs, "titlebar")}">: custom or system`] : [];
    const faults = concat(concat(concat(concat(sfaults, g2.faults), ifaults), ffaults), tfaults);
    if (faults.length > 0 || ts.length != 1) {
        return Err(join(faults, "\n"));
    }
    // (`host.folder`: the folder of the view, without its last separator,
    // "." for the current one)
    const folder = dir == "" ? "." : dir.slice(0, dir.length - 1);
    const quoted = join(split(join(split(folder, "\\"), "\\\\"), "\""), "\\\"");
    // (`host.width`, `host.height`: the size the view asks until the window
    // tells its own)
    const startW = match (tryParseI64(attr(rattrs, "width"))) {
        Ok(x) => x,
        Err(e) => 480,
    };
    const startH = match (tryParseI64(attr(rattrs, "height"))) {
        Ok(x) => x,
        Err(e) => 400,
    };
    // (`host.system`: "windows", "linux", ...: the glyphs of the buttons
    // of a window drawn by the view, those of the system's)
    // (`host.cwd`: the current folder, whose name a view shows for ".")
    const cwd = match (sys.cwd()) {
        Ok(c) => join(split(join(split(c, "\\"), "\\\\"), "\""), "\\\""),
        Err(e) => ".",
    };
    const [h0, hf] = lua.load(lua.newVm(), `${HOST_LUA}\nhost.folder = "${quoted}"\nhost.width = ${startW}\nhost.height = ${startH}\nhost.system = "${sys.platform()}"\nhost.cwd = "${cwd}"`, "host");
    const [h1, hr] = lua.call(h0, hf, []);
    const ran = scriptsRun(h1, map(namesIn(attr(rattrs, "script"), " "), (x) => dir + x), 0);
    return match (ran) {
        Err(e) => Err(e),
        Ok(v0) => {
            const [v1, f] = lua.load(v0, g2.code + "\nreturn F", path);
            if (lua.failed(v1)) {
                return Err(lua.errorText(v1));
            }
            const [v2, rs] = lua.call(v1, f, []);
            if (lua.failed(v2) || rs.length == 0) {
                return Err(lua.failed(v2) ? lua.errorText(v2) : `${path}: the functions of the view not made`);
            }
            const v3 = lua.setGlobal(v2, REG, rs[0]);
            const dim = (name: string, d: i64) => match (tryParseI64(attr(rattrs, name))) {
                Ok(x) => x,
                Err(e) => d,
            };
            const menu = has(rattrs, "menu") ? namesIn(attr(rattrs, "menu"), ",") : ["Couper", "Copier", "Coller", "Tout sélectionner"];
            const a = {
                vm: v3, cx: { file: path, classes: classes, binds: g2.binds, pics: pics, names: g2.images }, tpl: ts, eds: map(g2.binds, (b) => editing("")), tree: Div(style(), []), hs: [],
                focus: -1, hover: -1, pressed: -1, err: "", title: has(rattrs, "title") ? attr(rattrs, "title") : "Isocron", width: dim("width", 480), height: dim("height", 400),
                resizable: attr(rattrs, "resizable") != "false", minimizable: attr(rattrs, "minimizable") != "false", maximizable: attr(rattrs, "maximizable") != "false",
                drawn: attr(rattrs, "titlebar") == "custom", menu: menu, close: close, beforeClose: beforeClose,
                key: key, seen: map(g2.binds, (x) => false), pressX: 0.0f32, pressY: 0.0f32, held: noPlace(),
                memo: [], memoErr: "", luaRan: true,
                docs: [], codeFocus: false, active: true, advance: 7.7f32, shownPath: "", shownScroll: -1, codeWidth: 0.0f32, codeHeight: 0.0f32, ratio: 1.0f32, fileReads: [],
            };
            return Ok(rebuilt(filesAtOnce(a)));
        },
    };
}

// the files and folders the scripts asked read at once (when the view is
// read), each given to its function, until they ask none
action filesAtOnce(a: App): App {
    const [a1, fx] = requested(a);
    return fx.length == 0 ? a1 : filesAtOnce(answeredAll(a1, fx, 0));
}

action answeredAll(a: App, fx: Effect[n], k: i64): App {
    return k >= n ? a : answeredAll(delivered(a, answerOf(fx[k])), fx, k + 1);
}

// the answer to the effect `e` (a file read, a folder listed)
action answerOf(e: Effect): HandInput {
    return match (e) {
        ReadText(p) => match (sys.readText(p)) {
            Ok(t) => TextRead(p, t, true),
            Err(x) => TextRead(p, sys.message(x), false),
        },
        ListFolder(p) => match (sys.listDir(p)) {
            Ok(names) => {
                const sep = p.endsWith("/") || p.endsWith("\\") || p == "" ? "" : "/";
                return FolderListed(p, map(names, (x) => sys.isDir(p + sep + x) ? x + "/" : x), true);
            },
            Err(x) => FolderListed(p, [sys.message(x)], false),
        },
        _ => TextRead("", "", false),
    };
}

// the files and folders the scripts asked (`host.readFile`,
// `host.listFolder` since the last time): the effects that ask them
// (not inlined: the application given whole, its machine moved, not
// copied, into the call)
@noInline
function requested(a: App): [App, Effect[]] {
    const host = lua.global(a.vm, "host");
    const take = lua.fieldOf(a.vm, host, "take");
    // (the collector held: the values kept for the next elements stay
    // where they are)
    const [v0, rs] = lua.call(lua.held(a.vm, 1), take, []);
    const v1 = lua.held(v0, -1);
    if (lua.failed(v1) || rs.length == 0) {
        return [{ ...a, vm: lua.failed(v1) ? lua.recover(v1) : v1 }, []] as const;
    }
    const t = rs[0];
    const n = lua.sequenceLength(v1, t) / 3;
    const kinds = map(iota(n), (k) => lua.plainText(v1, lua.element(v1, t, 3 * k + 1)));
    const paths = map(iota(n), (k) => lua.plainText(v1, lua.element(v1, t, 3 * k + 2)));
    const texts = map(iota(n), (k) => lua.plainText(v1, lua.element(v1, t, 3 * k + 3)));
    // (the documents opened, closed, the focus given to the code)
    // (each request in its order: a document saved under another path,
    // then closed, written before it is closed)
    return requestsDone({ ...a, vm: v1 }, kinds, paths, texts, 0, []);
}

// the effects of the requests of the scripts: a file or a folder read, the
// window minimized, maximized, closed, a document written
// (a document saved under another path: renamed, then written there)
function requestsDone(a: App, kinds: string[n], paths: string[n], texts: string[n], k: i64, out: Effect[]): [App, Effect[]] {
    if (k >= n) {
        return [a, out] as const;
    }
    const a0 = kinds[k] == "openfile" ? { ...a, fileReads: concat(a.fileReads, [paths[k]]) } : a;
    const a1 = docAsked(a0, kinds, paths, texts, k);
    const kind = kinds[k];
    const path = kind == "saveas" ? texts[k] : paths[k];
    const di = findIndex(a1.docs, (d) => d.path == path);
    const fx: Effect[] = kind == "read" || kind == "openfile" ? [ReadText(path)] : (kind == "list" ? [ListFolder(path)] : (kind == "min" ? [Minimize] : (kind == "max" ? [ToggleMaximized]
        : (kind == "close" ? [CloseWindow] : ((kind == "save" || kind == "saveas") && di >= 0 ? [WriteText(path, textOf(a1.docs[di]))] : [])))));
    return requestsDone(a1, kinds, paths, texts, k + 1, concat(out, fx));
}

// the document asked by the `k`-th request of the scripts: opened (`doc`:
// made of its text, kept when it is open already), closed, saved under
// another path, the focus given to the code or taken
function docAsked(a: App, kinds: string[n], paths: string[n], texts: string[n], k: i64): App {
    const kind = kinds[k];
    const path = paths[k];
    const open = findIndex(a.docs, (d) => d.path == path) >= 0;
    const a1 = kind == "doc" && !open ? { ...a, docs: concat(a.docs, [ratioSet(docOf(path, texts[k]), a.ratio, a.codeWidth, a.codeHeight, a.advance)]) }
        : (kind == "closedoc" ? { ...a, docs: filter(a.docs, (d) => d.path != path) }
        : (kind == "saveas" ? { ...a, docs: map(a.docs, (d) => d.path == path ? renamed(d, texts[k]) : d), shownPath: a.shownPath == path ? texts[k] : a.shownPath }
        : (kind == "focus" ? { ...a, codeFocus: true, focus: -1 } : (kind == "blur" ? { ...a, codeFocus: false } : a))));
    return a1;
}

// the offset and the height of the box that scrolls `k` set in Lua
// (`host.offsets[k + 1]`, `host.heights[k + 1]`)
function viewported(a: App, k: i64, offset: f32, height: f32): App {
    const host = lua.global(a.vm, "host");
    const offs = lua.fieldOf(a.vm, host, "offsets");
    const hs = lua.fieldOf(a.vm, host, "heights");
    if (offs.t != T_TAB || hs.t != T_TAB) {
        return a;
    }
    const v1 = lua.rawSet(a.vm, offs.i, lua.integerValue(k + 1), lua.floatValue(f64(offset)));
    const v2 = lua.rawSet(v1, hs.i, lua.integerValue(k + 1), lua.floatValue(f64(height)));
    return { ...a, vm: v2, luaRan: true };
}

// `host.width` and `host.height` set to `w` and `h`: the size of the
// inside of the window in units
function sizeSet(a: App, w: f32, h: f32): App {
    const host = lua.global(a.vm, "host");
    if (host.t != T_TAB) {
        return a;
    }
    const [v1, kw] = lua.stringV(a.vm, "width");
    const [v2, kh] = lua.stringV(v1, "height");
    const v3 = lua.rawSet(v2, host.i, kw, lua.floatValue(f64(w)));
    return { ...a, vm: lua.rawSet(v3, host.i, kh, lua.floatValue(f64(h))), luaRan: true };
}

// the flag `name` of `host` set to `z` (`active`: the window the keyboard
// goes to)
function flagSet(a: App, name: string, z: boolean): App {
    const host = lua.global(a.vm, "host");
    if (host.t != T_TAB) {
        return a;
    }
    const [v1, key] = lua.stringV(a.vm, name);
    return { ...a, vm: lua.rawSet(v1, host.i, key, lua.booleanValue(z)), luaRan: true };
}

// `host.maximized` set to `z`: the window maximized or restored
function maximizedSet(a: App, z: boolean): App {
    const host = lua.global(a.vm, "host");
    if (host.t != T_TAB) {
        return a;
    }
    const [v1, key] = lua.stringV(a.vm, "maximized");
    return { ...a, vm: lua.rawSet(v1, host.i, key, lua.booleanValue(z)), luaRan: true };
}

// the answer `i` (a file read, a folder listed) given to the function that
// asked it
function delivered(a: App, i: HandInput): App {
    const host = lua.global(a.vm, "host");
    const deliver = lua.fieldOf(a.vm, host, "deliver");
    const [v1, args] = match (i) {
        TextRead(p, t, ok) => {
            const [w1, s] = lua.stringV(a.vm, t);
            return [w1, ok ? [s, lua.nilValue()] : [lua.nilValue(), s]] as const;
        },
        FolderListed(p, names, ok) => {
            if (!ok) {
                const [w1, s] = lua.stringV(a.vm, names.length > 0 ? names[0] : "");
                return [w1, [lua.nilValue(), s]] as const;
            }
            const [w1, tv] = lua.stringsTable(a.vm, names);
            return [w1, [tv, lua.nilValue()]] as const;
        },
        _ => [a.vm, [lua.nilValue(), lua.nilValue()]] as const,
    };
    const [v2, rs] = lua.call(v1, deliver, args);
    if (lua.failed(v2)) {
        const why = a.err == "" ? lua.errorText(v2) : a.err;
        return { ...a, vm: lua.recover(v2), err: why, luaRan: true };
    }
    return { ...a, vm: v2, luaRan: true };
}

// the file asked by `host.openFile` open: its `done` called with true
function deliveredOpen(a: App): App {
    const host = lua.global(a.vm, "host");
    const deliver = lua.fieldOf(a.vm, host, "deliver");
    const [v2, rs] = lua.call(a.vm, deliver, [lua.booleanValue(true), lua.nilValue()]);
    if (lua.failed(v2)) {
        const why = a.err == "" ? lua.errorText(v2) : a.err;
        return { ...a, vm: lua.recover(v2), err: why, luaRan: true };
    }
    return { ...a, vm: v2, luaRan: true };
}

// ----- the elements made -------------------------------------------------

// what making the elements carries: the machine (its collector held), the
// places made, the first error, the editing of the fields, the focus and
// the hand, the fields made the last time and those made now
// (`memo`: the values of Lua, given again in their order when `replay`,
// `at` the next; recorded otherwise)
type B = { vm: lua.Vm, hs: H[], err: string, eds: Editing[], focus: i64, hover: i64, pressed: i64, seen: boolean[], now: boolean[], memo: V[], replay: boolean, at: i64,
    docs: Doc[], codeFocus: boolean, advance: f32, shownPath: string, shownScroll: i64 };

// the function `f` of the view called with `args`: its first value (nil
// after an error, the first one kept)
function called(b: B, f: i64, args: V[n]): [B, V] {
    if (b.replay && b.at < b.memo.length) {
        const kept = b.memo[b.at];
        return [{ ...b, at: b.at + 1 }, kept] as const;
    }
    const fns = lua.global(b.vm, REG);
    const fv = lua.element(b.vm, fns, f + 1);
    const [v1, rs] = lua.call(b.vm, fv, args);
    if (lua.failed(v1)) {
        const why = b.err == "" ? lua.errorText(v1) : b.err;
        return [{ ...b, vm: lua.recover(v1), err: why, memo: b.replay ? b.memo : concat(b.memo, [lua.nilValue()]), at: b.at + 1 }, lua.nilValue()] as const;
    }
    const r = rs.length > 0 ? rs[0] : lua.nilValue();
    return [{ ...b, vm: v1, memo: b.replay ? b.memo : concat(b.memo, [r]), at: b.at + 1 }, r] as const;
}

// the value of a property of the kind `kind` given by Lua (`v`), PNone
// when it is not one
function fromLua(vm: lua.Vm, kind: i64, v: V): PV {
    if (kind == KIND_BOOL) {
        return PBool(lua.truthy(v));
    }
    if (kind == KIND_TEXT) {
        return PText(lua.plainText(vm, v));
    }
    if (lua.isString(v)) {
        return valueIn(kind, lua.plainText(vm, v));
    }
    const x = lua.numberOf(vm, v);
    if (x != x) {
        return PNone;
    }
    if (kind == KIND_COLOR) {
        return PCol(rgb(u32(i64(x))));
    }
    if (kind == KIND_I64) {
        return PInt(i64(x));
    }
    if (kind == KIND_LENGTH) {
        return PLen(Px(f32(x)));
    }
    return kind == KIND_F32 ? PNum(f32(x)) : PNone;
}

// the value `val` of a property of the kind `kind` (`name`, at `line`)
function valued(b: B, file: string, name: string, kind: i64, val: Val, args: V[n], line: i64): [B, PV] {
    return match (val) {
        Lit(pv) => [b, pv] as const,
        Fn(f) => {
            const [b1, v] = called(b, f, args);
            const pv = fromLua(b1.vm, kind, v);
            return match (pv) {
                PNone => [{ ...b1, err: b1.err == "" ? `${file}:${line}: ${lua.plainText(b1.vm, v)} is not a value of \`${name}\` (${kindName(kind)})` : b1.err }, PNone] as const,
                _ => [b1, pv] as const,
            };
        },
    };
}

// the text of a value
function texted(b: B, val: Val, args: V[n]): [B, string] {
    return match (val) {
        Lit(pv) => [b, textOfPV(pv)] as const,
        Fn(f) => {
            const [b1, v] = called(b, f, args);
            const s = lua.plainText(b1.vm, v);
            return [b1, s] as const;
        },
    };
}

// the props `ps` of the names `names` (kinds `kinds`) applied by `set`
function applied<S>(b: B, file: string, s: S, ps: Prop[n], names: string[k], kinds: i64[k], args: V[m], line: i64, set: (S, i64, PV) => S): [B, S] {
    return fold(ps, [b, s], (acc, p) => {
        const [b1, s1] = acc;
        const [b2, pv] = valued(b1, file, names[p.k], kinds[p.k], p.v, args, line);
        return match (pv) {
            PNone => [b2, s1] as const,
            _ => [b2, set(s1, p.k, pv)] as const,
        };
    });
}

// a place added: its message
// the places of the parts of the editor of the document `di`, from the
// `k`-th
function placedParts(b: B, di: i64, k: i64, args: V[n]): B {
    if (k >= PARTS) {
        return b;
    }
    const [b1, id] = place(b, { kind: H_PART, click: -1, drag: -1, enter: -1, change: di, bind: k, args: args });
    return placedParts(b1, di, k + 1, args);
}

// the places of the lines `k` to `last` (excluded) of the document `di`
function placedLines(b: B, di: i64, k: i64, last: i64, args: V[n]): B {
    if (k >= last) {
        return b;
    }
    const [b1, id] = place(b, { kind: H_CODE, click: -1, drag: -1, enter: -1, change: di, bind: k, args: args });
    return placedLines(b1, di, k + 1, last, args);
}

function place(b: B, h: H): [B, i64] {
    const id = b.hs.length;
    return [{ ...b, hs: concat(b.hs, [h]) }, id] as const;
}

function handOf(b: B, id: i64): Hand {
    return { hovered: b.hover == id, pressed: b.pressed == id };
}

// the argument `k` (of ARG_NAMES) of a component, `d` when not given
function argOf(b: B, file: string, c: Comp, k: i64, kind: i64, d: PV, args: V[n]): [B, PV] {
    const at = findIndex(c.args, (p) => p.k == k);
    if (at < 0) {
        return [b, d] as const;
    }
    const [b1, pv] = valued(b, file, ARG_NAMES[k], kind, c.args[at].v, args, c.line);
    return match (pv) {
        PNone => [b1, d] as const,
        _ => [b1, pv] as const,
    };
}

// the elements of the template `t`, the values of its loops `args`
function made(b: B, cx: Cx, t: Tpl, args: V[m]): [B, Element[]] {
    return match (t) {
        TBox(dir, ps, cs, click, drag, kids, line) => {
            const base = dir == 1 ? { ...style(), direction: Row } : (dir == 2 ? { ...style(), direction: Column } : style());
            const [b1, id] = click >= 0 || drag >= 0 ? place(b, { kind: H_BOX, click: click, drag: drag, enter: -1, change: -1, bind: -1, args: args }) : [b, -1] as const;
            const [b2, st] = applied(b1, cx.file, classedBox(base, cx.classes, cs), ps, BOX_PROPS, BOX_KINDS, args, line, setBox);
            // (its classes in their states over it: under the pointer, pressed)
            const hovered = id >= 0 && id == b2.hover ? inState(st, cx.classes, cs, "hover") : st;
            const shown = id >= 0 && id == b2.pressed ? inState(hovered, cx.classes, cs, "active") : hovered;
            const [b3, es] = madeAll(b2, cx, kids, args, 0, []);
            return [b3, [Div(id >= 0 ? { ...shown, onClick: id } : shown, es)]] as const;
        },
        TText(ps, cs, val, line) => {
            const [b1, em] = argText(b, cx.file, ps, 0, PNum(14.0f32), args, line);
            const [b2, color] = argText(b1, cx.file, ps, 1, PCol(rgb(0x111827u32)), args, line);
            const base = textStyle(numOf(em, 14.0f32), colOf(color, rgb(0x111827u32)));
            const [b3, al] = argText(b2, cx.file, ps, 2, PNone, args, line);
            const aligned0 = match (al) {
                PAl(a) => ({ ...base, align: a }),
                _ => base,
            };
            const [b3a, fc] = argText(b3, cx.file, ps, 3, PInt(0), args, line);
            const aligned = { ...aligned0, face: intOf(fc, 0) };
            const [b4, s] = texted(b3a, val, args);
            // (its classes, then the attributes it is given over them, as
            // those of a box and as CSS)
            const given = map(iota(4), (k) => findIndex(ps, (p) => p.k == k) >= 0);
            const own = [em, color, al, fc];
            const styled = fold(iota(4), classedText(aligned, cx.classes, cs), (t, k) => given[k] ? setText(t, k, own[k]) : t);
            return [b4, [Label(styled, s)]] as const;
        },
        TComp(c) => comp(b, cx, c, args),
        TImage(src, ps, line) => {
            const [b1, name] = texted(b, src, args);
            const [b2, w] = argText2(b1, cx.file, ps, 1, args, line);
            const [b3, h] = argText2(b2, cx.file, ps, 2, args, line);
            const k = findIndex(cx.names, (x) => x == name);
            if (k < 0) {
                return [{ ...b3, err: b3.err == "" ? `${cx.file}:${line}: the image \`${name}\` is not read (name it in images="..." of the view)` : b3.err }, []] as const;
            }
            return [b3, [Image(cx.pics[k], w, h)]] as const;
        },
        TCode(dv, sc, line) => {
            const [b1, path] = texted(b, dv, args);
            const di = findIndex(b1.docs, (d) => d.path == path);
            if (di < 0) {
                return [b1, []] as const;
            }
            // (a place for each line in sight, in their order: the message of
            // the line `k` the first one's and `k` after it)
            const d = b1.docs[di];
            const [first, last] = sightOf(d, LINE_HEIGHT);
            const firstId = b1.hs.length;
            const b2 = placedLines(b1, di, first, last, args);
            const partsId = b2.hs.length;
            const b3 = placedParts(b2, di, 0, args);
            const look = lookWith(codeLook(b1.advance, 1, firstId - first, b1.codeFocus), partsId, 2, sc, b1.hover);
            return [{ ...b3, shownPath: path, shownScroll: sc }, codeElements(d, look)] as const;
        },
        TEach(f, kid, line) => {
            const [b1, seq] = called(b, f, args);
            const n = lua.sequenceLength(b1.vm, seq);
            return eachMade(b1, cx, kid[0], args, seq, n, 1, []);
        },
    };
}

// the property `k` of a text (of TEXT_PROPS), `d` when not given
function argText(b: B, file: string, ps: Prop[n], k: i64, d: PV, args: V[m], line: i64): [B, PV] {
    const at = findIndex(ps, (p) => p.k == k);
    if (at < 0) {
        return [b, d] as const;
    }
    const [b1, pv] = valued(b, file, TEXT_PROPS[k], TEXT_KINDS[k], ps[at].v, args, line);
    return match (pv) {
        PNone => [b1, d] as const,
        _ => [b1, pv] as const,
    };
}

// the size `k` (1 width, 2 height) of an image, 0 (its own) when not given
function argText2(b: B, file: string, ps: Prop[n], k: i64, args: V[m], line: i64): [B, f32] {
    const at = findIndex(ps, (p) => p.k == k);
    if (at < 0) {
        return [b, 0.0f32] as const;
    }
    const [b1, pv] = valued(b, file, k == 1 ? "width" : "height", KIND_F32, ps[at].v, args, line);
    return [b1, numOf(pv, 0.0f32)] as const;
}

// the child `kid` made for each element of the sequence `seq` (from the
// `i`-th of `count`), after the elements `acc`
// (a recursion: `b`, given at each step, is not copied; the elements made
// before, nodes, are counted, not copied)
function eachMade(b: B, cx: Cx, kid: Tpl, args: V[m], seq: V, count: i64, i: i64, acc: Element[]): [B, Element[]] {
    if (i > count) {
        return [b, acc] as const;
    }
    const inner = concat(args, [lua.element(b.vm, seq, i), lua.integerValue(i)]);
    const [b1, es] = made(b, cx, kid, inner);
    return eachMade(b1, cx, kid, args, seq, count, i + 1, concat(acc, es));
}

function madeAll(b: B, cx: Cx, ts: Tpl[j], args: V[m], i: i64, acc: Element[]): [B, Element[]] {
    if (i >= j) {
        return [b, acc] as const;
    }
    const [b1, es] = made(b, cx, ts[i], args);
    return madeAll(b1, cx, ts, args, i + 1, concat(acc, es));
}

// a component made, its classes applied to its box
function comp(b: B, cx: Cx, c: Comp, args: V[m]): [B, Element[]] {
    const kind = c.kind;
    const [b1, label] = texted(b, c.label, args);
    const h = { kind: kind == C_FIELD ? H_FIELD : H_COMP, click: c.click, drag: -1, enter: c.enter, change: c.change, bind: c.bind, args: args };
    const [b2, id] = kind == C_PROGRESS || (kind != C_FIELD && c.click < 0) ? [b1, -1] as const : place(b1, h);
    const [b3, e] = compElement(b2, cx.file, c, kind, label, id, cx.binds, args);
    // (its classes: its box, in the states it is in, under the pointer,
    // pressed, with the focus (a field), and its texts)
    const hovered = id >= 0 && id == b3.hover;
    const pressed = id >= 0 && id == b3.pressed;
    const focused = kind == C_FIELD && b3.focus == c.bind;
    const styled = (s: Style) => {
        const s0 = classedBox(s, cx.classes, c.classes);
        const s1 = hovered ? inState(s0, cx.classes, c.classes, "hover") : s0;
        const s2 = pressed ? inState(s1, cx.classes, c.classes, "active") : s1;
        return focused ? inState(s2, cx.classes, c.classes, "focus") : s2;
    };
    return [b3, [c.classes.length == 0 ? e : textsClassed(restyled(e, styled), cx.classes, c.classes)]] as const;
}

function compElement(b: B, file: string, c: Comp, kind: i64, label: string, id: i64, binds: string[k], args: V[m]): [B, Element] {
    if (kind == C_BUTTON) {
        const [b1, primary] = argOf(b, file, c, 0, KIND_BOOL, PBool(true), args);
        const [b2, width] = argOf(b1, file, c, 1, KIND_LENGTH, PLen(Auto), args);
        return [b2, button(label, id, boolOf(primary, true), lenOf(width, Auto), handOf(b2, id))] as const;
    }
    if (kind == C_ICON) {
        const [b1, danger] = argOf(b, file, c, 2, KIND_BOOL, PBool(false), args);
        return [b1, iconButton(label, id, boolOf(danger, false), handOf(b1, id))] as const;
    }
    if (kind == C_FIELD) {
        const [b1, hint] = argOf(b, file, c, 3, KIND_TEXT, PText(""), args);
        const [b2, width] = argOf(b1, file, c, 1, KIND_LENGTH, PLen(Fill(1.0f32)), args);
        // the text of its global: the field made anew when Lua changed it
        const g = lua.global(b2.vm, binds[c.bind]);
        const text = lua.isString(g) ? lua.plainText(b2.vm, g) : "";
        const ed = b2.eds[c.bind].text == text ? b2.eds[c.bind] : editing(text);
        // (`autofocus`: the focus given to the field when it appears)
        const [b2a, auto] = argOf(b2, file, c, 8, KIND_BOOL, PBool(false), args);
        const takes = boolOf(auto, false) && !b2a.seen[c.bind];
        const b3 = { ...b2a, eds: b2a.eds.with(c.bind, ed), now: b2a.now.with(c.bind, true), focus: takes ? c.bind : b2a.focus };
        return [b3, textField(ed, b3.focus == c.bind, textOfPV(hint), id, lenOf(width, Fill(1.0f32)))] as const;
    }
    if (kind == C_CHECK) {
        const [b1, checked] = argOf(b, file, c, 4, KIND_BOOL, PBool(false), args);
        return [b1, checkbox(boolOf(checked, false), id, handOf(b1, id))] as const;
    }
    if (kind == C_TOGGLE) {
        const [b1, on] = argOf(b, file, c, 5, KIND_BOOL, PBool(false), args);
        const [b2, at] = argOf(b1, file, c, 7, KIND_F32, PNum(boolOf(on, false) ? 1.0f32 : 0.0f32), args);
        return [b2, toggleAt(numOf(at, 0.0f32), id)] as const;
    }
    const [b1, value] = argOf(b, file, c, 6, KIND_F32, PNum(0.0f32), args);
    const [b2, width] = argOf(b1, file, c, 1, KIND_F32, PNum(200.0f32), args);
    return [b2, progress(numOf(value, 0.0f32), numOf(width, 200.0f32))] as const;
}

// the application with its elements made again (its memory collected
// first when it has grown: the values of the places made after it)
export function rebuilt(a: App): App {
    return rebuiltUnless(a, false);
}

// what made the elements with the collector of its machine held by `by`
// more (not inlined: given whole, made anew of its parts, its machine
// moved rather than copied)
@noInline
function heldBy(b: B, by: i64): B {
    return { ...b, vm: lua.held(b.vm, by) };
}

// `rebuilt`, or `a` as it is when `waits`
// (not inlined: the application given whole, its machine moved)
@noInline
function rebuiltUnless(a: App, waits: boolean): App {
    if (waits) {
        return a;
    }
    // (Lua has not run since the values were kept: made again from them,
    // no Lua called, nothing collected: the tables they name stay)
    const replay = !a.luaRan && a.memo.length > 0;
    // (replayed: held while it is due, so not collected, then as it was;
    // else collected when due and held while the elements are made)
    // (no `if` between the machine and another: each would copy it)
    const v0 = lua.held(lua.collectIfDue(lua.held(a.vm, replay ? 1 : 0)), replay ? -1 : 1);
    const b0 = { vm: v0, hs: [], err: "", eds: a.eds, focus: a.focus, hover: a.hover, pressed: a.pressed, seen: a.seen, now: map(a.seen, (x) => false), memo: replay ? a.memo : [], replay: replay, at: 0,
        docs: a.docs, codeFocus: a.codeFocus && a.active, advance: a.advance, shownPath: "", shownScroll: -1 };
    const [b1, es] = made(b0, a.cx, a.tpl[0], []);
    const b2 = heldBy(b1, replay ? 0 : -1);
    // (the focus of a field no longer made lost)
    const focus = b2.focus >= 0 && !b2.now[b2.focus] ? -1 : b2.focus;
    // (the parts of `b2` read where the application is made of them: a text
    // of it read before would hold it, its arrays then copied)
    // (another document shown: the widget of the search of the one before
    // kept, as in Visual Studio Code)
    const prev = findIndex(a.docs, (d) => d.path == a.shownPath);
    const docs = prev >= 0 && b2.shownPath != a.shownPath && b2.shownPath != ""
        ? map(a.docs, (d) => d.path == b2.shownPath ? findFrom(d, a.docs[prev]) : d) : a.docs;
    return { ...a, vm: b2.vm, hs: b2.hs, eds: b2.eds, focus: focus, seen: b2.now, tree: es.length > 0 ? es[0] : Div(style(), []), err: a.err == "" ? (replay ? a.memoErr : b2.err) : a.err, memo: b2.memo, memoErr: replay ? a.memoErr : b2.err, luaRan: false,
        shownPath: b2.shownPath, shownScroll: b2.shownScroll, docs: docs,
        // (a field given the focus as it appears: the keyboard leaves the code)
        codeFocus: focus >= 0 && focus != a.focus ? false : a.codeFocus };
}

// the elements of the application: an error shown above them
export function view(a: App): Element {
    if (a.err == "") {
        return a.tree;
    }
    const banner = Div({ ...style(), width: Fill(1.0f32), padding: 8.0f32, background: rgb(0xFEE2E2u32) }, [Label(textStyle(12.0f32, rgb(0xB91C1Cu32)), a.err)]);
    return Div({ ...style(), width: Fill(1.0f32), height: Fill(1.0f32) }, [banner, Div({ ...style(), width: Fill(1.0f32), height: Fill(1.0f32) }, [a.tree])]);
}

// the function `f` of the view run with `args` (nothing for -1): the
// application with its error
function ran(a: App, f: i64, args: V[n]): App {
    const [a1, v] = ranValue(a, f, args);
    return a1;
}

// `ran`, the value of the function too (nil for -1)
function ranValue(a: App, f: i64, args: V[n]): [App, V] {
    if (f < 0) {
        return [a, lua.nilValue()] as const;
    }
    // (the fields and the places not read by a call: none given, the
    // application not copied for them)
    const b: B = { vm: a.vm, hs: [], err: "", eds: [], focus: a.focus, hover: a.hover, pressed: a.pressed, seen: [], now: [], memo: [], replay: false, at: 0,
        docs: [], codeFocus: false, advance: 0.0f32, shownPath: "", shownScroll: -1 };
    const [b1, v] = called(b, f, args);
    return [{ ...a, vm: b1.vm, err: a.err == "" ? b1.err : a.err, luaRan: true }, v] as const;
}

// the name of the key `k` given to `onkey`: Enter, Escape, Backspace, Tab,
// Left, Up, Right, Down, Delete, Home, End, else its character (a letter
// held with Ctrl: its small letter)
function keyName(k: i64): string {
    return k == ENTER ? "Enter" : (k == ESCAPE ? "Escape" : (k == BACKSPACE ? "Backspace" : (k == TAB ? "Tab"
        : (k == LEFT ? "Left" : (k == UP ? "Up" : (k == RIGHT ? "Right" : (k == DOWN ? "Down"
        : (k == DELETE ? "Delete" : (k == HOME ? "Home" : (k == END ? "End"
        : (k == inp.PAGE_UP ? "PageUp" : (k == inp.PAGE_DOWN ? "PageDown"
        : (k >= inp.F1 && k <= inp.F12 ? `F${k - inp.F1 + 1}` : stringOf(utf8(k)))))))))))))));
}

// the key `k` given to `onkey` (its name, Ctrl, Shift, Alt): whether it
// took it (a true value)
function keyed(a: App, k: i64, mods: i64): [App, boolean] {
    if (a.key < 0) {
        return [a, false] as const;
    }
    const [v1, name] = lua.stringV(a.vm, keyName(k));
    const args = [name, lua.booleanValue((mods & WITH_CTRL) != 0), lua.booleanValue((mods & WITH_SHIFT) != 0), lua.booleanValue((mods & WITH_ALT) != 0)];
    const [a1, v] = ranValue({ ...a, vm: v1 }, a.key, args);
    return [a1, lua.truthy(v)] as const;
}

// the field of the place `h` edited by the input `i`: its global set when
// its text changed, then its `onchange` run
function fieldEdited(a: App, h: H, i: HandInput, p: i64): [App, Effect[]] {
    const [ed, fx, own] = edited(a.eds[h.bind], i, p);
    if (ed.text == a.eds[h.bind].text) {
        return [{ ...a, eds: a.eds.with(h.bind, ed) }, fx] as const;
    }
    const [v1, s] = lua.stringV(a.vm, ed.text);
    const a1 = { ...a, vm: lua.setGlobal(v1, a.cx.binds[h.bind], s), eds: a.eds.with(h.bind, ed), luaRan: true };
    return [ran(a1, h.change, h.args), fx] as const;
}

// the place of the field with the focus (-1: none)
function focusedPlace(a: App): i64 {
    return a.focus < 0 ? -1 : findIndex(a.hs, (h) => h.kind == H_FIELD && h.bind == a.focus);
}

// the application after the input `i` of the hand, and what it asks
export function update(a0: App, i: HandInput): [App, Effect[]] {
    const a = { ...a0, err: "" };
    const before = docsSig(a);
    const [a1, fx] = answered(a, i);
    // (the files and folders its Lua asked: read by the loop of the window)
    const [a20, files] = requested(a1);
    // (the documents changed: what the scripts read of them told)
    const a2 = docsSig(a20) == before ? a20 : docsTold(a20);
    // (a box that scrolls told: the elements made again once the boxes of
    // the step are all told, at `Viewport(-1, ...)`)
    const waits = match (i) {
        Viewport(k, offset, height) => k >= 0,
        WindowSize(w, h) => true,
        _ => false,
    };
    const a3 = rebuiltUnless(a2, waits);
    // (another document shown: the box of the code at its own offset, as
    // each tab of Visual Studio Code keeps its own)
    const di = findIndex(a3.docs, (d) => d.path == a3.shownPath);
    const back: Effect[] = a3.shownPath != a.shownPath && a3.shownPath != "" && a3.shownScroll >= 0 && di >= 0 ? [ScrollTo(a3.shownScroll, a3.docs[di].top)] : [];
    return [a3, concat(concat(fx, files), back)] as const;
}

function answered(a: App, i: HandInput): [App, Effect[]] {
    return match (i) {
        // (the box of the documents: its lines made by the host, not by Lua,
        // which is not run for it: `host.offsets` holds its offset, its view
        // made again from the values Lua gave)
        Viewport(k, offset, height) => [k < 0 ? a : (k == a.shownScroll
            ? { ...viewported(withShown(a, (d) => viewed(d, offset, a.codeHeight > 0.0f32 ? a.codeHeight : height)), k, offset, height), luaRan: a.luaRan }
            : viewported(a, k, offset, height)), []] as const,
        WindowState(z) => [maximizedSet(a, z), []] as const,
        WindowSize(w, h) => [sizeSet(a, w, h), []] as const,
        WindowActive(z) => [flagSet({ ...a, active: z }, "active", z), []] as const,
        // (the window asks to close: `onbeforeclose` keeps it open by a true
        // value)
        CloseAsked => {
            if (a.beforeClose < 0) {
                return [a, []] as const;
            }
            const [a1, v] = ranValue(a, a.beforeClose, []);
            return [a1, lua.truthy(v) ? [KeepOpen] : []] as const;
        },
        // (the box of the documents laid out: each told its size)
        BoxSized(k, w, h) => [k == a.shownScroll ? { ...a, codeWidth: w, codeHeight: h, docs: map(a.docs, (d) => boxSized(d, w, h, a.advance)) } : a, []] as const,
        // (another density of the screen: the maps of the documents in its
        // pixels)
        Density(k) => [{ ...a, ratio: k, docs: map(a.docs, (d) => ratioSet(d, k, a.codeWidth, a.codeHeight, a.advance)) }, []] as const,
        // (the wheel across over the code shown: it scrolls across)
        WheelX(p, dx) => [p >= 0 && p < a.hs.length && (a.hs[p].kind == H_CODE || a.hs[p].kind == H_PART) ? withShown(a, (d) => wheeledAcross(d, dx)) : a, []] as const,
        TextWritten(p, ok, reason) => [ok ? { ...a, docs: map(a.docs, (d) => d.path == p ? saved(d) : d) } : { ...a, err: `${p}: ${reason}` }, []] as const,
        // (a file asked by `host.openFile`: its document made here, its text
        // not given to Lua, which is told it is open)
        TextRead(p, t, ok) => {
            const k = findIndex(a.fileReads, (x) => x == p);
            if (k < 0) {
                return [delivered(a, i), []] as const;
            }
            const a1 = { ...a, fileReads: concat(a.fileReads.slice(0, k), a.fileReads.slice(k + 1, a.fileReads.length)) };
            if (!ok) {
                return [delivered(a1, i), []] as const;
            }
            const open = findIndex(a1.docs, (d) => d.path == p) >= 0;
            const shown = t.indexOf("\u{0}") >= 0 ? "The file is not displayed in the text editor because it is either binary or uses an unsupported text encoding." : t;
            const a2 = open ? a1 : { ...a1, docs: concat(a1.docs, [ratioSet(docOf(p, shown), a1.ratio, a1.codeWidth, a1.codeHeight, a1.advance)]) };
            return [deliveredOpen(a2), []] as const;
        },
        FolderListed(p, names, ok) => [delivered(a, i), []] as const,
        Hover(p) => [{ ...a, hover: p }, []] as const,
        Click(p, x, y, at, clicks, mods) => {
            if (p < 0 || p >= a.hs.length) {
                return [{ ...a, pressed: p, held: noPlace() }, []] as const;
            }
            const h = a.hs[p];
            if (h.kind == H_CODE) {
                // (the cursor of the document at the line and the column
                // clicked; with Alt, a cursor more)
                const a1 = { ...a, pressed: p, held: h, focus: -1, codeFocus: true, pressX: x, pressY: y };
                return codeChanged(a1, h.change, rowClicked(a.docs[h.change], lookOf(a), h.bind, x, clicks, mods), []);
            }
            if (h.kind == H_PART) {
                // (a part of its editor: the widget of the search, the map, the
                // bar across)
                const a1 = { ...a, pressed: p, held: h, focus: -1, codeFocus: true, pressX: x, pressY: y };
                const [d1, fx] = codePartClicked(a.docs[h.change], lookOf(a), h.bind, i);
                return codeChanged(a1, h.change, d1, fx);
            }
            if (h.kind == H_FIELD) {
                return fieldEdited({ ...a, focus: h.bind, pressed: p, held: h, codeFocus: false }, h, i, p);
            }
            const a1 = { ...a, pressed: p, held: h, focus: h.kind == H_BOX ? -1 : a.focus, pressX: x, pressY: y, codeFocus: false };
            return [ran(a1, h.click, h.args), []] as const;
        },
        // (a drag from a box with `ondrag`; else the selection of a field)
        Drag(p, x, y, at) => {
            // (the place as it was pressed, whatever its number now)
            const h = p == a.pressed ? a.held : (p >= 0 && p < a.hs.length ? a.hs[p] : noPlace());
            // (a drag from a line of a document: the selection to the line and
            // the column under the pointer)
            if (h.kind == H_CODE && h.change < a.docs.length) {
                return codeChanged(a, h.change, rowDragged(a.docs[h.change], lookOf(a), h.bind, x, y), []);
            }
            if (h.kind == H_PART && h.change < a.docs.length) {
                const [d1, fx] = codePartDragged(a.docs[h.change], lookOf(a), h.bind, i);
                return [{ ...a, docs: map(iota(a.docs.length), (k) => k == h.change ? d1 : a.docs[k]) }, fx] as const;
            }
            if (h.kind >= 0 && h.drag >= 0) {
                return [ran(a, h.drag, concat(h.args, [lua.floatValue(f64(x - a.pressX)), lua.floatValue(f64(y - a.pressY))])), []] as const;
            }
            const fp = focusedPlace(a);
            return fp < 0 ? [a, []] as const : fieldEdited(a, a.hs[fp], i, fp);
        },
        Release(p) => [{ ...a, pressed: -1, held: noPlace() }, []] as const,
        // (the right button over a line of a document: its cursor there
        // unless within a selection, the menu of the editor of Visual
        // Studio Code)
        ContextMenu(p, x, y) => {
            if (p < 0 || p >= a.hs.length || a.hs[p].kind != H_CODE) {
                return [a, []] as const;
            }
            const h = a.hs[p];
            const d1 = rowContext(a.docs[h.change], lookOf(a), h.bind, x);
            return codeChanged({ ...a, focus: -1, codeFocus: true }, h.change, d1, [shownMenu(codeMenuLook(), codeMenu(d1))]);
        },
        // (an entry of that menu: its shortcut; the palette Lua's, as Ctrl+Shift+P)
        MenuChosen(k) => {
            const di = shownDoc(a);
            if (di < 0) {
                return [a, []] as const;
            }
            if (k == CODE_MENU_PALETTE) {
                const [a1, took] = keyed(a, 112, WITH_CTRL | WITH_SHIFT);
                return [a1, []] as const;
            }
            const [d1, fx] = codeMenuChosen(a.docs[di], k);
            return codeChanged({ ...a, codeFocus: true }, di, d1, fx);
        },
        Focus(p) => [{ ...a, focus: p >= 0 && p < a.hs.length && a.hs[p].kind == H_FIELD ? a.hs[p].bind : -1 }, []] as const,
        Key(k0, mods0) => {
            const [a0, took] = keyed(a, k0, mods0);
            return took ? [a0, []] as const : keyAnswered(a0, i, k0);
        },
        _ => {
            // (a character typed, a text pasted: the document with the focus)
            const di = shownDoc(a);
            if (a.codeFocus && di >= 0) {
                return match (i) {
                    inp.Text(c) => codeChanged(a, di, typedCode(a.docs[di], c), []),
                    Paste(t) => codeChanged(a, di, pasted(a.docs[di], t), []),
                    _ => [a, []] as const,
                };
            }
            const fp = focusedPlace(a);
            return fp < 0 ? [a, []] as const : fieldEdited(a, a.hs[fp], i, fp);
        },
    };
}

// the document shown (-1: none)
function shownDoc(a: App): i64 {
    return findIndex(a.docs, (d) => d.path == a.shownPath);
}

// the document shown changed by `f`
function withShown(a: App, f: (Doc) => Doc): App {
    return { ...a, docs: map(a.docs, (d) => d.path == a.shownPath ? f(d) : d) };
}

// how the code looks for the inputs: its box, the place under the pointer
function lookOf(a: App): CodeLook {
    return lookWith(codeLook(a.advance, 1, 0, a.codeFocus), 0, 2, a.shownScroll, a.hover);
}

// the document `di` made `d`: the line of its cursor revealed in the box
// that scrolls it
function codeChanged(a: App, di: i64, d: Doc, fx: Effect[n]): [App, Effect[]] {
    const [y, h] = cursorBand(d);
    const reveal = a.shownScroll >= 0 && (di < 0 || di >= a.docs.length || movedFrom(a.docs[di], d));
    const a1 = { ...a, docs: map(iota(a.docs.length), (k) => k == di ? d : a.docs[k]) };
    return [a1, reveal ? concat(fx, [Reveal(a.shownScroll, y, h)]) : fx] as const;
}

// what the scripts read of the documents changed: their cursors, whether
// they are saved
function docsSig(a: App): string {
    return join(map(a.docs, (d) => `${d.path}:${d.cursor.line}:${d.cursor.col}:${d.anchor.line}:${d.anchor.col}:${d.others.length}:${d.version}:${d.saved}`), "|");
}

// `host.docs[path]` of each document: `line`, `col` (from 1, a tab to its
// stop), `dirty`, `lang`, `indent`, `eol` ("LF" or "CRLF"), `symbols` (each
// `name` and `array`: around the cursor in a JSON)
function docsTold(a: App): App {
    const host = lua.global(a.vm, "host");
    if (host.t != T_TAB) {
        return a;
    }
    const [v1, t] = lua.newTable(a.vm, 0, a.docs.length);
    const v2 = docEntries(v1, t, a.docs, 0);
    return { ...a, vm: fieldSet(v2, host.i, "docs", { t: T_TAB, i: t, f: 0.0 }), luaRan: true };
}

function fieldSet(vm: lua.Vm, t: i64, name: string, v: V): lua.Vm {
    const [v1, k] = lua.stringV(vm, name);
    return lua.rawSet(v1, t, k, v);
}

function textSet(vm: lua.Vm, t: i64, name: string, s: string): lua.Vm {
    const [v1, x] = lua.stringV(vm, s);
    return fieldSet(v1, t, name, x);
}

function docEntries(vm: lua.Vm, t: i64, docs: Doc[n], k: i64): lua.Vm {
    if (k >= n) {
        return vm;
    }
    const d = docs[k];
    const [v1, e] = lua.newTable(vm, 0, 8);
    const v2 = fieldSet(fieldSet(v1, e, "line", lua.integerValue(d.cursor.line + 1)), e, "col", lua.integerValue(columnOf(lineAt(d.lines, d.cursor.line), d.cursor.col) + 1));
    const v3 = fieldSet(fieldSet(v2, e, "dirty", lua.booleanValue(dirty(d))), e, "indent", lua.integerValue(d.indent));
    const v4 = textSet(textSet(textSet(v3, e, "lang", d.lang.name), e, "eol", d.crlf ? "CRLF" : "LF"), e, "status", statusOf(d));
    const syms = symbolsAt(d);
    const [v5, st] = lua.newTable(v4, syms.length, 0);
    const v6 = symbolEntries(v5, st, syms, 0);
    const v7 = fieldSet(v6, e, "symbols", { t: T_TAB, i: st, f: 0.0 });
    const [v8, key] = lua.stringV(v7, d.path);
    return docEntries(lua.rawSet(v8, t, key, { t: T_TAB, i: e, f: 0.0 }), t, docs, k + 1);
}

function symbolEntries(vm: lua.Vm, t: i64, syms: Symbol[n], k: i64): lua.Vm {
    if (k >= n) {
        return vm;
    }
    const [v1, e] = lua.newTable(vm, 0, 2);
    const v2 = fieldSet(textSet(v1, e, "name", syms[k].name), e, "array", lua.booleanValue(syms[k].array));
    return symbolEntries(lua.rawSet(v2, t, lua.integerValue(k + 1), { t: T_TAB, i: e, f: 0.0 }), t, syms, k + 1);
}

// the width of a column of the font of fixed width (measured by the
// application when its fonts are read): the columns of the code clicked
export function measured(a: App, advance: f32): App {
    return { ...a, advance: advance };
}

// a key not taken by `onkey`: to the field with the focus (Enter runs its
// `onenter`, Escape takes the focus from it)
function keyAnswered(a: App, i: HandInput, k: i64): [App, Effect[]] {
    // (the document shown with the focus: its keys)
    const di = shownDoc(a);
    if (a.codeFocus && di >= 0) {
        return match (i) {
            Key(k1, mods) => {
                const [d1, fx] = docKeyed(a.docs[di], k1, mods);
                return codeChanged(a, di, d1, fx);
            },
            _ => [a, []] as const,
        };
    }
    const fp = focusedPlace(a);
    if (fp < 0) {
        return [a, []] as const;
    }
    if (k == ENTER) {
        return [ran(a, a.hs[fp].enter, a.hs[fp].args), []] as const;
    }
    if (k == ESCAPE) {
        return [{ ...a, focus: -1 }, []] as const;
    }
    return fieldEdited(a, a.hs[fp], i, fp);
}

// the application closed: its `onclose` run, what its Lua printed
export function closed(a: App): [App, string[]] {
    const a1 = ran(a, a.close, []);
    const [v1, out] = lua.takeOutput(a1.vm);
    return [{ ...a1, vm: v1 }, a1.err == "" ? out : concat(out, [a1.err])] as const;
}
