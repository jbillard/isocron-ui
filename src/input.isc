// What an application of the library is told of the hand (`Input`), and
// what it asks of the system in return (`Effect`): the places of its view
// clicked, dragged and released (where in them, where in their text, how
// many clicks), the place under the pointer, the characters typed, the
// keys that edit and the shortcuts, the text of the clipboard; the text
// copied to the clipboard, the clipboard asked for.

import { Color } from "./paint";

// the modifiers held with a key, as bits
export const WITH_SHIFT: i64 = 1;
export const WITH_CTRL: i64 = 2;
export const WITH_ALT: i64 = 4;

// the keys that edit text: below a space, as their ASCII codes; the others
// past the last code point
export const BACKSPACE: i64 = 8;
export const TAB: i64 = 9;
export const ENTER: i64 = 13;
export const ESCAPE: i64 = 27;
export const LEFT: i64 = 0x110001;
export const UP: i64 = 0x110002;
export const RIGHT: i64 = 0x110003;
export const DOWN: i64 = 0x110004;
export const DELETE: i64 = 0x110005;
export const HOME: i64 = 0x110006;
export const END: i64 = 0x110007;
export const PAGE_UP: i64 = 0x110008;
export const PAGE_DOWN: i64 = 0x110009;
// the keys of functions: F1 is 0x110010, F12 0x11001B
export const F1: i64 = 0x110010;
export const F2: i64 = 0x110011;
export const F3: i64 = 0x110012;
export const F12: i64 = 0x11001B;
// the signs of the shortcuts of lines, held with Ctrl: as Visual Studio
// Code, the key at the place of `/`, `[` and `]` of an American keyboard
// whatever the keyboard (Ctrl+: is Ctrl+/ on a French one under Windows)
export const SLASH: i64 = 47;
export const BRACKET_LEFT: i64 = 91;
export const BRACKET_RIGHT: i64 = 93;

// a dead key (an accent typed before its letter, `^` then `e`: `ê`), as a
// character of the hand: DEAD plus its accent, in the order of the symbols
// of X11 (grave, acute, circumflex, tilde, macron, breve, dot above,
// diaeresis, ring above, double acute, caron, cedilla); a code of the
// private area of Unicode, never a character of a text
export const DEAD: i64 = 0xF0000;
export const DEAD_ACCENTS: i64 = 12;

// the accent `k` alone (a dead key then a space, or a letter it does not
// go on)
const SPACING: i64[] = [0x60, 0xB4, 0x5E, 0x7E, 0xAF, 0x2D8, 0x2D9, 0xA8, 0x2DA, 0x2DD, 0x2C7, 0xB8];

// the letters each accent goes on and what they become, by threes: the
// accent, the letter, the letter with the accent (Latin-1, ÿ, Ÿ, ć, Ć)
const COMPOSE: i64[] = [
    0, 0x61, 0xe0, 0, 0x65, 0xe8, 0, 0x69, 0xec, 0, 0x6f, 0xf2, 0, 0x75, 0xf9, 0, 0x41, 0xc0, 0, 0x45, 0xc8, 0, 0x49, 0xcc, 0, 0x4f, 0xd2, 0, 0x55, 0xd9,
    1, 0x61, 0xe1, 1, 0x65, 0xe9, 1, 0x69, 0xed, 1, 0x6f, 0xf3, 1, 0x75, 0xfa, 1, 0x79, 0xfd, 1, 0x41, 0xc1, 1, 0x45, 0xc9, 1, 0x49, 0xcd, 1, 0x4f, 0xd3, 1, 0x55, 0xda, 1, 0x59, 0xdd, 1, 0x63, 0x107, 1, 0x43, 0x106,
    2, 0x61, 0xe2, 2, 0x65, 0xea, 2, 0x69, 0xee, 2, 0x6f, 0xf4, 2, 0x75, 0xfb, 2, 0x41, 0xc2, 2, 0x45, 0xca, 2, 0x49, 0xce, 2, 0x4f, 0xd4, 2, 0x55, 0xdb,
    3, 0x61, 0xe3, 3, 0x6e, 0xf1, 3, 0x6f, 0xf5, 3, 0x41, 0xc3, 3, 0x4e, 0xd1, 3, 0x4f, 0xd5,
    7, 0x61, 0xe4, 7, 0x65, 0xeb, 7, 0x69, 0xef, 7, 0x6f, 0xf6, 7, 0x75, 0xfc, 7, 0x79, 0xff, 7, 0x41, 0xc4, 7, 0x45, 0xcb, 7, 0x49, 0xcf, 7, 0x4f, 0xd6, 7, 0x55, 0xdc, 7, 0x59, 0x178,
    8, 0x61, 0xe5, 8, 0x41, 0xc5,
    11, 0x63, 0xe7, 11, 0x43, 0xc7,
];

// the character `c` typed after the dead key of the accent `k`: the
// letter with its accent; 0 when the accent does not go on it
export function composed(k: i64, c: i64): i64 {
    const j = findIndex(iota(COMPOSE.length / 3), (t) => COMPOSE[3 * t] == k && COMPOSE[3 * t + 1] == c);
    return j < 0 ? 0 : COMPOSE[3 * j + 2];
}

// the accent `k` alone
export function spacingAccent(k: i64): i64 {
    return k >= 0 && k < DEAD_ACCENTS ? SPACING[k] : 0;
}

// the input of the hand:
// - `Click(place, x, y, at, clicks, mods)`: the left button pressed on the
//   place whose message is `place`, at (x, y) units from its top left
//   corner (pixels divided by the density of the screen);
//   `at`, the offset in the text of a field under it where a caret would go
//   (-1: no field); `clicks`, 1, 2 for a double click, 3 for a triple one;
//   the modifiers held
// - `Drag(place, x, y, at)`: the pointer moved, the button held since a
//   click on `place` (x, y in units and `at` as for that place, beyond it
//   too)
// - `Release(place)`: the button released after a click on `place`
// - `Hover(place)`: the place under the pointer changed (-1: none)
// - `Text(c)`: a character typed (a code point, a space or above)
// - `Key(k, mods)`: a key that edits (BACKSPACE ... END) or a letter held
//   with Ctrl (its lower case code: Ctrl+C is `Key(99, WITH_CTRL)`), and
//   the modifiers held
// - `Paste(s)`: the text of the clipboard, after `AskPaste`
// - `Focus(place)`: the keyboard gave the focus to the place whose message
//   is `place` (Tab, Shift+Tab; -1: to none, Escape)
// - `Viewport(scroll, offset, height)`: the box that scrolls whose offset
//   is the `scroll`-th is at `offset` units from its top, and shows at most
//   `height` units (the height of the window): told when its offset
//   changes, and for every such box when the window changes its size or
//   its density (a long list builds the rows in sight alone with it:
//   `uniformList` of widgets.isc); the boxes of a step told, one
//   `Viewport(-1, 0, 0)` after them (an application that makes its view
//   again for each may wait for it to make it once)
// - `Tick(ms)`: the time of a frame (milliseconds of the clock of the
//   system), after `Animate`
// - `TextRead(path, text, ok)`: the text of the file `path` asked by
//   `ReadText` (`ok` false: the reason it could not be read instead)
// - `FolderListed(path, names, ok)`: the names in the folder `path` asked
//   by `ListFolder`, those of folders ending with `/` (`ok` false: none,
//   the reason as the only name)
// - `WindowState(maximized)`: the window maximized or not, told when it
//   changes (a title the application draws shows its button that restores
//   it then)
// - `WindowSize(width, height)`: the size of the inside of the window, in
//   units, told when it or the density changes, before the boxes that
//   scroll (a `Viewport(-1, 0, 0)` always after it: an application that
//   makes its view again waits for it); a bar laid out after the width (a
//   box 38 % of the window wide, Visual Studio Code)
// - `TextWritten(path, ok, reason)`: the text asked written by `WriteText`
//   written (`ok`), or the reason it was not
// - `WindowActive(active)`: the window the keyboard goes to or not, told
//   when it changes (Visual Studio Code dims its bar of the title in a
//   window inactive); under Windows, X11 (FocusIn, FocusOut) and Wayland
//   (the state `activated` of its configuration)
// - `CloseAsked`: the window asked to close (its button, Alt+F4, the
//   system): it closes after it unless the application answers `KeepOpen`
//   (an editor whose files are not saved asks first, then `CloseWindow`)
// - `WheelX(place, dx)`: the wheel turned across over the place whose
//   message is `place` (-1: none), `dx` units, right positive: a wheel
//   tilted, two fingers on a touchpad, the wheel turned with Shift held
// - `BoxSized(scroll, width, height)`: the box that scrolls whose offset is
//   the `scroll`-th laid out at `width` by `height` units (its inside, the
//   room of its scrollbar with it), told when it changes (an editor of code
//   lays its long lines out across it)
// - `Density(ratio)`: the pixels of a unit of the screen of the window
//   (1.25 at a scale of 125 %), told when it changes (1 until then), before
//   the size of the window: an image made in the pixels of the screen (the
//   map of an editor of code, as Visual Studio Code draws its minimap)
// - `ContextMenu(place, x, y)`: the right button pressed over the place
//   whose message is `place` (-1: none; not a field, which has the menu of
//   the library), at (x, y) units from its corner: the application may
//   answer `ShowMenu` (Visual Studio Code: the menu of the editor of code)
// - `MenuChosen(k)`: the `k`-th entry of the menu it showed chosen (a
//   click, Enter); the menu closed
export type Input = Click(i64, f32, f32, i64, i64, i64) | Drag(i64, f32, f32, i64) | Release(i64) | Hover(i64) | Text(i64) | Key(i64, i64) | Paste(string) | Focus(i64) | Viewport(i64, f32, f32) | Tick(i64) | TextRead(string, string, boolean) | FolderListed(string, string[], boolean) | WindowState(boolean) | WindowSize(f32, f32) | WindowActive(boolean) | TextWritten(string, boolean, string) | CloseAsked | WheelX(i64, f32) | BoxSized(i64, f32, f32) | Density(f32) | ContextMenu(i64, f32, f32) | MenuChosen(i64);

// what an application asks after an input: a text copied to the clipboard,
// the text of the clipboard (it comes as `Paste`), the next frame of an
// animation (it comes as `Tick`, about 16 ms later: asked again at each
// `Tick` while the animation lasts, the window drawn again each time), the
// text of a file (it comes as `TextRead`), the names in a folder (as
// `FolderListed`), each answered in the order asked
// (`Minimize`, `ToggleMaximized`, `CloseWindow`: what the buttons of a
// title the application draws ask, `WindowSpec.drawn`)
// (`WriteText(path, text)`: the file written, `TextWritten` after;
// `ScrollTo(box, offset)`: the box that scrolls `box` at `offset` units
// from its top; `Reveal(box, y, height)`: that box scrolled as little as
// shows the band of `height` units at `y` from the top of its content,
// whole (the line of the cursor of an editor in sight); `KeepOpen`: the
// window kept open after `CloseAsked`)
// (`ShowMenu(look, labels, keys, flags)`: a menu opened at the pointer,
// after `ContextMenu`, looking as `look` says: the texts of its entries,
// the keys of their shortcuts, their flags (`MENU_ENABLED`,
// `MENU_SEPARATOR`), as `shownMenu` makes them of `MenuItem`s; the entry
// chosen comes as `MenuChosen`)
export type Effect = Copy(string) | AskPaste | Animate | ReadText(string) | ListFolder(string) | Minimize | ToggleMaximized | CloseWindow | WriteText(string, string) | ScrollTo(i64, f32) | Reveal(i64, f32, f32) | KeepOpen | ShowMenu(MenuLook, string[], string[], i64[]);

// the flags of an entry of a menu: it can be chosen; it is a line between
// two groups
export const MENU_ENABLED: i64 = 1;
export const MENU_SEPARATOR: i64 = 2;

// the menu of the entries `items` shown, looking as `look` says
export function shownMenu(look: MenuLook, items: MenuItem[n]): Effect {
    return ShowMenu(look, map(items, (e) => e.label), map(items, (e) => e.keys), map(items, (e) => (e.enabled ? MENU_ENABLED : 0) | (e.separator ? MENU_SEPARATOR : 0)));
}

// an entry of a menu an application shows: its text, the keys of its
// shortcut shown at its right ("": none), whether it can be chosen; a line
// between two groups of entries when `separator` (its text then none)
export type MenuItem = { label: string, keys: string, enabled: boolean, separator: boolean };

// an entry of a menu
export function menuItem(label: string, keys: string): MenuItem {
    return { label: label, keys: keys, enabled: true, separator: false };
}

// a line between two groups of entries of a menu
export function menuSeparator(): MenuItem {
    return { label: "", keys: "", enabled: false, separator: true };
}

// how a menu looks: its background, its texts (those of the entries that
// cannot be chosen), the entry under the pointer (its background, its
// border), the lines between groups, its border, its shadow, the radius of
// its corners and of its entries lit, the size of its texts, the height of
// an entry, the room left and right of its texts, its width at least (in
// units)
export type MenuLook = { background: Color, foreground: Color, disabled: Color, selection: Color, selectionBorder: Color, separator: Color, border: Color, shadow: Color, radius: f32, itemRadius: f32, em: f32, item: f32, pad: f32, least: f32 };
