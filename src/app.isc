// An application in the manner of Elm in a window of the system: its model
// (of any type), its view laid out at the size of the window, and how the
// hand changes the model (`update`, given an `Input` of input.isc, gives
// the model and what it asks: the clipboard). The library keeps what the
// hand does to the interface itself: the place under the pointer and the
// shape of the pointer, the clicks counted (double, triple), the button
// held (a drag), the boxes that scroll (the wheel, their scrollbars dragged
// or clicked), the caret blinking (530 ms, shown again at each input), the
// modifiers, a clipboard of its own. The steps of the hand are the same
// everywhere (`step`); under Windows they come from a window of `win32`,
// under Linux from a window of Wayland (the module `unix`, the protocol
// spoken by `wayland.isc`, the keyboard read by `xkb.isc`). The model is
// drawn again after a change; a window resized, laid out again.
import * as sys from "sys";
import * as win from "win32";
import * as unix from "unix";
import * as net from "net";
import * as wl from "./wayland";
import * as x11 from "./x11";
import { IoError, ioError } from "sys";
import { rgb, rgba, render, Primitive, Box, quad, rounded, bordered, transparent } from "./paint";
import { Font, parse } from "./font";
import { Element, Div, Label, Px, Fill, Hit, Frame, placeFrame, placeOf, scaledElement, hitTest, clickAt, cursorAt, barAt, fieldAt, offsetAt, charAt, scrolled, thumb, style, textStyle, ARROW, FIELD, BAR, CLICK, MENU, FOCUS, WHEEL, tipOf } from "./ui";
import { POINTER as POINTER_SHAPE, TEXT as TEXT_SHAPE } from "./ui";
import { Input, Effect, Click, Drag, Release, Hover, Text, Key, Paste, Focus, Viewport, Tick, Copy, AskPaste, Animate, WITH_SHIFT, WITH_CTRL, WITH_ALT, BACKSPACE, TAB, ENTER, ESCAPE, LEFT, UP, RIGHT, DOWN, DELETE, HOME, END } from "./input";
import { DEAD, DEAD_ACCENTS, composed, spacingAccent } from "./input";
import { Keymap, parseKeymap, charOf } from "./xkb";
import * as cursors from "./cursors";
import { Atlas, emptyAtlas, resolved } from "./atlas";
import { lineWidth } from "./text";

// the half period of the caret's blinking, in nanoseconds
const BLINK: u64 = 530000000u64;

// the longest time between two clicks of a double click, in nanoseconds,
// and the farthest the pointer may move between them, in pixels
const DOUBLE: u64 = 500000000u64;
const NEAR: f32 = 4.0f32;

// what the hand does, as the windows of each system tell it: the pointer
// moved, a button pressed or released (0 left, 1 right, 2 middle), the
// wheel (pixels, down: positive), a character typed, a key that edits or a
// shortcut, the modifiers held, the size of the window, its closing, the
// text of the clipboard
// (`Elapsed`: time passed, a frame of an animation due)
export type Ev = Moved(f32, f32) | Down(i64) | Up(i64) | Scroll(f32) | Typed(i64) | Pressed(i64) | Mods(i64) | Resized(i64, i64) | Scaled(f32) | Closed | Pasted(string) | Elapsed;

// what the library keeps of the interface: the size of the window, the
// places of the frame shown and the offsets of its boxes that scroll, the
// pointer, the message of the place under it, the shape it has; the
// modifiers; the place pressed by the left button (its message, -1: none),
// the line of a field of that press (its index among the places), the
// corner of the place; the scrollbar dragged (its offset's number, -1:
// none) and where its thumb was grabbed, that under the pointer; the last
// click (its time, their count, its place); the last input (the caret
// shown from then); whether the frame has a caret, shown or not; a
// clipboard; what the model asked of the system since the last time the
// window took it (`asked`); the menu of a field (open, its corner, the
// entry under the pointer, -1: none; whether the field has a selection, to
// cut or copy; the texts of its entries: cut, copy, paste, select all); a
// frame to draw; the window closed
export type Ui = {
    w: i64,
    h: i64,
    hits: Hit[],
    offsets: f32[],
    x: f32,
    y: f32,
    hover: i64,
    cursor: i64,
    mods: i64,
    pressed: i64,
    field: i64,
    px: f32,
    py: f32,
    bar: i64,
    grab: f32,
    hotBar: i64,
    clickTime: u64,
    clicks: i64,
    cx: f32,
    cy: f32,
    since: u64,
    caret: boolean,
    caretOn: boolean,
    clipboard: string,
    asked: Effect[],
    menu: boolean,
    menuX: f32,
    menuY: f32,
    menuHover: i64,
    menuCut: boolean,
    labels: string[],
    scale: f32,
    dead: i64,
    focus: i64,
    ring: boolean,
    atlas: Atlas,
    animating: boolean,
    tickAt: u64,
    hoverSince: u64,
    tipDue: boolean,
    tipOff: boolean,
    redraw: boolean,
    closed: boolean,
};

// the texts of the entries of the menu of a field, by default
export function englishMenu(): string[] {
    return ["Cut", "Copy", "Paste", "Select all"];
}

// the letter of the shortcut of each entry of the menu (Ctrl+X, C, V, A)
const MENU_KEYS: i64[] = [120, 99, 118, 97];

// the interface of a window of `w` by `h` pixels at the time `now`
export function interface(w: i64, h: i64, now: u64): Ui {
    return {
        w: w, h: h, hits: [], offsets: fill(16, 0.0f32), x: -1.0f32, y: -1.0f32, hover: -1, cursor: ARROW, mods: 0,
        pressed: -1, field: -1, px: 0.0f32, py: 0.0f32, bar: -1, grab: 0.0f32, hotBar: -1,
        clickTime: 0u64, clicks: 0, cx: 0.0f32, cy: 0.0f32, since: now, caret: false, caretOn: true,
        clipboard: "", asked: [], menu: false, menuX: 0.0f32, menuY: 0.0f32, menuHover: -1, menuCut: false, labels: englishMenu(), scale: 1.0f32, dead: -1, focus: -1, ring: false, atlas: emptyAtlas(), animating: false, tickAt: 0u64, hoverSince: now, tipDue: false, tipOff: false,
        redraw: true, closed: false,
    };
}

// the model after the input `i`, and the interface with what it asks
// added to `asked` (a text copied: the clipboard of the interface too; a
// paste asked: given at once the clipboard of the interface, the window
// replacing it by the system's when it reaches it)
// (compiled once, called: the update of the application is copied here
// alone, not into each step that gives it an input)
@noInline
function told<M>(ui: Ui, m: M, i: Input, update: (M, Input) => [M, Effect[]]): [Ui, M] {
    const [nm, fx] = update(m, i);
    const copied = fold(fx, ui.clipboard, (c, e) => match (e) {
        Copy(s) => s,
        _ => c,
    });
    const animates = count(fx, (e) => e == Animate) > 0;
    return [{ ...ui, clipboard: copied, asked: concat(ui.asked, fx), redraw: true, animating: ui.animating || animates }, nm] as const;
}

// an effect that copies a text
function isCopy(e: Effect): boolean {
    return match (e) {
        Copy(s) => true,
        _ => false,
    };
}

// the place the keyboard reaches whose message is `id` (-1: none)
function focusIndex(hits: Hit[n], id: i64): i64 {
    return id < 0 ? -1 : findIndex(hits, (h) => h.kind == FOCUS && h.id == id);
}

// the focus of the keyboard on a place that is not a field, its ring shown:
// Enter and Space click it
function activates(ui: Ui): boolean {
    const k = focusIndex(ui.hits, ui.focus);
    if (!ui.ring || k < 0) {
        return false;
    }
    const h = ui.hits[k];
    return count(ui.hits, (f) => f.kind == FIELD && f.x >= h.x && f.y >= h.y && f.x < h.x + h.w && f.y < h.y + h.h) == 0;
}

// the place of the focus clicked by the keyboard: pressed and released at
// its centre
function activated<M>(ui: Ui, m: M, update: (M, Input) => [M, Effect[]]): [Ui, M] {
    const h = ui.hits[focusIndex(ui.hits, ui.focus)];
    const [u1, m1] = told(ui, m, Click(h.id, h.w * 0.5f32, h.h * 0.5f32, -1, 1, ui.mods), update);
    return told(u1, m1, Release(h.id), update);
}

// the focus of the keyboard moved by Tab (Shift+Tab: back) to the next
// place it reaches, in the order of the view, around; the model told
function tabbed<M>(ui: Ui, m: M, back: boolean, update: (M, Input) => [M, Effect[]]): [Ui, M] {
    const places = filter(ui.hits, (h) => h.kind == FOCUS);
    if (places.length == 0) {
        return [ui, m] as const;
    }
    const at = findIndex(places, (h) => h.id == ui.focus);
    const next = at < 0 ? (back ? places.length - 1 : 0) : (back ? (at + places.length - 1) % places.length : (at + 1) % places.length);
    const id = places[next].id;
    return told({ ...ui, focus: id, ring: true, redraw: true }, m, Focus(id), update);
}

// a key that edits pressed: Tab moves the focus of the keyboard; Enter
// clicks the place of the focus when it shows and is not a field; Escape
// takes the focus back (its ring hidden; the model told, or given the key
// when the focus came from the pointer: a field leaves it); else the
// model's
function keyPressed<M>(ui: Ui, m: M, k: i64, update: (M, Input) => [M, Effect[]]): [Ui, M] {
    if (k == TAB) {
        return tabbed(ui, m, (ui.mods & WITH_SHIFT) != 0, update);
    }
    if (k == ENTER && activates(ui)) {
        return activated(ui, m, update);
    }
    if (k == ESCAPE) {
        const back = { ...ui, focus: -1, ring: false, redraw: true };
        return ui.ring ? told(back, m, Focus(-1), update) : told(back, m, Key(k, ui.mods), update);
    }
    return told(ui, m, Key(k, ui.mods), update);
}

// the character `c` typed: a dead key kept for the next character (its
// accent: `^` then `e` gives `ê`), a character after one with its accent
// when it takes one, else the accent alone then the character (a space:
// the accent alone)
function typed<M>(ui: Ui, m: M, c: i64, update: (M, Input) => [M, Effect[]]): [Ui, M] {
    if (c >= DEAD && c < DEAD + DEAD_ACCENTS) {
        return [{ ...ui, dead: c - DEAD }, m] as const;
    }
    if (ui.dead < 0) {
        return c == 32 && activates(ui) ? activated(ui, m, update) : told(ui, m, Text(c), update);
    }
    const accent = ui.dead;
    const both = composed(accent, c);
    if (both != 0) {
        return told({ ...ui, dead: -1 }, m, Text(both), update);
    }
    const [u1, m1] = told({ ...ui, dead: -1 }, m, Text(spacingAccent(accent)), update);
    return c == 32 ? [u1, m1] as const : told(u1, m1, Text(c), update);
}

// the offset of the box that scrolls `id` set to `v`, within `range`
function offsetSet(offsets: f32[n], id: i64, v: f32, range: f32): f32[n] {
    return id < 0 || id >= n ? offsets : map(iota(n), (i) => i == id ? min(range, max(0.0f32, v)) : offsets[i]);
}

// the place of the scrollbar of the box `id` (its index, -1: none)
function barOf(hits: Hit[n], id: i64): i64 {
    return fold(iota(n), -1, (found, i) => hits[i].kind == BAR && hits[i].id == id ? i : found);
}

// the interface and the model after the pointer moved to (x, y): a
// scrollbar dragged, the place pressed dragged, the place under the
// pointer, the scrollbar under it, its shape
function movedTo<M>(ui: Ui, m: M, x: f32, y: f32, t: u64, update: (M, Input) => [M, Effect[]]): [Ui, M] {
    const at = { ...ui, x: x, y: y };
    // a menu open: its entry under the pointer lit, nothing else
    if (ui.menu) {
        const e = menuAt(ui.hits, x, y);
        return [{ ...at, menuHover: e, cursor: ARROW, redraw: at.redraw || e != ui.menuHover }, m] as const;
    }
    if (ui.bar >= 0) {
        const b = barOf(ui.hits, ui.bar);
        if (b < 0) {
            return [at, m] as const;
        }
        const h = ui.hits[b];
        const off = ui.bar < ui.offsets.length ? ui.offsets[ui.bar] : 0.0f32;
        const [ty, th] = thumb(h.y, h.h, h.range, off, ui.scale);
        const room = max(1.0f32, h.h - 4.0f32 * ui.scale - th);
        return [{ ...at, offsets: offsetSet(ui.offsets, ui.bar, (y - ui.grab - h.y - 2.0f32 * ui.scale) / room * h.range, h.range), redraw: true }, m] as const;
    }
    const [u1, m1] = ui.pressed >= 0
        ? told(at, m, Drag(ui.pressed, x - ui.px, y - ui.py, ui.field >= 0 && ui.field < ui.hits.length ? offsetAt(ui.hits[ui.field], x) : -1), update)
        : [at, m] as const;
    const place = hitTest(u1.hits, x, y);
    // (the place under the pointer since `t`: its tooltip shown half a
    // second later)
    const [u2, m2] = ui.pressed < 0 && place != u1.hover ? told({ ...u1, hover: place, hoverSince: t, tipOff: false }, m1, Hover(place), update) : [u1, m1] as const;
    const b = barAt(u2.hits, x, y);
    const hot = b >= 0 ? u2.hits[b].id : -1;
    // (the shape kept while a place is pressed: a selection dragged out of
    // its field keeps its bar)
    const shape = ui.pressed >= 0 ? u2.cursor : cursorAt(u2.hits, x, y);
    return [{ ...u2, hotBar: hot, cursor: shape, redraw: u2.redraw || hot != ui.hotBar }, m2] as const;
}

// the interface and the model after the left button pressed at the pointer
// at the time `now`: a scrollbar grabbed or clicked (a page towards the
// pointer), else the place under the pointer clicked (where in it, where
// in the text of its field, the clicks counted)
function pressedAt<M>(ui: Ui, m: M, now: u64, update: (M, Input) => [M, Effect[]]): [Ui, M] {
    const b = barAt(ui.hits, ui.x, ui.y);
    if (b >= 0) {
        const h = ui.hits[b];
        const off = h.id < ui.offsets.length ? ui.offsets[h.id] : 0.0f32;
        const [ty, th] = thumb(h.y, h.h, h.range, off, ui.scale);
        if (ui.y >= ty && ui.y < ty + th) {
            return [{ ...ui, bar: h.id, grab: ui.y - ty, redraw: true }, m] as const;
        }
        const page = h.h * 0.9f32;
        return [{ ...ui, offsets: offsetSet(ui.offsets, h.id, ui.y < ty ? off - page : off + page, h.range), redraw: true }, m] as const;
    }
    const c = clickAt(ui.hits, ui.x, ui.y);
    if (c < 0) {
        return [ui, m] as const;
    }
    const p = ui.hits[c];
    const again = now - ui.clickTime < DOUBLE && abs(ui.x - ui.cx) < NEAR && abs(ui.y - ui.cy) < NEAR;
    const clicks = again ? min(3, ui.clicks + 1) : 1;
    const fi = fieldAt(ui.hits, c, ui.x, ui.y);
    // (a click places the caret at the boundary nearest the pointer; a
    // double click takes the word of the character under it)
    const at = fi < 0 ? -1 : (clicks == 2 ? charAt(ui.hits[fi], ui.x) : offsetAt(ui.hits[fi], ui.x));
    // (the focus of the keyboard follows the click, its ring hidden: it
    // shows only when the keyboard moves it)
    const reached = count(ui.hits, (h) => h.kind == FOCUS && h.id == p.id) > 0;
    // (a press hides the tooltip until the pointer comes to another place)
    const pressed = { ...ui, pressed: p.id, field: fi, px: p.x, py: p.y, clickTime: now, clicks: clicks, cx: ui.x, cy: ui.y, since: now, focus: reached ? p.id : -1, ring: false, tipOff: true, redraw: true };
    return told(pressed, m, Click(p.id, ui.x - p.x, ui.y - p.y, at, clicks, ui.mods), update);
}

// the entry of the menu at (x, y): its number, -1 for none (or one that
// cannot be chosen)
function menuAt(hits: Hit[n], x: f32, y: f32): i64 {
    return fold(hits, -1, (found, h) => h.kind == MENU && h.range > 0.0f32 && x >= h.x && x < h.x + h.w && y >= h.y && y < h.y + h.h ? h.id : found);
}

// the right button pressed: over a field, its menu opened at the pointer
// (the field given the focus first by a click when it has not)
function menuOpened<M>(ui: Ui, m: M, now: u64, update: (M, Input) => [M, Effect[]]): [Ui, M] {
    const c = clickAt(ui.hits, ui.x, ui.y);
    const fi = fieldAt(ui.hits, c, ui.x, ui.y);
    if (fi < 0) {
        return [ui, m] as const;
    }
    const h = ui.hits[fi];
    const [u1, m1] = h.id == 0 && c >= 0
        ? told({ ...ui, since: now }, m, Click(ui.hits[c].id, ui.x - ui.hits[c].x, ui.y - ui.hits[c].y, offsetAt(h, ui.x), 1, ui.mods), update)
        : [ui, m] as const;
    return [{ ...u1, menu: true, menuX: ui.x, menuY: ui.y, menuHover: -1, menuCut: h.range > 0.0f32, cursor: ARROW, redraw: true }, m1] as const;
}

// a button pressed with the menu open: an entry chosen (its shortcut given
// to the model), the menu closed
function menuPressed<M>(ui: Ui, m: M, now: u64, update: (M, Input) => [M, Effect[]]): [Ui, M] {
    const e = menuAt(ui.hits, ui.x, ui.y);
    const closed = { ...ui, menu: false, menuHover: -1, redraw: true };
    return e >= 0 && e < 4 ? told({ ...closed, since: now }, m, Key(MENU_KEYS[e], WITH_CTRL), update) : [closed, m] as const;
}

// the menu of a field drawn at its corner, within the window: what draws
// it and its places (its entries, those that can be chosen with a `range`
// of 1), over the view
// the tooltip `text` below and right of the pointer, within the window: a
// dark box of a line of 13 units
function tipLaidOut(ui: Ui, f: Font, text: string): Primitive[] {
    const k = ui.scale;
    const w = lineWidth(f, 13.0f32 * k, text) + 22.0f32 * k;
    const h = (13.0f32 * 1.4f32 + 12.0f32) * k;
    const x = max(0.0f32, min(ui.x + 12.0f32 * k, f32(ui.w) - w - 2.0f32));
    const below = ui.y + 22.0f32 * k;
    const y = below + h < f32(ui.h) ? below : max(0.0f32, ui.y - h - 6.0f32 * k);
    const box = Div({ ...style(), padX: 11.0f32, padY: 6.0f32, background: rgb(0x111827u32), radius: 6.0f32, shadowBlur: 8.0f32, shadowY: 3.0f32, shadowColor: rgba(0.0f32, 0.0f32, 0.0f32, 0.2f32) }, [Label(textStyle(13.0f32, rgb(0xFFFFFFu32)), text)]);
    const [ps, hits] = placeFrame(f, scaledElement(box, k), x, y, w, h, { offsets: [], caretOn: false, hotBar: -1, scale: k, deferred: true });
    return ps;
}

function menuLaidOut(ui: Ui, f: Font): [Primitive[], Hit[]] {
    const n = min(4, ui.labels.length);
    const enabled = (k: i64) => k >= 2 || ui.menuCut;
    const entries = map(iota(n), (k) => Div({
        ...style(),
        width: Fill(1.0f32),
        height: Px(28.0f32),
        padding: 6.0f32,
        background: ui.menuHover == k ? rgb(0xE5EDFFu32) : rgba(0.0f32, 0.0f32, 0.0f32, 0.0f32),
        radius: 4.0f32,
        onClick: k,
        cursor: ARROW,
    }, [Label(textStyle(14.0f32, enabled(k) ? rgb(0x111827u32) : rgb(0x9CA3AFu32)), ui.labels[k])]));
    const w = 200.0f32 * ui.scale;
    const h = (8.0f32 + 28.0f32 * f32(n)) * ui.scale;
    const x = max(0.0f32, min(ui.menuX, f32(ui.w) - w - 2.0f32));
    const y = max(0.0f32, min(ui.menuY, f32(ui.h) - h - 2.0f32));
    const box = Div({
        ...style(),
        padding: 4.0f32,
        background: rgb(0xFFFFFFu32),
        border: 1.0f32,
        borderColor: rgb(0xD1D5DBu32),
        radius: 8.0f32,
        shadowBlur: 10.0f32,
        shadowY: 4.0f32,
        shadowColor: rgba(0.0f32, 0.0f32, 0.0f32, 0.18f32),
        cursor: ARROW,
    }, entries);
    const [ps, hits] = placeFrame(f, scaledElement(box, ui.scale), x, y, w, h, { offsets: [], caretOn: false, hotBar: -1, scale: ui.scale, deferred: true });
    // (its entries as entries of a menu; its box a place of its own, which
    // a click closes the menu on)
    const own = map(hits, (p) => p.kind == CLICK ? { ...p, kind: MENU, range: enabled(p.id) ? 1.0f32 : 0.0f32 } : p);
    return [ps, concat([placeOf(x, y, w, h, -1, MENU, 0.0f32, ARROW)], own)] as const;
}

// the interface and the model after the event `ev` at the time `now` (what
// the model asks added to `asked`)
// (compiled once, called by each loop of each system)
@noInline
export function step<M>(ui: Ui, m: M, ev: Ev, now: u64, update: (M, Input) => [M, Effect[]]): [Ui, M] {
    const [u1, m1] = stepOnce(ui, m, ev, now, update);
    const resized = match (ev) {
        Resized(w, h) => true,
        Scaled(k) => true,
        _ => false,
    };
    return viewports(u1, m1, ui.offsets, resized, 0, update);
}

// the model told where each box that scrolls is whose offset changed from
// `before` (every one the view shows when `all`: the window resized), from
// the `k`-th, in units
function viewports<M>(ui: Ui, m: M, before: f32[n], all: boolean, k: i64, update: (M, Input) => [M, Effect[]]): [Ui, M] {
    if (k >= n || k >= ui.offsets.length) {
        return [ui, m] as const;
    }
    const shown = all && count(ui.hits, (h) => h.kind == WHEEL && h.id == k) > 0;
    if (ui.offsets[k] != before[k] || shown) {
        const [u1, m1] = told(ui, m, Viewport(k, ui.offsets[k] / ui.scale, f32(ui.h) / ui.scale), update);
        return viewports(u1, m1, before, all, k + 1, update);
    }
    return viewports(ui, m, before, all, k + 1, update);
}

// one event given to the interface (`step` tells the boxes that scroll
// after it)
function stepOnce<M>(ui: Ui, m: M, ev: Ev, now: u64, update: (M, Input) => [M, Effect[]]): [Ui, M] {
    return match (ev) {
        Moved(x, y) => movedTo(ui, m, x, y, now, update),
        // the model told the time of a frame while it animates (it asks the
        // next one again by `Animate`)
        Elapsed => ui.animating ? told({ ...ui, animating: false, tickAt: now }, m, Tick(i64(now / 1000000u64)), update) : [ui, m] as const,
        Down(b) => ui.menu ? menuPressed(ui, m, now, update) : (b == 0 ? pressedAt(ui, m, now, update) : (b == 1 ? menuOpened(ui, m, now, update) : [ui, m] as const)),
        Up(b) => {
            if (b != 0) {
                return [ui, m] as const;
            }
            if (ui.bar >= 0) {
                return [{ ...ui, bar: -1, redraw: true }, m] as const;
            }
            if (ui.pressed < 0) {
                return [ui, m] as const;
            }
            const [u1, m1] = told({ ...ui, pressed: -1, field: -1 }, m, Release(ui.pressed), update);
            return [{ ...u1, cursor: cursorAt(u1.hits, ui.x, ui.y) }, m1] as const;
        },
        Scroll(dy) => [{ ...ui, offsets: scrolled(ui.offsets, ui.hits, ui.x, ui.y, dy * ui.scale), redraw: true }, m] as const,
        Typed(c) => typed({ ...ui, since: now }, m, c, update),
        // (Escape closes the menu; another key closes it and is the model's)
        // (a key forgets an accent typed before it: Backspace and Escape do
        // nothing else then)
        Pressed(k) => ui.menu && k == ESCAPE ? [{ ...ui, menu: false, menuHover: -1, dead: -1, redraw: true }, m] as const
            : (ui.dead >= 0 && (k == BACKSPACE || k == ESCAPE) ? [{ ...ui, dead: -1 }, m] as const
            : keyPressed({ ...ui, since: now, menu: false, menuHover: -1, dead: -1 }, m, k, update)),
        Mods(mods) => [{ ...ui, mods: mods }, m] as const,
        Resized(w, h) => [{ ...ui, w: w, h: h, redraw: true }, m] as const,
        // the pixels of a unit (the density of the screen): the offsets of
        // the boxes that scroll kept in units
        Scaled(k) => [{ ...ui, scale: k, offsets: map(ui.offsets, (o) => o * k / ui.scale), redraw: true }, m] as const,
        Closed => [{ ...ui, closed: true }, m] as const,
        Pasted(s) => told({ ...ui, since: now }, m, Paste(s), update),
    };
}

// `step` for each of the events `evs`; a paste asked given at once the
// clipboard of the interface
export function steps<M>(ui: Ui, m: M, evs: Ev[n], now: u64, update: (M, Input) => [M, Effect[]]): [Ui, M] {
    return fold(evs, [ui, m] as const, (acc, ev) => {
        const [u, mm] = acc;
        const before = u.asked.length;
        const [u1, m1] = step(u, mm, ev, now, update);
        const asks = count(iota(u1.asked.length - before), (k) => u1.asked[before + k] == AskPaste) > 0;
        return asks ? step(u1, m1, Pasted(u1.clipboard), now, update) : [u1, m1] as const;
    });
}

// the caret shown at the time `now`: for 530 ms from the last input, then
// hidden and shown in turn
export function caretShown(ui: Ui, now: u64): boolean {
    return ((now - ui.since) / BLINK) % 2u64 == 0u64;
}

// the milliseconds until the caret blinks (-1: no caret, no limit)
export function wakeIn(ui: Ui, now: u64): i64 {
    const k = (now - ui.since) / BLINK;
    const blink = ui.caret ? max(1, i64((ui.since + (k + 1u64) * BLINK - now) / 1000000u64) + 1) : -1;
    // the next frame of an animation, the tooltip of the place under the
    // pointer
    const frame = ui.animating ? (now >= ui.tickAt + FRAME ? 1 : max(1, i64((ui.tickAt + FRAME - now) / 1000000u64) + 1)) : -1;
    const tip = ui.tipDue ? (now >= ui.hoverSince + TIP_DELAY ? 1 : max(1, i64((ui.hoverSince + TIP_DELAY - now) / 1000000u64) + 1)) : -1;
    return soonest(soonest(blink, frame), tip);
}

// the sooner of two waits in milliseconds (-1: none)
function soonest(a: i64, b: i64): i64 {
    return a < 0 ? b : (b < 0 ? a : min(a, b));
}

// the time between two frames of an animation, and before a tooltip shows,
// in nanoseconds
const FRAME: u64 = 16000000u64;
const TIP_DELAY: u64 = 500000000u64;

// what time asks at `now`: a frame of an animation (the model told the
// time), and whether the window must be drawn again (the caret blinked, a
// tooltip is due, a frame of an animation)
export function timed<M>(ui: Ui, m: M, now: u64, update: (M, Input) => [M, Effect[]]): [Ui, M, boolean] {
    const [u1, m1] = ui.animating && now >= ui.tickAt + FRAME ? step(ui, m, Elapsed, now, update) : [ui, m] as const;
    const blink = u1.caret && caretShown(u1, now) != u1.caretOn;
    const tip = u1.tipDue && now >= u1.hoverSince + TIP_DELAY;
    return [u1, m1, blink || tip || u1.redraw] as const;
}

// the ring of the focus around the place `h`: 2 units wide, 2 units away,
// its corners those of the place, blue
function ringOf(h: Hit, k: f32): Primitive {
    const gap = 2.0f32 * k;
    const w = 2.0f32 * k;
    return Box(rounded(bordered(quad(h.x - gap - w, h.y - gap - w, h.w + 2.0f32 * (gap + w), h.h + 2.0f32 * (gap + w), transparent()), w, rgba(0.231f32, 0.510f32, 0.965f32, 0.85f32)), h.range + gap + w));
}

// the view of `m` laid out at the size of the window at the time `now`:
// what draws it, and the interface with its places (whether a field holds
// the focus: a caret to blink)
@noInline
export function laidOut<M>(ui: Ui, f: Font, m: M, view: (M) => Element, now: u64): [Primitive[], Ui] {
    const shown = caretShown(ui, now);
    // (its glyphs `Pending`: their images those the atlas keeps, the others
    // drawn once and kept)
    const e = view(m);
    const [vps, vhits] = placeFrame(f, scaledElement(e, ui.scale), 0.0f32, 0.0f32, f32(ui.w), f32(ui.h), { offsets: ui.offsets, caretOn: shown, hotBar: ui.hotBar, scale: ui.scale, deferred: true });
    const caret = count(vhits, (h) => h.kind == FIELD && h.id == 1) > 0;
    // the ring of the focus of the keyboard around its place, then the menu,
    // over the view
    const fk = focusIndex(vhits, ui.focus);
    const ring = ui.ring && fk >= 0 ? [ringOf(vhits[fk], ui.scale)] : [];
    const [mps, mhits] = ui.menu ? menuLaidOut(ui, f) : [[], []] as const;
    // the tooltip of the place under the pointer, half a second after it
    // came there (none while a button is held or the menu is open)
    const tip = ui.hover >= 0 && ui.pressed < 0 && !ui.menu && !ui.tipOff ? tipOf(e, ui.hover) : "";
    const due = tip != "" && now >= ui.hoverSince + TIP_DELAY;
    const tps = due ? tipLaidOut(ui, f, tip) : [];
    const [ps, atlas] = resolved(f, ui.atlas, concat(concat(concat(vps, ring), tps), mps));
    const hits = concat(vhits, mhits);
    // the place under the pointer, its shape, as the new places have them
    const hover = ui.pressed >= 0 ? ui.cursor : cursorAt(hits, ui.x, ui.y);
    return [ps, { ...ui, hits: hits, caret: caret, caretOn: shown, cursor: hover, redraw: false, atlas: atlas, tipDue: tip != "" && !due }] as const;
}

// the font of the file `paths[i]`, or of the first after it that is one;
// the reasons of those that are not
action firstFont(paths: string[n], i: i64, reasons: string): Result<Font, string> {
    if (i >= n) {
        return Err(`no font found:${reasons}`);
    }
    return match (sys.readFile(paths[i])) {
        Ok(b) => match (parse(b)) {
            Ok(f) => Ok(f),
            Err(e) => firstFont(paths, i + 1, `${reasons}\n  ${paths[i]}: ${e}`),
        },
        Err(e) => firstFont(paths, i + 1, `${reasons}\n  ${paths[i]}: ${sys.message(e)}`),
    };
}

// the font of an application: the file of `--font=file` among its
// arguments; else DejaVuSans.ttf beside the program (under Windows), in the
// current folder, then a font of the system: Segoe UI or Arial under
// Windows, DejaVu Sans in the usual folders of Linux (a program started
// from elsewhere than its folder, or alone, still finds one)
export action loadFont(args: string[k]): Result<Font, string> {
    const at = findIndex(args, (a) => a.startsWith("--font="));
    if (at >= 0) {
        return firstFont([args[at].slice(7, args[at].length)], 0, "");
    }
    if (sys.platform() == "windows") {
        const beside = match (win.programPath()) {
            Ok(p) => [`${p.slice(0, p.lastIndexOf("\\") + 1)}DejaVuSans.ttf`],
            Err(e) => [],
        };
        const root = match (sys.env("WINDIR")) {
            Some(w) => w,
            None => "C:\\Windows",
        };
        return firstFont(concat(beside, ["DejaVuSans.ttf", `${root}\\Fonts\\segoeui.ttf`, `${root}\\Fonts\\arial.ttf`]), 0, "");
    }
    return firstFont(["DejaVuSans.ttf", "/usr/share/fonts/truetype/dejavu/DejaVuSans.ttf", "/usr/share/fonts/TTF/DejaVuSans.ttf", "/usr/share/fonts/dejavu/DejaVuSans.ttf", "/usr/share/fonts/dejavu-sans-fonts/DejaVuSans.ttf"], 0, "");
}

// a failure of the application `title` shown: under Windows in a box of
// messages (a program without a console has no other place to show it),
// elsewhere printed
export action fail(title: string, text: string): void {
    if (sys.platform() == "windows") {
        win.alert(title, text);
    } else {
        print(`${title}: ${text}`);
    }
}

// the application titled `title` in a window of `width` by `height` pixels
// (its first size), its model `m` at the start, until the window is
// closed: its model then. `view` gives the elements of a model; `update`
// the model after an input of the hand, and what it asks
export action run<M>(title: string, width: i64, height: i64, f: Font, m: M, view: (M) => Element, update: (M, Input) => [M, Effect[]]): M {
    return runWith(title, width, height, englishMenu(), f, m, view, update);
}

// `run`, the texts of the entries of the menu of a field given (cut, copy,
// paste, select all)
export action runWith<M>(title: string, width: i64, height: i64, labels: string[], f: Font, m: M, view: (M) => Element, update: (M, Input) => [M, Effect[]]): M {
    if (sys.platform() == "windows") {
        return runWindows(title, width, height, labels, f, m, view, update);
    }
    // Wayland when its compositor is named, else X11 (the server of
    // DISPLAY), as GPUI chooses
    const wayland = sys.env("WAYLAND_DISPLAY") ?? "";
    if (wayland != "" || (sys.env("DISPLAY") ?? "") == "") {
        return runWayland(title, width, height, labels, f, m, view, update);
    }
    return runX11(title, width, height, labels, f, m, view, update);
}

// ----- Windows ---------------------------------------------------------

// the view of `m` laid out in the window, drawn and shown: the interface
// with its places
action frame<M>(w: win.Window, f: Font, m: M, view: (M) => Element, ui: Ui): Ui {
    const [ps, next] = laidOut(ui, f, m, view, clock());
    const shown = win.show(w, render(ui.w, ui.h, rgb(0xFFFFFFu32), ps), ui.w, ui.h);
    return next;
}

action runWindows<M>(title: string, width: i64, height: i64, labels: string[], f: Font, m: M, view: (M) => Element, update: (M, Input) => [M, Effect[]]): M {
    return match (win.open(title, width, height)) {
        Ok(w) => {
            const [cw, ch] = win.clientSize(w);
            // the pixels of a unit: the density of its screen
            const ui = frame(w, f, m, view, { ...interface(cw, ch, clock()), labels: labels, scale: f32(win.dpi(w)) / 96.0f32 });
            const end = loopWindows(w, f, m, ui, 0, ARROW, view, update);
            win.close(w);
            return end;
        },
        Err(e) => {
            fail(title, `the window could not be opened: ${sys.message(e)}`);
            return m;
        },
    };
}

// the key that edits of the virtual key `k` (0: none)
function editKey(k: i64): i64 {
    return k == 8 ? BACKSPACE : (k == 9 ? TAB : (k == 13 ? ENTER : (k == 27 ? ESCAPE
        : (k == 37 ? LEFT : (k == 38 ? UP : (k == 39 ? RIGHT : (k == 40 ? DOWN : (k == 46 ? DELETE : (k == 36 ? HOME : (k == 35 ? END : 0))))))))));
}

// the bit of the modifier of the virtual key `k` (Shift 16, Ctrl 17, Alt
// 18; 0: none)
function modifierOf(k: i64): i64 {
    return k == 16 ? WITH_SHIFT : (k == 17 ? WITH_CTRL : (k == 18 ? WITH_ALT : 0));
}

// the events of the hand of the events of a window of Windows: the
// modifiers followed (`mods`), a pair of units of UTF-16 joined (`high`,
// the first of a pair waiting), the keys that edit and the letters held
// with Ctrl (not with AltGr: Ctrl and Alt, which types characters) as
// keys, the characters a space or above as characters
function fromWindows(evs: win.Event[n], mods: i64, high: i64): [Ev[], i64, i64] {
    return readFrom(evs, 0, [], mods, high);
}

// `fromWindows` from the `i`-th event, after the events of the hand `out`
function readFrom(evs: win.Event[n], i: i64, out: Ev[], mods: i64, high: i64): [Ev[], i64, i64] {
    if (i >= n) {
        return [out, mods, high] as const;
    }
    return match (evs[i]) {
        win.Resize(a, b) => readFrom(evs, i + 1, concat(out, [Resized(a, b)]), mods, high),
        win.Pointer(a, b) => readFrom(evs, i + 1, concat(out, [Moved(f32(a) + 0.5f32, f32(b) + 0.5f32)]), mods, high),
        win.Button(b, down) => readFrom(evs, i + 1, concat(out, [down ? Down(b) : Up(b)]), mods, high),
        // a notch (120) of the wheel: 48 pixels
        win.Wheel(d) => readFrom(evs, i + 1, concat(out, [Scroll(-f32(d) * 0.4f32)]), mods, high),
        win.Key(k, down, s) => {
            const bit = modifierOf(k);
            if (bit != 0) {
                const nm = down ? mods | bit : mods & (~bit);
                return readFrom(evs, i + 1, concat(out, [Mods(nm)]), nm, high);
            }
            const edit = editKey(k);
            const ctrlOnly = (mods & WITH_CTRL) != 0 && (mods & WITH_ALT) == 0;
            const code = edit != 0 ? edit : (ctrlOnly && k >= 65 && k <= 90 ? k + 32 : 0);
            return readFrom(evs, i + 1, down && code != 0 ? concat(out, [Pressed(code)]) : out, mods, high);
        },
        win.Char(u) => {
            if (u >= 0xD800 && u < 0xDC00) {
                return readFrom(evs, i + 1, out, mods, u);
            }
            const c = u >= 0xDC00 && u < 0xE000 && high > 0 ? 0x10000 + (high - 0xD800) * 1024 + (u - 0xDC00) : u;
            return readFrom(evs, i + 1, c >= 32 && c != 127 ? concat(out, [Typed(c)]) : out, mods, 0);
        },
        win.Close => readFrom(evs, i + 1, concat(out, [Closed]), mods, high),
        // another density of screen (the window resized by Windows)
        win.Dpi(d) => readFrom(evs, i + 1, concat(out, [Scaled(f32(d) / 96.0f32)]), mods, high),
        _ => readFrom(evs, i + 1, out, mods, high),
    };
}

// the events of the hand `evs` from the `i`-th, each given to `step` in its
// order, what the model asks done at once: a text copied put on the
// clipboard of the system, a paste given its text (that of the interface
// when the system's is not reached)
action feedWindows<M>(w: win.Window, ui: Ui, m: M, evs: Ev[n], i: i64, now: u64, update: (M, Input) => [M, Effect[]]): [Ui, M] {
    if (i >= n || ui.closed) {
        return [ui, m] as const;
    }
    const [u1, m1] = step(ui, m, evs[i], now, update);
    // (ISC_UI_TRACE set: each event of the hand printed, with its time and
    // the clicks counted)
    if (sys.env("ISC_UI_TRACE") != None) {
        print([i64(now / 1000000u64), evs[i], u1.clicks, u1.cursor] as const);
    }
    const [u2, m2] = askedWindows(w, { ...u1, asked: [] }, m1, u1.asked, 0, now, update);
    return feedWindows(w, u2, m2, evs, i + 1, now, update);
}

// what the model asked (`fx` from the `k`-th), done
@noInline
action askedWindows<M>(w: win.Window, ui: Ui, m: M, fx: Effect[n], k: i64, now: u64, update: (M, Input) => [M, Effect[]]): [Ui, M] {
    if (k >= n) {
        return [ui, m] as const;
    }
    return match (fx[k]) {
        Copy(s) => {
            const put = win.clipboardSet(w, s);
            return askedWindows(w, ui, m, fx, k + 1, now, update);
        },
        AskPaste => {
            const text = match (win.clipboardGet(w)) {
                Ok(t) => t,
                Err(e) => ui.clipboard,
            };
            const [u1, m1] = step(ui, m, Pasted(text), now, update);
            return askedWindows(w, { ...u1, asked: [] }, m1, fx, k + 1, now, update);
        },
        // (the frames of an animation: the loop asks them)
        Animate => askedWindows(w, ui, m, fx, k + 1, now, update),
    };
}

// the events of the window until it is closed, the caret blinking between
// them, the shape of the pointer (`shape`: that set) following the places
action loopWindows<M>(w: win.Window, f: Font, m: M, ui: Ui, high: i64, shape: i64, view: (M) => Element, update: (M, Input) => [M, Effect[]]): M {
    return match (win.events(w, wakeIn(ui, clock()))) {
        Ok(evs) => {
            const now = clock();
            const [ins, mods, nh] = fromWindows(evs, ui.mods, high);
            const [u0, m0] = feedWindows(w, ui, m, ins, 0, now, update);
            if (u0.closed) {
                return m0;
            }
            // what time asks: the caret blinked, a frame of an animation, a
            // tooltip due; drawn again
            const [u1, m1, due] = timed(u0, m0, now, update);
            const next = due && u1.w > 0 && u1.h > 0 ? frame(w, f, m1, view, u1) : u1;
            if (next.cursor != shape) {
                win.setCursor(w, next.cursor);
            }
            return loopWindows(w, f, m1, next, nh, next.cursor, view, update);
        },
        Err(e) => m,
    };
}

// ----- Wayland ---------------------------------------------------------

// what the loop keeps from one read to the next: the bytes of an event cut
// by a read, whether the window is shown, the next id of an object (the
// compositor takes them in their order), the objects of the image shown
// (its pool and its buffer, 0: none), the keyboard (its table, its
// modifiers as Wayland gives them); the pointer: the serial of its entry
// (0: outside the window), the shape shown (-1: none yet), the device of
// the shapes the compositor draws (0: none), else the surface and the
// first buffer of the images the program draws; the end
type State = {
    pending: u8[],
    shown: boolean,
    next: u32,
    pool: u32,
    buffer: u32,
    keymap: Keymap,
    mods: u32,
    entry: u32,
    shape: i64,
    shapes: u32,
    cursorSurface: u32,
    cursorFirst: u32,
    cursorScale: i64,
    output: u32,
    scale: i64,
    lw: i64,
    lh: i64,
    manager: u32,
    device: u32,
    lastOffer: u32,
    lastMime: string,
    offer: u32,
    mime: string,
    source: u32,
    text: string,
    serial: u32,
    fds: i32[],
    fdAt: i64,
    done: boolean,
    failed: string,
};

// the bytes `b` are UTF-8 (each character its leading byte and the right
// number of bytes after it)
function utf8Valid(b: u8[n]): boolean {
    const left = fold(b, 0, (need, x) => {
        if (need < 0) {
            return need;
        }
        if (need > 0) {
            return (x & 0xC0u8) == 0x80u8 ? need - 1 : -1;
        }
        return x < 0x80u8 ? 0 : ((x & 0xE0u8) == 0xC0u8 ? 1 : ((x & 0xF0u8) == 0xE0u8 ? 2 : ((x & 0xF8u8) == 0xF0u8 ? 3 : -1)));
    });
    return left == 0;
}

// the bytes of `b` from now to its end (a second at most without any)
action readAll(b: net.Conn, acc: u8[]): u8[] {
    const ready = match (unix.poll([unix.fdOf(b)], 1000)) {
        Ok(rs) => rs[0] != 0i32,
        Err(e) => false,
    };
    if (!ready) {
        return acc;
    }
    return match (net.read(b, 65536)) {
        Ok(x) => x.length == 0 ? acc : readAll(b, concat(acc, x)),
        Err(e) => acc,
    };
}

// the text of the selection of another program (the offer `offer` of the
// type `mime`): a pair of sockets made (a name of the abstract space, one
// end accepted), one end given to the compositor, which the program writes
// the text into, the other read to its end; "" when it fails
@noInline
action readOffer(c: net.Conn, offer: u32, mime: string): string {
    const name = `@isocron-ui-paste-${clock()}`;
    return match (unix.listen(name)) {
        Ok(l) => match (unix.connect(name)) {
            Ok(a) => match (unix.accept(l)) {
                Ok(b) => {
                    const sent = unix.sendWithFds(c, wl.receiveRequest(offer, mime), [unix.fdOf(a)]);
                    net.close(a);
                    net.closeListener(l);
                    const bytes = readAll(b, []);
                    net.close(b);
                    return utf8Valid(bytes) ? stringOf(bytes) : "";
                },
                Err(e) => {
                    net.close(a);
                    net.closeListener(l);
                    return "";
                },
            },
            Err(e) => {
                net.closeListener(l);
                return "";
            },
        },
        Err(e) => "",
    };
}

// the text `text` made the selection of the seat (a source of data of
// this program, the one before destroyed), given to the programs that
// paste it (`sent`); nothing without a device of data
@noInline
action offered(c: net.Conn, st: State, text: string): State {
    if (st.manager == 0u32 || st.device == 0u32) {
        return st;
    }
    const old = st.source != 0u32 ? net.write(c, wl.sourceDestroy(st.source)) : Ok(());
    const made = net.write(c, wl.selectionRequests(st.manager, st.next, st.device, st.serial));
    return { ...st, source: st.next, next: st.next + 1u32, text: text };
}

// the event `ev` given to `step`, what the model asks done: a text copied
// made the selection of the seat; a paste given the selection when it is
// another program's (this program's source no longer the selection), else
// the program's clipboard
@noInline
action feedWayland<M>(c: net.Conn, ui: Ui, m: M, now: u64, st: State, update: (M, Input) => [M, Effect[]], ev: Ev): [M, Ui, State] {
    const [u1, m1] = step(ui, m, ev, now, update);
    const copied = count(u1.asked, (e) => isCopy(e)) > 0;
    const asks = count(u1.asked, (e) => e == AskPaste) > 0;
    const st1 = copied ? offered(c, st, u1.clipboard) : st;
    if (!asks) {
        return [m1, { ...u1, asked: [] }, st1] as const;
    }
    const external = st1.source == 0u32 && st1.offer != 0u32 && st1.mime != "";
    const text = external ? readOffer(c, st1.offer, st1.mime) : u1.clipboard;
    const [u2, m2] = step({ ...u1, asked: [] }, m1, Pasted(text), now, update);
    return [m2, { ...u2, asked: [] }, st1] as const;
}

// the images of the pointer drawn here made again at `k` pixels a unit (a
// surface, a pool, three buffers at the next ids; the pool's id the
// surface's plus one), those before destroyed
@noInline
action cursorImages(c: net.Conn, st: State, k: i64): State {
    const side = cursors.SIDE * k;
    return match (unix.shared(3 * side * side * 4)) {
        Ok(mem) => {
            const written = unix.writeSharedU32(mem, 0, concat(concat(cursors.imageAt(0, k), cursors.imageAt(1, k)), cursors.imageAt(2, k)));
            const sent = unix.sendWithFds(c, wl.pointerImageRequests(st.next, st.next + 1u32, st.next + 2u32, 3, side), [unix.sharedFd(mem)]);
            unix.closeShared(mem);
            const old = net.write(c, wl.pointerImagesDestroy(st.cursorSurface, st.cursorSurface + 1u32, st.cursorFirst, 3));
            return { ...st, cursorSurface: st.next, cursorFirst: st.next + 2u32, cursorScale: k, next: st.next + 5u32, shape: -1 };
        },
        Err(e) => st,
    };
}

// the shape of the pointer `shape` shown at its entry
@noInline
action shapeShown(c: net.Conn, st: State, shape: i64): State {
    if (st.entry == 0u32 || shape == st.shape) {
        return st;
    }
    const [hx, hy] = cursors.hotSpot(shape);
    const sent = st.shapes != 0u32
        ? net.write(c, wl.shapeRequest(st.shapes, st.entry, shape))
        : net.write(c, wl.pointerImageRequest(st.cursorSurface, st.cursorFirst + u32(shape), cursors.SIDE * st.cursorScale, st.cursorScale, st.entry, hx, hy));
    return { ...st, shape: shape };
}

action globals(c: net.Conn, pending: u8[], g: wl.Globals): wl.Globals {
    return match (unix.receiveWithFds(c, 65536, 8)) {
        Ok(r) => {
            const [evs, rest] = wl.events(concat(pending, r.bytes));
            const g2 = wl.globalsOf(evs, g);
            return count(evs, (e) => e.obj == wl.SYNC) > 0 || r.bytes.length == 0 ? g2 : globals(c, rest, g2);
        },
        Err(e) => g,
    };
}

// the view of `m` drawn into a new memory shared with the compositor and
// shown as the `images`-th image, the previous one destroyed; the
// interface with its places
action drawWayland<M>(c: net.Conn, f: Font, m: M, view: (M) => Element, ui: Ui, st: State): [Ui, State] {
    const [ps, next] = laidOut(ui, f, m, view, clock());
    const pool = st.next;
    const buffer = st.next + 1u32;
    return match (unix.shared(ui.w * ui.h * 4)) {
        Ok(mem) => {
            const written = unix.writeSharedU32(mem, 0, render(ui.w, ui.h, rgb(0xFFFFFFu32), ps));
            const sent = unix.sendWithFds(c, wl.imageRequests(pool, buffer, ui.w * ui.h * 4, ui.w, ui.h), [unix.sharedFd(mem)]);
            unix.closeShared(mem);
            const old = st.pool != 0u32 ? net.write(c, wl.destroyRequests(st.pool, st.buffer)) : Ok(());
            const drawn = { ...st, next: st.next + 2u32, pool: pool, buffer: buffer };
            return written == Ok(()) && sent == Ok(()) ? [next, drawn] as const : [next, { ...drawn, done: true, failed: "an image not sent" }] as const;
        },
        Err(e) => [next, { ...st, done: true, failed: sys.message(e) }] as const,
    };
}

// the table of the keyboard, from its descriptor (`bytes` bytes, ended by a
// zero)
action keymapOf(fd: i32, bytes: i64): Keymap {
    const km = match (unix.mapShared(fd, bytes, false)) {
        Ok(mem) => {
            const text = match (unix.readShared(mem, 0, bytes)) {
                Ok(b) => stringOf(b.slice(0, findIndex(b, (x) => x == 0u8) < 0 ? b.length : findIndex(b, (x) => x == 0u8))),
                Err(e) => "",
            };
            unix.closeShared(mem);
            return parseKeymap(text);
        },
        Err(e) => parseKeymap(""),
    };
    return km;
}

action runWayland<M>(title: string, width: i64, height: i64, labels: string[], f: Font, m: M, view: (M) => Element, update: (M, Input) => [M, Effect[]]): M {
    const path = wl.socketPath(sys.env("WAYLAND_DISPLAY") ?? "", sys.env("XDG_RUNTIME_DIR") ?? "/tmp");
    return match (unix.connect(path)) {
        Ok(c) => {
            const asked = net.write(c, concat(wl.request(wl.DISPLAY, 1u32, wl.le32(wl.REGISTRY)), wl.request(wl.DISPLAY, 0u32, wl.le32(wl.SYNC))));
            const g = globals(c, [], { compositor: 0u32, shm: 0u32, wmBase: 0u32, seat: 0u32, cursorShape: 0u32, output: 0u32, data: 0u32 });
            if (g.compositor == 0u32 || g.shm == 0u32 || g.wmBase == 0u32) {
                net.close(c);
                return m;
            }
            const made = net.write(c, wl.windowRequests(g, title));
            // the shapes of the pointer: drawn by the compositor when it can
            // (ids 13 and 14), else three images drawn here (a surface, a
            // pool, three buffers: 13 to 17)
            const shaped = g.cursorShape != 0u32 ? net.write(c, wl.shapeRequests(g, wl.POOL, wl.POOL + 1u32)) : Ok(());
            const images = g.cursorShape != 0u32 ? Ok(()) : match (unix.shared(3 * cursors.SIDE * cursors.SIDE * 4)) {
                Ok(mem) => {
                    const w0 = unix.writeSharedU32(mem, 0, concat(concat(cursors.image(0), cursors.image(1)), cursors.image(2)));
                    const sent = unix.sendWithFds(c, wl.pointerImageRequests(wl.POOL, wl.POOL + 1u32, wl.POOL + 2u32, 3, cursors.SIDE), [unix.sharedFd(mem)]);
                    unix.closeShared(mem);
                    return sent;
                },
                Err(e) => Err(e),
            };
            const st = {
                pending: [], shown: false, next: g.cursorShape != 0u32 ? wl.POOL + 2u32 : wl.POOL + 5u32, pool: 0u32, buffer: 0u32,
                keymap: parseKeymap(""), mods: 0u32, entry: 0u32, shape: -1,
                shapes: g.cursorShape != 0u32 ? wl.POOL + 1u32 : 0u32, cursorSurface: wl.POOL, cursorFirst: wl.POOL + 2u32, cursorScale: 1,
                output: 0u32, scale: 1, lw: width, lh: height,
                manager: 0u32, device: 0u32, lastOffer: 0u32, lastMime: "", offer: 0u32, mime: "", source: 0u32, text: "", serial: 0u32, fds: [], fdAt: 0,
                done: false, failed: "",
            };
            // the first screen, for its scale (the next id)
            const st1 = g.output != 0u32 ? { ...st, output: st.next, next: st.next + 1u32 } : st;
            const bound = g.output != 0u32 ? net.write(c, wl.outputRequests(g, st.next)) : Ok(());
            // the selections of the other programs: the manager of the data
            // and the device of the seat (the next two ids)
            const st2 = g.data != 0u32 && g.seat != 0u32 ? { ...st1, manager: st1.next, device: st1.next + 1u32, next: st1.next + 2u32 } : st1;
            const data = g.data != 0u32 && g.seat != 0u32 ? net.write(c, wl.dataRequests(g, st1.next, st1.next + 1u32)) : Ok(());
            const end = loopWayland(c, f, m, { ...interface(width, height, clock()), labels: labels }, st2, view, update);
            net.close(c);
            return end;
        },
        Err(e) => m,
    };
}

// the modifiers of Wayland (the usual tables: Shift 1, Control 4, Mod1 8)
// as those of input.isc
function modsOf(mods: u32): i64 {
    return ((mods & 1u32) != 0u32 ? WITH_SHIFT : 0) | ((mods & 4u32) != 0u32 ? WITH_CTRL : 0) | ((mods & 8u32) != 0u32 ? WITH_ALT : 0);
}

// the event of the hand of a character `ch` of the keyboard: the keys that
// edit and the letters held with Ctrl (not with AltGr) as keys, the
// characters a space or above as characters (none: -1 as a character)
function keyEvent(ch: i64, mods: u32): Ev {
    const ctrl = (mods & 4u32) != 0u32 && (mods & 128u32) == 0u32;
    if (ch == 8 || ch == 9 || ch == 13 || ch == 27 || ch >= 0x110000) {
        return Pressed(ch);
    }
    if (ctrl && ((ch >= 97 && ch <= 122) || (ch >= 65 && ch <= 90))) {
        return Pressed(ch | 32);
    }
    return Typed(ch >= 32 && ch != 127 ? ch : -1);
}

// the events of the window until it is closed (or its compositor gone),
// the caret blinking between them
action loopWayland<M>(c: net.Conn, f: Font, m: M, ui: Ui, st: State, view: (M) => Element, update: (M, Input) => [M, Effect[]]): M {
    if (st.done || ui.closed) {
        return m;
    }
    // nothing to read before the caret blinks: drawn again
    const wait = wakeIn(ui, clock());
    const ready = match (unix.poll([unix.fdOf(c)], wait)) {
        Ok(rs) => rs[0] != 0i32,
        Err(e) => true,
    };
    if (!ready) {
        const [u1, m1, due] = timed(ui, m, clock(), update);
        const [u2, s2] = st.shown && due ? drawWayland(c, f, m1, view, u1, st) : [u1, st] as const;
        return loopWayland(c, f, m1, u2, s2, view, update);
    }
    const r = match (unix.receiveWithFds(c, 65536, 8)) {
        Ok(got) => got,
        Err(e) => ({ bytes: [], fds: [] }),
    };
    if (r.bytes.length == 0) {
        return m;
    }
    const [evs, rest] = wl.events(concat(st.pending, r.bytes));
    // the descriptors received, taken in their order by the events that
    // carry one (the table of the keyboard, a paste of another program),
    // then closed
    const [hm, hu, ns] = handle(c, f, m, evs, 0, ui, { ...st, pending: rest, fds: r.fds, fdAt: 0 }, view, update);
    const closed = map(r.fds, (fd) => unix.closeFd(fd) == Ok(()) ? 1 : 0);
    const [nu, nm, due] = timed(hu, hm, clock(), update);
    const [u2, s2] = due && ns.shown && !ns.done ? drawWayland(c, f, nm, view, nu, ns) : [nu, ns] as const;
    return loopWayland(c, f, nm, u2, shapeShown(c, s2, u2.cursor), view, update);
}

// the events `evs` from the `i`-th, answered in their order
action handle<M>(c: net.Conn, f: Font, m: M, evs: wl.Event[n], i: i64, ui: Ui, st: State, view: (M) => Element, update: (M, Input) => [M, Effect[]]): [M, Ui, State] {
    if (i >= evs.length || st.done) {
        return [m, ui, st] as const;
    }
    const now = clock();
    const e = evs[i];
    // the table of the keyboard: the descriptor sent with its event
    if (e.obj == wl.KEYBOARD && e.op == 0u32 && e.args.length >= 8) {
        const km = st.fdAt < st.fds.length ? keymapOf(st.fds[st.fdAt], i64(wl.word(e.args, 4))) : st.keymap;
        return handle(c, f, m, evs, i + 1, ui, { ...st, keymap: km, fdAt: st.fdAt + 1 }, view, update);
    }
    // the serial of an input (its entry, a key, a button): that of the
    // selection made after it
    const serial = (e.obj == wl.KEYBOARD && (e.op == 1u32 || e.op == 3u32)) || (e.obj == wl.POINTER && e.op == 3u32) ? (e.args.length >= 4 ? wl.word(e.args, 0) : st.serial) : st.serial;
    // this program's selection: its text written to the descriptor of a
    // program that pastes it (closed after the events); another's selection
    // made: this one's destroyed
    if (st.source != 0u32 && e.obj == st.source && e.op == 1u32) {
        const written = st.fdAt < st.fds.length ? unix.writeFd(st.fds[st.fdAt], bytes(st.text)) : Ok(());
        return handle(c, f, m, evs, i + 1, ui, { ...st, fdAt: st.fdAt + 1 }, view, update);
    }
    if (st.source != 0u32 && e.obj == st.source && e.op == 2u32) {
        const gone = net.write(c, wl.sourceDestroy(st.source));
        return handle(c, f, m, evs, i + 1, ui, { ...st, source: 0u32, text: "" }, view, update);
    }
    // the selections of the others: an offer made (its types follow), the
    // selection set (an offer, or none)
    if (st.device != 0u32 && e.obj == st.device && e.op == 0u32 && e.args.length >= 4) {
        return handle(c, f, m, evs, i + 1, ui, { ...st, lastOffer: wl.word(e.args, 0), lastMime: "" }, view, update);
    }
    if (st.lastOffer != 0u32 && e.obj == st.lastOffer && e.op == 0u32) {
        const [mime, after] = wl.strAt(e.args, 0);
        const better = mime == "text/plain;charset=utf-8" || (st.lastMime == "" && (mime == "text/plain" || mime == "UTF8_STRING"));
        return handle(c, f, m, evs, i + 1, ui, better ? { ...st, lastMime: mime } : st, view, update);
    }
    if (st.device != 0u32 && e.obj == st.device && e.op == 5u32 && e.args.length >= 4) {
        const id = wl.word(e.args, 0);
        const gone = st.offer != 0u32 && st.offer != id ? net.write(c, wl.offerDestroy(st.offer)) : Ok(());
        const next = id == 0u32 ? { ...st, offer: 0u32, mime: "" } : { ...st, offer: id, mime: id == st.lastOffer ? st.lastMime : "" };
        return handle(c, f, m, evs, i + 1, ui, next, view, update);
    }
    if (serial != st.serial) {
        return handle(c, f, m, evs, i, ui, { ...st, serial: serial }, view, update);
    }
    const [nm, nu, ns] = match (wl.input(e)) {
        // (sizes and places in units of the compositor, the images in
        // pixels: times the scale of its screen)
        wl.Size(w, h) => {
            if (w <= 0 || h <= 0) {
                return [m, ui, st] as const;
            }
            const [mm, u, s2] = feedWayland(c, ui, m, now, st, update, Resized(w * st.scale, h * st.scale));
            return [mm, u, { ...s2, lw: w, lh: h }] as const;
        },
        wl.OutputScale(obj, k) => {
            if (obj != st.output || k < 1 || k == st.scale) {
                return [m, ui, st] as const;
            }
            const set = net.write(c, wl.scaleRequest(k));
            const [u1, m1] = steps(ui, m, [Scaled(f32(k)), Resized(st.lw * k, st.lh * k)], now, update);
            // the pointer drawn here: its images at the scale of the screen
            const st2 = st.shapes == 0u32 ? cursorImages(c, { ...st, scale: k }, k) : { ...st, scale: k };
            return [m1, { ...u1, asked: [] }, shapeShown(c, st2, u1.cursor)] as const;
        },
        wl.Configure(serial) => {
            const acked = net.write(c, wl.request(wl.XDG_SURFACE, 4u32, wl.le32(serial)));
            const [u2, s2] = drawWayland(c, f, m, view, ui, { ...st, shown: true });
            return [m, u2, s2] as const;
        },
        wl.Ping(serial) => {
            const pong = net.write(c, wl.request(wl.WM_BASE, 3u32, wl.le32(serial)));
            return [m, ui, st] as const;
        },
        wl.Pointer(x, y) => feedWayland(c, ui, m, now, st, update, Moved(f32(x) * f32(st.scale), f32(y) * f32(st.scale))),
        // its entry: its serial kept (the shape of the pointer set with it)
        wl.Enter(serial, x, y) => {
            const [mm, u, s2] = feedWayland(c, ui, m, now, st, update, Moved(f32(x) * f32(st.scale), f32(y) * f32(st.scale)));
            return [mm, u, shapeShown(c, { ...s2, entry: serial, shape: -1 }, u.cursor)] as const;
        },
        wl.Leave => [m, ui, { ...st, entry: 0u32 }] as const,
        // the buttons of evdev: left (BTN_LEFT, 272), right, middle
        wl.Button(b, down) => {
            const which = b == 272u32 ? 0 : (b == 273u32 ? 1 : (b == 274u32 ? 2 : -1));
            return which < 0 ? [m, ui, st] as const : feedWayland(c, ui, m, now, st, update, down ? Down(which) : Up(which));
        },
        wl.Modifiers(mods) => {
            const [u, mm] = steps(ui, m, [Mods(modsOf(mods))], now, update);
            return [mm, u, { ...st, mods: mods }] as const;
        },
        // the vertical wheel: its distance, four times (a notch: 10)
        wl.Axis(axis, value) => axis == 0u32 ? feedWayland(c, ui, m, now, st, update, Scroll(f32(value) * 4.0f32)) : [m, ui, st] as const,
        wl.Key(code, down) => {
            const ch = down ? charOf(st.keymap, code, st.mods) : 0;
            return ch != 0 ? match (keyEvent(ch, st.mods)) {
                Typed(t) => t < 0 ? [m, ui, st] as const : feedWayland(c, ui, m, now, st, update, Typed(t)),
                ev => feedWayland(c, ui, m, now, st, update, ev),
            } : [m, ui, st] as const;
        },
        wl.Close => feedWayland(c, ui, m, now, st, update, Closed),
        wl.Failure(msg) => [m, ui, { ...st, done: true, failed: msg }] as const,
        _ => [m, ui, st] as const,
    };
    return handle(c, f, nm, evs, i + 1, nu, ns, view, update);
}

// ----- X11 ---------------------------------------------------------------

// the atoms the window of X11 asks, in their order
const ATOMS: string[] = ["WM_PROTOCOLS", "WM_DELETE_WINDOW", "_NET_WM_NAME", "UTF8_STRING", "CLIPBOARD", "TARGETS", "ISOCRON_PASTE"];
const A_PROTOCOLS: i64 = 0;
const A_DELETE: i64 = 1;
const A_NET_NAME: i64 = 2;
const A_UTF8: i64 = 3;
const A_CLIPBOARD: i64 = 4;
const A_TARGETS: i64 = 5;
const A_PASTE: i64 = 6;
// the atoms every server has (their numbers fixed by the protocol)
const XA_ATOM: u32 = 4u32;
const XA_RESOURCE_MANAGER: u32 = 23u32;
const XA_STRING: u32 = 31u32;
const XA_WM_NAME: u32 = 39u32;

// what the loop of X11 keeps: the server, the ids of the window, of its
// context of drawing and of its three pointers, the shape shown, the table
// of the keyboard, the modifiers held, the bytes of a message not received
// whole and the messages read not yet answered, the atoms, the selection
// owned and its text
type XState = {
    setup: x11.Setup,
    window: u32,
    gc: u32,
    cursorFirst: u32,
    shape: i64,
    keymap: Keymap,
    mods: i64,
    pending: u8[],
    queued: x11.Message[],
    atoms: u32[],
    owner: boolean,
    text: string,
    done: boolean,
};

// the bytes `c` received within `ms` ms added to those of `pending`: the
// whole messages among them, the bytes left; none received: `gone`
action readX(c: net.Conn, pending: u8[], ms: i64): [x11.Message[], u8[], boolean] {
    const ready = match (unix.poll([unix.fdOf(c)], ms)) {
        Ok(rs) => rs[0] != 0i32,
        Err(e) => true,
    };
    if (!ready) {
        return [[], pending, false] as const;
    }
    return match (net.read(c, 1048576)) {
        Ok(b) => {
            const [ms2, rest] = x11.messages(concat(pending, b));
            return [ms2, rest, b.length == 0] as const;
        },
        Err(e) => [[], pending, true] as const,
    };
}

// the replies of the server until `want` are received (at most a second
// between two reads), in their order; the other messages kept apart
action repliesX(c: net.Conn, pending: u8[], want: i64, got: x11.Message[], others: x11.Message[]): [x11.Message[], x11.Message[], u8[]] {
    if (got.length >= want) {
        return [got, others, pending] as const;
    }
    const [ms, rest, gone] = readX(c, pending, 1000);
    if (gone || ms.length == 0) {
        return [got, others, rest] as const;
    }
    return repliesX(c, rest, want, concat(got, filter(ms, (m) => m.code == 1)), concat(others, filter(ms, (m) => m.code != 1)));
}

// the first event of the code `code` read (at most a second without a
// message), the others kept in the order they came
action eventX(c: net.Conn, st: XState, code: i64, seen: x11.Message[]): [boolean, x11.Message, XState] {
    const k = findIndex(seen, (m) => m.code == code);
    if (k >= 0) {
        const rest = concat(seen.slice(0, k), seen.slice(k + 1, seen.length));
        return [true, seen[k], { ...st, queued: concat(st.queued, rest) }] as const;
    }
    const [ms, rest, gone] = readX(c, st.pending, 1000);
    if (gone || ms.length == 0) {
        return [false, { code: 0, bytes: [] }, { ...st, pending: rest, queued: concat(st.queued, seen) }] as const;
    }
    return eventX(c, { ...st, pending: rest }, code, concat(seen, ms));
}

// the density of the screen in the resources of the server (`Xft.dpi`,
// the value desktops set), as pixels of a unit; 1 without it
function scaleOf(resources: string): f32 {
    const lines = resources.split("\n");
    const k = findIndex(lines, (l) => l.startsWith("Xft.dpi:"));
    if (k < 0) {
        return 1.0f32;
    }
    const v = match (tryParseF64(lines[k].slice(8, lines[k].length).trim())) {
        Ok(d) => d,
        Err(e) => 96.0,
    };
    return v >= 48.0 && v <= 960.0 ? f32(v / 96.0) : 1.0f32;
}

// the rows of the image `px` sent from `y` in requests of `rows` rows
action stripsX(c: net.Conn, st: XState, px: u32[n], w: i64, h: i64, y: i64, rows: i64): boolean {
    if (y >= h) {
        return true;
    }
    const k = min(rows, h - y);
    const sent = net.write(c, x11.putImage(st.window, st.gc, px, w, y, k, st.setup.depth, st.setup.littleImages));
    return sent == Ok(()) && stripsX(c, st, px, w, h, y + k, rows);
}

// the view of `m` laid out, drawn and sent to the window; the interface
// with its places
@noInline
action drawX11<M>(c: net.Conn, f: Font, m: M, view: (M) => Element, ui: Ui, st: XState): Ui {
    const [ps, next] = laidOut(ui, f, m, view, clock());
    const px = render(ui.w, ui.h, rgb(0xFFFFFFu32), ps);
    const sent = stripsX(c, st, px, ui.w, ui.h, 0, x11.rowsPerRequest(ui.w, st.setup.maxRequest));
    return next;
}

// the text of the selection `CLIPBOARD` of another program asked as
// UTF-8 into the property of the window; "" when it fails or is not UTF-8
@noInline
action pasteX(c: net.Conn, st: XState): [string, XState] {
    const asked = net.write(c, x11.convertSelection(st.window, st.atoms[A_CLIPBOARD], st.atoms[A_UTF8], st.atoms[A_PASTE]));
    const [found, ev, st1] = eventX(c, st, x11.SELECTION_NOTIFY, []);
    if (!found || x11.u32At(ev.bytes, 20) == 0u32) {
        return ["", st1] as const;
    }
    const read = net.write(c, x11.getProperty(st.window, st.atoms[A_PASTE], true));
    const [rs, others, rest] = repliesX(c, st1.pending, 1, [], []);
    const st2 = { ...st1, pending: rest, queued: concat(st1.queued, others) };
    if (rs.length == 0) {
        return ["", st2] as const;
    }
    const b = x11.propertyValue(rs[0]);
    return [utf8Valid(b) ? stringOf(b) : "", st2] as const;
}

// the event `ev` given to `step`, what the model asks done: a text copied
// made the selection `CLIPBOARD` of this window; a paste given the
// selection of another program, else the program's clipboard
@noInline
action feedX11<M>(c: net.Conn, ui: Ui, m: M, now: u64, st: XState, update: (M, Input) => [M, Effect[]], ev: Ev): [M, Ui, XState] {
    const [u1, m1] = step(ui, m, ev, now, update);
    const copied = count(u1.asked, (e) => isCopy(e)) > 0;
    const asks = count(u1.asked, (e) => e == AskPaste) > 0;
    const owned = copied ? net.write(c, x11.setSelectionOwner(st.window, st.atoms[A_CLIPBOARD])) : Ok(());
    const st1 = copied ? { ...st, owner: true, text: u1.clipboard } : st;
    if (!asks) {
        return [m1, { ...u1, asked: [] }, st1] as const;
    }
    const [got, st2] = st1.owner ? [u1.clipboard, st1] as const : pasteX(c, st1);
    const text = got == "" ? u1.clipboard : got;
    const [u2, m2] = step({ ...u1, asked: [] }, m1, Pasted(text), now, update);
    return [m2, { ...u2, asked: [] }, st2] as const;
}

// a program that asks the selection this window owns answered: its text
// (UTF-8, or the list of the types offered) written into the property it
// names, then told; another type refused
@noInline
action answerX(c: net.Conn, st: XState, e: x11.Message): XState {
    const b = e.bytes;
    const requestor = x11.u32At(b, 12);
    const target = x11.u32At(b, 20);
    const named = x11.u32At(b, 24);
    const property = named == 0u32 ? target : named;
    const types = st.atoms[A_TARGETS] == target;
    const text = target == st.atoms[A_UTF8] || target == XA_STRING;
    const written = types ? net.write(c, x11.changeProperty(requestor, property, XA_ATOM, 32, x11.words([st.atoms[A_TARGETS], st.atoms[A_UTF8], XA_STRING])))
        : (text && st.owner ? net.write(c, x11.changeProperty(requestor, property, target, 8, bytes(st.text))) : Ok(()));
    const told = net.write(c, x11.selectionNotify(requestor, x11.u32At(b, 16), target, types || (text && st.owner) ? property : 0u32, x11.u32At(b, 4)));
    return st;
}

// the modifiers of the state `state` of an event of X11 given to the
// interface when they changed
function modsStepped<M>(ui: Ui, m: M, st: XState, state: i64, now: u64, update: (M, Input) => [M, Effect[]]): [Ui, M, XState] {
    const mods = modsOf(u32(state));
    if (mods == st.mods) {
        return [ui, m, st] as const;
    }
    const [u1, m1] = steps(ui, m, [Mods(mods)], now, update);
    return [{ ...u1, asked: [] }, m1, { ...st, mods: mods }] as const;
}

// the message `e` answered: the model, the interface and the state after it
action answerMessageX<M>(c: net.Conn, m: M, e: x11.Message, ui: Ui, st: XState, update: (M, Input) => [M, Effect[]]): [M, Ui, XState] {
    const now = clock();
    const b = e.bytes;
    if (sys.env("ISC_UI_TRACE") != None && e.code == 0) {
        print(["error of X11", i64(b[1]), i64(b[10]), x11.u32At(b, 4)] as const);
    }
    if (e.code == x11.KEY_PRESS || e.code == x11.BUTTON_PRESS || e.code == x11.BUTTON_RELEASE) {
        // the modifiers held first
        const state = x11.u16At(b, 28);
        const [u0, m0, s0] = modsStepped(ui, m, st, state, now, update);
        if (e.code == x11.KEY_PRESS) {
            const ch = charOf(s0.keymap, u32(b[1]), u32(state));
            if (ch == 0) {
                return [m0, u0, s0] as const;
            }
            return match (keyEvent(ch, u32(state))) {
                Typed(t) => t < 0 ? [m0, u0, s0] as const : feedX11(c, u0, m0, now, s0, update, Typed(t)),
                kev => feedX11(c, u0, m0, now, s0, update, kev),
            };
        }
        // the buttons of X11: 1 left, 2 middle, 3 right, 4 and 5 the wheel
        // (a notch up, down: as 10 units of Wayland, four times)
        const button = i64(b[1]);
        const down = e.code == x11.BUTTON_PRESS;
        if (button == 4 || button == 5) {
            return down ? feedX11(c, u0, m0, now, s0, update, Scroll(button == 5 ? 40.0f32 : -40.0f32)) : [m0, u0, s0] as const;
        }
        const which = button == 1 ? 0 : (button == 3 ? 1 : (button == 2 ? 2 : -1));
        return which < 0 ? [m0, u0, s0] as const : feedX11(c, u0, m0, now, s0, update, down ? Down(which) : Up(which));
    }
    if (e.code == x11.MOTION || e.code == x11.ENTER) {
        return feedX11(c, ui, m, now, st, update, Moved(f32(x11.i16At(b, 24)), f32(x11.i16At(b, 26))));
    }
    if (e.code == x11.CONFIGURE) {
        const w = x11.u16At(b, 20);
        const h = x11.u16At(b, 22);
        return w == ui.w && h == ui.h ? [m, ui, st] as const : feedX11(c, ui, m, now, st, update, Resized(w, h));
    }
    if (e.code == x11.EXPOSE) {
        return x11.u16At(b, 16) == 0 ? [m, { ...ui, redraw: true }, st] as const : [m, ui, st] as const;
    }
    if (e.code == x11.CLIENT_MESSAGE) {
        const closing = x11.u32At(b, 8) == st.atoms[A_PROTOCOLS] && x11.u32At(b, 12) == st.atoms[A_DELETE];
        return closing ? feedX11(c, ui, m, now, st, update, Closed) : [m, ui, st] as const;
    }
    if (e.code == x11.SELECTION_REQUEST) {
        return [m, ui, answerX(c, st, e)] as const;
    }
    if (e.code == x11.SELECTION_CLEAR) {
        return [m, ui, x11.u32At(b, 12) == st.atoms[A_CLIPBOARD] ? { ...st, owner: false, text: "" } : st] as const;
    }
    if (e.code == x11.MAPPING) {
        // the table of the keyboard changed: read again
        const asked = net.write(c, x11.keyboardMapping(st.setup.minKeycode, st.setup.maxKeycode - st.setup.minKeycode + 1));
        const [rs, others, rest] = repliesX(c, st.pending, 1, [], []);
        const km = rs.length == 0 ? st.keymap : x11.keymapOf(rs[0], st.setup.minKeycode);
        return [m, ui, { ...st, keymap: km, pending: rest, queued: concat(st.queued, others) }] as const;
    }
    return [m, ui, st] as const;
}

// the messages `ms` from the `i`-th, answered in their order
action handleX<M>(c: net.Conn, m: M, ms: x11.Message[n], i: i64, ui: Ui, st: XState, update: (M, Input) => [M, Effect[]]): [M, Ui, XState] {
    if (i >= n || st.done || ui.closed) {
        return [m, ui, st] as const;
    }
    const [nm, nu, ns] = answerMessageX(c, m, ms[i], ui, st, update);
    return handleX(c, nm, ms, i + 1, nu, ns, update);
}

// the events of the window until it is closed (or its server gone), the
// caret blinking between them: the messages answered, the window drawn
// again when it changed, the shape of the pointer set
action loopX11<M>(c: net.Conn, f: Font, m: M, ui: Ui, st: XState, view: (M) => Element, update: (M, Input) => [M, Effect[]]): M {
    if (st.done || ui.closed) {
        return m;
    }
    // the messages read during a wait (a paste) first
    const queued = st.queued.length > 0;
    const [ms, rest, gone] = queued ? [st.queued, st.pending, false] as const : readX(c, st.pending, wakeIn(ui, clock()));
    if (gone) {
        return m;
    }
    const [hm, hu, ns] = handleX(c, m, ms, 0, ui, { ...st, pending: rest, queued: [] }, update);
    const [nu, nm, due] = timed(hu, hm, clock(), update);
    const u2 = due ? drawX11(c, f, nm, view, nu, ns) : nu;
    const shaped = u2.cursor != ns.shape ? net.write(c, x11.setCursor(ns.window, ns.cursorFirst + u32(u2.cursor))) : Ok(());
    return loopX11(c, f, nm, { ...u2, redraw: false }, { ...ns, shape: u2.cursor }, view, update);
}

// the connection to the server of `display`: its abstract socket, else
// its file
action connectX(display: string): Result<net.Conn, IoError> {
    const [abstract, path, number] = x11.displayPlace(display);
    if (number < 0) {
        return Err(ioError(2, "a display of X11 on another machine"));
    }
    if (abstract != "") {
        return match (unix.connect(abstract)) {
            Ok(c) => Ok(c),
            Err(e) => unix.connect(path),
        };
    }
    return unix.connect(path);
}

action runX11<M>(title: string, width: i64, height: i64, labels: string[], f: Font, m: M, view: (M) => Element, update: (M, Input) => [M, Effect[]]): M {
    const display = sys.env("DISPLAY") ?? "";
    return match (connectX(display)) {
        Ok(c) => {
            const [a, p, number] = x11.displayPlace(display);
            const key = x11.localCookie(number);
            const hello = net.write(c, x11.setupRequest(key.length > 0 ? "MIT-MAGIC-COOKIE-1" : "", key));
            const answer = setupBytes(c, []);
            const setup = x11.setupOf(answer);
            if (setup.failure != "") {
                fail(title, setup.failure);
                net.close(c);
                return m;
            }
            // the atoms, the table of the keyboard, the resources of the
            // server (its density): replies in this order
            const asked = net.write(c, concat(concat(x11.internAtoms(ATOMS, 0, []),
                x11.keyboardMapping(setup.minKeycode, setup.maxKeycode - setup.minKeycode + 1)), x11.getProperty(setup.root, XA_RESOURCE_MANAGER, false)));
            const [rs, others, rest] = repliesX(c, [], ATOMS.length + 2, [], []);
            if (rs.length < ATOMS.length + 2) {
                fail(title, "the server of X11 did not answer");
                net.close(c);
                return m;
            }
            const atoms = map(iota(ATOMS.length), (k) => x11.atomOf(rs[k]));
            const keymap = x11.keymapOf(rs[ATOMS.length], setup.minKeycode);
            const resources = x11.propertyValue(rs[ATOMS.length + 1]);
            const scale = scaleOf(utf8Valid(resources) ? stringOf(resources) : "");
            const pw = i64(f32(width) * scale);
            const ph = i64(f32(height) * scale);
            const id = (k: i64) => setup.idBase | (u32(k) & setup.idMask);
            const window = id(1);
            const name = bytes(title);
            const glyphs = map(iota(3), (k) => k == POINTER_SHAPE ? x11.GLYPH_HAND : (k == TEXT_SHAPE ? x11.GLYPH_TEXT : x11.GLYPH_ARROW));
            const made = net.write(c, concat(concat(concat(concat(
                x11.createWindow(window, setup.root, pw, ph, setup.white),
                x11.changeProperty(window, XA_WM_NAME, XA_STRING, 8, name)),
                concat(x11.changeProperty(window, atoms[A_NET_NAME], atoms[A_UTF8], 8, name), x11.changeProperty(window, atoms[A_PROTOCOLS], XA_ATOM, 32, x11.le32(atoms[A_DELETE])))),
                concat(concat(x11.createGc(id(2), window), x11.openFont(id(3), "cursor")), x11.glyphCursors(id(4), id(3), glyphs, 0, []))),
                concat(x11.setCursor(window, id(4)), x11.mapWindow(window))));
            const st = {
                setup: setup, window: window, gc: id(2), cursorFirst: id(4), shape: ARROW, keymap: keymap, mods: 0,
                pending: rest, queued: others, atoms: atoms, owner: false, text: "", done: false,
            };
            const ui = { ...interface(pw, ph, clock()), labels: labels, scale: scale, redraw: false };
            const end = loopX11(c, f, m, ui, st, view, update);
            net.close(c);
            return end;
        },
        Err(e) => {
            fail(title, `no display: the server of X11 of "${display}" could not be reached (${sys.message(e)})`);
            return m;
        },
    };
}

// the whole answer of the server to the setup (at most a second between
// two reads)
action setupBytes(c: net.Conn, got: u8[]): u8[] {
    if (got.length >= 8 && got.length >= x11.setupLength(got)) {
        return got;
    }
    const ready = match (unix.poll([unix.fdOf(c)], 1000)) {
        Ok(rs) => rs[0] != 0i32,
        Err(e) => false,
    };
    if (!ready) {
        return got;
    }
    return match (net.read(c, 65536)) {
        Ok(b) => b.length == 0 ? got : setupBytes(c, concat(got, b)),
        Err(e) => got,
    };
}
