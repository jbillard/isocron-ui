// A file of Lua run by the interpreter of the library (src/lua.isc), its
// lines printed, its error as the reference interpreter writes it
// (`lua: file:line: message`): the tests of tests/lua.sh compare the two.
// usage: run FILE.lua [ARGS...]   (ARGS: the `...` of the chunk)
import * as lua from "../../src/lua";

action main(args: string[k]): i32 {
    if (args.length < 1) {
        print("usage: run FILE.lua [ARGS...]");
        return 2;
    }
    const st0 = lua.newState();
    if (lua.failed(st0)) {
        print(`lua: the prelude: ${lua.errorText(st0)}`);
        return 1;
    }
    const [s1, f] = lua.load(st0, readText(args[0]), args[0]);
    if (lua.failed(s1)) {
        print(`lua: ${lua.errorText(s1)}`);
        return 1;
    }
    const [s2, rs] = lua.call(s1, f, map(args.slice(1, args.length), (a) => lua.Str(a)));
    const [s3, out] = lua.takeOutput(s2);
    if (out.length > 0) {
        print(join(out, "\n"));
    }
    if (lua.failed(s3)) {
        print(`lua: ${lua.errorText(s3)}`);
        return 1;
    }
    return 0;
}
