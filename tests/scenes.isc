// The scenes of the tests: each drawn small (the interpreter draws them
// too), written as a PNG file into the folder of the first argument; its
// CRC-32 printed.
import { interface, laidOut } from "../src/app";
import { editing } from "../src/edit";
import { Primitive, Box, Blur, Color, quad, rounded, bordered, rgb, rgba, render } from "../src/paint";
import { encode, crc32, decode } from "../src/png";
import { parse } from "../src/font";
import { line } from "../src/text";
import { place, placeScrolled, Div, Image as ImageEl, Row, style } from "../src/ui";
import { Center } from "../src/text";
import { view, initial, update, INCREMENT, STEP } from "../examples/counter";
import * as todo from "../examples/todo";

function corners(x: f32, y: f32, w: f32, h: f32, blur: f32, c: Color, r: f32): Primitive {
    return Blur({ x: x, y: y, w: w, h: h, blur: blur, color: c, topLeft: r, topRight: r, bottomRight: r, bottomLeft: r });
}

action scene(dir: string, name: string, w: i64, h: i64, base: Color, ps: Primitive[n]): void {
    const f = encode(w, h, render(w, h, base, ps));
    writeBytes(`${dir}/${name}.png`, f);
    print(`${name} ${crc32(f)}`);
}

action main(args: string[k]): i32 {
    const white = rgb(0xFFFFFFu32);
    // a square, a rounded rectangle, a pill, at fractional places
    scene(args[0], "quads", 64, 48, white, [
        Box(quad(4.0f32, 4.0f32, 16.0f32, 16.0f32, rgb(0xEF4444u32))),
        Box(rounded(quad(24.5f32, 4.25f32, 30.0f32, 20.0f32, rgb(0x3B82F6u32)), 6.0f32)),
        Box(rounded(quad(6.0f32, 30.0f32, 50.0f32, 12.0f32, rgb(0x10B981u32)), 6.0f32)),
    ]);
    // borders of different widths, a radius larger than the border
    scene(args[0], "borders", 64, 48, rgb(0xF3F4F6u32), [
        Box(bordered(rounded(quad(4.0f32, 4.0f32, 56.0f32, 40.0f32, white), 10.0f32), 3.0f32, rgb(0x111827u32))),
        Box({ ...quad(14.0f32, 14.0f32, 36.0f32, 20.0f32, rgb(0xFDE68Au32)), borderColor: rgb(0xD97706u32), top: 1.0f32, right: 4.0f32, bottom: 2.0f32, left: 0.0f32, topLeft: 0.0f32, topRight: 8.0f32, bottomRight: 3.0f32, bottomLeft: 0.0f32 }),
    ]);
    // colours with alpha over each other, on a transparent base
    scene(args[0], "alpha", 64, 48, rgba(0.0f32, 0.0f32, 0.0f32, 0.0f32), [
        Box(rounded(quad(4.0f32, 4.0f32, 36.0f32, 30.0f32, rgba(1.0f32, 0.0f32, 0.0f32, 0.5f32)), 8.0f32)),
        Box(rounded(quad(24.0f32, 14.0f32, 36.0f32, 30.0f32, rgba(0.0f32, 0.0f32, 1.0f32, 0.5f32)), 8.0f32)),
    ]);
    // shadows: sharp, blurred, then their card
    scene(args[0], "shadows", 64, 48, rgb(0xE5E7EBu32), [
        corners(10.0f32, 10.0f32, 40.0f32, 24.0f32, 4.0f32, rgba(0.0f32, 0.0f32, 0.0f32, 0.5f32), 6.0f32),
        Box(rounded(quad(8.0f32, 7.0f32, 40.0f32, 24.0f32, white), 6.0f32)),
        corners(14.0f32, 38.0f32, 30.0f32, 6.0f32, 0.0f32, rgba(0.2f32, 0.2f32, 0.6f32, 0.7f32), 3.0f32),
    ]);
    // text: two sizes, accents, kerning (AV), a fraction of a pixel
    match (parse(readBytes("tests/fonts/DejaVuSans.ttf"))) {
        Ok(f) => {
            scene(args[0], "text", 96, 40, white, concat(line(f, 16.0f32, "AVé€", 4.25f32, 17.0f32, rgb(0x111827u32)), line(f, 11.0f32, "Isocron 0,5", 4.0f32, 33.0f32, rgb(0x2563EBu32))));
            // the layout of the counter (examples/counter.isc), its model
            // after two messages
            const [ps, hits] = place(f, view(update(update(initial(), STEP), INCREMENT)), 0.0f32, 0.0f32, 480.0f32, 320.0f32);
            scene(args[0], "counter", 480, 320, white, ps);
            // the list of tasks: a draft typed in the field that has the
            // focus (its caret after it), the button that adds lit
            const t = { ...todo.initial(), field: editing("Pain"), focused: true, hover: todo.ADD };
            const [tp, th] = place(f, todo.view(t), 0.0f32, 0.0f32, 520.0f32, 420.0f32);
            scene(args[0], "todo", 520, 420, white, tp);
            // ten tasks, their column scrolled by 100 pixels: cut at its
            // top and its bottom
            const many = { ...todo.initial(), items: map(iota(10), (i) => ({ text: `Tâche ${i}`, done: i % 3 == 0 })) };
            const [sp, sh] = placeScrolled(f, todo.view(many), 0.0f32, 0.0f32, 520.0f32, 420.0f32, map(iota(16), (i) => i == 0 ? 100.0f32 : 0.0f32));
            scene(args[0], "scrolled", 520, 420, white, sp);
            // the menu of the field open over the list, its second entry
            // under the pointer, the field holding a selection
            const sel = { ...todo.initial(), field: { text: "Pain de mie", caret: 11, anchor: 5 }, focused: true };
            const ui0 = { ...interface(520, 420, 0u64), menu: true, menuX: 150.0f32, menuY: 128.0f32, menuHover: 1, menuCut: true, labels: ["Couper", "Copier", "Coller", "Tout sélectionner"] };
            const [mp, mu] = laidOut(ui0, f, sel, todo.view, 0u64);
            scene(args[0], "menu", 520, 420, white, mp);
            // the list of tasks at 150 % (a screen of 144 dots per inch): its
            // window of 520 by 420 units, 780 by 630 pixels
            const [sp15, su15] = laidOut({ ...interface(780, 630, 0u64), scale: 1.5f32 }, f, { ...todo.initial(), field: editing("Pain"), focused: true }, todo.view, 0u64);
            scene(args[0], "todo150", 780, 630, white, sp15);
            // the focus of the keyboard on the button Ajouter: its ring
            const [fp, fu] = laidOut({ ...interface(520, 420, 0u64), focus: todo.ADD, ring: true }, f, todo.initial(), todo.view, 0u64);
            scene(args[0], "focus", 520, 420, white, fp);
            // images of the PngSuite (colour and alpha; colour): at their
            // size, four times larger (bilinear), stretched; over a ground
            // of colour, the alpha seen through
            match (decode(readBytes("tests/png/basn6a08.png"))) {
                Ok(pa) => match (decode(readBytes("tests/png/basn2c08.png"))) {
                    Ok(pc) => {
                        const pics = Div({ ...style(), direction: Row, gap: 16.0f32, padding: 16.0f32, align: Center, stretch: false, background: rgb(0xFDE68Au32) }, [
                            ImageEl(pa, 0.0f32, 0.0f32),
                            ImageEl(pa, 128.0f32, 128.0f32),
                            ImageEl(pc, 96.0f32, 48.0f32),
                        ]);
                        const [ip, ih] = place(f, pics, 0.0f32, 0.0f32, 320.0f32, 160.0f32);
                        scene(args[0], "images", 320, 160, white, ip);
                    },
                    Err(e) => print(e),
                },
                Err(e) => print(e),
            };
        },
        Err(e) => print(e),
    };
    return 0;
}
